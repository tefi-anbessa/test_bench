require 'test_helper'
require 'helpers/test_setup_helpers'
<%- unless @nesting == :none -%>
require <%= "helpers/#{policy_resource_class.underscore}_test".inspect %>
<%- end -%>
<%- if @namespaced -%>
module <%= module_name %>
<%- end -%>
  class <%= model_class_name %>PolicyTest < ActiveSupport::TestCase
    include TestSetupHelpers
<%- unless @nesting == :none -%>
    include <%= "#{policy_resource_class}Test" %>
<%- end -%>

    setup do
      setup_projects_and_users
<%- case @nesting -%>
<%- when :project -%>
      setup_project_resources
<%- when :discipline -%>
      setup_disciplines
      setup_discipline_resources
      setup_accredited_users
<%- when :tag -%>
      setup_disciplines
      setup_tags
      setup_nested_discipline_resources(:tag, @tag, @other_tag)
      setup_accredited_users
<%- when :document -%>
      setup_disciplines
      setup_documents
      setup_nested_discipline_resources(:document, @document, @other_document)
      setup_accredited_users
<%- when :issue -%>
      setup_disciplines
      setup_documents
      setup_issues
      setup_nested_discipline_resources(:issue, @issue, @other_issue)
      setup_accredited_users
<%- when :none -%>
      # System resources are bespoke, standalone policies (see
      # docs/ROLES_AND_PERMISSIONS.md's Policy Architecture section) - no
      # shared test module to include, write this resource's own tests.
<%- end -%>
    end
  end
<%- if @namespaced -%>
end
<%- end -%>
