require 'test_helper'
<%- unless @nesting == :none %>
require <%= "helpers/#{@nesting.to_s}_resource_policy_test" %>
<%- end -%>
require 'helpers/resource_policy_test'
<%- if @namespaced -%>
module <%= module_name %>
<%- end -%>
  class <%= model_class_name %>PolicyTest < ActiveSupport::TestCase
<%- unless @nesting == :none %>
    include <%= "#{@nesting.to_s.camelize}ResourcePolicyTest" %>
<%- end -%>

    def setup
      setup_resource_policy_test
      @resource = create(:<%= singular_table_name %>, discipline: @discipline)
      @other_resource = create(:<%= singular_table_name %>, discipline: @other_discipline)
    end

    def new_project_resource
      build(:<%= singular_table_name %>, discipline: @discipline)
    end

    def new_other_project_resource
      build(:<%= singular_table_name %>, discipline: @other_discipline)
    end

    # All setup and tests have been abstracted to ResourcePolicyTest and PolicyTestHelpers.
  end
<%- if @namespaced -%>
end
<%- end -%>