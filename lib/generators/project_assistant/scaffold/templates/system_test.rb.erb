require "application_system_test_case"
require "helpers/nested_resource_system_tests"
<%- if @namespaced -%>
module <%= module_name %>
<%- end -%>
  class <%= model_class_name.pluralize %>SystemTest < ApplicationSystemTestCase
    include Devise::Test::IntegrationHelpers
    include Warden::Test::Helpers
    include ActionView::Helpers::NumberHelper
    include NestedResourceSystemTests

    # The only two routes that actually vary by nesting type - everything
    # else (content check, show, new, edit, update, delete) is handled
    # generically by NestedResourceSystemTests.
    def resource_index_path
      <%= index_path(@nesting) %>
    end

    def new_resource_path
      <%= new_path(@nesting) %>
    end

    setup do
      setup_common_data
<%- case @nesting -%>
<%- when :discipline -%>
      setup_disciplines
      setup_accredited_users
<%- when :tag -%>
      setup_disciplines
      setup_accredited_users
      setup_tags
<%- when :document -%>
      setup_disciplines
      setup_accredited_users
      setup_documents
<%- when :project -%>
      # Reuse the project-scoped tiers setup_projects_and_users already
      # created - this resource isn't discipline-scoped, so there's no
      # functional role to grant a separate accredited_user.
      @accredited_user = @project_manager
      @admin = @project_admin
<%- when :none -%>
      # No distinct editor tier is assumed here - adjust if this resource's
      # policy actually grants edit access to someone other than admins.
      @accredited_user = @admin
<%- end -%>
      setup_model_specific_data
    end

    def setup_model_specific_data
      setup_nested_resources(<%= @nesting.inspect %>, <%= @nesting == :none ? "nil" : "@#{@nesting}" %>)
      @resource_index_header = I18n.t("<%= view_key %>.index.header", scope_text: <%= index_scope_text %>)
      @resource_index_title = I18n.t("<%= view_key %>.index.title")

      # List fields that should appear in index.
      # The generator will include test for sort link header for each included field,
      # and test for an appropriate value field for the type.
      @index_fields = %i[<%= @index_field_names.join(" ") %>]

      # List index fields that should have ransack search capability.
      # The generator will only build and test for "contains" predicates (_cont).
      # Don't include numeric or date fields here, add model specific tests for these later in this file if required.
      @search_fields = %i[<%= @searchable_field_names.join(" ") %>]

      # List all attribute fields that should appear in show.
      @show_fields = %i[<%= @attribute_names.join(" ") %>]

      # List all associations that should have a collapsible card on the show view.
      @show_associations = %i[<%= @association_names.join(" ") %>]

      # List all fields that should appear in forms (usually all).
      # New and edit required separately because some models have read only fields that can't be edited.
      # Set a differrent valid value for the field if it is required to be unique, otherwise set nil for factory default.
      @new_fields = { <%= @all_field_names.map { |f| "#{f}: nil" }.join(", ") %> }
      @edit_fields = @new_fields
    end

    def fill_in_model_specific_fields
      # Code for filling in any fields that don't follow the assumed pattern of the field type.
      # E.g. numeric fields with a drop down selector.
    end
  end
<%- if @namespaced -%>
end
<%- end -%>
