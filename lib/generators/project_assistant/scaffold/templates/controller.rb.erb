module <%= module_name %>
  class <%= model_class.pluralize %>Controller < ApplicationController
    before_action :authenticate_user!
    before_action :require_project!, only: %i[ new create edit update ]
    before_action :set_<%= singular_name %>, only: [:show, :edit, :update, :destroy]

    # GET /<%= controller_file_path %>
    def index
      authorize <%= class_name %>, :index?
      @q = policy_scope(<%= class_name %>).ransack(params[:q])
      @pagy, @<%= plural_name %> = pagy(@q.result.includes(:tag), limit: 20)
    end

    # GET /<%= controller_file_path %>/1
    def show
      authorize @<%= singular_name %>
    end

    # GET /<%= controller_file_path %>/new
    def new
      @<%= singular_name %> = <%= class_name %>.new
      authorize @<%= singular_name %>
      setup_form
    end

    # POST /<%= controller_file_path %>
    def create
      @<%= singular_name %> = <%= class_name %>.new(<%= singular_name %>_params)
      authorize @<%= singular_name %>

      if @<%= singular_name %>.save
        flash[:success] = [t('flash.create.notice', resource_name: "<%= human_name %>")]
        redirect_to @resource
      else
        flash[:alert] = [t('flash.create.alert', resource_name: "<%= singular_name %>")]
        render :new, status: :unprocessable_content
      end
    end

    # GET /<%= controller_file_path %>/1/edit
    def edit
      authorize @<%= singular_name %>
      setup_form
    end

    # PATCH/PUT /<%= controller_file_path %>/1
    def update
      authorize @<%= singular_name %>
      if @<%= singular_name %>.update(<%= singular_name %>_params)
        flash[:success] = [t('flash.update.notice', resource_name: "<%= human_name %>")]
        redirect_to @<%= singular_name %>
      else
        flash[:alert] = [t('flash.update.alert', resource_name: "<%= singular_name %>")]
        render :edit, status: :unprocessable_content 
      end
    end

    # DELETE /<%= controller_file_path %>/1
    def destroy
      authorize @<%= singular_name %>
      if @<%= singular_name %>.destroy
        flash[:success] = [t('flash.destroy.notice', resource_name: "<%= human_name %>")]
      else
        flash[:alert] = [t('flash.destroy.alert', resource_name: "<%= singular_name %>")]
      end
      redirect_to <%= plural_name %>_path
    end

    private

    # Use callbacks to share common setup or constraints between actions.
    def set_<%= singular_name %>
      @<%= singular_name %> = <%= class_name %>.find(params[:id])
    end

    # Only allow a list of trusted parameters through.
    def <%= singular_name %>_params
      params.require(:<%= singular_name %>).permit(<%= @fields.map { |f| ":#{f[:name]}" }.join(', ') %>)
    end
  end
end
