# frozen_string_literal: true
<%- if @namespaced -%>
module <%= module_name %>
<%- end -%>
  class <%= model_class.pluralize %>Controller < ApplicationController
    before_action :authenticate_user!
    before_action :require_project!, only: %i[ new create edit update ]
    before_action :set_<%= singular_name %>, only: [:show, :edit, :update, :destroy]
    before_action :set_swatch, only: [:index, :show, :new, :edit]

    # GET /<%= controller_file_path %>
    def index
      authorize <%= class_name %>.new()
      @q = policy_scope(<%= class_name %>).ransack(params[:q])
      @pagy, @<%= plural_name %> = pagy(@q.result, limit: 20)
    end

    # GET /<%= controller_file_path %>/1
    def show
      authorize @<%= singular_name %>
    end

    # GET /<%= controller_file_path %>/new
    def new
      @<%= singular_name %> = <%= class_name %>.new
      authorize @<%= singular_name %>
      setup_form
    end

    # POST /<%= controller_file_path %>
    def create
      @<%= singular_name %> = <%= class_name %>.new(<%= singular_name %>_params)
      authorize @<%= singular_name %>

      if @<%= singular_name %>.save
        flash[:success] = t('flash.create.notice', 
          resource_name: @<%= singular_name %>.model_name.human)
        set_swatch
        redirect_to @<%= singular_name %>
      else
        flash[:alert] = t('flash.create.alert', 
          resource_name: @<%= singular_name %>.model_name.human.downcase)
        set_swatch
        render :new, status: :unprocessable_content
      end
    end

    # GET /<%= controller_file_path %>/1/edit
    def edit
      authorize @<%= singular_name %>
      setup_form
    end

    # PATCH/PUT /<%= controller_file_path %>/1
    def update
      authorize @<%= singular_name %>
      if @<%= singular_name %>.update(<%= singular_name %>_params)
        flash[:success] = t('flash.update.notice', 
          resource_name: @<%= singular_name %>.model_name.human)
        set_swatch
        redirect_to @<%= singular_name %>
      else
        flash[:alert] = t('flash.update.alert', 
          resource_name: @<%= singular_name %>.model_name.human.downcase)
        set_swatch
        render :edit, status: :unprocessable_content 
      end
    end

    # DELETE /<%= controller_file_path %>/1
    def destroy
      authorize @<%= singular_name %>
      if @<%= singular_name %>.destroy
        flash[:success] = t('flash.destroy.notice', 
          resource_name: @<%= singular_name %>.model_name.human)
      else
        flash[:alert] = t('flash.destroy.alert', 
          resource_name: @<%= singular_name %>.model_name.human.downcase)
      end
      set_swatch
      redirect_to <%= plural_route_name %>_path
    end

    private

      def set_<%= singular_name %>
        @<%= singular_name %> = policy_scope(<%= class_name %>).find_by!(id: params[:id])
        raise ApplicationController::ConflictError, :out_of_scope if @<%= singular_name %>.nil?
      end

      def set_swatch
        @swatch = <%= name %>.swatch
      end

      def setup_form
        # Add selector setup here.
      end

      def <%= singular_name %>_params
        params.require(:<%= singular_table_name %>)
        .permit(<%= @fields.map { |field| 
          if field[:type] == "references"
            ":#{field[:name]}_id"
          else
            ":#{field[:name]}"
          end
        }.join(', ') %>)
      end
  end
<%- if @namespaced -%>
end
<%- end -%>
