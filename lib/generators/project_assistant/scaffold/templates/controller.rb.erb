# frozen_string_literal: true
<%- if @namespaced -%>
module <%= module_name %>
<%- end -%>
  class <%= model_class_name.pluralize %>Controller < ApplicationController
<%- if controller_mixin.present? -%>
    include <%= controller_mixin %>
<%- end -%>

    # GET /resource or /resource.json
    def index
      index_resource
    end

    # GET /resources/1 or /resources/1.json
    def show
      show_resource
    end

    # GET /resources/new
    def new
      new_resource
    end

    # POST /resources or /resources.json
    def create
      create_resource
    end

    # GET /resources/1/edit
    def edit
      edit_resource
    end

    # PATCH/PUT /resources/1 or /resources/1.json
    def update
      update_resource
    end

    # DELETE /resources/1 or /resources/1.json
    def destroy
      destroy_resource
    end

    private

      def setup_additional_form_data
        # Include setup for form variables such as select fields.
        <%- @association_fields.each do |field| -%>
          @<%= field[:name].pluralize %> = policy_scope(<%= field[:name].classify %>)
        <%- end -%>
      end

      def after_create_hook(resource)
        # Include any additional requirements for creating related entities here.
      end

      def after_update_hook(resource)
        # Include any additional requirements for updating related entities here.
      end

      def resource_params
        params.require(:<%= singular_table_name %>)
        .permit(<%= @params %>)
      end
  end
<%- if @namespaced -%>
end
<%- end -%>
