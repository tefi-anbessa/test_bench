<!-- <%= human_name %> collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<%% <%= singular_name %> = object %>
<%% context ||= <%= singular_name %>.model_name.human %>
<%%= render 'components/collapsible', id: "#{id}_#{<%= singular_name %>.id}_details", 
  title: [context, <%= singular_name %>.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
    <div class="container-fluid">
      <%% nav_link(action: :show, record: <%= singular_name %>) %>
<%- @attribute_fields.each do |field| -%>
  <%- options = field[:options].slice(:precision, :scale, :units, :si) -%>
  <%- opts = options.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") -%>
  <%- case field[:type] -%>
  <%- when :string -%>
      <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>) %>
  <%- when :integer, :bigint, :boolean, :text, :jsonb, :date, :datetime, :timestamp, :time, :enum, :enum_translated -%> 
      <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>, type: :<%= field[:type] %>) %>
  <%- when :float, :decimal -%>
      <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>, type: :<%= field[:type] %><%= ", #{opts}" unless opts.empty? %>) %>
  <%- when :binary -%> 
      <div class="col-8"><%%= 'PLACEHOLDER FOR BINARY FIELD' %></div>
  <%- else -%> 
      <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>) %>
  <%- end -%>
<%- end -%>

<%- @association_fields.each do |field| -%>
      <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>, type: :association) %>
<%- end -%>
    </div> <!-- end container-fluid -->
<%% end %>