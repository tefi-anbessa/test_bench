<tr scope="row">
  <%% unless current_project %>
    <td scope = "col"><%%= row.project.code %></td>
  <%% end %>
  <%- @fields.select { |field| INDEX_TYPES.include?(field[:type]) }.each do |field| -%>
    <%- case field[:type] -%>
    <%- when "string", "enum", "integer", "bigint", "decimal" -%>
  <td><%%= row.<%= field[:name] %> || '-' %></td>
    <%- when "float" -%>
  <td><%%= number_to_human(row.<%= field[:name] %>, 
    precision: 4, units: { unit: "x", thousand: "kx", million: "Mx" }) || '-' %></td>
    <%- when "enum_translated" -%>
  <td><%%= row.class.human_enum_name(:<%= field[:name] %>, row.<%= field[:name] %>) %></td>
    <%- when "references" -%>
  <td><%%= row.<%= field[:name] %>.present? ?
    link_to(row.<%= field[:name] %>.label, row.<%= field[:name] %>) : 
    '-' %></td>
    <%- else -%>
  <td><%%= row.<%= field[:name] %> || '-' %></td>
    <%- end -%>
  <%- end -%>
  <td>
    <%% if policy(row).show? %>
      <%%= nav_button(action: :show, record: row, icon_only: true) %>
    <%% end %>
    <%% if policy(row).edit? %>
      <%%= nav_button(action: :edit, record: row, path: edit_<%= singular_table_name %>_path(row), icon_only: true) %>
    <%% end %>
    <%% if policy(row).destroy? %>
      <%%= nav_button(action: :destroy, record: row, icon_only: true) %>
    <%% end %>
  </td>
</tr>
       