<%% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto"style="<%%= container_styles(@swatch)%>"
  <!-- Header Card -->
  <div class="card mb-4" style="<%%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <!-- Discipline and project links -->
        <div class="col-2">
          <% if @discipline.present? %>
            <%= nav_button(action: :show_project, record: @discipline.project) %>
            <%= nav_button(action: :show_discipline, record: @discipline) %>
          <% elsif @project.present? %>
            <%= nav_button(action: :show_project, record: @project) %>
          <% end %>
        </div>

        <!-- Header Text (Left - 8 columns) -->
        <div class="col-8">
          <%% project_text = current_project.present? ? 
          [t('activerecord.models.project.one'), current_project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project.other')) %>
          <h5 class="mb-0"><%%= t('.header', project: project_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 align-content-end">
          <% if policy(<%= class_name %>.new).new? %>
            <%= nav_button(action: :new, path: new_<%= singular_table_name %>_path, record: <%= class_name %>.new) %>
          <% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%%= search_form_for @q do |f| %>
        <%- @fields.select { |field| SEARCHABLE_TYPES.include?(field[:type]) }.each do |field| -%>
          <%%= f.search_field :<%= field[:name] %>_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.<%= i18n_scope %>.<%= field[:name] %>") %>
          <%- end -%>
          <%%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%%== bs_icon('search') %>
          <%% end %>
        <%% end %>
      </div>

      <!-- <% human_name %> -->
      <table id='<%= table_name %>' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%%= render 'header' %>
        <tbody>
          <%% @<%= plural_name %>.each do |row| %>
            <%%= render 'row', row: row %>
          <%% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%%== pagy_bootstrap_nav(@pagy) %>
      <%%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
