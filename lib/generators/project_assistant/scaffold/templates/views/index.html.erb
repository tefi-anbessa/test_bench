<%% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto"style="<%%= container_styles(@swatch)%>"
  <!-- Header Card -->
  <div class="card mb-4" style="<%%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <!-- Back links -->
        <div class="col-2">
          <%% if @project.present? %>
            <%%= nav_button(action: :show_project, record: @project) %>
          <%% end %>
          <%% if @discipline.present? %>
            <%%= nav_button(action: :show_discipline, record: @discipline) %>
          <%% end %>
          <%% if @tag.present? %>
            <%%= nav_button(action: :show_tag, record: @tag) %>
          <%% end %>
        </div>

        <!-- Header Text (Left - 8 columns) -->
        <div class="col-8">
          <%% if @tag.present? %>
            <%% scope_text = [t('activerecord.models.tag.one'), @tag.label].join(": ") %>
          <%% elsif @discipline.present? %>
            <%% scope_text = [t('activerecord.models.discipline.one'), @discipline.label].join(": ")  %>
          <%% elsif @project.present? %>
            <%% scope_text = [t('activerecord.models.project.one'), @project.label].join(": ")  %>
          <%% else %>
            <%% scope_text = t('index.all', models: t('activerecord.models.project.other')) %>
          <%% end %>
          <h5 class="mb-0"><%%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 align-content-end">
          <%% if policy(<%= new_build(@nesting) %>).new? %>
            <%%= nav_button(action: :new, path: <%= new_path(@nesting) %>, record: <%= new_build(@nesting) %>) %>
          <%% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%%= search_form_for @q do |f| %>
<%- @searchable_fields.each do |field| -%>
          <%%= f.search_field :<%= field[:name] %>_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.<%= i18n_scope %>.<%= field[:name] %>") %>
<%- end -%>
          <%%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%%== bs_icon('search') %>
          <%% end %>
        <%% end %>
      </div>

      <!-- <% human_name %> -->
<%- if @nesting == :tagable %>
      <!-- Policies for tagables are invariate over the scope , so no need to look up policy for each record. -->
      <%% can_show = policy(@discipline.tags.build()).show? %>
      <%% can_edit = policy(@discipline.tags.build()).edit? %>
      <%% can_delete = policy(@discipline.tags.build()).destroy? %>
<%- end -%>
      <table id='<%= table_name %>' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%%= render 'header' %>
        <tbody>
          <%% @<%= plural_name %>.each do |row| %>
            <%%= render 'row', row: row %>
          <%% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%%== pagy_bootstrap_nav(@pagy) %>
      <%%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
