<%% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto"style="<%%= container_styles(@swatch)%>"
  <!-- Header Card -->
  <div class="card mb-4" style="<%%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%%= card_header_styles(@swatch) %>">
      <div class="d-flex justify-content-between align-items-center">
        <!-- Header Text (Left) -->
        <div class="ms-2">
          <%% project_text = current_project.present? ? 
          [current_project.class.model_name.human, current_project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project').pluralize) %>
          <h5 class="mb-0"><%%= t('.header', project: project_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <%% if policy(<%= class_name %>).new? %>
            <%%= link_to new_<%= singular_table_name %>_path, 
              class: "btn btn-outline-primary actions",
              aria: { label: t('actions.new') },
              title: t('actions.new') do %>
              <%%== bs_icon('plus-square-fill') %>
              <span class="ms-1">
                <%%= [t('actions.new'), t('activerecord.models.<%= controller_i18n_scope.singularize %>')].join(' ') %>
              </span>
            <%% end %>
        <%% end %>
      </div> <!-- end of d-flex -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%%= search_form_for @q do |f| %>
        <%- @fields.select { |field| SEARCHABLE_TYPES.include?(field[:type]) }.each do |field| -%>
          <%%= f.search_field :<%= field[:name] %>_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.<%= controller_i18n_scope %>.<%= field[:name] %>") %>
          <%- end -%>
          <%%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%%== bs_icon('search') %>
          <%% end %>
        <%% end %>
      </div>

      <!-- <% human_name %> -->
      <table id='<%= table_name %>' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%%= render 'header' %>
        <tbody>
          <%% @<%= plural_name %>.each do |row| %>
            <%%= render 'row', row: row %>
          <%% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%%== pagy_bootstrap_nav(@pagy) %>
      <%%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
