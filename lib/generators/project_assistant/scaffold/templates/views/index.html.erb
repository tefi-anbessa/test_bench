<%% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto"style="<%%= container_styles(@swatch)%>"
  <!-- Header Card -->
  <div class="card mb-4" style="<%%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <!-- Back link -->
        <div class="col-2">
<%- if index_back_link[0].present? -%>
          <%%= nav_button(action: <%= index_back_link[0] %>, record: <%= index_back_link[1] %>) %>
<%- end -%>
        </div>

        <!-- Header Text (Left - 8 columns) -->
        <div class="col-8">
          <h5 class="mb-0"><%%= t('.header', scope_text: <%= index_scope_text %>) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 align-content-end">
          <%% if policy(<%= new_build(@nesting) %>).new? %>
            <%%= nav_button(action: :new, path: <%= new_path(@nesting) %>, record: <%= new_build(@nesting) %>) %>
          <%% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
<%- case @nesting -%>
<%- when :tagable -%>
        <%%= search_form_for @q, url: discipline_tagables_path(@discipline) do |f| %>
          <%%= hidden_field_tag :tagable_type, <%= class_name %> %>
<%- when :none -%>
        <%%= search_form_for @q do |f| %>
<%- else -%>
        <%%= search_form_for [@<%= @nesting %>, @q] do |f| %>
<%- end -%>
<%- @searchable_fields.each do |field| -%>
          <%%= f.search_field :<%= field[:name] %>_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.<%= i18n_scope %>.<%= field[:name] %>") %>
<%- end -%>
          <%%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%%== bs_icon('search') %>
          <%% end %>
        <%% end %>
      </div>

      <!-- <% human_name %> -->
<%- if @nesting == :tagable %>
      <!-- Policies for tagables are invariate over the scope , so no need to look up policy for each record. -->
      <%% can_show = policy(@discipline.tags.build()).show? %>
      <%% can_edit = policy(@discipline.tags.build()).edit? %>
      <%% can_delete = policy(@discipline.tags.build()).destroy? %>
<%- end -%>
      <table id='<%= table_name %>' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%%= render '<%= File.join(controller_file_path, "header") %>' %>
        <tbody>
          <%% @<%= plural_name %>.each do |row| %>
            <%%= render '<%= File.join(controller_file_path, "row") %>', row: row %>
          <%% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%%== pagy_bootstrap_nav(@pagy, classes: 'pagination pagination-sm') %>
      <%%== pagy_info(@pagy) %>
      <%%== pagy_limit_selector_js(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
