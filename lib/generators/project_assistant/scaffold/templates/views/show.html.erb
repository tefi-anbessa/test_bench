<%% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%%= container_styles(@swatch) %>">
  <!-- <%= human_name %> Header Card -->
  <div class="card mb-4" style="<%%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <%% if policy(@<%= singular_name %>).index? %>
              <%%= nav_button(action: :index, path: <%= plural_route_name %>_path, record: @<%= singular_name %>) %>
            <%% end %>

            <!-- Previous Button -->
            <%%%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Badge Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%%= badge_styles(@swatch) %>">
                <%%= t('.header', label: @<%= singular_name %>.label)%>
              </span>
              <!-- Add descriptor here if available -->
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <%% if policy(@<%= singular_name %>).edit? %>
                <%%= nav_button(action: :edit, record: @<%= singular_name %>, path: edit_<%= singular_route_name %>_path(@<%= singular_name %>)) %>
              <%% end %>

              <%% if policy(@<%= singular_name %>).destroy? %>
                <%%= nav_button(action: :destroy, record: @<%= singular_name %>) %>
              <%% end %>

              <%% if policy(@<%= singular_name %>).new? %>
                <%%= nav_button(action: :new, path: new_<%= singular_route_name %>_path, record: <%= class_name %>.new) %>
              <%% end %>
            </div> <!-- button group -->
          </div> <!-- d-flex align-items-center -->
        </div> <!-- right navigation and actions -->
      </div> <!-- row align-items-center -->
    </div> <!-- card header -->

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- <%= model_class %> Details Card -->
          <div class="card mb-4" style="<%%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%%= t('show.details', model: @<%= singular_name %>.model_name.human) %></h4>
            </div>

            <div class="card-body p-3">
<%- @fields.each do |field| -%>
              <div class="row mb-1">
                <div class="col-4 text-muted"><%%= t("activerecord.attributes.#{route_url}.#{field[:name]}") %></div>
  <%- case field[:type] -%>
  <%- when "string", "enum", "integer", "bigint", "decimal" -%>
                <div class="col-8"><%%= @<%= singular_name %>.<%= field[:name] %> || '-' %></div>
  <%- when "float" -%>
                <div class="col-8"><%%= number_to_human(@<%= singular_name %>.<%= field[:name] %>, 
                  precision: 4, 
                  units: { unit: "x", thousand: "kx", million: "Mx" }) || '-' %></div>
  <%- when "enum_translated" -%>
                <div class="col-8"><%%= @<%= singular_name %>.class.human_enum_name(:<%= field[:name] %>, @<%= singular_name %>.<%= field[:name] %>) %></div>
  <%- when "text", "jsonb" -%> 
                <div class="col-8"><%%= simple_format(@<%= singular_name %>.<%= field[:name] %> || '-') %></div>
  <%- when "datetime", "timestamp", "time", "date" -%> <!-- Default to time_tag -->
                <div class="col-8"><%%= time_tag(@<%= singular_name %>.<%= field[:name] %> || '-') %></div>
  <%- when "binary" -%> 
                <div class="col-8"><%%= 'PLACEHOLDER FOR BINARY FIELD' %></div>
  <%- when "references", "belongs_to" -%>
                <!-- <%= field %> is in associations section -->
  <%- else -%> <!-- Other type: Fallback to show whatever content is in the field. -->
                <div class="col-8"><%%= @<%= singular_name %>.<%= field[:name] %> || '-' %></div>
  <%- end -%>
              </div> <!-- end row -->
<%- end -%>
            </div>   <!-- temporary end inner card body -->

            <!-- <%= model_class %> Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @<%= singular_name %>.model_name.human) %></h4>
            </div>

<%- @fields.select { |field| field[:type] == "references" || field[:type] == "belongs_to" }.each do |field| -%>
          <div class="col-12 col-md-6 col-lg-4">
            <%%= render "<%= File.join(*class_path, field[:name].pluralize, "card") %>", object: @<%= singular_name %>, association: :<%= field[:name] %> %>
          </div>
        <%- end -%>
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
