require "test_helper"
require "helpers/test_setup_helpers"
require "helpers/model_test_macros"
<%- if @namespaced -%>
module <%= module_name %>
<%- end -%>
  class <%= model_class_name %>Test < ActiveSupport::TestCase
    include TestSetupHelpers
    include ModelTestMacros

    def setup
      setup_common_test_data
      setup_model_specific_data
    end
    
    def setup_model_specific_data
      @resource = create(:<%= singular_table_name %>)
      # Insert model specific test setup here, including relationships with other models.
      # E.g. setup electrical_demand for electrical models.
    end

<%- required_attributes = @required_fields - @association_fields -%>
<%- required_associations = @required_fields & @association_fields -%>
<%- if required_attributes.any? -%>
    test_required_fields(<%= required_attributes.map { |f| ":#{f[:name]}" }.join(", ") %>)
<%- end -%>
<%- if required_associations.any? -%>
    test_required_associations(<%= required_associations.map { |f| ":#{f[:name]}" }.join(", ") %>)
<%- end -%>
<%- if @unique_fields.any? -%>
    test_unique_fields(<%= @unique_fields.map { |f| ":#{f[:name]}" }.join(", ") %>)
<%- end -%>
<%- @enum_fields.each do |field| -%>
    test_enum_field(:<%= field[:name] %>, prefix: true)
<%- end -%>
<%- translated_fields = @enum_fields.select { |f| f[:type] == :enum_translated } -%>
<%- if translated_fields.any? -%>
    test_enum_translations(<%= translated_fields.map { |f| ":#{f[:name]}" }.join(", ") %>)
<%- end -%>

    # Insert model specific tests here.
    # E.g. test electrical_demand for electrical models.

<%- if @namespaced -%>
  end
<%- end -%>
end