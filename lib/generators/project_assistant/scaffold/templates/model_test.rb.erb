require "test_helper"
require "helpers/model_test_patterns"
<%- if @namespaced -%>
module <%= module_name %>
  class <%= model_class %>Test < ActiveSupport::TestCase
<%- else -%>
class <%= model_class %> < ApplicationRecord
<%- end -%>
    include ModelTestPatterns

    def setup
      setup_model_specific_data
    end
    
    def setup_model_specific_data
      @resource = create(:<%= singular_table_name %>)
      # Insert model specific test setup here, including relationships with other models.
      # E.g. setup electrical_demand for electrical models.
    end

<%- @fields.select { |f| f[:options].include?('required') }.each do |field| -%>
    test "<%= field[:name] %> must be present" do
      @resource.<%= field[:name] %> = nil
      refute @resource.valid?
      <%- if field[:type] == 'references' -%>
      assert_includes @resource.errors[:<%= field[:name] %>], I18n.t("errors.messages.required")
      <%- else -%>
      assert_includes @resource.errors[:<%= field[:name] %>], I18n.t("errors.messages.blank")
      <%- end -%>
    end
<%- end -%>

    # Insert model specific tests here.
    # E.g. test electrical_demand for electrical models.

  end
<%- if @namespaced -%>
end
<%- end -%>