# frozen_string_literal: true
<%- if @namespaced -%>
module <%= module_name %>
  class <%= model_class_name %> < Base
<%- else -%>
class <%= model_class_name %> < ApplicationRecord
<%- end -%>
  # === Mixins ===
<%- if @nesting == :tagable -%>
    include Tagable
<%- end -%>

  # === Constants ===
    # enum declarations
<%- @enum_fields.each do |field| -%>
    enum :<%= field[:name] %>, Constants.<%= i18n_scope %>.<%= field[:name] %>.to_h
<%- end -%>

  # === Gem macros ===
<%- unless @nesting == :tagable -%>
    has_paper_trail
<%- end -%>

  # === Attributes ===

  # === Associations ===
<%- @association_fields.each do |field| -%>
    belongs_to :<%= field[:name] %><%- unless field[:options][:required] == true -%>, optional: true<%- end %>
<%- end -%>
<%- unless @nesting.in?(%i[none tagable]) -%>
    belongs_to <%= @nesting.inspect %>
<%- end -%>

  # === Scopes ===

  # === Validations ===
    # Presence validation for required fields.
<%- @required_fields.each do |field| -%>
    validates :<%= field[:name] %>, presence: true
<%- end -%>
    
    # Uniqueness validation for unique fields.
<%- @unique_fields.each do |field| -%>
    validates :<%= field[:name] %>, uniqueness: true
<%- end -%>

  # === Callbacks ===

  # === Class methods ===

  # === Class methods - Queries ===
    # Provide SQL for ordering records in the navigator
    def self.navigator_order_sql
      "<%= table_name %>.created_at ASC"
    end

  # === Public methods ===

  # === Private methods ===
    private

    def self.ransackable_attributes(auth_object = nil)
      <%= @ransack_attributes %>
    end

    def self.ransackable_associations(auth_object = nil)
      <%= @ransack_associations %>
    end
<%- if @namespaced -%>
  end
<%- end -%>
end