# frozen_string_literal: true
<%- if @namespaced -%>
module <%= module_name %>
  class <%= model_class %> < Base
<%- else -%>
class <%= model_class %> < ApplicationRecord
<%- end -%>

    # Belongs to associatons
    <%- @fields.select { |f| %w[references].include?(f[:type]) }.each do |field| -%>
    belongs_to :<%= field[:name] %><%- unless field[:options].include?('required') %>, optional: true<%- end %>
    <%- end -%>
    
    # enum declarations
    <%- @fields.select { |f| %w[enum enum_translated].include?(f[:type]) }.each do |field| -%>
    enum :<%= field[:name] %>, Constants.<%= module_name.underscore %>.<%= singular_name %>.<%= field[:name] %>.to_h
    #!!! Define enum options in Constants file config/constants/<%= module_name.underscore %>.yml
    <%- end -%>
    
    # Presence validation for required fields.
    <%- @fields.select { |f| f[:options].include?('required') && !%w[references].include?(f[:type]) }.each do |field| -%>
    validates :<%= field[:name] %>, presence: true
    <%- end -%>
    
    # Uniqueness validation for unique fields.
    <%- @fields.select { |f| f[:options].include?('uniq') }.each do |field| -%>
    validates :<%= field[:name] %>, uniqueness: true
    <%- end -%>
    
    private

    def self.ransackable_attributes(auth_object = nil)
      [<%= (@fields.select { |f| SEARCHABLE_TYPES.include?(f[:type]) }.map { |f| ":#{f[:name]}" } + 
      [':created_at', ':updated_at']).join(', ') %>]
    end

    def self.ransackable_associations(auth_object = nil)
      <%- associations = [ ] -%>
      <%- @fields.select { |f| %w[references].include?(f[:type]) }.each do |field| -%>
        <%- associations += [field[:name]] -%>
      <%- end -%>
      <%= associations %>
    end
  end
<%- if @namespaced -%>
end
<%- end -%>