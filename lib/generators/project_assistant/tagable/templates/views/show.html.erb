<%% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%%= container_styles(@swatch) %>">
  <!-- <%= human_name %> Header Card -->
  <div class="card mb-4" style="<%%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <%% if policy(@<%= singular_name %>).index? %>
              <%%= nav_button(action: :index, path: discipline_<%= plural_route_name %>_path(@discipline), record: @<%= singular_name %>) %>
            <%% end %>

            <!-- Previous Button -->
            <%%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div> <!-- end d-flex align-items-center -->
        </div> <!-- end left column -->

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6">
                <%%= t('.header', label: [@tag.long_label, @tag.service].compact.join(' - ')) %>
              </span>
              <%% end %>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <%% if policy(@<%= singular_name %>).edit? %>
                <%%= nav_button(action: :edit, path: edit_<%= singular_route_name %>_path(@<%= singular_name %>), record: @<%= singular_name %>) %>
              <%% end %>

              <%% if policy(@<%= singular_name %>).destroy? %>
                <%%= nav_button(action: :delete, record: @<%= singular_name %>) %>
              <%% end %>

              <%% if policy(@<%= singular_name %>).new? %>
                <%%= nav_button(action: :new, path: new_discipline_<%= singular_route_name %>_path(@discipline), record: @<%= singular_name %>) %>
              <%% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- <%= human_name %> Details Card -->
          <div class="card mb-4" style="<%%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%%= t('show.details', model: @<%= singular_name %>.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%%= card_styles(@swatch) %>">
<%- @attribute_fields.each do |field| -%>
  <%- case field[:type] -%>
  <%- when :string, :integer, :bigint -%>
              <%%= show_attribute(@<%= singular_name %>, :<%= field[:name] %>) %>
  <%- when :enum -%>
              <%%= show_attribute(@<%= singular_name %>, :<%= field[:name] %>, type: :enum) %>
  <%- when :enum_translated -%>
              <%%= show_attribute(@<%= singular_name %>, :<%= field[:name] %>, type: :enum_translated) %>
  <%- when :float, :decimal -%>
              <%%= show_attribute(@<%= singular_name %>, :<%= field[:name] %>, type: :<%= field[:type] %>, **<%= field[:options].slice(:units, :si, :scale, :precision).inspect %>) %>
  <%- when :text, :jsonb -%>
              <%%= show_attribute(@<%= singular_name %>, :<%= field[:name] %>, type: :<%= field[:type] %>) %>
  <%- when :datetime, :timestamp, :time -%> 
              <%%= show_attribute(@<%= singular_name %>, :<%= field[:name] %>, type: :<%= field[:type] %>) %>
  <%- when :date -%> 
              <%%= show_attribute(@<%= singular_name %>, :<%= field[:name] %>, type: :date) %>
  <%- when :boolean -%>
              <%%= show_attribute(@<%= singular_name %>, :<%= field[:name] %>, type: :boolean) %>
  <%- when :binary -%> 
                <div class="col-8"><%%= 'PLACEHOLDER FOR BINARY FIELD' %></div>
  <%- else -%> 
              <%%= show_attribute(@<%= singular_name %>, :<%= field[:name] %>) %>
  <%- end -%>
              </div> <!-- end row -->
<%- end -%>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%%= t('show.associations', model: @<%= singular_name %>.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%%= card_styles(@swatch) %>">
              
              <!-- Tag Card -->
              <%% if @<%= singular_name %>.tag.present? %>
                <%%= show_association(@<%= singular_name %>, :tag) %>
              <%% else %>
                <div class="row g-3 mb-3">
                  <div class="alert alert-danger">
                    <%%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                  </div>
                </div>
              <%% end %>

<%- @association_fields.each do |field| -%>
              <%%= show_association(@<%= singular_name %>, :<%= field[:name] %>) %>
<%- end -%>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
