<%% provide(:title, t('.title')) %>
<div class="container mt-3">
  <!-- <%= human_name %> Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <%% if policy(@<%= singular_name %>).index? %>
              <%%= link_to <%= plural_route_name %>_path,
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: t('actions.index') do %>
                <%%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%%= t('actions.index') %></span>
              <%% end %>
            <%% end %>

            <!-- Previous Button -->
            <%% prev_<%= singular_name %> = @<%= singular_name %>.prev %>
            <%% if prev_<%= singular_name %>.present? %>
              <%% disabled = prev_<%= singular_name %> == @<%= singular_name %> %>
              <%% title_text = t('actions.previous') + ": " + prev_<%= singular_name %>.label %>
              <%%= link_to prev_<%= singular_name %>,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: title_text do %>
                <%%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%%= t('actions.previous') %>
                </span>
              <%% end %>
            <%% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge bg-primary fs-6">
                <%%= t('.header', label: @<%= singular_name %>.label)%>
              </span>
              <%% if @<%= singular_name %>.tag&.service.present? %>
                <small class="text-muted ms-2"><%%= @<%= singular_name %>.tag.service %></small>
              <%% end %>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%% next_<%= singular_name %> = @<%= singular_name %>.next %>
            <%% if next_<%= singular_name %>.present? %>
              <%% title_text = t('actions.next') + ": " + next_<%= singular_name %>.label %>
              <%% disabled = next_<%= singular_name %> == @<%= singular_name %> %>
              <%%= link_to next_<%= singular_name %>,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: title_text do %>
                <span class="d-none d-md-inline">
                  <%%= t('actions.next') %>
                </span>
                <%%== bs_icon('box-arrow-in-right') %>
              <%% end %>
            <%% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <%% if policy(@<%= singular_name %>).edit? %>
                <%%= link_to edit_<%= singular_route_name %>_path(@<%= singular_name %>),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%%= t('actions.edit') %>
                  </span>
                <%% end %>
              <%% end %>

              <%% if policy(@<%= singular_name %>).destroy? %>
                <%%= link_to @<%= singular_name %>,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%%= t('actions.delete') %>
                  </span>
                <%% end %>
              <%% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
          <!-- Tag Card -->
          <%% if @<%= singular_name %>.tag.present? %>
            <div class="row g-3 mb-3">
                <%%= render 'tags/card', tag: @<%= singular_name %>.tag %>
            </div>
          <%% else %>
            <div class="row g-3 mb-3">
              <div class="alert alert-danger">
                <%%= t('show.orphan', model: Tag.model_name.human.downcase) %>
              </div>
            </div>
          <%% end %>

          <!-- Resource Details Card -->
          <div class="card mb-4">
            <div class="card-header py-1">
              <h4 class="mb-0"><%%= t('show.details', model: @<%= singular_name %>.model_name.human) %></h4>
            </div>

            <div class="card-body p-3">
<%- @fields.each do |field| -%>
              <div class="row mb-1">
                <div class="col-4 text-muted"><%%= @<%= singular_name %>.class.human_attribute_name(:<%= field[:name] %>) %></div>
  <%- case field[:type] -%>
  <%- when "string", "enum", "integer", "bigint", "decimal" -%>
                <div class="col-8"><%%= @<%= singular_name %>.<%= field[:name] %> || '-' %></div>

  <%- when "float" -%>
                <div class="col-8"><%%= number_to_human(@<%= singular_name %>.<%= field[:name] %>, 
                  precision: 4, 
                  units: { unit: "x", thousand: "kx", million: "Mx" }) || '-' %></div>

  <%- when "enum_translated" -%>
                <div class="col-8"><%%= @<%= singular_name %>.class.human_enum_name(:<%= field[:name] %>, @<%= singular_name %>.<%= field[:name] %>) %></div>
  <%- when "text", "jsonb" -%> # TODO: Add json formatting
                <div class="col-8"><%%= simple_format(@<%= singular_name %>.<%= field[:name] %> || '-') %></div>

  <%- when "datetime", "timestamp", "time", "date" -%> # Default to time_tag
                <div class="col-8"><%%= time_tag(@<%= singular_name %>.<%= field[:name] %> || '-') %></div>

  <%- when "binary" -%> # TODO: Add binary field support
                <div class="col-8"><%%= 'PLACEHOLDER FOR BINARY FIELD' %></div>

  <%- else -%> # Fallback to show whatever content is in the field.
                <div class="col-8"><%%= @<%= singular_name %>.<%= field[:name] %> || '-' %></div>
  <%- end -%>
              </div> <!-- end row -->
<%- end -%>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
