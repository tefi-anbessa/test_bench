<%% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto"style="<%%= container_styles(@swatch)%>"
  <!-- Tagable Resource Header Card -->
  <div class="card mb-4" style="<%%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%%= card_header_styles(@swatch) %>">
      <div class="d-flex justify-content-between align-items-center">

        <!-- Discipline link -->
        <div class="col-2">
            <%%= nav_button(action: :show_discipline, record: @discipline) %>
        </div>
        
        <!-- Header Text (Left) -->
        <div class="col-8">
          <h5><%%= t('.header',
            scope_text: [@discipline.project.code, 
                          t("activerecord.models.discipline.one"), 
                          @discipline.code].join(' ')) %>
          </h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 align-content-end">
          <%% if policy(<%= class_name %>).new? %>
            <%%= nav_button(action: :new, path: new_discipline_<%= singular_route_name %>_path(@discipline), record: <%= class_name %>.new) %>
          <%% end %>
        </div>
      </div> <!-- end of d-flex -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%%= search_form_for @q, discipline_<%= plural_route_name %>_path(@discipline) do |f| %>
        <%- @fields.select { |field| SEARCHABLE_TYPES.include?(field[:type]) }.each do |field| -%>
          <%%= f.search_field :<%= field[:name] %>_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.<%= i18n_scope %>.<%= field[:name] %>") %>
          <%- end -%>
          <%%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%%== bs_icon('search') %>
          <%% end %>
        <%% end %>
      </div>

      <!-- Broken and incomplete links -->
      <%% unless @link_broken.empty? %>
        <table id='link_broken' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-danger">
              <th colspan="9">
                <%%= t('index.link_broken', 
                count: @link_broken.count,
                models: t("activerecord.models.<%= plural_name %>", count: @link_broken.count)) %>
              </th>
            </tr>
            <%%= render 'tags/header' %>
          </thead>
          <tbody>
            <%% @link_broken.each do |tag| %>
              <%%= render 'tags/row', t: tag %>
            <%% end %>
          </tbody>
        </table>
      <%% end %>
      <%% unless @link_incomplete.empty? %>
        <table id='link_incomplete' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-warning">
              <th colspan="9">
                <%%= t('index.link_incomplete', 
                count: @link_incomplete.count,
                models: t("activerecord.models.<%= plural_name %>", count: @link_incomplete.count)) %>
              </th>
            </tr>
            <%%= render 'tags/header' %>
          </thead>
          <tbody>
            <%% @link_incomplete.each do |tag| %>
              <%%= render 'tags/row', t: tag %>
            <%% end %>
          </tbody>
        </table>
      <%% end %>

<!-- <% human_name %> -->
      <!-- Policies for tagables are invariate over the scope , so no need to look up policy for each record. -->
      <%% can_show = policy(@discipline.tags.build()).show? %>
      <%% can_edit = policy(@discipline.tags.build()).edit? %>
      <%% can_delete = policy(@discipline.tags.build()).destroy? %>
      <table id='<%= table_name %>' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%%= render 'header' %>
        <tbody>
          <%% unless @orphans.empty? %>
            <tr class="table-danger">
              <%- columns = @fields.select { |field| INDEX_TYPES.include?(field[:type]) }.count + 3 %>
              <td colspan="<%%= columns + (current_project ? 0 : 1) %>">
                <%%= t('index.orphans', 
                count: @orphans.count,
                models: t("activerecord.models.motor", count: @orphans.count)) %>
              </td>
            </tr>
            <%% @orphans.each do |row| %>
              <%%= render 'row', row: row %>
            <%% end %>
            <tr class="table-success">
              <td colspan="<%%= columns + (current_project ? 0 : 1) %>">
                <%%= t('.title') %>
              </td>
            </tr>
          <%% end %>
          <%% @<%= plural_name %>.each do |row| %>
            <%%= render 'row', row: row, can_show: can_show, can_edit: can_edit, can_delete: can_delete %>
          <%% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%%== pagy_bootstrap_nav(@pagy) %>
      <%%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
