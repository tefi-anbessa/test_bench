<tr scope="row">
  <%% unless current_project %>
    <td scope = "col"><%%= row.tag&.nil? ? '-' : row.tag.discipline.project.code %></td>
  <%% end %>
  <%% if row.tag&.nil? %>
    <td>'-'</td>
    <td class="table-danger"><%%= t("index.no_tag", id: row.id) %></td>
  <%% else %>
    <td><%%= row.tag.stage %></td>
    <td><%%= index_link(action: :show_tag, record: row.tag) %></td>
  <%% end %>
  <%- @index_fields.each do |field| -%>
    <%- attr = "#{field[:name]}" -%>
    <%- case field[:type] -%>
    <%- when :string, :enum, :integer, :bigint -%>
  <td><%%= index_attribute(row, :<%= attr %>) %></td>
    <%- when :decimal, :float -%>
  <td><%%= index_attribute(row, :<%= attr %>, type: <%= field[:type] %>, **<%= field[:options].slice(:units, :si, :scale, :precision).inspect %>) %></td>
    <%- when :enum_translated -%>
  <td><%%= index_attribute(row, :<%= attr %>, type: :enum_translated) %></td>
    <%- when :references, :belongs_to -%>
  <td><%%= index_attribute(row, :<%= attr %>, type: :association) %></td>
    <%- when :boolean -%>
  <td><%%= index_attribute(row, :<%= attr %>, type: :boolean) %></td>
    <%- end -%>
  <%- end -%>
  <td>
    <%% if can_show %>
      <%%= nav_button(action: :show, record: row, icon_only: true) %>
    <%% end %>
    <%% if can_edit %>
      <%%= nav_button(action: :edit, record: row, path: edit_<%= singular_table_name %>_path(row), icon_only: true) %>
    <%% end %>
    <%% if can_delete %>
      <%%= nav_button(action: :delete, record: row, icon_only: true) %>
    <%% end %>
  </td>
</tr>
