<tr scope="row">
  <%% unless current_project %>
    <td scope="col"><%%= row.tag&.nil? ? '-' : row.tag.discipline.project.code %></td>
  <%% end %>
  <%% if row.tag&.nil? %>
    <td>-</td>
    <td class="table-danger"><%%= t("index.no_tag", id: row.id) %></td>
  <%% else %>
    <td><%%= row.tag.stage %></td>
    <td><%%= index_link(action: :show_tag, record: row.tag) %></td>
  <%% end %>
<%- @index_fields.each do |field| -%>
  <%- options = field[:options].slice(:precision, :scale, :units, :si) -%>
  <%- opts = options.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") -%>
  <%- attr = "#{field[:name]}" -%>
  <%- case field[:type] -%>
  <%- when :string -%>
  <td><%%= index_attribute(row, :<%= attr %>) %></td>
  <%- when :integer, :bigint, :text, :jsonb, :boolean, :date, :datetime, :time, :timestamp, :enum, :enum_translated -%>
  <td><%%= index_attribute(row, :<%= attr %>, type: :<%= field[:type] %>) %></td>
  <%- when :decimal, :float -%>
  <td><%%= index_attribute(row, :<%= attr %>, type: :<%= field[:type] %><%= ", #{opts}" unless opts.empty? %>) %></td>
  <%- when :references, :belongs_to -%>
  <td><%%= index_attribute(row, :<%= attr %>, type: :association) %></td>
  <%- end -%>
<%- end -%>
  <td>
    <%% if can_show %>
      <%%= nav_button(action: :show_tagable, record: row, icon_only: true) %>
    <%% end %>
    <%% if can_edit %>
      <%%= nav_button(action: :edit_tagable, record: row, icon_only: true) %>
    <%% end %>
    <%% if can_delete %>
      <%%= nav_button(action: :delete_tagable, record: row, icon_only: true) %>
    <%% end %>
  </td>
</tr>
