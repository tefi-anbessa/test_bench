<tr scope="row">
  <%% unless current_project %>
    <td scope = "col"><%%= row.tag&.nil? ? '-' : row.tag.discipline.project.code %></td>
  <%% end %>
  <%% if row.tag&.nil? %>
    <td>'-'</td>
    <td class="table-danger"><%%= t("index.no_tag", id: row.id) %></td>
  <%% else %>
    <td><%%= row.tag.stage %></td>
    <td><%%= link_to row.tag.label, tag_path(row.tag) %></td>
  <%% end %>
  <%- @fields.select { |field| INDEX_TYPES.include?(field[:type]) }.each do |field| -%>
    <%- case field[:type] -%>
    <%- when "string", "enum", "integer", "bigint", "decimal" -%>
      <td><%%= row.<%= field[:name] %> || '-' %></td>
    <%- when "float" -%>
      <td><%%= number_to_human(row.<%= field[:name] %>, 
        precision: 4, units: { unit: "x", thousand: "kx", million: "Mx" }) || '-' %></td>
    <%- when "enum_translated" -%>
      <td><%%= row.class.human_enum_name(:<%= field[:name] %>, row.<%= field[:name] %>) %></td>
    <%- else -%>
      <td><%%= row.<%= field[:name] %> || '-' %></td>
    <%- end -%>
  <%- end -%>
  <td>
    <%% if policy(row).show? %>
      <%%= link_to row, class: "btn btn-secondary btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show') do %>
        <%%== bs_icon('eye') %>
      <%% end %>
    <%% end %>
    <%% if policy(row).edit? %>
      <%%= link_to edit_<%= singular_table_name %>_path(row), class: "btn btn-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit') do %>
        <%%== bs_icon('pencil') %>
      <%% end %>
    <%% end %>
    <%% if policy(row).destroy? %>
      <%%= link_to row,
              data: { method: :delete, confirm: t('actions.delete_sure') },
              class: "btn btn-danger btn-sm icon-link",
              aria: { label: t('actions.delete') },
              title: t('actions.delete') do %>
        <%%== bs_icon('trash') %>
      <%% end %>
    <%% end %>
  </td>
</tr>
