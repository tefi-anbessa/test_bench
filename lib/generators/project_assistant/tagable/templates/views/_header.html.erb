<thead>
  <%% unless current_project %>
    <th scope="col"><%%= sort_link(@q, 'tag_discipline_project_code', t('activerecord.models.project.one')) %></th>
  <%% end %>
  <th scope="col"><%%= sort_link(@q, :tag_stage) %></th>
  <th scope="col"><%%= sort_link(@q, :tag) %></th>
<%- @index_fields.each do |field| -%>
  <%- case field[:type] -%>
    <%- when :belongs_to, :references -%>
  <th scope="col"><%%= sort_link(@q, :<%= field[:name] %>, t("activerecord.models.<%= field[:name] %>.one")) %></th>
    <%- else %>
  <th scope="col"><%%= sort_link(@q, :<%= field[:name] %>, t("activerecord.attributes.<%= i18n_scope %>.<%= field[:name] %>")) %></th>
    <%- end %>
  <%- end -%>
  <th scope="col" width="150px"><%%= t('table.links')%></th>
</thead>
