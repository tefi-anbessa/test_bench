<!-- <%= human_name %> collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<%% <%= singular_name %> = object %>
<%% context ||= <%= singular_name %>.model_name.human %>
<%%= render 'components/collapsible', id: "#{id}_#{<%= singular_name %>.id}_details", 
  title: [context, <%= singular_name %>.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%%= nav_link(action: :show, record: <%= singular_name %>) %>
<%- @fields.each do |field| -%>
  <%- case field[:type] -%>
  <%- when :string, :enum, :integer, :bigint -%>
              <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>) %>
  <%- when :float, :decimal -%>
              <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>, type: :<%= field[:type] %>, **<%= field[:options].slice(:units, :si, :scale, :precision).inspect %>) %>
  <%- when :enum_translated -%>
              <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>, type: :enum_translated) %>
  <%- when :boolean -%>
              <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>, type: :<%= field[:type] %>) %>
  <%- when :text, :jsonb -%> <!-- TODO: Add json formatting -->
              <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>, type: :<%= field[:type] %>) %>
  <%- when :datetime, :timestamp, :time -%> <!-- Default to time_tag -->
              <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>, type: :datetime) %>
  <%- when :date -%> 
              <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>, type: :date) %>
  <%- when :binary -%> <!-- TODO: Add binary field support -->
                <div class="col-8"><%%= 'PLACEHOLDER FOR BINARY FIELD' %></div>
  <%- when :references, :belongs_to -%>
              <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>, type: :association %>) %>
  <%- else -%><!-- Fallback to show whatever content is in the field. -->
              <%%= show_attribute(<%= singular_name %>, :<%= field[:name] %>) %>
  <%- end %>
      </div>
<%- end -%>
    </div> <!-- end container-fluid -->
<%% end %>