<div class="container mt-3" style="<%%= container_styles(swatch) %>">
  <div class="card" style="<%%= card_styles(swatch) %>">
    <div class="card-header p-2" style="<%%= card_header_styles(swatch) %>">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class ="mt-1">
            <span class="badge fs-6" style="<%%= badge_styles(swatch) %>">
              <%%= yield(:header) %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <%%= bootstrap_form_with(model: <%= singular_name %>,
          url: <%= singular_name %>.persisted? ?
            <%= singular_name %> : 
            ( tag.persisted? ?
              tag_<%= plural_route_name %>_path(tag) :
              discipline_<%= plural_route_name %>_path(discipline)),
          layout: :horizontal,
          label_col: "col-sm-4",
          control_col: "col-sm-8",
          wrapper_class: 'mb-1',
          ) do |f| %>

      <div class="card-body p-2" style="<%%= form_styles(swatch) %>">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">        <!-- Adjust to fit field width requirements -->

            <!-- Tag -->
            <%%= f.fields_for tag do |tag_f| %>
              <%%= render 'tags/form_nested', tag_f: tag_f, tag: tag %>
            <%% end %>

            <!-- <%= human_name %> Details -->
            <div class="card mb-1" style="<%%= card_styles(swatch) %>">
              <div class="card-header p-2" style="<%%= card_header_styles(swatch) %>">
                <h6><%%= yield(:header) %></h6>
              </div>
              <div class="card-body p-2" style="<%%= form_styles(swatch) %>">
                <%%= render 'shared/error_messages', object: f.object %>

<%- @fields.each do |field| -%>
  <%- required = field[:options].include? ('required') %>
  <%- case field[:type] -%>
    <%- when :string -%>
                <%%= form_field(f, :<%= field[:name] %>) %>
    <%- when :text, :jsonb -%>
                <%%= form_field(f, :<%= field[:name] %>, type: :text) %>
    <%- when :integer, :bigint -%>
                <%%= form_field(f, :<%= field[:name] %>, type: :number) %>
    <%- when :float, :decimal -%>
                <%%= form_field(f, :<%= field[:name] %>, type: :number<%= field[:options][:units].present? ? ", units: #{field[:options][:units]}" : "" %>) %>
    <%- when :datetime, :timestamp, :time -%>
                <%%= form_field(f, :<%= field[:name] %>, type: :datetime) %>
    <%- when :date -%>
                <%%= form_field(f, :<%= field[:name] %>, type: :date) %>
    <%- when :boolean -%>
                <%%= form_field(f, :<%= field[:name] %>, type: :boolean) %>
    <%- when :enum -%>
                <%%= form_field(f, :<%= field[:name] %>, type: :enum, required: required) %>
    <%- when :enum_translated -%>
                <%%= form_field(f, :<%= field[:name] %>, type: :enum_translated, required: required) %>
    <%- when :references, :belongs_to -%>
                <%% collection = options_for_select(@<%= field[:name].pluralize %>, selected: <%= singular_name %>.<%= field[:name] %>_id) %>
                <%%= form_field(f, :<%= field[:name] %>, type: :select, collection: collection, required: required) %>
  <%- end -%>
<%- end -%>
                
              </div> <!-- end <%= singular_name %> card body -->
            </div> <!-- end <%= singular_name %> card -->

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%%= link_to <%= singular_name %>.persisted? ? <%= singular_name %> : discipline_<%= plural_route_name %>_path(@discipline),
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false } do %>
                <%%= t('actions.discard') %>
                <%%== bs_icon('x-square') %>
              <%% end %>

              <%%= f.button :submit, class: 'btn btn-primary', name: "form[submit]" do %>
                <%%= yield(:button_text) %>
                <%%== bs_icon('save') %>
              <%% end %>
            </div> <!-- end card footer -->
          </div> <!-- end responsive columns -->
        </div> <!-- end row -->
      </div> <!-- end card body -->
    <%% end %> <!-- end bootstrap_form_with -->
  </div> <!-- end card -->
</div> <!-- end container -->
