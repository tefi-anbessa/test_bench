  <%- field_type = if [:enum, :enum_translated].include?(field[:type])
                      'integer'
                    elsif field[:type] == :ip
                      'string'
                    else
                      field[:type].to_s
                    end -%>
  <%- options = "" -%>
  <%- if field.dig(:options, :required) -%>
    <%- options = ", null: false" -%>
  <%- end -%>
  <%- if field.dig(:options, :index) && !field_unique?(field) -%>
    <%- options += ", index: true" -%>
  <%- end -%>
      t.<%= field_type %> :<%= field[:name] + options %>
<%- end -%>
<%- @association_fields.each do |field| -%>
      t.references :<%= field[:name] %>, foreign_key: true
<%- end -%>
      t.timestamps
