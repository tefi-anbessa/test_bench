class Create<%= singular_table_name.camelize %> < ActiveRecord::Migration[<%= Rails.version.to_f %>]
  def change
    create_table :<%= table_name %> do |t|
      <%- @fields.each do |field| -%>
        <%- field_type = if [:enum, :enum_translated].include?(field[:type])
                      'integer'
                    else
                      field[:type].to_s
                    end -%>
        <%- options = "" -%>
        <%- if field[:options].include?(:required) -%>
          <%- options = ", null: false" -%>
        <%- end -%>
        <%- if field[:options].include?(:unique) || field[:options].include?(:uniq) -%>
          <%- options += ", index: { unique: true }" -%>
        <%- elsif field[:options].include?(:index) -%>
          <%- options += ", index: true" -%>
        <%- end -%>
        <%- if %i[references belongs_to].include? field[:type] -%>
          <%- options += ", foreign_key: true" -%>
        <%- end -%>
        <%- if %i[decimal float].include?(field[:type]) && field[:options].include?(:scale) -%>
          <%- options += ", scale: #{field[:options][:scale]}" -%>
        <%- end -%>
        <%- if %i[decimal float].include?(field[:type]) && field[:options].include?(:precision) -%>
          <%- options += ", precision: #{field[:options][:precision]}" -%>
        <%- end -%>
      t.<%= field_type %> :<%= field[:name] + options %>
    <%- end -%>
      t.timestamps
    end
  end
end