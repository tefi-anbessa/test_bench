class Create<%= singular_table_name.camelize %> < ActiveRecord::Migration[<%= Rails.version.to_f %>]
  def change
    create_table :<%= table_name %> do |t|
      <%- @fields.each do |field| -%>
        <%- field_type = if ['enum', 'enum_translated'].include?(field[:type])
                      'integer'
                    else
                      field[:type]
                    end -%>
        <%- options = "" -%>
        <%- if field[:options].include?('required') -%>
          <%- options = ", null: false" -%>
        <%- end -%>
        <%- if field[:options].include?('unique') -%>
          <%- options += ", index: { unique: true }" -%>
        <%- elsif field[:options].include?('index') -%>
          <%- options += ", index: true" -%>
        <%- end -%>
      t.<%= field_type %> :<%= field[:name] + options %>
    <%- end -%>
      t.timestamps
    end
  end
end