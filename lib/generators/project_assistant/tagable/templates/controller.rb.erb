module <%= module_name %>
  class <%= tagable_name.pluralize %>Controller < ApplicationController
    include TagablesController

    # GET /resource or /resource.json
    def index
      index_tagable
    end

    # GET /resources/1 or /resources/1.json
    def show
      show_tagable
    end

    # GET /resources/1/edit
    def edit
      edit_tagable
    end

    # GET /resources/new
    def new
      new_tagable
    end

    # POST /resources or /resources.json
    def create
      create_tagable
    end

    # PATCH/PUT /resources/1 or /resources/1.json
    def update
      update_tagable
    end

    # DELETE /resources/1 or /resources/1.json
