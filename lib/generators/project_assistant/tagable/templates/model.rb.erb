# frozen_string_literal: true
module <%= module_name %>
  class <%= model_class_name %> < Base
  # === Mixins ===
    include Tagable

  # === Constants ===
    # enum declarations
<%- @enum_fields.each do |field| -%>
    enum :<%= field[:name] %>, Constants.<%= i18n_scope %>.<%= field[:name] %>.to_h, prefix: true
<%- end -%>

  # === Gem macros ===

  # === Attributes ===

  # === Associations ===
<%- @association_fields.each do |field| -%>
    belongs_to :<%= field[:name] %><%- unless field[:options][:required] == true -%>, optional: true<%- end %>
<%- end -%>

  # === Scopes ===

  # === Validations ===
    # Presence validation for required fields.
<%- @required_fields.each do |field| -%>
    validates :<%= field[:name] %>, presence: true
<%- end -%>

    # Uniqueness validation for unique fields.
<%- @unique_fields.each do |field| -%>
    validates :<%= field[:name] %>, uniqueness: true
<%- end -%>

  # === Callbacks ===

  # === Class methods ===

  # === Class methods - Queries ===

  # === Public methods ===

  # === Private methods ===
    private

    def self.ransackable_attributes(auth_object = nil)
      <%= @ransack_attributes %>
    end

    def self.ransackable_associations(auth_object = nil)
      <%= @ransack_associations %>
    end
  end
end
