# frozen_string_literal: true

module <%= module_name %>
  class <%= tagable_name %> < Base

    # === Mixins ===
    include Tagable

    # === Constants ===
    # enum declarations
    <%- @enum_fields.each do |field| -%>
    enum :<%= field[:name] %>, Constants.<%= module_name.underscore %>.<%= singular_name %>.<%= field[:name] %>.to_h
    <%- end -%>

    # === Gem macros ===

    # === Attributes ===

    # === Associations ===
    # Belongs to associatons
    <%- @association_fields.each do |field| -%>
    belongs_to :<%= field[:name] %><%- unless field[:options][:required] == true %>, optional: true<%- end %>
    <%- end -%>

    # === Scopes ===

    # === Validations ===
    # Presence validation for required fields.
    <%- @required_fields.each do |field| -%>
    validates :<%= field[:name] %>, presence: true
    <%- end -%>
    <%- @unique_fields.each do |field| -%>
    validates :<%= field[:name] %>, uniqueness: true
    <%- end -%>

    # === Callbacks ===

    # === Class methods ===

    # === Public methods ===

    # === Private methods ===
    private

    def self.ransackable_attributes(auth_object = nil)
      [<%= (@fields.select { |f| SEARCHABLE_TYPES.include?(f[:type]) }.map { |f| ":#{f[:name]}" } + 
      [':created_at', ':updated_at']).join(', ') %>]
    end

    def self.ransackable_associations(auth_object = nil)
      <%- associations = [ :tag, :tag_discipline, :tag_discipline_project ] -%>
      <%- @association_fields.each do |field| -%>
        <%- associations << field[:name].to_sym -%>
      <%- end -%>
      <%= associations %>
    end
  end
end