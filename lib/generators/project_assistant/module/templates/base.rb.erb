module <%= name.camelize %>
  class Base < ApplicationRecord
    self.abstract_class = true
    # Add shared module behavior here

    # Default discipline for tagable models to reference back to this module, used in testing. 
    # Not used in the application, as projects can set their own disciplines.
    def self.discipline
      <%= name.split("::").last.to_s %>
    end

    def label
      "define default label in app/models/<%= name.underscore %>/base.rb"
    end

    def long_label
      "define default long_label in app/models/<%= name.underscore %>/base.rb"
    end

    def self.swatch
      Swatch.find_by(name: "app_theme")
    end
  end
end