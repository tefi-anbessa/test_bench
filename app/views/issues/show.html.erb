<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Issue Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@issue).index? %>
              <%= nav_button(action: :index, path: document_issues_path(@issue.document), record: @issue.document) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Badge Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @issue.label)%>
              </span>
              <!-- Add descriptor here if available -->
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@issue).edit? %>
                <%= nav_button(action: :edit, path: edit_issue_path(@issue), record: @issue) %>
              <% end %>

              <% if policy(@issue).destroy? %>
                <%= nav_button(action: :delete, path: @issue, record: @issue) %>
              <% end %>

              <% if policy(@document.issues.build()).new? %>
                <%= nav_button(action: :new, path: new_document_issue_path(@issue.document), record: @issue) %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Issue Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @issue.model_name.human) %></h4>
            </div>

            <div class="card-body">
              <%= show_attribute(@issue, :code) %>
              <%= show_attribute(@issue, :reason) %>
              <%= show_attribute(@issue, :created_at, type: :date) %>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: t("activerecord.models.tag.one")) %></h4>
            </div>

            <div class="card-body p-3">
              <%= show_association(@issue, :document) %>
              <%= show_association(@issue, :source_format) %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
