<% resource = object %>
<%= render 'components/collapsible',
  id: "issues_#{resource.id}_details",
  title: t("issues.show.header", label: resource.label),
  expanded: false,
  header_class: 'py-1' do %>
  
    <div class="container-fluid">
      <div class="row mb-1">
        <% text = t("actions.jump_to", model: t("activerecord.models.issue")) %>
        <%= link_to resource, 
            class: "btn btn-sm btn-outline-secondary me-2",
            title: text do %>
          <%== bs_icon('box-arrow-in-up-left') %>
          <span class="d-none d-md-inline"><%= text %></span>
        <% end %>
      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= resource.class.human_attribute_name(:document) %></div>
        <div class="col-8"><%= resource.document&.label || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= resource.class.human_attribute_name(:code) %></div>
        <div class="col-8"><%= resource.code || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= resource.class.human_attribute_name(:reason) %></div>
        <div class="col-8"><%= resource.reason || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= resource.class.human_attribute_name(:source_format) %></div>
        <div class="col-8"><%= resource.source_format&.label || '-' %></div>

      </div>
    </div> <!-- end container-fluid -->
<% end %>