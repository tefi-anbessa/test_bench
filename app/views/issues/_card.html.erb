<!-- Issue collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% issue = object %>
<%= render 'components/collapsible',
      id: "#{id}_#{issue.id}_details",
      title: [context, issue.long_label].join(": "),
      expanded: false,
      header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: issue) %>

    <%= show_attribute(issue, :code) %>
    <%= show_attribute(issue, :reason) %>
    <%= show_attribute(issue, :created_at, type: :date) %>
    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t('activerecord.models.source_format.one') %></div>
      <div class="col-8"><%= issue.source_format&.label || '-' %></div>
    </div>
  </div> <!-- end container-fluid -->
<% end %>