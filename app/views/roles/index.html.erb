<% provide(:title, t('.title')) %>
<nav class="navbar bg-body-tertiary">
  <div class="container-fluid">
    <ul class="navbar-nav me-auto mb-2 mb-lg-0 flex-row">
      <li class="nav-item">
        <%= link_to new_role_path, class: "btn btn-primary actions",
              aria: { label: t('actions.new') },
              title: t('actions.new')  do %>
          <%== icon('plus-square-fill') %>
          <%= t('actions.new') + " " + t('activerecord.models.role') %>
        <% end %>
      </li>
      <span class="nav-text ms-3 me-3 h2">
        <%= t('.header')%>
      </span>
    </ul>
  </div>
</nav>
<div class = "container">
  <div class = 'listing'>

    <%== pagy_bootstrap_nav(@pagy) %>
    <table id='roles' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
      <thead>
        <th scope="col"><%= t('activerecord.models.user') %></th>
        <th scope="col"><%= t('activerecord.models.role') %></th>
        <th scope="col"><%= t('activerecord.attributes.role.resource_type') %></th>
        <th scope="col"><%= t('activerecord.attributes.resource_id') %></th>
        <th scope="col" width="150px"><%= t('table.links')%></th>
      </thead>
      <tbody>
        <% @roles.each do |r| %>
          <% r.users.each do |u| %>
            <tr scope="row">
              <td><%= u.name %></td>
              <td><%= r.name %></td>
              <td><%= r.resource_type %></td>
              <td><%= r.resource_id %></td>
              <td>
                <% if current_user && current_user.admin? %>
                  <%= link_to user_role_path(u, r),
                        data: {turbo_method: :delete,
                                turbo_confirm: t('actions.delete_sure')},
                        class: "btn btn-danger btn-sm icon-link",
                        aria: { label: t('actions.delete') },
                        title: t('actions.delete'),
                        display: "inline" do %>
                    <%== icon('trash') %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
    <%== pagy_info(@pagy) %>


  </div>
</div>
