<% provide(:title, t('.title')) %>
<div class="container mb-3">
  <div class="position-relative"> 
    <h2 class="text-center mb-0">
      <%= t('.header')%>
    </h2>
  </div>
</div>
<div class = "container">
  <div class = 'listing'>

    <%== pagy_bootstrap_nav(@pagy) %>
    <table id='roles' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
      <thead>
      <th scope="col"><%= t('activerecord.attributes.role.resource_type') %></th>
      <th scope="col"><%= t('activerecord.attributes.role.resource_id') %></th>
        <th scope="col"><%= t('activerecord.models.role') %></th>
        <th scope="col"><%= t('activerecord.models.user') %></th>
        <th scope="col" width="150px"><%= t('table.links')%></th>
      </thead>
      <tbody>
        <% @roles.each do |r| %>
          <% r.users.each do |u| %>
            <tr scope="row" class="role_row">
              <td><%= r.resource_type.present? ? 
              t("activerecord.models.#{r.resource_type}") : 
              '[' + t('rolify.role_types.global') + ']' %></td>
              <td><%= r.resource.present? ? r.resource.label : '' %></td>
              <td><%= r.name %></td>
              <td><%= u.name %></td>
              <td>
              <% if policy(r).destroy? %>
                <%= link_to user_role_path(u, r, role_return_path: roles_path),
                      data: { turbo_method: :delete, 
                              turbo_confirm: t('actions.delete_sure') },
                      class: "btn btn-danger btn-sm icon-link",
                      aria: { label: t('actions.revoke') },
                      title: t('actions.revoke'),
                      display: "inline" do %>
                  <%== icon('trash') %>
                <% end %>
              <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
    <%== pagy_info(@pagy) %>

  </div>

    <% if policy(Role).new? %>
    <%= render 'roles/role_assignment',
                role: @role,
                roles: @roles,
                users: @users,
                resources: @resources,
                selected_user_id: nil,
                selected_resource_type: nil,
                selected_resource_id: nil,
                selected_role_name: nil,
                role_return_path: roles_path %>
    <% end %>
</div>
