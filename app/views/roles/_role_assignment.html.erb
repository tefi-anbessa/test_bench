<%# This partial renders an index view if a resource instance is supplied, %>
<%# and the role assignment form for new roles of any role type. It can be included in any view %>
<%= bootstrap_form_with(model: role || Role.new, url: roles_path, data: { turbo: true }) do |f| %>
  <%= render 'shared/error_messages', object: f.object %>

  <div class="card shadow-sm bg-light mb-3">
    <div class="card-body p-3">
      <%# If resource exists, this partial is for an instance edit form %>
      <% if local_assigns[:selected_resource].present? && local_assigns[:selected_resource].persisted? %>
        <%# Render existing roles if any %>
        <h5 class="h5 card-title text-center mb-3">
          <%= t('roles.partial.existing_roles') %>
        </h5>
        <%= render 'roles/role_assignments', 
             selected_resource: local_assigns[:selected_resource],
             role_return_path: local_assigns[:role_return_path] %>
      <% end %>

      <h5 class="h5 card-title text-center mb-3">
        <%= t('roles.new.title') %>
      </h5>
      
      <div class="mb-3">
        <% if local_assigns[:selected_resource].present? && local_assigns[:selected_resource].persisted? %>
          <%= t('roles.new.message_instance_html') %>
        <% else %>
          <%= t('roles.new.message_global_html') %>
        <% end %>
    </div>

      <div class="row g-2">
        <div class="col-12 col-md-4">
          <% if local_assigns[:selected_resource].present? && local_assigns[:selected_resource].persisted? %>
            <%# Resource instance role - show read-only resource info %>
            <%= f.hidden_field :resource_type, value: local_assigns[:selected_resource].class.name %>
            <%= f.hidden_field :resource_id, value: local_assigns[:selected_resource].id %>
            
            <div class="form-group mb-2">
              <label class="form-label small text-muted mb-1"><%= t('activerecord.attributes.role.resource') %></label>
              <input type="text" class="form-control form-control-sm" 
                     value="<%= local_assigns[:selected_resource].try(:label) || local_assigns[:selected_resource].class.model_name.human %>" 
                     readonly>
            </div>
          <% else %>
            <%# Global role or resource class role - show dropdowns %>
            <%= f.select :resource_type, 
                  options_for_select(@resource_types, f.object.resource_type),
                  { label: t('activerecord.attributes.role.resource_type'), label_class: 'small text-muted' },
                  class: 'form-select form-select-sm mb-2',
                  data: { controller: 'resource-type-selector', 
                          action: 'change->resource-type-selector#updateResourceSelect' } %>
            
            <div data-resource-type-selector-target="resourceSelector" class="d-none">
              <%= f.select :resource_id, 
                    [],
                    { label: t('activerecord.attributes.role.resource'), label_class: 'small text-muted' },
                    class: 'form-select form-select-sm mb-2' %>
            </div>
          <% end %>
        </div>

        <div class="col-12 col-md-3">
          <%= f.select :name, 
                grouped_options_for_select(@grouped_role_names, f.object.name),
                { label: t('activerecord.attributes.role.name'), label_class: 'small text-muted', include_blank: true },
                class: 'form-select form-select-sm' %>
        </div>

        <div class="col-12 col-md-3">
          <%= f.collection_select :user_id, @users, :id, :name, 
                { label: t('activerecord.attributes.role.user'), label_class: 'small text-muted', include_blank: true },
                { class: 'form-select form-select-sm' } %>
        </div>

        <div class="col-12 col-md-2 d-flex align-items-end">
          <%= f.submit t('actions.grant'), class: 'btn btn-sm btn-primary w-100' %>
        </div>
      </div>
    </div>
  </div>
<% end %>
