<div class="container mt-3">
  <div class="card">
    <div class="card-header p-2">
      <h5 class="mb-0">
        <%= @cable_type.persisted? ? t('actions.edit') : t('actions.new') %> <%= t('activerecord.models.cable_type') %>
      </h5>
    </div>
    
    <%= bootstrap_form_with(model: @cable_type, layout: :horizontal) do |f| %>
      <div class="card-body p-3">
        <%= render 'shared/error_messages', object: f.object %>
        
        <!-- Conductor Details -->
        <div class="card mb-4">
          <div class="card-header py-1">
            <h6 class="mb-0"><%= t('cable_types.form.conductor_details') %></h6>
          </div>
          <div class="card-body p-3">
            <div class="row">
              <div class="col-md-6">
                <%= f.text_field :conductor_material, wrapper: { class: 'mb-3' } %>
              </div>
              <div class="col-md-6">
                <%= f.text_field :conductor_makeup, wrapper: { class: 'mb-3' } %>
              </div>
            </div>
            
            <div class="row">
              <div class="col-md-4">
                <%= f.select :csa, 
                      Constants.electrical.conductor_csa,
                      { wrapper: { class: 'mb-3' } },
                      { class: 'form-select' },
                      { append: 'sq mm' } %>
              </div>
              <div class="col-md-4">
                <%= f.select :neutral_csa, 
                      Constants.electrical.conductor_csa,
                      { include_blank: true, wrapper: { class: 'mb-3' } },
                      { class: 'form-select' },
                      { append: 'sq mm' } %>
              </div>
              <div class="col-md-4">
                <%= f.select :earth_csa, 
                      Constants.electrical.conductor_csa,
                      { include_blank: true, wrapper: { class: 'mb-3' } },
                      { class: 'form-select' },
                      { append: 'sq mm' } %>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Insulation and Protection -->
        <div class="card mb-4">
          <div class="card-header py-1">
            <h6 class="mb-0"><%= t('cable_types.form.insulation_protection') %></h6>
          </div>
          <div class="card-body p-3">
            <div class="row">
              <div class="col-md-3">
                <%= f.text_field :insulation, wrapper: { class: 'mb-3' } %>
              </div>
              <div class="col-md-3">
                <%= f.text_field :bedding, wrapper: { class: 'mb-3' } %>
              </div>
              <div class="col-md-3">
                <%= f.text_field :armour, wrapper: { class: 'mb-3' } %>
              </div>
              <div class="col-md-3">
                <%= f.text_field :sheath, wrapper: { class: 'mb-3' } %>
              </div>
            </div>
            
            <div class="row">
              <div class="col-md-6">
                <%= f.number_field :bedding_od, 
                      step: '0.1',
                      min: 0,
                      wrapper: { class: 'mb-3' },
                      append: 'mm' %>
              </div>
              <div class="col-md-6">
                <%= f.number_field :overall_od, 
                      step: '0.1',
                      min: 0,
                      wrapper: { class: 'mb-3' },
                      append: 'mm' %>
              </div>
            </div>
            
            <div class="row">
              <div class="col-md-6">
                <%= f.select :temperature_rating,
                      Constants.electrical.temperature_rating,
                      { wrapper: { class: 'mb-3' } },
                      { class: 'form-select' } %>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Card Footer with Actions -->
      <div class="card-footer bg-transparent border-top-0 py-3">
        <div class="d-flex justify-content-end">
          <% if @cable_type.persisted? %>
            <%= link_to @cable_type, 
                  class: 'btn btn-outline-secondary me-2',
                  data: { turbo_confirm: t('actions.sure') } do %>
              <%= t('actions.cancel') %>
            <% end %>
          <% else %>
            <%= link_to cable_types_path,
                  class: 'btn btn-outline-secondary me-2',
                  data: { turbo_confirm: t('actions.sure') } do %>
              <%= t('actions.cancel') %>
            <% end %>
          <% end %>
          
          <%= f.submit(yield(:button_text) || t('actions.save'), 
                class: 'btn btn-primary') %>
        </div>
      </div>
    <% end %>
  </div>
</div>
