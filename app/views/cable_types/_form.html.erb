<div class="container mt-3">
  <div class="card">
    <div class="card-header p-2">

      <!-- Center Label Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
              <%= cable_type.persisted? ? t('actions.edit') : t('actions.new') %> 
              <% if cable_type.present? && cable_type.persisted? %>
                <%= [t('activerecord.models.cable_type'), cable_type.label].join(': ') %>
                <small class="text-muted ms-2"><%= cable_type.label %></small>
              <% else %>
                <%= t('activerecord.models.cable_type') %>
              <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: cable_type,
            layout: :horizontal,
            label_col: "col-sm-6",
            control_col: "col-sm-6",
            wrapper_class: 'mb-0 p-1',
            bootstrap: {
              form: { class: 'mb-0' },
              label: { class: 'mb-0' }
            }) do |f| %>

      <div class="card-body p-3 mx-auto" style="max-width: 30rem;">
        <%= render 'shared/error_messages', object: f.object %>
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Project card -->
            <% if cable_type.project.present? %>
              <%= render 'projects/project_card',
                    project: cable_type.project %>
            <% else %>
              <!-- Project select field -->
              <div class="card-body p-3 mx-auto">
                <%= f.select :project_id,
                    @projects.map { |p| [p.label, p.id] },
                    { wrapper: { class: 'mb-1' },
                      class: 'form-select' } %>
              </div>
            <% end %>  

            <!-- Conductor Details -->
            <div class="row">
                <%= f.select :conductor_material,
                      @conductor_select.map { |k, v| [k.to_s.titleize, k] },
                      { wrapper: { class: 'mb-1' },
                        class: 'form-select' } %>
            </div>
            <div class="row">
                <%= f.select :csa,
                      @csa_select.map { |csa| ["#{csa} mm²", csa] },
                      { wrapper: { class: 'mb-1' } },
                      { class: 'form-select' } %>
            </div>
            <div class="row">
                <%= f.number_field :cores,
                        step: '1',
                        min: 1,
                        wrapper: { class: 'mb-1' } %>
            </div>

            <div class="row">
                <%= f.select :neutral_csa,
                      @csa_select.map { |csa| ["#{csa} mm²", csa] } ,
                      { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>

            <div class="row">
              <%= f.select :earth_csa,
                    @csa_select.map { |csa| ["#{csa} mm²", csa] },
                    { include_blank: t("form.none"),
                    wrapper: { class: 'mb-1' } } %>
            </div>

            <!-- Insulation and Protection -->
            <div class="row">
                <%= f.select :insulation,
                      @insulation_select.map { |k, v| [k, k] },
                      { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :bedding,
                  @insulation_select.map { |k, v| [k, k] },
                  { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :armour,
                  @armour_select.map { |k, v| [k, k] },
                  { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :sheath,
                  @insulation_select.map { |k, v| [k, k] },
                  { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>

            <div class="row">
                <%= f.number_field :bedding_od,
                  step: '0.1',
                  min: 0,
                  wrapper: { class: 'mb-1' },
                  append: 'mm' %>
            </div>
            <div class="row">
                <%= f.number_field :overall_od,
                  step: '0.1',
                  min: 0,
                  wrapper: { class: 'mb-1' },
                  append: 'mm' %>
            </div>

            <!-- Rating -->
            <div class="row">
                <%= f.select :temperature_rating,
                  @temperature_select.map { |k, v| [k, k] },
                  { include_blank: t("form.unknown"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :voltage_rating,
                  @voltage_select.map { |k, v| [k, k] },
                  { include_blank: t("form.unknown"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
          </div>
        </div>

        <!-- Notes -->
        <div class="row">
            <%= f.text_area :notes,
              label_col: "col-sm-2",
              control_col: "col-sm-10",
              rows: 3,
              wrapper: { class: 'mb-1' } %>
        </div>
      </div>

      <!-- Card Footer with Actions -->
      <div class="card-footer p-3 mx-auto">
        <div class="d-flex justify-content-end gap-2">
          <%= link_to(@cable_type.persisted? ? cable_type_path(@cable_type) : cable_types_path,
                class: 'btn btn-warning',
                data: { confirm: t('actions.sure'), turbo: false }) do %>
            <%= t('actions.discard') %>
            <%== icon('x-square') %>
          <% end %>

          <%= f.button :submit, class: 'btn btn-primary' do %>
            <%= yield(:button_text) || t('actions.save') %>
            <%== icon('save') %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
