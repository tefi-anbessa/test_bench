<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">

      <!-- Center Label Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(@swatch) %>">
              <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div> <!-- end of card header -->

    <%= bootstrap_form_with(model: cable_type,
            html: { novalidate: true },
            url: cable_type.persisted? ? cable_type : discipline_cable_types_path(@discipline),
            layout: :horizontal,
            label_col: "col-sm-6",
            control_col: "col-sm-6",
            wrapper_class: 'mb-0 p-1',
            bootstrap: {
              form: { class: 'mb-0' },
              label: { class: 'mb-0' }
            }) do |f| %>

      <div class="card-body p-3 mx-auto" style="<%= form_styles(@swatch) %>">
        <%= render 'shared/error_messages', object: f.object %>
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Role -->
            <div class="row">
                <%= f.select :primary_role,
                      CableType.primary_roles.map { |k, v| [t("activerecord.attributes.cable_type.primary_roles.#{k}"), k] },
                      { wrapper: { class: 'mb-1' },
                        class: 'form-select' } %>
            </div>

            <!-- Conductor Details -->
            <div class="row">
              <%= f.select :conductor_material,
                    CableType.conductor_materials.map { |k, v| [k.to_s.titleize, k] },
                    { wrapper: { class: 'mb-1' },
                      class: 'form-select' } %>
            </div>
            <div class="row">
                <%= f.number_field :groups,
                        step: '1',
                        min: 1,
                        wrapper: { class: 'mb-1' } %>
            </div>
            <div class="row">
                <%= f.select :construction,
                      CableType.constructions.map { |k, v| [t("activerecord.attributes.cable_type.constructions.#{k}"), k] },
                      { wrapper: { class: 'mb-1' },
                        class: 'form-select' } %>
            </div>
            <div class="row">
                <%= f.select :csa,
                      @csa_select.map { |csa| ["#{csa} mm²", csa] },
                      { wrapper: { class: 'mb-1' } },
                      { class: 'form-select' } %>
            </div>

            <!-- Discipline-specific detail fields -->
            <%= f.fields_for :detail do |detail_f| %>
              <% if cable_type.detail.is_a?(Electrical::CableTypeDetail) %>
                <%= render 'cable_types/detail_fields_electrical', f: detail_f, csa_select: @csa_select %>
              <% elsif cable_type.detail.is_a?(Instrument::CableTypeDetail) %>
                <%= render 'cable_types/detail_fields_instrument', f: detail_f %>
              <% end %>
            <% end %>

            <!-- Insulation and Protection -->
            <div class="row">
                <%= f.select :insulation,
                      CableType.insulations.map { |k, v| [k, k] },
                      { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :bedding,
                  CableType.beddings.map { |k, v| [k, k] },
                  { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :armour,
                  CableType.armours.map { |k, v| [k, k] },
                  { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :sheath,
                  CableType.sheaths.map { |k, v| [k, k] },
                  { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>

            <div class="row">
                <%= f.number_field :bedding_od,
                  step: '0.1',
                  min: 0,
                  wrapper: { class: 'mb-1' },
                  append: 'mm' %>
            </div>
            <div class="row">
                <%= f.number_field :overall_od,
                  step: '0.1',
                  min: 0,
                  wrapper: { class: 'mb-1' },
                  append: 'mm' %>
            </div>

            <!-- Rating and protection -->
            <div class="row">
                <%= f.select :temperature_rating,
                  CableType.temperature_ratings.map { |k, v| [k, k] },
                  { include_blank: t("form.unknown"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :voltage_rating,
                  CableType.voltage_ratings.map { |k, v| [k, k] },
                  { include_blank: t("form.unknown"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :fire_protection,
                      CableType.fire_protections.map { |k, v| [t("activerecord.attributes.cable_type.fire_protections.#{k}"), k] },
                      { include_blank: t("form.unknown"),
                        wrapper: { class: 'mb-1' } } %>
            </div>

            <!-- Environment protection and applicable standards -->
            <%= form_field(f, :environment_protection, type: :jsonb) %>
            <%= form_field(f, :applicable_standard, type: :jsonb) %>
          </div>
        </div>

        <!-- Notes -->
        <div class="row">
            <%= f.text_area :notes,
              label_col: "col-sm-2",
              control_col: "col-sm-10",
              rows: 3,
              wrapper: { class: 'mb-1' } %>
        </div>
      </div>

      <!-- Card Footer with Actions -->
      <div class="card-footer p-3 mx-auto">
        <div class="d-flex justify-content-end gap-2">
          <%= link_to(cable_type.persisted? ? cable_type : discipline_cable_types_path(@discipline),
                class: 'btn btn-warning',
                data: { confirm: t('actions.sure'), turbo: false }) do %>
            <%= t('actions.discard') %>
            <%== bs_icon('x-square') %>
          <% end %>

          <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
            <%= yield(:button_text) || t('actions.save') %>
            <%== bs_icon('save') %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
