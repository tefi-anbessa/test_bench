<tr scope="row">
  <td><%= row.conductor_material %></td>
  <td><%= row.csa %></td>
  <td><%= row.cores %></td>
  <td><%= row.neutral_csa %></td>
  <td><%= row.earth_csa %></td>
  <td><%= row.insulation %></td>
  <td><%= row.bedding %></td>
  <td><%= row.armour %></td>
  <td><%= row.sheath %></td>
  <td><%= row.bedding_od %></td>
  <td><%= row.overall_od %></td>
  <td><%= row.temperature_rating %></td>
  <td><%= row.voltage_rating %></td>
  <td>
    <% if policy(row).show? %>
      <%= link_to cable_type_path(row), class: "btn btn-secondary btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(row).edit? %>
      <%= link_to edit_cable_type_path(row), class: "btn btn-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline"  do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(row).destroy? %>
      <%= link_to cable_type_path(row), method: :delete, class: "btn btn-danger btn-sm icon-link",
            aria: { label: t('actions.delete') },
            title: t('actions.delete'),
            display: "inline"  do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>
