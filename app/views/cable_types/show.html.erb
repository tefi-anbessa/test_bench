<!-- Centred container for cable type show card -->
<div class="container mt-3 mx-auto">
  <!-- Cable Type Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <%= link_to cable_types_path,
                  class: "btn btn-sm btn-outline-secondary me-2",
                  title: t('actions.index') do %>
              <%== icon('list-columns-reverse') %>
              <span class="d-none d-mds-inline"><%= t('actions.index') %></span>
            <% end %>

            <!-- Previous Button -->
            <% if @prev.present? %>
              <% disabled = @prev == @cable_type %>
              <%= link_to cable_type_path(@prev, q: @ransack_params),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{@prev.label}" do %>
                <%== icon('arrow-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge bg-primary fs-6">
              <% @cable_type.code %>
                <%= [t('activerecord.models.cable_type', default: 'Cable Type'), 
                  @cable_type&.label].compact.join(' ') %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% if @next.present? %>
              <% disabled = @next == @cable_type %>
              <%= link_to cable_type_path(@next, q: @ransack_params),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{@next.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== icon('arrow-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@cable_type).edit? %>
                <%= link_to edit_cable_type_path(@cable_type),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@cable_type).destroy? %>
                <%= link_to @cable_type,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>  <!-- end of card header -->

    <div class="card-body">

      <!-- Project collapsible card -->
      <%= render 'projects/project_card',
      title: [t('activerecord.models.project'), 
        @cable_type.project.label].compact.join(': ') %>
      

      <!-- Cable Details Inner Card -->
    <div class="card">
      <div class="card-body p-0">  <!-- Remove default padding -->
        <div class="table-responsive">
          <table class="table table-bordered table-sm mb-0" style="width: auto;">
            <tbody>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.conductor_material') %></th>
                <td><%= @cable_type&.conductor_material %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.csa') %></th>
                <td><%= @cable_type&.csa %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.cores') %></th>
                <td><%= @cable_type&.cores %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.neutral_csa') %></th>
                <td><%= @cable_type&.neutral_csa %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.earth_csa') %></th>
                <td><%= @cable_type&.earth_csa %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.insulation') %></th>
                <td><%= @cable_type&.insulation %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.bedding') %></th>
                <td><%= @cable_type&.bedding %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.armour') %></th>
                <td><%= @cable_type&.armour %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.sheath') %></th>
                <td><%= @cable_type&.sheath %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.bedding_od') %></th>
                <td><%= @cable_type&.bedding_od %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.overall_od') %></th>
                <td><%= @cable_type&.overall_od %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.temperature_rating') %></th>
                <td><%= @cable_type&.temperature_rating %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.voltage_rating') %></th>
                <td><%= @cable_type&.voltage_rating %></td>
              </tr>
              <tr>
                <th><%= t('activerecord.attributes.cable_type.notes') %></th>
                <td><%= @cable_type&.notes %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div> <!-- inner card -->
  </div>
</div>
