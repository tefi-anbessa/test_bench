<thead>
  <% unless current_project %>
    <th scope = "col"><%= sort_link(@q, "#{Project.model_name.human}", :project_id) %>
  <% end %>
  <th scope="col"><%= sort_link(@q, :id, t('activerecord.attributes.cable_type.id')) %></th>
  <th scope="col"><%= sort_link(@q, :primary_role, t('activerecord.attributes.cable_type.primary_role')) %></th>
  <th scope="col"><%= t('activerecord.attributes.cable_type.notes') %></th>
  <th scope="col"><%= sort_link(@q, :code, t('activerecord.attributes.cable_type.code')) %></th>
  <th scope="col"><%= sort_link(@q, :cables, t('activerecord.models.cable.other')) %></th>
  <th scope="col" width="150px"><%= t('table.links')%></th>
</thead>
