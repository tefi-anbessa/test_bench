<!-- Centred container for cable type show card -->
<div class="container mt-3 mx-auto">
  <!-- Cable Type Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <%= link_to cable_types_path,
                  class: "btn btn-sm btn-outline-secondary me-2",
                  title: t('actions.index') do %>
              <%== icon('list-columns-reverse') %>
              <span class="d-none d-mds-inline"><%= t('actions.index') %></span>
            <% end %>

            <!-- Previous Button -->
            <% prev_cable_type = @cable_type.prev %>
            <% if prev_cable_type.present? %>
              <% disabled = prev_cable_type == @cable_type %>
              <%= link_to cable_type_path(prev_cable_type),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_cable_type.label}" do %>
                <%== icon('arrow-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge bg-primary fs-6">
              <% @cable_type.code %>
                <%= [t('activerecord.models.cable_type', default: 'Cable Type'), 
                  @cable_type&.label].compact.join(' ') %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_cable_type = @cable_type.next %>
            <% if next_cable_type.present? %>
              <% disabled = next_cable_type == @cable_type %>
              <%= link_to cable_type_path(next_cable_type),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_cable_type.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== icon('arrow-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@cable_type).edit? %>
                <%= link_to edit_cable_type_path(@cable_type),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@cable_type).destroy? %>
                <%= link_to @cable_type,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>  <!-- end of card header -->

    <div class="card-body">

      <!-- Project collapsible card -->
      <%= render 'projects/project_card',
      title: [t('activerecord.models.project'), 
        @cable_type.project.label].compact.join(': ') %>
      

      <!-- Cable Details Inner Card -->
      <div class="card">
        <div class="card-body">
      
          <div class="row">
            <div class="col-md-6">
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.conductor_material') %></div>
                    <div class="col-8"><%= @cable_type&.conductor_material %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.csa') %></div>
                    <div class="col-8"><%= @cable_type&.csa %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.cores') %></div>
                    <div class="col-8"><%= @cable_type&.cores %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.neutral_csa') %></div>
                    <div class="col-8"><%= @cable_type&.neutral_csa %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.earth_csa') %></div>
                    <div class="col-8"><%= @cable_type&.earth_csa %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.insulation') %></div>
                    <div class="col-8"><%= @cable_type&.insulation %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.bedding') %></div>
                    <div class="col-8"><%= @cable_type&.bedding %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.armour') %></div>
                    <div class="col-8"><%= @cable_type&.armour %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.sheath') %></div>
                    <div class="col-8"><%= @cable_type&.sheath %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.bedding_od') %></div>
                    <div class="col-8"><%= @cable_type&.bedding_od %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.overall_od') %></div>
                    <div class="col-8"><%= @cable_type&.overall_od %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.temperature_rating') %></div>
                    <div class="col-8"><%= @cable_type&.temperature_rating %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.voltage_rating') %></div>
                    <div class="col-8"><%= @cable_type&.voltage_rating %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.notes') %></div>
                    <div class="col-8"><%= @cable_type&.notes %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div> <!-- inner card -->
  </div>
</div>
