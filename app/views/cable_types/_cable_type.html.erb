    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable_type.bedding') %>:
      </span>
      <span class="col-2 data-field">
        <%= cable_type.bedding %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable_type.armour') %>:
      </span>
      <span class="col-2 data-field">
