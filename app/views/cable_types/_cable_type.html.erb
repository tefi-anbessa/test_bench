        <%= cable_type.sheath %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
        <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable_type.bedding_od') %>:
      </span>
      <span class="col-2 data-field">
        <%= cable_type.bedding_od %>mm
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable_type.overall_od') %>:
      </span>
      <span class="col-2 data-field">
        <%= cable_type.overall_od %>mm
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable_type.temperature_rating') %>:
      </span>
      <span class="col-2 data-field">
        <%= cable_type.temperature_rating %>
      </span>
    </div>
  </div>
</div>
