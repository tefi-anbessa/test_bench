<div id="<%= dom_id cable_type %>">

  <%= render 'components/collapsible',
    id: "cable_type_#{cable_type.id}_details",
    title: t('cable_types.show.header', label: cable_type.label),
    expanded: false,
    header_class: 'py-1' do %>

    <div class="row mb-1">
      <% text = t("show.linked", model: cable_type.model_name.human) %>
      <%= link_to cable_type_path(cable_type),
        class: "btn btn-sm btn-outline-secondary me-2",
        title: text do %>
        <%== icon('box-arrow-in-up-left') %>
        <span class="d-none d-md-inline"><%= text %></span>
      <% end %>
    </div>
    
    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.code') %></div>
      <div class="col-8"><%= cable_type.code.presence || '-' %></div>
    </div>
    
    <div class="row mb-1">
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.conductor_material') %></div>
        <div class="col-8"><%= cable_type.conductor_material.presence || '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.cores') %></div>
        <div class="col-8"><%= cable_type.cores.presence || '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.csa') %></div>
        <div class="col-8"><%= cable_type.csa.present? ? "#{cable_type.csa} mm²" : '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.neutral_csa') %></div>
        <div class="col-8"><%= cable_type.neutral_csa.present? ? "#{cable_type.neutral_csa} mm²" : '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.earth_csa') %></div>
        <div class="col-8"><%= cable_type.earth_csa.present? ? "#{cable_type.earth_csa} mm²" : '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.insulation') %></div>
        <div class="col-8"><%= cable_type.insulation.presence || '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.bedding') %></div>
        <div class="col-8"><%= cable_type.bedding.presence || '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.armour') %></div>
        <div class="col-8"><%= cable_type.armour.presence || '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.sheath') %></div>
        <div class="col-8"><%= cable_type.sheath.presence || '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.temperature_rating') %></div>
        <div class="col-8"><%= cable_type.temperature_rating.presence || '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.overall_od') %></div>
        <div class="col-8"><%= cable_type.overall_od.present? ? "#{cable_type.overall_od} mm" : '-' %></div>
      </div>
      
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t('activerecord.attributes.cable_type.bedding_od') %></div>
        <div class="col-8"><%= cable_type.bedding_od.present? ? "#{cable_type.bedding_od} mm" : '-' %></div>
      </div>
    </div>
  <% end %>
</div>
