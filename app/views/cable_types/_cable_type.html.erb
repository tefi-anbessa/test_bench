<div id="<%= dom_id cable_type %>">
  <div class="container text-start">
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable_type.conductor_material') %>:
      </span>
      <span class="col-2 data-field">
        <%= cable_type.conductor_material %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable_type.conductor_makeup') %>:
      </span>
      <span class="col-2 data-field">
        <%= cable_type.conductor_makeup %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable_type.csa') %>:
      </span>
      <span class="col-2 data-field">
        <%= cable_type.csa %>mm<sup>2</sup>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable_type.neutral_csa') %>:
      </span>
      <span class="col-2 data-field">
        <%= cable_type.neutral_csa %>mm<sup>2</sup>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
