<% provide(:title, t('.title')) %>
<div class="row justify-content-center mt-5">
  <div class="col-md-8 text-center">
  <%= error_image('HAL9000-v2.jpg', 409) %>

    <h1 class="display-4 text-danger">409: <%= t('.header') %></h1>
    
    <%= render 'shared/flash' if flash.any? %>
    
    <div class="card mt-4">
      <div class="card-header bg-danger text-white">
        <h2 class="h5 mb-0"><%= t('.subheader') %></h2>
      </div>
      <div class="card-body text-start">
        <% if @exception.present? %>
          <p class="card-text"><strong><%= t('.reason') %></strong> <%= @exception.message %></p>
          
          <% if @exception.respond_to?(:record) && @exception.record.present? %>
            <p class="card-text">
              <strong><%= t('.resource') %>:</strong> 
              <code><%= @exception.record.class.model_name.human %></code>
              <% if @exception.record.respond_to?(:id) %>
                (ID: <%= @exception.record.id %>)
              <% end %>
            </p>
          <% end %>
          
          <% if @exception.backtrace.present? && Rails.env.development? %>
            <div class="mt-3">
              <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#errorDetails" aria-expanded="false" aria-controls="errorDetails">
                <%= t('.show_details') %>
              </button>
              <div class="collapse mt-2" id="errorDetails">
                <div class="card card-body bg-light">
                  <pre class="mb-0"><%= @exception.backtrace.join("\n") %></pre>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
        
        <% if defined?(current_user) && current_user %>
          <div class="mt-3 pt-3 border-top">
            <p class="card-text small text-muted mb-1"><strong><%= t('.user') %>:</strong> <%= current_user.email %></p>
            <% if current_user.respond_to?(:roles) %>
              <p class="card-text small text-muted mb-0">
                <strong><%= t('.roles') %>:</strong> 
                <%= current_user.roles.map { |r| r.name.titleize }.join(', ') %>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="card-footer bg-transparent">
        <%= link_to root_path, class: 'btn btn-primary' do %>
          <%== bs_icon('house-door') %> <%= t('.back_to_home') %>
        <% end %>

        <%= link_to '#', class: 'btn btn-outline-secondary ms-2', onclick: 'history.back(); return false;' do %>
          <%== bs_icon('arrow-return-left') %> <%= t('.go_back') %>
        <% end %>
      </div>
    </div>
  </div>
</div>
