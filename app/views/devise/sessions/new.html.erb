<div class="container mt-5">
  <div class="row justify-content-end">
    <div class="col-md-6 col-lg-5 col-xl-4">
      <div class="card">
        <div class="card-header">
          <h4 class="mb-0"><%= t('.sign_in') %></h4>
        </div>
        <div class="card-body">
          <%= bootstrap_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <%= f.text_field :login, autofocus: true, autocomplete: "username", wrapper: { class: 'mb-3' } %>
            <%= f.password_field :password, autocomplete: "current-password", wrapper: { class: 'mb-3' } %>

            <% if devise_mapping.rememberable? %>
              <%= f.check_box :remember_me, wrapper: { class: 'mb-3' } %>
            <% end %>

            <%= f.submit t('.sign_in'), class: 'btn btn-primary w-100' %>
          <% end %>

          <hr class="my-3">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
