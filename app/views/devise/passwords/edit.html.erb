<div class="container mt-5">
  <div class="row justify-content-end">
    <div class="col-md-6 col-lg-5 col-xl-4">
      <div class="card">
        <div class="card-header">
          <h4 class="mb-0"><%= t('.change_your_password') %></h4>
        </div>
        <div class="card-body">
          <%= bootstrap_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>
            <%= f.hidden_field :reset_password_token %>

            <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
                  label: t('.new_password'),
                  help: @minimum_password_length ? t('devise.shared.minimum_password_length', count: @minimum_password_length) : nil,
                  wrapper: { class: 'mb-3' } %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password",
                  label: t('.confirm_new_password'),
                  wrapper: { class: 'mb-3' } %>

            <%= f.submit t('.change_my_password'), class: 'btn btn-primary w-100' %>
          <% end %>

          <hr class="my-3">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
