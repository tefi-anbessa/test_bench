<% provide(:title, t('.title')) %>
<div class="container mt-3">
  <!-- Motor Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@motor).index? %>
              <%= link_to motors_path,
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: t('actions.index') do %>
                <%== icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_motor = @motor.prev %>
            <% if prev_motor.present? %>
              <% disabled = prev_motor == @motor %>
              <%= link_to motor_path(prev_motor),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_motor.label}" do %>
                <%== icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge bg-primary fs-6">
                <%= t('.header', label: @motor.label)%>
              </span>
              <% if @motor.tag&.service.present? %>
                <small class="text-muted ms-2"><%= @motor.tag.service %></small>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_motor = @motor.next %>
            <% if next_motor.present? %>
              <% disabled = next_motor == @motor %>
              <%= link_to motor_path(next_motor),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_motor.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== icon('arrow-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@motor).edit? %>
                <%= link_to edit_motor_path(@motor),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@motor).destroy? %>
                <%= link_to @motor,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>


    <div class="d-flex flex-column justify-content-center">
      <div class="card-body">

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Tag Card -->
            <% if @motor.tag.present? %>
              <div class="row g-3 mb-3">
                  <%= render 'tags/tag_card', tag: @motor.tag %>
              </div>
            <% else %>
              <div class="row g-3 mb-3">
                <div class="alert alert-danger">
                  <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                </div>
              </div>
            <% end %>

            <!-- Motor Details Card -->
            <div class="row">
              <div class="card mb-4">
                <div class="card-body p-3">

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.motor.motor_type') %></div>
                    <div class="col-8"><%= Motor.human_enum_name(:motor_type, @motor.motor_type) %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.motor.frame_size') %></div>
                    <div class="col-8"><%= "frame_#{@motor.frame_size}" %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.motor.poles') %></div>
                    <div class="col-8"><%= @motor.poles || '-' %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.motor.ingress_protection') %></div>
                    <div class="col-8"><%= @motor.ingress_protection.present? ?
                      ["IP", @motor.ingress_protection].join(' ') : '-' %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.motor.speed_rated') %></div>
                    <div class="col-8"><%= @motor.speed_rated || '-' %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.motor.notes') %></div>
                    <div class="col-8"><%= @motor.notes || '-' %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted">
                      <% text = t('activerecord.models.demand') %>
                      <% if @motor.demand.present? %>
                        <%= link_to demand_path(@motor.demand),
                          class: "btn btn-sm btn-outline-secondary",
                          title: text do %>
                            <%= text %>
                            <%== icon('box-arrow-in-down-right') %>
                        <% end %>
                      <% else %>
                      <% text = t("actions.link", resource: t("activerecord.models.demand")) %>
                        <% if policy(Demand).new? %>
                          <%= link_to new_tag_demand_path(@motor.tag.id),
                              class: "btn btn-sm btn-outline-primary mb-2",
                              title: text do %>
                                <span class="d-none d-md-inline">
                                  <%= text %>
                                </span>
                                <%== icon('link') %>
                              <% end %>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
