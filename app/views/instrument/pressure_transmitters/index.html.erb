<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch) %>">
  <!-- Tagable Resource Header Card -->
  <div class="card mb-1" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-1" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <!-- Discipline and project links -->
        <div class="col-2">
          <%= nav_button(action: :show_project, record: @discipline.project) %>
          <%= nav_button(action: :show_discipline, record: @discipline) %>
        </div>

        <!-- Header Text (Left) -->
        <div class="col-8">
          <% scope_text = [@discipline.project.label, @discipline.model_name.human, @discipline.label].join(' ') %>
          <h5><%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 text-end">
          <% if @discipline.present? && policy(@discipline.tags.build()).new? %>
            <%= nav_button(action: :new, path: new_discipline_tagable_path(@discipline, tagable_type: 'Instrument::PressureTransmitter'), record: Instrument::PressureTransmitter.new) %>
          <% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: discipline_tagables_path(@discipline) do |f| %>
          <%= hidden_field_tag :tagable_type, @type %>
          <%= f.search_field :measurement_type_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.measurement_type") %>
          <%= f.search_field :pressure_unit_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.pressure_unit") %>
          <%= f.search_field :signal_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.signal") %>
          <%= f.search_field :communication_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.communication") %>
          <%= f.search_field :fluid_phase_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.fluid_phase") %>
          <%= f.search_field :process_fluid_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.process_fluid") %>
          <%= f.search_field :accuracy_class_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.accuracy_class") %>
          <%= f.search_field :connection_type_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.connection_type") %>
          <%= f.search_field :connection_size_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.connection_size") %>
          <%= f.search_field :case_material_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.case_material") %>
          <%= f.search_field :wetted_material_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.wetted_material") %>
          <%= f.search_field :movement_type_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.movement_type") %>
          <%= f.search_field :ip_rating_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.ip_rating") %>
          <%= f.search_field :accessories_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.accessories") %>
          <%= f.search_field :notes_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.instrument/pressure_transmitter.notes") %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!-- Broken and incomplete links -->
      <% unless @link_broken.empty? %>
        <table id='link_broken' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-danger">
              <th colspan="<%= 20 + (current_project ? 0 : 1) %>">
                <%= t('index.link_broken',
                      count: @link_broken.count,
                      models: t("activerecord.models.instrument/pressure_transmitter", count: @link_broken.count)) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_broken.each do |tag| %>
              <%= render 'tags/row', row: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <% unless @link_incomplete.empty? %>
        <table id='link_incomplete' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-warning">
              <th colspan="<%= 20 + (current_project ? 0 : 1) %>">
                <%= t('index.link_incomplete',
                      count: @link_incomplete.count,
                      models: t("activerecord.models.instrument/pressure_transmitter", count: @link_incomplete.count)) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_incomplete.each do |tag| %>
              <%= render 'tags/row', row: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <!-- Pressure transmitters -->
      <!-- Policies for tagables are invariant over the scope, so no need to look up policy for each record. -->
      <% can_show = policy(@discipline.tags.build()).show? %>
      <% can_edit = policy(@discipline.tags.build()).edit? %>
      <% can_delete = policy(@discipline.tags.build()).destroy? %>
      <table id='instrument_pressure_transmitters' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'instrument/pressure_transmitters/header' %>
        <tbody>
          <% unless @orphans.empty? %>
            <tr class="table-danger">
              <td colspan="<%= 20 + (current_project ? 0 : 1) %>">
                <%= t('index.orphans', models: t("activerecord.models.instrument/pressure_transmitter").tableize) %>
              </td>
            </tr>
            <% @orphans.each do |row| %>
              <%= render 'instrument/pressure_transmitters/row', row: row, can_show: can_show, can_edit: can_edit, can_delete: can_delete %>
            <% end %>
            <tr class="table-success">
              <td colspan="<%= 20 + (current_project ? 0 : 1) %>">
                <%= t('.title') %>
              </td>
            </tr>
          <% end %>
          <% @pressure_transmitters.each do |row| %>
            <%= render 'instrument/pressure_transmitters/row', row: row, can_show: can_show, can_edit: can_edit, can_delete: can_delete %>
          <% end %>
        </tbody>
      </table>
    <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
      <%== pagy_bootstrap_nav(@pagy, classes: 'pagination pagination-sm') %>
      <%== pagy_info(@pagy) %>
      <%== pagy_limit_selector_js(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
