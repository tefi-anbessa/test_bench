<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Pressure gauge Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@pressure_gauge.tag).index? %>
              <%= nav_button(action: :index, path: discipline_tagables_path(@discipline, tagable_type: 'Instrument::PressureGauge'), record: @pressure_gauge) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous_tagable, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Badge Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @pressure_gauge.label)%>
              </span>
              <!-- Add descriptor here if available -->
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next_tagable, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@pressure_gauge.tag).edit? %>
                <%= nav_button(action: :edit_tagable, record: @pressure_gauge) %>
              <% end %>

              <% if policy(@pressure_gauge.tag).destroy? %>
                <%= nav_button(action: :delete_tagable, record: @pressure_gauge) %>
              <% end %>

              <% if policy(@pressure_gauge.tag).new? %>
                <%= nav_button(action: :new, path: new_discipline_tagable_path(@discipline, 
                    tagable_type: 'Instrument::PressureGauge'), record: @pressure_gauge) %>
              <% end %>
            </div> <!-- button group -->
          </div> <!-- d-flex align-items-center -->
        </div> <!-- right navigation and actions -->
      </div> <!-- row align-items-center -->
    </div> <!-- card header -->

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- PressureGauge Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @pressure_gauge.model_name.human) %></h4>
            </div>

            <div class="card-body p-3">
 
              <%= show_attribute(@pressure_gauge, :measurement_type, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :pressure_unit, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :range_min, type: :float, precision: 6) %>
              <%= show_attribute(@pressure_gauge, :range_max, type: :float, precision: 6) %>
              <%= show_attribute(@pressure_gauge, :fluid_phase, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :process_fluid, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :accuracy_class, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :dial_size, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :connection_type, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :connection_size, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :case_material, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :wetted_material, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :movement_type, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :liquid_filled, type: :boolean) %>
              <%= show_attribute(@pressure_gauge, :fill_fluid, type: :enum_translated) %>
              <%= show_attribute(@pressure_gauge, :ip_rating) %>
              <%= show_attribute(@pressure_gauge, :safety_pattern, type: :boolean) %>
              <%= show_attribute(@pressure_gauge, :accessories, type: :jsonb) %>
              <%= show_attribute(@pressure_gauge, :notes, type: :text) %>
            </div>   <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @pressure_gauge.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <%= show_association(@pressure_gauge, :tag) %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
