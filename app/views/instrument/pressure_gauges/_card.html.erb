<!-- Pressure gauge collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% pressure_gauge = object %>
<% context ||= pressure_gauge.model_name.human %>
<%= render 'components/collapsible', id: "#{id}_#{pressure_gauge.id}_details", 
  title: [context, pressure_gauge.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
    <div class="container-fluid">
      <%= nav_link(action: :show, record: pressure_gauge) %>
 
      <%= show_attribute(pressure_gauge, :measurement_type, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :pressure_unit, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :range_min, type: :float, precision: 6) %>
      <%= show_attribute(pressure_gauge, :range_max, type: :float, precision: 6) %>
      <%= show_attribute(pressure_gauge, :fluid_phase, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :process_fluid, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :accuracy_class, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :dial_size, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :connection_type, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :connection_size, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :case_material, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :wetted_material, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :movement_type, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :liquid_filled, type: :boolean) %>
      <%= show_attribute(pressure_gauge, :fill_fluid, type: :enum_translated) %>
      <%= show_attribute(pressure_gauge, :ingress_protection) %>
      <%= show_attribute(pressure_gauge, :safety_pattern, type: :boolean) %>
      <%= show_attribute(pressure_gauge, :accessories, type: :jsonb) %>
      <%= show_attribute(pressure_gauge, :notes, type: :text) %>

    </div> <!-- end container-fluid -->
<% end %>