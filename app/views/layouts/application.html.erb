
<!DOCTYPE html>
<html>
  <head lang="<%= I18n.locale %>">
    <title><%= full_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <%# Bootstrap CSS via asset pipeline %>
    <%= stylesheet_link_tag "bootstrap", "data-turbo-track": "reload" %>
    
    <%= javascript_importmap_tags %>
    
    <%# Bootstrap JS Bundle with Popper from CDN (temporary) %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <%= render 'layouts/shim' %>
  </head>
  <body>
    <%= render 'layouts/header' %>

    <div class="container" id="flash-messages">
      <% flash.each do |message_type, message| %>
        <div class="alert alert-<%= message_type %>"><%= message %></div>
      <% end %>
    </div>
    <%= yield %>
    
    <%# Page size selector functionality %>
    <%= javascript_import_module_tag "controllers/page_size" %>
    
    <%= render 'layouts/footer' %>
    <%= debug(params) if Rails.env.development? %>

  </body>
</html>
