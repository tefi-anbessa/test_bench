<nav class="navbar navbar-expand-md navbar-light bg-light fixed-top">
  <div class="container-fluid">
    <div class="nav-item">
      <%= link_to root_path,
                class: ["navbar-brand", { active: current_page?(root_path) }],
                id: "logo" do %>
        <%= image_tag("favicon.ico", size: 40) %>
        <%= t('app_name') %>
      <% end %>
    </div>

    <button class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id="navbarSupportedContent">
      <ul class="navbar-nav">
        <% if user_signed_in? %>
            <% if policy(Role).index? %>
              <li class="nav-item">
                <%= link_to t('role', scope: 'activerecord.models').pluralize,
                  roles_path,
                  class: 'nav-link',
                  aria: { label: t('role', scope: 'activerecord.models').pluralize } %>
              </li>
            <% end %>

            <% if policy(Swatch).create? %>
              <li class="nav-item">
                <%= link_to t('swatch', scope: 'activerecord.models').pluralize,
                  swatches_path,
                  class: 'nav-link',
                  aria: { label: t('swatch', scope: 'activerecord.models').pluralize } %>
              </li>
            <% end %>

            <!-- Project section -->
            <% if policy(Project).index? %> 
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle"
                    href="#"
                    data-bs-toggle="dropdown"
                    id="project-menu-btn"
                    role="button"
                    aria-expanded="false">
                    <%= project_selected? ?
                      t('project', scope: 'activerecord.models') + ": " + current_project.code :
                      t('project', scope: 'activerecord.models').pluralize %>
                </a>
                <ul class="dropdown-menu" aria-labelledby="project-menu-btn">
                  <% if project_selected? %>
                    <% if policy(current_project).show? %>
                    <li><%= link_to [t('actions.show'), current_project.code].join(" "),
                          project_path(current_project),
                          class: "dropdown-item" %></li>
                    <% end %>
                    <% if policy(current_project).edit? %>
                    <li><%= link_to [t('actions.edit'), current_project.code].join(" "),
                          edit_project_path(current_project),
                          class: "dropdown-item" %></li>
                    <% end %>
                  <% end %>
                  
                  <li><%= link_to t('actions.select'),
                        select_projects_path,
                        class: "dropdown-item" %></li>
                  <li><%= link_to t('project', scope: 'activerecord.models').pluralize,
                        projects_path,
                        class: "dropdown-item" %></li>
                </ul>
              </li>
            <% end %> <!-- Project section -->

            <!-- Change section: if access is available to change models, make a dropdown menu -->
            <% if current_project && policy(current_project.change_requests.build()).new? %> 
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle"
                    href="#"
                    data-bs-toggle="dropdown"
                    id="project-change-menu-btn"
                    role="button"
                    aria-expanded="false">
                    <%= t('module_name.project_change').pluralize %>
                </a>
                <ul class="dropdown-menu" aria-labelledby="project-change-menu-btn">
                  <% if policy(ProjectChange::Request).index? %>
                    <li><%= link_to t('project_change.requests.index.title'),
                          project_project_change_requests_path(current_project),
                          class: "dropdown-item" %></li>
                  <% end %>
                </ul>
              </li> <!-- Change dropdown -->
            <% end %>

            <!-- User section -->
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle"
                  href="#"
                  data-bs-toggle="dropdown"
                  id="user-menu-btn"
                  role="button"
                  aria-expanded="false">
                <%= current_user.name %>
              </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="user-menu-btn">
              <li>
                <%= link_to t('menu.profile'),
                  user_path(current_user),
                  class: "dropdown-item" %>
              </li>
              <li>
                <%= link_to t('menu.edit'),
                  edit_user_registration_path,
                  class: "dropdown-item" %>
              </li>
              <% if policy(current_user).index? %>
                <li>
                  <%= link_to t('activerecord.models.user.other'),
                    users_path,
                    class: 'dropdown-item' %>
                </li>
              <% end %>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= link_to t('menu.log_out'),
                  destroy_user_session_path,
                  data: { "turbo-method": :delete },
                  class: "dropdown-item" %>
              </li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to t('menu.log_in'),
                  new_user_session_path,
                  class: 'nav-link',
                  aria: { label: t('menu.log_in') } %>
          </li>
        <% end %>

        <li class="nav-item dropdown ms-2">
          <a class="nav-link dropdown-toggle" href="#"
                id="navbarLocaleSelect"
                role="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">
                <%= icon(flag_code(locale), style: "width: 1.5rem; height: auto;") %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarLocaleSelect">
            <% I18n.available_locales.each do |locale| %>
              <li>
                <%= icon(flag_code(locale), style: "width: 1.5rem; height: auto;") %>
                <% if I18n.locale == locale %>
                  <span class="ms-2"><%= t("language", locale: locale) %></span>
                <% else %>
                  <%= link_to t("language", locale: locale),
                            url_for(locale: locale),
                            class: "ms-2 text-decoration-none" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
