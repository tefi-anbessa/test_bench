<div class="container mt-3" style="<%= container_styles(swatch) %>">
  <div class="card" style="<%= card_styles(swatch) %>">
    <div class="card-header p-2">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
            <span class="badge fs-6" style="<%= badge_styles(swatch) %>">
              <%= yield(:header) %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: swatch,
          layout: :horizontal,
          label_col: "col-sm-4",
          control_col: "col-sm-8",
          wrapper_class: 'mb-1',
          ) do |f| %>

      <div class="card-body p-2">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">        <!-- Adjust to fit field width requirements -->

            <!-- Swatch Details -->
            <div class="card mb-1" style="<%= form_styles(swatch) %>">

              <div class="card-body p-2">
                <%= render 'shared/error_messages', object: f.object %>

                <%= form_field(f, :name, label_cols: 4, control_cols: 8) %>
                <%= form_field(f, :bg, type: :colour, label_cols: 4, control_cols: 4, append: swatch.bg) %>
                <%= form_field(f, :text, type: :colour, label_cols: 4, control_cols: 4, append: swatch.text) %>
                <%= form_field(f, :form_bg, type: :colour, label_cols: 4, control_cols: 4, append: swatch.form_bg) %>
                <%= form_field(f, :form_field, type: :colour, label_cols: 4, control_cols: 4, append: swatch.form_field) %>
                <%= form_field(f, :card_bg, type: :colour, label_cols: 4, control_cols: 4, append: swatch.card_bg) %>
                <%= form_field(f, :card_header_bg, type: :colour, label_cols: 4, control_cols: 4, append: swatch.card_header_bg) %>
                <%= form_field(f, :card_border, type: :colour, label_cols: 4, control_cols: 4, append: swatch.card_border) %>
                <%= form_field(f, :badge_bg, type: :colour, label_cols: 4, control_cols: 4, append: swatch.badge_bg) %>
                <%= form_field(f, :badge_text, type: :colour, label_cols: 4, control_cols: 4, append: swatch.badge_text) %>
                <%= form_field(f, :link_text, type: :colour, label_cols: 4, control_cols: 4, append: swatch.link_text) %>
                <%= form_field(f, :link_hover, type: :colour, label_cols: 4, control_cols: 4, append: swatch.link_hover) %>
                
              </div> <!-- end swatch card body -->
            </div> <!-- end swatch card -->

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%= link_to(swatch.persisted? ? 
              swatch : 
              swatches_path,
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>

              <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
                <%= yield(:button_text) %>
                <%== bs_icon('save') %>
              <% end %>
            </div> <!-- end card footer -->
          </div> <!-- end responsive columns -->
        </div> <!-- end row -->
      </div> <!-- end card body -->
    <% end %> <!-- end bootstrap_form_with -->
  </div> <!-- end card -->
</div> <!-- end container -->
