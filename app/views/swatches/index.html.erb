<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto">
  <!-- Tagable Resource Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="d-flex justify-content-between align-items-center">
        <!-- Header Text (Left) -->
        <div class="ms-2">
          <h5 class="mb-0"><%= t('.header') %></h5>
        </div>

        <!-- New Button (Right) -->
        <% if policy(Swatch.new()).new? %>
            <%= nav_button(action: :new, record: Swatch.new(), path: new_swatch_path) %>
        <% end %>
      </div> <!-- end of d-flex -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q do |f| %>
          <%= f.search_field :name_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.swatch.name") %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!--  -->
      <table id='swatches' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% @swatches.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
