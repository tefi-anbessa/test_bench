<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Swatch Header Card -->
  <div class="card mb-1" style="<%= container_styles(@swatch) %>"> <!-- Use container background colour for outer card -->
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@swatch).index? %>
              <%= link_to swatches_path,
                    class: "btn btn-sm btn-outline-info me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_swatch = @swatch.prev %>
            <% if prev_swatch.present? %>
              <% disabled = prev_swatch == @swatch %>
              <% title_text = t('actions.previous') + ": " + prev_swatch.label %>
              <%= link_to prev_swatch,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: title_text do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @swatch.label)%>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_swatch = @swatch.next %>
            <% if next_swatch.present? %>
              <% title_text = t('actions.next') + ": " + next_swatch.label %>
              <% disabled = next_swatch == @swatch %>
              <%= link_to next_swatch,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: title_text do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@swatch).edit? %>
                <%= link_to edit_swatch_path(@swatch),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@swatch).destroy? %>
                <%= link_to @swatch,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@swatch).new? %>
                <%= link_to new_swatch_path, 
                  class: "btn btn-outline-primary actions",
                  aria: { label: t('actions.new') },
                  title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="ms-1">
                    <%= [t('actions.new'), t('activerecord.models.swatch', count: 1)].join(' ') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Swatch Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @swatch.model_name.human) %></h4>
            </div>

            <div class="card-body p-3">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.name") %></div>
                <div class="col-8"><%= @swatch.name || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.bg") %></div>
                <div class="col-8" style="<%= container_styles(@swatch) %>"><%= @swatch.bg || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.text") %></div>
                <div class="col-8" style="<%= container_styles(@swatch) %>"><%= @swatch.text || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.form_bg") %></div>
                <div class="col-8" style="<%= form_styles(@swatch) %>"><%= @swatch.form_bg || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.form_field") %></div>
                <div class="col-8" style="<%= form_field_styles(@swatch) %>"><%= @swatch.form_field || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.card_bg") %></div>
                <div class="col-8" style="<%= card_styles(@swatch) %>"><%= @swatch.card_bg || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.card_header_bg") %></div>
                <div class="col-8" style="<%= card_header_styles(@swatch) %>"><%= @swatch.card_header_bg || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.card_border") %></div>
                <div class="col-8" style="background-color: #{@swatch.card_border}"><%= @swatch.card_border || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.badge_bg") %></div>
                <div class="col-8" style="<%= badge_styles(@swatch) %>"><%= @swatch.badge_bg || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.badge_text") %></div>
                <div class="col-8" style="<%= badge_styles(@swatch) %>"><%= @swatch.badge_text || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.link_text") %></div>
                <div class="col-8" style="<%= link_styles(@swatch) %>"><%= @swatch.link_text || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.link_hover") %></div>
                <div class="col-8" style="<%= link_hover_styles(@swatch) %>"><%= @swatch.link_hover || '-' %></div>
              </div> <!-- end row -->
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
