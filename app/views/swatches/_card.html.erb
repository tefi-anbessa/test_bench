<% resource = object %>
<%= render 'components/collapsible',
  id: "swatch_#{resource.id}_details",
  title: t("swatches.show.header", label: resource.name),
  expanded: false,
  header_class: 'py-1' do %>
  
    <div class="container-fluid">
      <div class="row mb-1">
        <% text = t("actions.jump_to", model: t("activerecord.models.swatch", count: 1)) %>
        <% if policy(resource).show? %>
          <%= link_to resource, 
            class: "btn btn-sm btn-outline-secondary me-2",
            title: text do %>
            <%== bs_icon('box-arrow-in-up-left') %>
            <span class="d-none d-md-inline"><%= text %></span>
          <% end %>
        <% end %>
      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.name") %></div>
        <div class="col-8"><%= resource.name || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.bg") %></div>
        <div class="col-8" style="<%= container_styles(resource) %>"><%= resource.bg || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.text") %></div>
        <div class="col-8" style="<%= container_styles(resource) %>"><%= resource.text || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.form_bg") %></div>
        <div class="col-8" style="<%= form_styles(resource) %>"><%= resource.form_bg || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.form_field") %></div>
        <div class="col-8" style="<%= form_field_styles(resource) %>"><%= resource.form_field || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.card_bg") %></div>
        <div class="col-8" style="<%= card_styles(resource) %>"><%= resource.card_bg || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.card_header_bg") %></div>
        <div class="col-8" style="<%= card_header_styles(resource) %>"><%= resource.card_header_bg || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.card_border") %></div>
        <div class="col-8" style="background-color: <%= resource.card_border %>"><%= resource.card_border || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.badge_bg") %></div>
        <div class="col-8" style="<%= badge_styles(resource) %>"><%= resource.badge_bg || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.badge_text") %></div>
        <div class="col-8" style="<%= badge_styles(resource) %>"><%= resource.badge_text || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.link_text") %></div>
        <div class="col-8" style="<%= link_styles(resource) %>"><%= resource.link_text || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.swatch.link_hover") %></div>
        <div class="col-8" style="<%= link_hover_styles(resource) %>"><%= resource.link_hover || '-' %></div>

      </div>
    </div> <!-- end container-fluid -->
<% end %>