<!-- Abstracted display of dropdown collapsible card for associated records on show view. -->
<!-- Expecting object and association variables. -->

<% if object.respond_to?(association) %>
<!-- Set label text to attribute translation, if it exists, otherwise model name translation. -->
<% associated = I18n.exists?("activerecord.attributes.#{object.model_name.i18n_key}.#{association}") ?
            t("activerecord.attributes.#{object.model_name.i18n_key}.#{association}") :
            t("activerecord.models.#{object.reflect_on_association(association).klass.model_name.i18n_key}.one") %>
  <% record = object.send(association) %>
  <% if record.present? %>
    <% partial = "#{record.model_name.collection}/card" %>
    <% if lookup_context.exists?(partial, [], true) %>
      <!-- Show a collapsible card for the associated object. -->
      <%= render partial, object: record, context: associated %>
    <% else %>
      <!-- No card available for this type, show a link to the object. -->
      <div class="col-4 text-muted">
        <%= object.class.human_attribute_name(association) %>
      </div>
      <% path = begin
        polymorphic_path([record])
      rescue NoMethodError, ActionController::UrlGenerationError
        '#'
      end %>
      <div class="col-8">
        <%= link_to path,
              class: "btn btn-sm btn-outline-info mb-2",
              title: t('show.linked', model: record.class.model_name.human) do %>
                <%== bs_icon('box-arrow-down-right') %>
                <span class="d-none d-md-inline"><%= t('show.linked', model: record.class.model_name.human) %></span>
            <% end %>
      </div>
    <% end %>
  <% else %>
    <!-- No record present, show unassigned -->
    <div class="col-4 text-muted">
      <%= t("activerecord.attributes.#{object.model_name.i18n_key}.#{association}") %>
    </div>
    <div class="col-8">
      <%= t('index.unassigned') %>
    </div>
  <% end %>
<% else %>
  <!-- Invalid association -->
  <div class="col-4 text-muted">
    <%= t("activerecord.attributes.#{object.model_name.i18n_key}.#{association}") %>
  </div>
  <div class="col-8">
    <%= t('show.invalid', model: association.to_s) %>
  </div>
<% end %>
