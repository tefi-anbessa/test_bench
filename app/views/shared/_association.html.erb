<!-- Expecting object_type, object_id, allowed_types and optional context to be passed in -->
<% if object_type.present? %>
  <% if allowed_types.include?(object_type) && object_type.safe_constantize%>
    <% type_name = object_type.constantize.model_name.human %>
    <% object = object_type.constantize.find_by(id: object_id) %>
    <div class="row mb-1">
    <% if object.present? %>
      <% partial = "#{object.model_name.collection}/card" %>
      <% if lookup_context.exists?(partial, [], true) %>
        <!-- Show a collapsible card for the associated object. -->
        <% context ||= type_name %>
        <%= render partial, object: object, context: context %>
      <% else %>
        <!-- No card available for this type, show a link to the object. -->
        <div class="col-4 text-muted">
          <%= context %>
        </div>
        <% path = begin
          polymorphic_path([object])
        rescue NoMethodError, ActionController::UrlGenerationError
          '#'
        end %>
        <div class="col-8">
          <%= link_to path,
                class: "btn btn-sm btn-outline-secondary mb-2",
                title: t('show.linked', model: type_name) do %>
                  <%== bs_icon('box-arrow-down-right') %>
                  <span class="d-none d-md-inline"><%= t('show.linked', model: type_name) %></span>
              <% end %>
        </div>
      <% end %>
    <% else %>
      <!-- Valid type but no valid object -->
      <div class="col-4 text-muted">
        <%= context %>
      </div>
      <% if object_id.present? %>
        <div class="col-8">
          <%= t('show.invalid', model: type_name) %>
        </div>
      <% else %>
        <div class="col-8">
          <%= t('show.unassigned', model: type_name) %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <!-- Invalid type -->
    <div class="col-12 text-muted">
      <%= t("index.invalid_type", type: object_type) %>
    </div>
  <% end %>
<% else %>
  <!-- No object type specified -->
  <div class="col-4 text-muted">
    <%= context %>
  </div>
  <div class="col-8">
    <%= t('index.unassigned') %>
  </div>
<% end %>
