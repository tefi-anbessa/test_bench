<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.project.code %></td>
  <% end %>
  <td><%= row.label || '-' %></td>  
  <td><%= row.title || '-' %></td>  
  <td><%= row.class.human_enum_name(:duration, row.duration) %></td>
  <td>
    <% perms = @permissions || permissions_for(row) %>
    <% if perms[:show] %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if perms[:edit] %>
      <%= nav_button(action: :edit, record: row, path: edit_change_management_request_path(row), icon_only: true) %>
    <% end %>
    <% if perms[:destroy] %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
