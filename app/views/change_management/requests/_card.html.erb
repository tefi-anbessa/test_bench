<!-- Request collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% request = object %>
<%= render 'components/collapsible',
  id: "#{id}_#{request.id}_details",
  title: [context, request.label].join(": "),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: request) %>
    <%= show_attribute(request, :serial, type: :integer) %>
    <%= show_attribute(request, :title) %>
    <%= show_attribute(request, :duration, type: :enum_translated) %>
    <%= show_attribute(request, :reason, type: :text) %>
    <%= show_attribute(request, :summary, type: :text) %>
  </div> <!-- end container-fluid -->
<% end %>