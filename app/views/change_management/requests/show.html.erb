<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Request Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@request).index? %>
              <%= nav_button(action: :index_project, path: project_change_management_requests_path(@project), record: @request) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Badge Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @request.label)%>
              </span>
              <!-- Add descriptor here if available -->
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm">
              <% if policy(@request).edit? %>
                <%= nav_button(action: :edit, path: edit_change_management_request_path(@request), record: @request) %>
              <% end %>
              
              <% if policy(@request).destroy? %>
                <%= nav_button(action: :delete, record: @request) %>
              <% end %>

              <% if policy(@request).new? %>
                <%= nav_button(action: :new, path: new_project_change_management_request_path(@project), record: @request) %>
              <% end %>
            </div> <!-- button group -->
          </div> <!-- d-flex align-items-center -->
        </div> <!-- right navigation and actions -->
      </div> <!-- row align-items-center -->
    </div> <!-- card header -->

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Request Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @request.model_name.human) %></h4>
            </div>

            <div class="card-body p-3">
              <%= show_attribute(@request, :serial, type: :integer) %>
              <%= show_attribute(@request, :title) %>
              <%= show_attribute(@request, :duration, type: :enum_translated) %>
              <%= show_attribute(@request, :reason, type: :text) %>
              <%= show_attribute(@request, :summary, type: :text) %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
