<% provide(:title, t('.title', tag: @demand.tag.nil? ? "No tag" : @demand.tag.full_tag )) %>
<%# Header with navigation buttons. %>
<nav class="navbar bg-body-tertiary">
  <div class="container">
    <ul class="navbar-nav flex-row page-heading">
    <% if policy(Demand).index? %>
        <li class="nav-item d-inline-flex p-1">
          <%= link_to demands_path,
                class: "icon-link btn btn-sm btn-secondary actions",
                title: t('actions.index') do %>
            <%== icon('list-columns-reverse') %>
            <%= t('actions.index') %>
          <% end %>
        </li>
      <% end %>
      <% if policy(Demand).edit? %>
        <li class="nav-item d-inline-flex p-1">
          <%= link_to edit_demand_path(@demand),
                class: "icon-link btn btn-sm btn-warning actions",
                title: t('actions.edit') do %>
                <%== icon('pencil') %>
                <%= t('actions.edit') %>
          <% end %>
        </li>
      <% end %>
      <% if policy(Demand).destroy? %>
        <li class="nav-item d-inline-flex p-1">
          <%= link_to @demand,
                method: :delete,
                class: "icon-link btn btn-sm btn-danger actions",
                title: t('actions.delete'),
                data: { confirm: "Are you sure? Delete cannot be undone." } do %>
            <%== icon('trash') %>
            <%= t('actions.delete') %>
          <% end %>
        </li>
      <% end %>

      <li class="nav-item d-inline-flex p-1">
        <%= link_to @demand.prev("id"),
              class: "icon-link btn btn-sm btn-secondary actions",
              title: t('actions.previous') do %>
          <%== icon('arrow-left') %>
          <%= t('actions.previous') %>
        <% end %>
      </li>

      <li class="nav-text h3 d-inline-flex p-1 ms-5 me-5">
        <%= t('.header', tag: @demand.tag.nil? ? "No tag" : @demand.tag.full_tag ) %>
      </li>

      <li class="nav-item d-inline-flex p-1">
        <%= link_to @demand.next("id"),
              class: "icon-link btn btn-sm btn-secondary actions",
              title: t('actions.next') do %>
          <%= t('actions.next') %>
          <%== icon('arrow-right') %>
        <% end %>
      </li>
    </ul>
  </div>
</nav>

<div class="container">
  <%= render @demand %>
</div>

<div class="container">
  <% unless @demand.demandable_type.blank? %>
    <nav class="navbar bg-body-tertiary">
      <div class="container">
        <ul class="navbar-nav flex-row">
          <% if policy(@demand.demandable).new? && @demand.demandable.nil? %>
            <li class="nav-item d-inline-flex p-1">
              <%= link_to eval("new_tag_#{@demand.demandable_type.tableize.singularize}_path(#{@demand.id})"),
                    class: "icon-link btn btn-sm btn-primary actions",
                    title: t('actions.new') do %>
                <%== icon('link-45deg') %>
                <%= "Link New #{@demand.demandable_type}" %>
              <% end %>
            </li>
          <% else %>
            <li class="nav-item d-inline-flex p-1">
              <%= link_to eval("#{@demand.demandable_type.tableize.singularize}_path(#{@demand.id})"),
                    class: "icon-link btn btn-sm btn-primary actions",
                    title: t('actions.new') do %>
                <%== icon('eye') %>
                <%= "Show #{@demand.demandable_type}" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </nav>
  <% end %>
</div>
