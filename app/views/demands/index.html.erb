<% provide(:title, t('.title')) %>
<nav class="navbar bg-body-tertiary">
  <div class="container">
    <ul class="navbar-nav me-auto mb-2 mb-lg-0 flex-row">
      
      <span class="nav-text ms-3 me-3 h2">
        <%= t('.header')%>
      </span>
    </ul>
  </div>
</nav>

  <div class = 'listing'>
    <%== pagy_bootstrap_nav(@pagy) %>
    <table id='demands' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
      <%= render 'demand_header' %>
      <tbody>
        <% unless @orphans.empty? %>
          <tr class="table-danger">
            <td colspan="13">
              <%= t('index.orphans', models: t("activerecord.models.demand").tableize) %>
            </td>
          </tr>
          <% @orphans.each do |demand| %>
            <%= render 'demand_row', d: demand %>
          <% end %>
        <% end %>
        <tr class="table-success">
          <td colspan="13">
            <%= t('.title') %>
          </td>
        </tr>
        <% @demands.each do |demand| %>
          <%= render 'demand_row', d: demand %>
        <% end %>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
    <%== pagy_info(@pagy) %>
  </div>
</div>
