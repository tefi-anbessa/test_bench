<% resource = object %>
<%= render 'components/collapsible',
  id: "#{project_change_requests}_#{resource.id}_details",
  title: t("project_change.requests.show.header", label: resource.label),
  expanded: false,
  header_class: 'py-1' do %>
  
    <div class="container-fluid">
      <div class="row mb-1">
        <% text = t("actions.jump_to", model: t("activerecord.models.project_change.request")) %>
        <%= link_to resource, 
            class: "btn btn-sm btn-outline-secondary me-2",
            title: text do %>
          <%== bs_icon('box-arrow-in-up-left') %>
          <span class="d-none d-md-inline"><%= text %></span>
        <% end %>
      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.models.project.one") %></div>
        <div class="col-8"><%= resource.project&.label || '-' %></div>
      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.project_change.request.serial") %></div>
        <div class="col-8"><%= resource.label || '-' %></div>
      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.project_change.request.title") %></div>
        <div class="col-8"><%= resource.title || '-' %></div>
      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.project_change.request.reason") %></div>
        <div class="col-8"><%= simple_format(resource.reason || '-') %></div>
      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.project_change.request.summary") %></div>
        <div class="col-8"><%= simple_format(resource.summary || '-') %></div>
      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.project_change.request.duration") %></div>
        <div class="col-8"><%= resource.class.human_enum_name(:duration, resource.duration) %></div>
      </div>
    </div> <!-- end container-fluid -->
<% end %>