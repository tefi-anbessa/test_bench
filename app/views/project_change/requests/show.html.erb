<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Request Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@request).index? %>
              <%= link_to project_project_change_requests_path(@project),
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_request = @request.prev %>
            <% if prev_request.present? %>
              <% disabled = prev_request == @request %>
              <% title_text = t('actions.previous') + ": " + prev_request.label %>
              <%= link_to prev_request,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: title_text do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Badge Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @request.label)%>
              </span>
              <!-- Add descriptor here if available -->
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_request = @request.next %>
            <% if next_request.present? %>
              <% title_text = t('actions.next') + ": " + next_request.label %>
              <% disabled = next_request == @request %>
              <%= link_to next_request,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: title_text do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@request).edit? %>
                <%= link_to edit_project_change_request_path(@request),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@request).destroy? %>
                <%= link_to @request,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@request).new? %>
                <%= link_to new_project_project_change_request_path(@project),
                  class: "btn btn-outline-primary actions",
                  aria: { label: t('actions.new') },
                  title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="ms-1">
                    <%= [t('actions.new'), t('activerecord.models.project_change/request.one')].join(' ') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Request Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @request.model_name.human) %></h4>
            </div>

            <div class="card-body p-3">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.models.project.one") %></div>
                <div class="col-8"><%= render "projects/card", object: @request.project %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.project_change/request.serial") %></div>
                <div class="col-8"><%= @request.label || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.project_change/request.title") %></div>
                <div class="col-8"><%= @request.title || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.project_change/request.duration") %></div>
                <div class="col-8"><%= @request.class.human_enum_name(:duration, @request.duration) %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.project_change/request.reason") %></div>
                <div class="col-8"><%= simple_format(@request.reason || '-') %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.project_change/request.summary") %></div>
                <div class="col-8"><%= simple_format(@request.summary || '-') %></div>
              </div> <!-- end row -->
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
