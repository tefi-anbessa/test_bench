<div class="container mt-3">
  <div class="card">
    <div class="card-header p-2">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
            <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: switchboard, 
          layout: :horizontal, 
          label_col: "col-sm-4", 
          control_col: "col-sm-8",
          wrapper_class: 'mb-1',
          ) do |f| %>

      <div class="card-body p-2">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Tag -->
            <div class="card mb-1">
              <% if tag.persisted? %>
                <%= render 'tags/tag_card', tag: tag %>
                <%= hidden_field_tag :tag_id, tag.id %>
              <% else %>
                <%= f.fields_for tag do |tag_f| %>
                  <%= render 'tags/form_nested', tag_f: tag_f, tag: tag %>
                <% end %>
              <% end %>
            </div>

            <!-- Switchboard Details -->
            <div class="card mb-1">
              <div class="card-header p-2">
                <h5><%= t('activerecord.models.switchboard') %></h5>
              </div>

              <div class="card-body p-2">
                <%= render 'shared/error_messages', object: f.object %>

                <div class="card p-2 mb-2" data-controller="ip-rating">
                  <div class="row">
                    <div class="col-4">
                      <%= f.text_field :ingress_protection,
                              class: 'form-control form-control-sm',
                              layout: :vertical,
                              prepend: 'IP',
                              data: { 'ip-rating-target': 'output' } %>
                    </div>
                    <div class="col-4">
                      <div class="row">
                      <%= select_tag :ip_1,
                        options_for_select(@ip_1.map { |k, v| ["#{v} - #{k.to_s.titleize}", v] }, 
                          switchboard.ingress_protection&.first),
                        {
                          class: 'form-select mb-0',
                          label_col: "col-sm-4",
                          control_col: "col-sm-3",
                          data: { 
                            action: 'change->ip-rating#update',
                            'ip-rating-target': 'firstDigit' 
                          } 
                        } %>
                      </div>
                      <div class="row">
                        <%= select_tag :ip_2,
                          options_for_select(@ip_2.map { |k, v| ["#{v} - #{k.to_s.titleize}", v] }, 
                            switchboard.ingress_protection&.last),
                            {
                              class: 'form-select mb-0',
                              label_col: "col-sm-2",
                              control_col: "col-sm-10",
                              data: { 
                                action: 'change->ip-rating#update',
                                'ip-rating-target': 'secondDigit' 
                              } 
                            } %>
                      </div>
                    </div>
                  </div>
                </div> <!-- end ip Card -->
                
                <%= f.select :voltage_rating,
                    options_for_select(
                      voltage_ratings.keys.map { |k| [k, k] },
                      selected: switchboard.voltage_rating
                    ),
                    { include_blank: true },
                    class: 'form-control form-control-sm',
                    label_col: "col-sm-4",
                    control_col: "col-sm-3" %>

                <%= f.number_field :busbar_rating,
                        class: 'form-control form-control-sm',
                        step: '1',
                        min: 0,
                        append: 'A',
                        label_col: "col-sm-4",
                        control_col: "col-sm-3",
                        wrapper: { class: 'mb-1' } %>

                <%= f.number_field :busbar_fault_rating,
                        class: 'form-control form-control-sm',
                        step: '100',
                        min: 0,
                        append: 'A',
                        label_col: "col-sm-4",
                        control_col: "col-sm-3",
                        wrapper: { class: 'mb-1' } %>

                <%= f.number_field :busbar_fault_duration,
                        class: 'form-control form-control-sm',
                        step: '.05',
                        min: 0,
                        append: 's',
                        label_col: "col-sm-4",
                        control_col: "col-sm-3",
                        wrapper: { class: 'mb-1' } %>

                <%= f.text_field :cable_entry,
                        class: 'form-control form-control-sm',
                        label_col: "col-sm-4",
                        control_col: "col-sm-3",
                        wrapper: { class: 'mb-1' } %>

                <%= f.text_area :incomer_protection,
                        class: 'form-control form-control-sm',
                        label_col: "col-sm-4",
                        control_col: "col-sm-8",
                        wrapper: { class: 'mb-1' } %>

                <%= f.text_area :metering,
                        class: 'form-control form-control-sm',
                        label_col: "col-sm-4",
                        control_col: "col-sm-8",
                        wrapper: { class: 'mb-1' } %>

                <%= f.text_area :neutral_bar_connections,
                        class: 'form-control form-control-sm',
                        label_col: "col-sm-4",
                        control_col: "col-sm-8",
                        wrapper: { class: 'mb-1' } %>

                <%= f.text_area :earth_bar_connections,
                        class: 'form-control form-control-sm',
                        label_col: "col-sm-4",
                        control_col: "col-sm-8",
                        wrapper: { class: 'mb-1' } %>

                <%= f.text_area :notes,
                        class: 'form-control form-control-sm',
                        label_col: "col-sm-4",
                        control_col: "col-sm-8",
                        wrapper: { class: 'mb-1' } %>

                <div class="row mb-1">
                  <label class="col-form-label col-sm-4" for="circuits">
                    <%= t('activerecord.models.circuit').pluralize %>
                  </label>
                  <div class="col-sm-8">
                    <%= number_field_tag :circuits,
                            class: 'form-control form-control-sm',
                            value: circuits %>
                  </div>
                </div>
              </div> <!-- end switchboard card body -->
            </div> <!-- end switchboard card -->

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%= link_to(switchboard, 
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== icon('x-square') %>
              <% end %>

              <%= f.button :submit, class: 'btn btn-primary' do %>
                <%= yield(:button_text) %>
                <%== icon('save') %>
              <% end %>
            </div> <!-- end card footer -->
          </div> <!-- end responsive columns -->
        </div> <!-- end row -->
      </div> <!-- end card body -->
    <% end %>
  </div> <!-- end card -->
</div> <!-- end container -->
