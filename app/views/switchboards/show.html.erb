<% content_for :title, [t('activerecord.models.switchboard'), 
  @switchboard.tag&.full_tag].join(' ') %>
<div class="container mt-3">
  <!-- Switchboard Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@switchboard).index? %>
              <%= link_to switchboards_path,
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: t('actions.index') do %>
                <%== icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_switchboard = @switchboard.prev %>
            <% if prev_switchboard.present? %>
              <% disabled = prev_switchboard == @switchboard %>
              <%= link_to switchboard_path(prev_switchboard),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_switchboard.tag&.full_tag}" do %>
                <%== icon('arrow-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge bg-primary fs-6">
                <%= [t('activerecord.models.switchboard'), 
                  @switchboard.tag&.full_tag].join(' ') %>
              </span>
              <% if @switchboard.tag&.service.present? %>
                <small class="text-muted ms-2"><%= @switchboard.tag.service %></small>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_switchboard = @switchboard.next %>
            <% if next_switchboard.present? %>
              <% disabled = next_switchboard == @switchboard %>
              <%= link_to switchboard_path(next_switchboard),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_switchboard.tag&.full_tag}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== icon('arrow-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@switchboard).edit? %>
                <%= link_to edit_switchboard_path(@switchboard),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@switchboard).destroy? %>
                <%= link_to @switchboard,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>


    <div class="d-flex flex-column justify-content-center">
      <div class="card-body">
      
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Tag Card -->
            <% if @switchboard.tag.present? %>
              <div class="row g-3 mb-3">
                  <%= render 'tags/tag_card', tag: @switchboard.tag %>
              </div>
            <% else %>
              <div class="row g-3 mb-3">
                <div class="alert alert-danger">
                  <%= t('index.no_tag') %>
                </div>
              </div>
            <% end %>
        
            <!-- Switchboard Details Card -->
            <div class="row">
              <div class="card mb-4">
                <div class="card-body p-3">
                  
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.ingress_protection') %></div>
                  <div class="col-8"><%= @switchboard.ingress_protection.present? ? 
                    ["IP", @switchboard.ingress_protection].join(' ') : '-' %></div>
                </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.voltage_rating') %></div>
                    <div class="col-8"><%= @switchboard.voltage_rating.present? ? 
                    @switchboard.voltage_rating : '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.busbar_rating') %></div>
                    <div class="col-8"><%= @switchboard.busbar_rating || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.busbar_fault_rating') %></div>
                    <div class="col-8"><%= @switchboard.busbar_fault_rating || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.busbar_fault_duration') %></div>
                    <div class="col-8"><%= @switchboard.busbar_fault_duration || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.cable_entry') %></div>
                    <div class="col-8"><%= @switchboard.cable_entry || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.incomer_protection') %></div>
                    <div class="col-8"><%= @switchboard.incomer_protection || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.metering') %></div>
                    <div class="col-8"><%= @switchboard.metering || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.neutral_bar_connections') %></div>
                    <div class="col-8"><%= @switchboard.neutral_bar_connections || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.earth_bar_connections') %></div>
                    <div class="col-8"><%= @switchboard.earth_bar_connections || '-' %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.switchboard.circuits') %></div>
                    <div class="col-8"><%= @switchboard.circuits.count || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted">
                      <% text = t('activerecord.attributes.switchboard.circuits') %>
                      <%= link_to switchboard_circuits_path(@switchboard),
                        class: "btn btn-sm btn-outline-secondary",
                        title: text do %>
                          <%= text %>
                          <%== icon('box-arrow-in-down-right') %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
