<div id="<%= dom_id switchboard %>">
  <p>
    <strong>Location:</strong>
    <%= switchboard.location %>
  </p>

  <p>
    <strong>Service:</strong>
    <%= switchboard.service %>
  </p>

  <p>
    <strong>Ingress protection:</strong>
    <%= switchboard.ingress_protection %>
  </p>

  <p>
    <strong>Busbar rating:</strong>
    <%= switchboard.busbar_rating %>
  </p>

  <p>
    <strong>Busbar fault rating:</strong>
    <%= switchboard.busbar_fault_rating %>
  </p>

  <p>
    <strong>Busbar fault duration:</strong>
    <%= switchboard.busbar_fault_duration %>
  </p>

  <p>
    <strong>Cable entry:</strong>
    <%= switchboard.cable_entry %>
  </p>

  <p>
    <strong>Incomer protection:</strong>
    <%= switchboard.incomer_protection %>
  </p>

  <p>
    <strong>Incomer metering:</strong>
    <%= switchboard.metering %>
  </p>

  <p>
    <strong>Neutral bar connections:</strong>
    <%= switchboard.neutral_bar_connections %>
  </p>

  <p>
    <strong>Earth bar connections:</strong>
    <%= switchboard.earth_bar_connections %>
  </p>

</div>
