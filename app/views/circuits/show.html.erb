<% content_for :title, t('.title', label: @circuit.label) %>
<div class="container mt-3">
  <!-- Circuit Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@circuit).index? %>
              <%= link_to switchboard_circuits_path(@circuit.switchboard),
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: t('actions.index') do %>
                <%== icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_circuit = @circuit.prev %>
            <% if prev_circuit.present? %>
              <% disabled = prev_circuit == @circuit %>
              <%= link_to circuit_path(prev_circuit),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_circuit.label}" do %>
                <%== icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge bg-primary fs-6">
                <%= t('.header', label: @circuit.label) %>
              </span>
              <% if @circuit.demand&.tag&.service.present? %>
                <small class="text-muted ms-2"><%= @circuit.demand.tag.service %></small>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_circuit = @circuit.next %>
            <% if next_circuit.present? %>
              <% disabled = next_circuit == @circuit %>
              <%= link_to circuit_path(next_circuit),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_circuit.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@circuit).edit? %>
                <%= link_to edit_circuit_path(@circuit),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@circuit).destroy? %>
                <%= link_to @circuit,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column justify-content-center">
      <div class="card-body">
      
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Switchboard Card -->
            <% if @circuit.switchboard.tag.present? %>
              <div class="row g-3 mb-3">
                  <%= render 'switchboards/switchboard', switchboard: @circuit.switchboard %>
              </div>
            <% else %>
              <div class="row g-3 mb-3">
                <div class="alert alert-danger">
                  <%= t('index.no_tag') %>
                </div>
              </div>
            <% end %>
        
            <!-- Circuit Details Card -->
            <div class="row">
              <div class="card mb-4">
                <div class="card-body p-3">
                  
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.attributes.circuit.label') %></div>
                  <div class="col-8"><%= @circuit.label.presence || '-' %></div>
                </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.circuit.phase') %></div>
                    <div class="col-8"><%= @circuit.phase.presence || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.circuit.device') %></div>
                    <div class="col-8"><%= @circuit.device.presence || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.circuit.poles') %></div>
                    <div class="col-8"><%= @circuit.poles.presence || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.circuit.curve') %></div>
                    <div class="col-8"><%= @circuit.curve.presence || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.circuit.rating') %></div>
                    <div class="col-8"><%= @circuit.rating.presence || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.circuit.elcb') %></div>
                    <div class="col-8"><%= @circuit.elcb.presence || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.circuit.contactor') %></div>
                    <div class="col-8"><%= @circuit.contactor.presence || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.circuit.notes') %></div>
                    <div class="col-8"><%= @circuit.notes.presence || '-' %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
