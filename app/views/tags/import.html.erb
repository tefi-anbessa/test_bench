<% provide(:title, t(".title")) %>
<%= render "import/upload_form",
      header: (@discipline.present? ? t(".header_discipline", discipline: @discipline.long_label) : t(".header_project", project: @project.label)),
      url: (@discipline.present? ? import_discipline_tags_path(@discipline) : import_project_tags_path(@project)),
      cancel_url: (@discipline.present? ? discipline_tags_path(@discipline) : project_tags_path(@project)) %>
