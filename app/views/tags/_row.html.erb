<tr scope="row">
  <% unless @project.present? %>
    <td><%= row.project.label %></td>
  <% end %>
  <td><%= row.stage %></td>
  <td><%= row.long_label %></td>
  <td>
    <span title="<%= row.notes %>">
      <%= truncate(strip_tags(row.notes.to_s), length: 20) %>
    </span>
  </td>
  <td><%= row.service %></td>
  <td><%= row.location %></td>
  <td><%= row.parent.present? ? index_link(action: :show_tag, record: row.parent) : "-" %></td>
  <td><%= @children_counts ? @children_counts.fetch(row.id, 0) : row.children.count %></td>
  <td>
    <%= render "tags/tagable_link", row: row, view: "index" %>
  </td>
  <td>
    <% perms = @permissions&.[](row.discipline_id) || { show: policy(row).show?, edit: policy(row).edit?, destroy: policy(row).destroy? } %>
    <% if perms[:show] %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if perms[:edit] %>
      <%= nav_button(action: :edit, record: row, path: edit_tag_path(row), icon_only: true) %>
    <% end %>
    <% if perms[:destroy] %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
