<tr scope="row">
  <% unless @project.present? %>
    <td><%= t.project.label %></td>
  <% end %>
  <td><%= t.stage %></td>
  <td><%= t.long_label %></td>
  <td>
    <span title="<%= t.notes %>">
      <%= truncate(strip_tags(t.notes.to_s), length: 20) %>
    </span>
  </td>
  <td><%= t.service %></td>
  <td><%= t.location %></td>
  <td><%= t.parent.present? ? link_to(t.parent.long_label, t.parent) : "-" %></td>
  <td><%= t.children.count %></td>
  <td>
    <%= render "tags/tagable_link", t: t, view: "index" %>
  </td>
  <td>
    <% if policy(t).show? %>
      <%= link_to t, class: "btn btn-outline-info btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(t).edit? %>
      <%= link_to edit_tag_path(t), class: "btn btn-outline-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline"  do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(t).destroy? %>
    <%= link_to t, 
          data: { method: :delete, confirm: t('actions.delete_sure') },
          class: "btn btn-outline-danger btn-sm icon-link",
          aria: { label: t('actions.delete') },
          title: t('actions.delete'),
          display: "inline"  do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>
