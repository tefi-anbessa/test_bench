<tr scope="row">
  <% unless @project.present? %>
    <td><%= t.project.label %></td>
  <% end %>
  <td><%= t.stage %></td>
  <td><%= t.discipline.label %></td>
  <td><%= t.full_tag %></td>
  <td><%= t.service %></td>
  <td><%= t.location %></td>
  <td><%= t.notes %></td>
  <td>
    <% if t.tagable_type.present? && Tag.tagable_types.include?(t.tagable_type)%>
      <% text = t.tagable_type.constantize.model_name.human %>
      <% if t.tagable.present? %>
        <%= link_to t.tagable,
            class: "btn btn-sm btn-outline-info mb-2 icon-link",
            title: t('show.linked', model: t.tagable_type.constantize.model_name.human) do %>
              <%== bs_icon('box-arrow-down-right') %>
              <%= text %>
            <% end %>
      <% else %>
        <% if policy(t.build_tagable()).new? %>
          <% resource = t.tagable_type.constantize.model_name.singular %>
          <%= link_to eval("new_tag_#{resource}_path(#{t.id})"),
              class: "btn btn-sm btn-outline-primary mb-2 icon-link",
              title: t('actions.link', resource: resource) do %>
                <%== bs_icon('link') %>
              <%= text %>
              <% end %>
        <% else %>
          <%= t.tagable_type.constantize.model_name.human %>
        <% end %>
      <% end %>
    <% else %>
      <span class="text-muted">
        <%= t.tagable_type.nil? ? 
          t('index.unassigned') :
          t('index.invalid') %>
      </span>
    <% end %>
  </td>
  <td>
    <% if policy(t).show? %>
      <%= link_to t, class: "btn btn-outline-info btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(t).edit? %>
      <%= link_to edit_tag_path(t), class: "btn btn-outline-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline"  do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(t).destroy? %>
    <%= link_to t, 
          data: { method: :delete, confirm: t('actions.delete_sure') },
          class: "btn btn-outline-danger btn-sm icon-link",
          aria: { label: t('actions.delete') },
          title: t('actions.delete'),
          display: "inline"  do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>
