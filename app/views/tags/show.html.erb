<% content_for :title, "#{t('activerecord.models.tag') + ' ' + @tag.full_tag}" %>
<div class="container mt-3 themed" style="<%= swatch_variables(@swatch) %>">
  <!-- Tag Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <%= link_to tags_path,
                  class: "btn btn-sm btn-outline-secondary me-2",
                  title: t('actions.index') do %>
              <%== bs_icon('list-columns-reverse') %>
              <span class="d-none d-md-inline"><%= t('actions.index') %></span>
            <% end %>

            <!-- Previous Button -->
            <% prev_tag = @tag.prev %>
            <% if prev_tag.present? %>
              <% disabled = prev_tag == @tag %>
              <%= link_to tag_path(prev_tag),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary
                      #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_tag.full_tag}" do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6">
                <%= [t('activerecord.models.tag'), @tag.full_tag].join(': ') %>
              </span>
              <% if @tag.service.present? %>
                <small class="text-muted ms-2"><%= @tag.service %></small>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_tag = @tag.next %>
            <% if next_tag.present? %>
              <% disabled = next_tag == @tag %>
              <%= link_to tag_path(next_tag),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary
                      me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_tag.full_tag}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@tag).edit? %>
                <%= link_to edit_tag_path(@tag),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>
              <% if policy(@tag).destroy? %>
                <%= link_to @tag,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@tag).new? %>
                <%= link_to new_tag_path, 
                  class: "btn btn-outline-primary actions",
                  aria: { label: t('actions.new') },
                  title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="ms-1">
                    <%= [t('actions.new'), t('activerecord.models.tag')].join(' ') %>
                  </span>
                <% end %>
              <% end %>
            </div> <!-- button group -->
          </div> <!-- d-flex align-items-center -->
        </div> <!-- right navigation and actions -->
      </div> <!-- row align-items-center -->
    </div> <!-- card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-sm-12 col-10 col-md-8 col-lg-6 col-xl-4">

          <!-- Project collapsible card -->
          <div class="row mb-1">
            <%= render 'projects/card', object: @tag.project %>
          </div>

          <!-- Project stage -->
          <div class="row mb-1">
            <div class="col-4"><%= t('activerecord.attributes.tag.stage') %></div>
            <div class="col-8"><%= @tag.stage %></div>
          </div>

          <!-- Discipline Info -->
          <div class="row mb-1">
            <div class="col-4 text-muted"><%= t('activerecord.models.discipline') %></div>
            <div class="col-8"><%= [@tag.discipline.label, " - ", @tag.discipline.name].join %></div>
          </div>

          <!-- Tag Details -->
          <div class="row mb-1">
            <div class="col-4 text-muted"><%= t('activerecord.attributes.tag.full_tag') %></div>
            <div class="col-8"><%= @tag.full_tag %></div>
          </div>

          <!-- Prefix -->        
          <div class="row mb-1">
            <div class="col-4 text-muted"><%= t('activerecord.attributes.tag.prefix') %></div>
            <div class="col-8"><%= @tag.prefix %></div>
          </div>

          <!-- Serial -->
          <div class="row mb-1">
            <div class="col-4 text-muted"><%= t('activerecord.attributes.tag.serial') %></div>
            <div class="col-8"><%= @tag.serial.to_s.rjust(4, '0') %></div>
          </div>
          
          <!-- Suffix -->
          <div class="row mb-1">
            <div class="col-4 text-muted"><%= t('activerecord.attributes.tag.suffix') %></div>
            <div class="col-8"><%= @tag.suffix %></div>
          </div>
          
          <!-- Service -->
          <div class="row mb-1">
            <div class="col-4 text-muted"><%= t('activerecord.attributes.tag.service') %></div>
            <div class="col-8"><%= @tag.service %></div>
          </div>
          
          <!-- Location -->
          <div class="row mb-1">
            <div class="col-4 text-muted"><%= t('activerecord.attributes.tag.location') %></div>
            <div class="col-8"><%= @tag.location %></div>
          </div>
          
          <!-- Notes -->
          <div class="row mb-1">
            <div class="col-4 text-muted"><%= t('activerecord.attributes.tag.notes') %></div>
            <div class="col-8"><%= @tag.notes %></div>
          </div>

          <!-- Tagable Section -->
          <% if (@tag.tagable.present? rescue false) %>
            <% partial = "#{@tag.tagable.class.model_name.plural}/card" %>
            <% if lookup_context.exists?(partial, [], true) %>
              <!-- Show a collapsible card for tagable. -->
              <div class="row g-3 mb-1">
                <%= render partial, object: @tag.tagable %>
              </div>
            <% else %>
              <!-- Show a link to tagable. -->
              <div class="row mb-1">
                <div class="col-4 text-muted">
                  <%= t('activerecord.attributes.tag.tagable_type') %>
                </div>
                <div class="col-8">
                  <% text = @tag.tagable.class.model_name.human %>
                  <%= link_to @tag.tagable,
                        class: "btn btn-sm btn-outline-secondary mb-2",
                        title: t('show.linked', model: text) do %>
                          <%== bs_icon('box-arrow-down-right') %>
                          <span class="d-none d-md-inline"><%= t('show.linked', model: text) %></span>
                      <% end %>
                </div>
              </div>
            <% end %>
          <% else %> <!-- valid tagable not present -->
            <div class="row mb-1">
              <div class="col-4 text-muted">
                <%= t('activerecord.attributes.tag.tagable_type') %>
              </div>
              <div class="col-8">
                <% if @tag.tagable_type.present? %>
                  <% if Tag.tagable_types.include?(@tag.tagable_type) %>
                    <% text = @tag.tagable_type.constantize.model_name.name.sub('::', ' ') %>
                    <% if policy(@tag.tagable_type.constantize).new? %>
                      <!-- Setup a link to create the tagable. -->
                      <% resource = @tag.tagable_type.constantize.model_name.singular %>
                      <%= link_to eval("new_tag_#{resource}_path(#{@tag.id})"),
                            class: "btn btn-sm btn-outline-primary mb-2",
                            title: t('actions.link', resource: text) do %>
                              <%== bs_icon('link') %>
                              <span class="d-none d-md-inline">
                                <%= t('actions.link', resource: text) %>
                              </span>
                            <% end %>
                    <% else %>        <!-- policy: no permission -->
                      <span class="text-muted">
                        <%= text %>
                      </span>
                    <% end %>         <!-- policy -->
                  <% else %>        <!-- invalid tagable_type -->
                    <span class="text-muted">
                      <%= t("activerecord.errors.models.tagable_type.invalid", tagable_type: @tag.tagable_type) %>
                    </span>
                  <% end %>         <!-- valid tagable_type -->
                <% else %>          <!-- tagable_type not present? -->
                  <span class="text-muted">
                    <%= t('show.unassigned', model: t("activerecord.attributes.tag.tagable_type")) %>
                  </span>
                <% end %>           <!-- tagable_type.present? -->
              </div> <!-- col -->
            </div> <!-- row -->
          <% end %>         <!-- tagable.present? -->
        </div> <!-- responsive columns -->
      </div> <!-- row -->
    </div> <!-- card body -->
  </div> <!-- card -->
</div> <!-- container -->
