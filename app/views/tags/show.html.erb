
<% provide(:title, t('.title', tag: @tag.full_tag)) %>
<%# Header with navigation buttons. %>
<nav class="navbar bg-body-tertiary">
  <div class="container">
    <ul class="navbar-nav flex-row page-heading">
      <li class="nav-item d-inline-flex p-1">
        <% if policy(@tag).index? %>
          <%= link_to tags_path,
                class: "icon-link btn btn-sm btn-secondary actions",
                title: t('actions.index') do %>
            <%== icon('list-columns-reverse') %>
            <%= t('actions.index') %>
          <% end %>
        </li>
      <% end %>
      <!-- Admin section -->
      <% if policy(@tag).edit? %>
        <li class="nav-item d-inline-flex p-1">
          <%= link_to edit_tag_path(@tag),
                class: "icon-link btn btn-sm btn-warning actions",
                title: t('actions.edit') do %>
                <%== icon('pencil') %>
                <%= t('actions.edit') %>
          <% end %>
        </li>
      <% end %>
      <% if policy(@tag).destroy? %>
        <li class="nav-item d-inline-flex p-1">
          <%= link_to @tag,
                method: :delete,
                class: "icon-link btn btn-sm btn-danger actions",
                title: t('actions.delete'),
                data: { confirm: "Are you sure? Delete cannot be undone." } do %>
            <%== icon('trash') %>
            <%= t('actions.delete') %>
          <% end %>
        </li>
      <% end %>

      <li class="nav-item d-inline-flex p-1">
        <%= link_to @tag.prev("id"),
              class: "icon-link btn btn-sm btn-secondary actions",
              title: t('actions.previous') do %>
          <%== icon('arrow-left') %>
          <%= t('actions.previous') %>
        <% end %>
      </li>

      <li class="nav-text h3 d-inline-flex p-1 ms-5 me-5">
        <%= t('.header', tag: @tag.full_tag) %>
      </li>

      <li class="nav-item d-inline-flex p-1">
        <%= link_to @tag.next("id"),
              class: "icon-link btn btn-sm btn-secondary actions",
              title: t('actions.next') do %>
          <%= t('actions.next') %>
          <%== icon('arrow-right') %>
        <% end %>
      </li>
    </ul>
  </div>
</nav>

<%= render @tag %>

<% unless @tag.tagable_type.blank? %>
  <nav class="navbar bg-body-tertiary">
    <div class="container">
      <ul class="navbar-nav flex-row">
        <% if @tag.tagable_id.nil? %>
          <li class="nav-item d-inline-flex p-1">
            <%= link_to eval("new_tag_#{@tag.tagable_type.tableize.singularize}_path(#{@tag.id})"),
                  class: "icon-link btn btn-sm btn-primary actions",
                  title: t('actions.new') do %>
              <%== icon('link-45deg') %>
              <%= "Link New #{@tag.tagable_type}" %>
            <% end %>
          </li>
        <% else %>
          <li class="nav-item d-inline-flex p-1">
            <%= link_to eval("#{@tag.tagable_type.tableize.singularize}_path(#{@tag.tagable_id})"),
                  class: "icon-link btn btn-sm btn-secondary actions",
                  title: t('actions.show') do %>
              <%== icon('eye') %>
              <%= "Show #{@tag.tagable_type}" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </nav>
<% end %>
