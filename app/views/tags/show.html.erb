<% content_for :title, t('.title') %>
<div class="container mt-3 themed" style="<%= swatch_variables(@swatch) %>">
  <!-- Tag Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Buttons -->
            <% if policy(Tag).index? %>
              <%= nav_button(action: :index_project, path: project_tags_path(@discipline.project), record: @tag) %>
              <%= nav_button(action: :index_discipline, path: discipline_tags_path(@discipline), record: @tag) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6">
                <%= t('.header', label: [@tag.long_label, @tag.service].compact.join(' - ')) %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm">
              <% if policy(@tag).edit? %>
                <%= nav_button(action: :edit, path: edit_tag_path(@tag), record: @tag) %>
              <% end %>
              
              <% if policy(@tag).destroy? %>
                <%= nav_button(action: :delete, record: @tag) %>
              <% end %>

              <% if policy(@tag).new? %>
                <%= nav_button(action: :new, path: new_discipline_tag_path(@discipline), record: @tag) %>
              <% end %>
            </div> <!-- button group -->
          </div> <!-- d-flex align-items-center -->
        </div> <!-- right navigation and actions -->
      </div> <!-- row align-items-center -->
    </div> <!-- card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-sm-12 col-10 col-md-8 col-lg-6 col-xl-6">

          <!-- Inner Card -->
          <!-- Resource Details -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: t("activerecord.models.tag.one")) %></h4>
            </div>
            <div class="card-body">
              <% parts = @tag.prefix_parts %>
              <% if parts = @tag.prefix_parts %>
                <%= render partial: "prefix", locals: { tag: @tag, parts: parts } %>
              <% else %>
                <%= show_attribute(@tag, :prefix) %>
              <% end %>
              <% if @tag.discipline.isa51_type_schema? %>
                <%= show_attribute(@tag, :loop_id) %>
              <% else %>
                <%= show_attribute(@tag, :serial) %>
              <% end %>
              <%= show_attribute(@tag, :suffix) %>
              <%= show_attribute(@tag, :notes, type: :text) %>
              <%= show_attribute(@tag, :stage) %>
              <%= show_attribute(@tag, :location) %>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: t("activerecord.models.tag.one")) %></h4>
            </div>

            <div class="card-body p-3">

              <!-- Project collapsible card -->
              <%= show_association(@tag, :project) %>

              <!-- Discipline card -->
              <%= show_association(@tag, :discipline) %>

              <!-- Tagable Section -->
              <% if (@tag.tagable.present? rescue false) %>
                <%= show_association(@tag, :tagable, header: :model) %>
              <% else %> 
                <% if @tag.tagable_type.present? %>
                  <% if Tag.safe_tagable_types.include?(@tag.tagable_type) %>
                    <% text = @tag.tagable_type.constantize.model_name.human %>
                    <% if policy(@tag.build_tagable()).new? %>
                      <!-- Setup a link to create the tagable. -->
                      <% resource = @tag.tagable_type.constantize.model_name.singular %>
                      <%= nav_button(action: :link, path: eval("new_tag_tagable_path(#{@tag.id}, tagable_type: @tag.tagable_type)"), record: @tag.build_tagable()) %>
                    <% else %>        <!-- policy: no permission -->
                      <%= show_attribute(@tag, :tagable_type) %>
                    <% end %>         <!-- policy -->
                  <% else %>        <!-- invalid tagable_type -->
                    <span class="">
                      <%= t("activerecord.errors.models.tag.attributes.tagable_type.invalid", tagable_type: @tag.tagable_type) %>
                    </span>
                  <% end %>         <!-- valid tagable_type -->
                <% else %>          <!-- tagable_type not present? -->
                  <span class="">
                    <%= t('show.unassigned', model: t("activerecord.attributes.tag.tagable_type")) %>
                  </span>
                <% end %>           <!-- tagable_type.present? -->
              <% end %>         <!-- tagable.present? -->

              <!-- Parent card -->
              <%= show_association(@tag, :parent) %>

              <!-- Children card -->
              <div class="row mb-1">
                <%= render 'shared/children', parent: @tag, association: :children %>
              </div>

              <!-- Loop elements card for isa51 type schemas -->
              <% if @tag.discipline.isa51_type_schema? %>
                <div class="row mb-1">
                  <%= render 'shared/children', parent: @tag, association: :loop_elements %>
                </div>
              <% end %>
            </div> <!-- inner card body -->
          </div> <!-- inner card -->
        </div> <!-- responsive columns -->
      </div> <!-- row -->
    </div> <!-- card body -->
  </div> <!-- card -->
</div> <!-- container -->
