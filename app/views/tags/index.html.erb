<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch)%>">
  <!-- Tag list header -->
  <div class="card mb-1" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-1" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <!-- Discipline or project link -->
        <div class="col-2">
          <% if @discipline.present? %>
            <%= link_to discipline_path(@discipline), class: "btn btn-sm btn-outline-info" do %>
              <%= @discipline.name %>
              <%= bs_icon('collection', class: "me-1") %>
            <% end %>
          <% elsif current_project.present? %>
            <%= link_to project_path(current_project), class: "btn btn-sm btn-outline-info" do %>
              <%= current_project.label %>
              <%= bs_icon('layers', class: "me-1") %>
            <% end %>
          <% end %>
        </div>

        <!-- Header Text (Left - 8 columns) -->
        <div class="col-8">
          <% scope_text = @discipline.present? ? 
          [@discipline.class.model_name.human, @discipline.long_label].join(': ') : 
          current_project.present? ? 
          [current_project.class.model_name.human, current_project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project.other')) %>
          <h5><%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 align-content-end">
          <% if @discipline.present? && policy(@discipline.tags.build()).new? %>
              <%= link_to new_discipline_tag_path(@discipline),
                class: "btn btn-sm btn-outline-primary actions",
                aria: { label: t('actions.new') },
                title: t('actions.new') do %>
                <%== bs_icon('plus-square-fill') %>
                <span class="ms-1"><%= [t('actions.new'), t('activerecord.models.tag.one')].join(' ') %></span>
              <% end %>
          <% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->
    
    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: discipline_tags_path(@discipline) do |f| %>
          <%= f.search_field :prefix_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.tag.prefix') %>
          <%= f.search_field :serial_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.tag.serial') %>
          <%= f.search_field :service_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.tag.service') %>
          <%= f.search_field :location_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.tag.location') %>
          <%= f.search_field :notes_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.tag.notes') %>
          <%= f.button nil, class: "btn btn-primary btn-sm", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div> <!-- search form class -->

      <!-- Broken and incomplete tags go here -->
      <!-- Tags -->
      <table id='tags' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% unless @orphans.nil? || @orphans&.empty? %>
            <tr class="table-danger">
              <td colspan="<%= 9 + (current_project ? 1 : 0) %>">
                <%= t('index.orphans', models: t("activerecord.models.tag", count: @orphans&.count)) %>
              </td>
            </tr>
            <% @orphans.each do |row| %>
              <%= render 'row', row: row %>
            <% end %>
            <tr class="table-success">
              <td colspan="<%= 9 + (current_project ? 1 : 0) %>">
                <%= t('.title') %>
              </td>
            </tr>
          <% end %>
          <% @tags.each do |t| %>
            <%= render 'row', t: t %>
          <% end %>
        </tbody>
      </table>
    </div> <!-- end of card body -->
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div> <!-- end of car footer -->
  </div> <!-- end of card -->
</div> <!-- end of container -->
