<div class="card" style="<%= card_styles(@swatch) %>" data-controller="tag"
     data-tag-model-name-value="<%= t('activerecord.models.tag') %>">
  <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
    <!-- Left Tag Header -->
    <div class="col text-left">
      <div class="d-flex flex-column align-items-left">
        <div class="mt-1">
          <%= tag.persisted? ? t('actions.edit') : t('actions.new') %>
          <span data-tag-target="preview">
            <% if tag.persisted? %>
              <%= [t('activerecord.models.tag'), tag.full_tag].join(': ') %>
            <% else %>
              <%= t('activerecord.models.tag') %>
            <% end %>
          </span>
          <% if tag.persisted? && tag.service.present? %>
            <small class="text-muted ms-2"><%= tag.service %></small>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
    <%= render 'shared/error_messages', object: tag %>

      <!-- Stage -->
      <div class="row">
        <%= tag_f.number_field :stage,
        label_col: "col-sm-3",
        control_col: "col-sm-3",
              min: 0,
              max: 10,
              title: t('activerecord.help.tag.stage') %>
      </div>

      <!-- Discipline -->
      <div class="row">
        <%= tag_f.select :discipline_id,
              options_for_select(
                  @disciplines.map { |label, name, id|
                    translated_label = t("discipline.label.#{label}", default: label)
                    translated_name = t("discipline.name.#{name}", default: name)
                    ["#{translated_label}: #{translated_name}", id]
                  },
                tag.discipline_id
              ),
              { class: 'form-select' },
              { data: { action: 'change->tag#updateFormStructure' } } %>
      </div>

      <!-- Prefix Fields - Dynamic based on discipline schema -->
      <%= render 'tags/prefix_fields', tag: tag, f: tag_f %>

      <!-- Full tag preview -->
      <%= hidden_field_tag :full_tag, id: 'tag_full_tag_preview' %>

      <!-- Serial and Suffix -->
      <div class="row">
        <%= tag_f.text_field :serial,
        label_col: "col-sm-3",
        control_col: "col-sm-3",
              title: t('activerecord.help.tag.serial'),
              pattern: '\d*',
              inputmode: 'numeric',
              value: tag.serial.present? ? tag.serial.to_s.rjust(4, '0') : '0000',
              data: {
                action: 'change->tag#updatePreview input->tag#updatePreview'
              },
              id: 'tag_serial' %>
        <%= tag_f.text_field :suffix,
        label_col: "col-sm-3",
        control_col: "col-sm-3",
              title: t('activerecord.help.tag.suffix'),
              data: { action: 'change->tag#updatePreview input->tag#updatePreview' },
              id: 'tag_suffix' %>
      </div>

      <div class="row">
        <%= tag_f.text_field :service,
          label_col: "col-sm-3",
          control_col: "col-sm-9",
                title: t('activerecord.help.tag.service'),
                required: true %>
      </div>

      <div class="row">
        <%= tag_f.text_field :location,
                label_col: "col-sm-3",
                control_col: "col-sm-9",
                title: t('activerecord.help.tag.location') %>
      </div>

      <!-- Notes -->
      <div class="row">
        <%= tag_f.text_area :notes,
                label_col: "col-sm-3",
                control_col: "col-sm-9",
                rows: 3,
                placeholder: t('activerecord.help.tag.notes') %>
      </div>

      <!-- Tagable Type -->
      <div class="row">
        <%= tag_f.select :tagable_type,
              Tag.tagable_types,
              { include_blank: t("form.none") },
              { class: 'form-select' } %>
      </div>
  </div>

  <!-- Tag preview is now handled by the Stimulus controller -->
</div>
