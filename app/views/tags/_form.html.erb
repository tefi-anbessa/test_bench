<!-- Expects tag, discipline, schema and parts variables. -->
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <!-- Center Form Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
            <span class="badge fs-6">
              <%= yield(:header) %>
              <% if tag.persisted? && tag.service.present? %>
                <%= tag.service %>
              <% end %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: tag,
      url: tag.persisted? ? tag : discipline_tags_path(tag.discipline),
      layout: :horizontal,
      label_col: "col-sm-4",
      control_col: "col-sm-8"
      ) do |f| %>

      <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
      <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Stage -->
            <%= form_field(f, :stage, type: :number, label_cols: 3, control_cols: 3, min: 0, max: 10) %>

            <!-- Prefix Fields - Dynamic based on discipline schema -->
            <%= render 'tags/prefix_fields', tag: tag, form: f, schema: schema, parts: parts %>

            <!-- Serial and Suffix -->
            <%= form_field(f, :serial, type: :string, label_cols: 3, control_cols: 3, 
                  min: 0, pattern: '\d*', inputmode: 'numeric', data: { action: 'tag#updatePreview' },
                  value: tag.serial.present? ? tag.serial.to_s.rjust(4, '0') : '0000', id: 'tag_serial') %>
            <%= form_field(f, :suffix, label_cols: 3, control_cols: 3, data: { action: 'tag#updatePreview' },
                  id: 'tag_suffix' ) %>
            <%= form_field(f, :service, label_cols: 3, control_cols: 9) %>
            <%= form_field(f, :location, label_cols: 3, control_cols: 9) %>
            <%= form_field(f, :notes, type: :text, label_cols: 3, control_cols: 9) %>

            <!-- Parent Tag -->
            <div class="row">
              <%= f.collection_select :parent_id, parents, :id, :full_tag,
                    { include_blank: t("form.none") },
                    { class: 'form-select' } %>
            </div>

            <!-- Tagable Type -->
            <div class="row">
              <%= f.select :tagable_type, 
                options_for_select(Tag.safe_tagable_types.map { |type| [type.safe_constantize.model_name.human, type] }, 
                  tag.tagable_type),
                    { include_blank: t("form.none") },
                    { class: 'form-select' } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Footer with Actions -->
      <div class="card-footer bg-transparent text-end p-2">
        <%= link_to(tag.persisted? ? tag_path(tag) : discipline_tags_path(discipline),
              class: 'btn btn-warning',
              data: { confirm: t('actions.sure'), turbo: false }) do %>
          <%= t('actions.discard') %>
          <%== bs_icon('x-square') %>
        <% end %>
        <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
          <%= yield(:button_text) %>
          <%== bs_icon('save') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
