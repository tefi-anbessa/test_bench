<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
            <span class="badge fs-6">
              <%= yield(:header) %>
              <% if tag.persisted? && tag.service.present? %>
                <%= tag.service %>
              <% end %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: tag,
      url: tag.persisted? ? edit_tag_path(tag) : discipline_tags_path(@discipline),
      layout: :horizontal,
      label_col: "col-sm-4",
      control_col: "col-sm-8",
      wrapper: { class: 'mb-1' },
      data: { controller: 'tag', 'tag-model-name-value': t('activerecord.models.tag.one') }) do |f| %>

      <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
      <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Stage -->
            <div class="row">
              <%= f.number_field :stage,
              label_col: "col-sm-3",
              control_col: "col-sm-3",
                    min: 0,
                    max: 10,
                    title: t('activerecord.help.tag.stage') %>
            </div>

            <!-- Discipline -->
            <%= f.hidden_field :discipline_id, value: @discipline.id %>

            <!-- Prefix Fields - Dynamic based on discipline schema -->
            <%= render 'tags/prefix_fields', tag: tag, f: f %>

            <!-- Serial and Suffix -->
            <div class="row">
              <%= f.text_field :serial,
                label_col: "col-sm-3",
                control_col: "col-sm-3",
                title: t('activerecord.help.tag.serial'),
                pattern: '\d*',
                inputmode: 'numeric',
                value: tag.serial.present? ? tag.serial.to_s.rjust(4, '0') : '0000',
                data: { 
                  action: 'change->tag#updatePreview input->tag#updatePreview'
                },
                id: 'tag_serial' %>
            </div>

            <div class="row">
              <%= f.text_field :suffix,
              label_col: "col-sm-3",
              control_col: "col-sm-3",
                    title: t('activerecord.help.tag.suffix'),
                    data: { action: 'change->tag#updatePreview input->tag#updatePreview' },
                    id: 'tag_suffix' %>
            </div>

            <div class="row">
              <%= f.text_field :service,
                label_col: "col-sm-3",
                control_col: "col-sm-9",
                      title: t('activerecord.help.tag.service'),
                      required: true %>
            </div>

            <div class="row">
              <%= f.text_field :location,
                      label_col: "col-sm-3",
                      control_col: "col-sm-9",
                      title: t('activerecord.help.tag.location') %>
            </div>

            <!-- Notes -->
            <div class="row">
              <%= f.text_area :notes,
                      label_col: "col-sm-3",
                      control_col: "col-sm-9",
                      rows: 3,
                      placeholder: t('activerecord.help.tag.notes') %>
            </div>

            <!-- Hidden field for full tag preview -->
            <%= hidden_field_tag :full_tag, id: 'tag_full_tag_preview' %>

            <!-- Tagable Type -->
            <div class="row">
              <%= f.select :tagable_type,
                    Tag.tagable_types,
                    { include_blank: t("form.none") },
                    { class: 'form-select' } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Footer with Actions -->
      <div class="card-footer bg-transparent text-end p-2">
        <%= link_to(tag.persisted? ? tag_path(tag) : discipline_tags_path(@discipline),
              class: 'btn btn-warning',
              data: { confirm: t('actions.sure'), turbo: false }) do %>
          <%= t('actions.discard') %>
          <%== bs_icon('x-square') %>
        <% end %>
        <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
          <%= yield(:button_text) %>
          <%== bs_icon('save') %>
        <% end %>
      </div>

      <!-- Tag preview is now handled by the Stimulus controller -->
    <% end %>
  </div>
</div>
