<div class="container mt-3">
  <div class="card">
    <div class="card-header p-2">
      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
            <%= yield(:header) %>
            <% if tag.persisted? && tag.service.present? %>
              <small class="text-muted ms-2"><%= tag.service %></small>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: tag,
      layout: :horizontal,
      label_col: "col-sm-4",
      control_col: "col-sm-8",
      wrapper: { class: 'mb-1' },
      data: { controller: 'tag', 'tag-model-name-value': t('activerecord.models.tag') }) do |f| %>

      <div class="card-body p-2">
      <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Project -->
            <div class="col-md-12">
              <% if project.present? %>
                <%= f.hidden_field :project_id, value: project.id %>
                <%= render 'projects/project_card',
                      project: project %>
              <% else %>
                <%= f.select :project_id,
                      options_for_select(
                        projects.map { |p| ["#{p.code}: #{p.title}", p.id] },
                        tag.project_id
                      ),
                      { class: 'form-select', required: true  } %>
              <% end %>
            </div>

            <!-- Stage -->
            <div class="row">
              <%= f.number_field :stage,
              label_col: "col-sm-3",
              control_col: "col-sm-3",
                    min: 0,
                    max: 10,
                    title: t('activerecord.attributes.tag.stage_help') %>
            </div>

            <!-- Discipline -->
            <div class="row">
              <%= f.select :discipline_id,
                    options_for_select(
                      disciplines.map { |d|
                        ["#{t("discipline.#{d.code.downcase.to_sym}.code", 
                          default: d.code)}: #{t("discipline.#{d.code.downcase.to_sym}.name", 
                          default: d.code)}", d.id]
                      },
                      tag.discipline_id
                    ),
                    { class: 'form-select' },
                    { data: { action: 'change->tag#updateFormStructure' } } %>
            </div>

            <!-- Prefix Fields - Dynamic based on discipline schema -->
            <%= render 'tags/tag_prefix_fields', tag: tag, f: f %>

            <!-- Serial and Suffix -->
            <div class="row">
              <%= f.text_field :serial,
              label_col: "col-sm-3",
              control_col: "col-sm-3",
                    title: t('activerecord.attributes.tag.serial_help'),
                    pattern: '\d*',
                    inputmode: 'numeric',
                    value: tag.serial.present? ? tag.serial.to_s.rjust(4, '0') : '0000',
                    data: { 
                      controller: 'numeric-mask',
                      'numeric-mask-target': 'input',
                      action: 'change->tag#updatePreview input->tag#updatePreview'
                    },
                    id: 'tag_serial' %>
            </div>

            <div class="row">
              <%= f.text_field :suffix,
              label_col: "col-sm-3",
              control_col: "col-sm-3",
                    title: t('activerecord.attributes.tag.suffix_help'),
                    data: { action: 'change->tag#updatePreview input->tag#updatePreview' },
                    id: 'tag_suffix' %>
            </div>

            <div class="row">
              <%= f.text_field :service,
                label_col: "col-sm-3",
                control_col: "col-sm-9",
                      title: t('activerecord.attributes.tag.service_help'),
                      required: true %>
            </div>

            <!-- Notes -->
            <div class="row">
              <%= f.text_area :notes,
                      label_col: "col-sm-3",
                      control_col: "col-sm-9",
                      rows: 3,
                      placeholder: t('activerecord.attributes.tag.notes_help') %>
            </div>

            <!-- Hidden field for full tag preview -->
            <%= hidden_field_tag :full_tag, id: 'tag_full_tag_preview' %>

            <!-- Tagable Type -->
            <div class="row">
              <%= f.select :tagable_type,
                    Tag.tagable_types,
                    { include_blank: t("form.none") },
                    { class: 'form-select' } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Footer with Actions -->
      <div class="card-footer bg-transparent text-end p-2">
        <%= link_to(tag.persisted? ? tag_path(tag) : tags_path,
              class: 'btn btn-warning',
              data: { confirm: t('actions.sure'), turbo: false }) do %>
          <%= t('actions.discard') %>
          <%== icon('x-square') %>
        <% end %>
        <%= f.submit((yield(:button_text)), class: 'btn btn-primary') do %>
          <%== icon('save') %>
        <% end %>
      </div>

      <!-- Tag preview is now handled by the Stimulus controller -->
    <% end %>
  </div>
</div>
