<div class="container">
  <%= bootstrap_form_with(model: @tag, layout: :vertical) do |f| %>
    <%= render 'shared/error_messages', object: f.object %>

    <div class="d-flex flex-row mb-1">
      <div class="p-2 me-1 form-field">
        <%= f.select :project_id,
              Project.all.collect { |p| [ "#{p.code}: #{p.title}", p.id ] }%>
      </div>
      <div class="p-2 me-1 form-field">
        <%= f.number_field :stage %>
      </div>
      <div class="p-2 me-1 form-field">
        <%= f.collection_select :discipline_id, Discipline.all, :id, :code%>
      </div>
    </div>

    <div class="d-flex flex-row mb-1">
      <div class="p-2 me-1 form-field">
        <%= f.select :prefix, Tag.distinct.pluck(:prefix),
              include_blank: t('form.new_select') %>
      </div>
      <div class="p-2 me-1 form-field">
        <%= f.text_field :new_prefix,
              help: t('activerecord.attributes.tag.prefix_help') %>
      </div>
      <div class="p-2 me-1 form-field">
        <%= f.number_field :serial,
              help: t('activerecord.attributes.tag.serial_help') %>
      </div>
      <div class="p-2 me-1 form-field">
        <%= f.text_field :suffix,
              help: t('activerecord.attributes.tag.suffix_help') %>
      </div>
      <div class="p-2 me-1 data-field">
        <%= f.text_field :full_tag, disabled: true %>
      </div>
    </div>

    <div class="d-flex flex-row mb-1">
      <div class="p-2 me-1 form-field">
        <%= f.text_field :service, required: true,
              help: t('activerecord.attributes.tag.service') %>
      </div>
    </div>
    <div class="d-flex flex-row mb-1">
      <div class="p-2 me-1 form-field">
        <%= f.text_area :notes,
              placeholder: t('activerecord.attributes.tag.notes') %>
      </div>
    </div>

    <div class="d-flex flex-row mb-1">
      <div class="p-2 me-1 form-field">
        <%= f.select :tagable_type, Constants.tagable, include_blank: true %>
      </div>
    </div>

    <div class="d-flex flex-row mb-1">
      <div class="actions">
        <%= f.primary do %>
          <%= yield(:button_text) %>
          <%== icon('save') %>
        <% end %>
        <% if @tag.persisted? %>
          <%= link_to @tag, class: "btn btn-warning actions",
                  data: { turbo_confirm: t('actions.sure') } do %>
                  <%= t('actions.discard') %>
                  <%== icon('x-square') %>
          <% end %>
        <% else %>
          <%= link_to tags_path, class: "btn btn-warning actions",
                  data: { turbo_confirm: t('actions.sure') }  do %>
            <%= t('actions.discard') %>
            <%== icon('x-square') %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
