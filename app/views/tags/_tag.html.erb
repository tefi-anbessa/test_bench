<div id="<%= dom_id tag %>">
  <div class="container text-start">
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.models.project') %>:
      </span>
      <span class="col-4 data-field">
        <%= tag.project.code + ': ' + tag.project.title %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.tag.stage') + ':' %>
      </span>
      <span class="col-1 data-field">
        <%= tag.stage %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.tag.service') + ':' %>
      </span>
      <span class="col-4 data-field">
        <%= tag.service %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.tag.location') + ':' %>
      </span>
      <span class="col-4 data-field">
        <%= tag.location %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.tag.notes')  + ':' %>
      </span>
      <span class="col-1 data-field">
        <%= tag.notes %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.tag.tagable_type') + ':' %>
      </span>
      <span class="col-1 data-field">
        <%= tag.tagable_type %>
      </span>
    </div>
  </div>
</div>
