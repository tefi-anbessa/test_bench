<% provide(:title, t(".title")) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <h5 class="mb-0">
        <%= @discipline.present? ? t(".header_discipline", discipline: @discipline.long_label) : t(".header_project", project: @project.label) %>
      </h5>
    </div>

    <div class="card-body p-3" style="<%= form_styles(@swatch) %>">
      <p class="text-muted"><%= t(".help") %></p>

      <%= form_with url: (@discipline.present? ? discipline_tags_import_path(@discipline) : project_tags_import_path(@project)),
            method: :post, multipart: true, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :file, t(".file_label"), class: "form-label" %>
          <%= f.file_field :file, class: "form-control", accept: ".csv,.xlsx,.xlsm,.ods", required: true %>
          <small class="form-text text-muted"><%= t(".file_help") %></small>
        </div>

        <div class="d-flex justify-content-end">
          <%= f.submit t(".submit"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
