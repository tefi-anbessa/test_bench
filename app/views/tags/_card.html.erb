
<%= render 'components/collapsible',
  id: "tag_#{tag.id}_details",
  title: t("tags.show.header", label: [tag.label, tag.service].join(' ')),
  expanded: false,
  header_class: 'py-1' do %>

    <div class="row mb-1">
      <% text = t("show.linked", model: tag.model_name.human) %>
      <%= link_to tag_path(tag),
        class: "btn btn-sm btn-outline-secondary me-2",
        title: text do %>
        <%== bs_icon('box-arrow-in-up-left') %>
        <span class="d-none d-md-inline"><%= text %></span>
      <% end %>
    </div>

    <div class="row mb-1">
      <div class="col-12">
        <%= link_to [t('activerecord.models.project.one') + ':',
                      tag.project.code,
                      tag.project.title].join(' '),
          project_path(tag.project), 
          class: 'text-decoration-none' %>
      </div>
    </div>

    <div class="row mb-1">
      <div class="col-12">
        <%= [t('activerecord.attributes.tag.stage'), tag.stage].join(': ') %>
      </div>
    </div>

    <div class="row mb-1">
      <div class="col-12">
        <%= t("activerecord.attributes.tag.location") %>: <%= tag.location || '-' %>
      </div>
    </div>

    <% if tag.notes.present? %>
      <div class="row mb-1">
        <div class="col-12">
          <div class="d-flex">
            <span class="text-muted me-2"><%= t('activerecord.attributes.tag.notes') %>:</span>
            <span><%= tag.notes %></span>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

