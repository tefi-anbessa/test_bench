<!-- Tag collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% tag = object %>
<% return false unless tag.present? && tag.is_a?(Tag) %>
<%= render 'components/collapsible',
      id: "#{id}_#{tag.id}_details",
      title: [context, tag.long_label].join(": "),
      expanded: false,
      header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show_tag, record: tag) %>
    <%= nav_link(action: :show_discipline, record: tag.discipline) %>

    <%= show_attribute(tag, :stage) %>
    <%= show_attribute(tag, :service) %>
    <%= show_attribute(tag, :location) %>
    <%= show_attribute(tag, :notes, type: :text) %>
  </div>
<% end %>
