
<% if Tag.safe_tagable_types.include?(row.tagable_type) %>
  <% if row.tagable.present? %>
    <%= index_link(action: :down, record: row.tagable) %>
  <% else %>
    <% if policy(row.build_tagable()).new? %>
      <% resource = row.tagable_type.constantize.model_name.singular %>
      <%= index_link(action: :link, path: eval("new_tag_#{resource}_path(#{row.id})"), record: row.build_tagable()) %>
    <% else %>
      <%= row.tagable_type.constantize.model_name.human %>
    <% end %>
  <% end %>
<% else %>
  <span class="text-muted">
      <%= row.tagable_type.present? ?
      t('index.invalid') :
      t('index.unassigned') %>
  </span>
<% end %>
