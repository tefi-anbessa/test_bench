<tr scope="row">
  <td><%= highlight row.code, params.dig(:q, :code_cont) %></td>
  <td><%= highlight row.title, params.dig(:q, :title_cont) %></td>
  <td><%= highlight row.description, params.dig(:q, :description_cont) %></td>
  <td>
    <% if policy(row).show? %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>

    <% if policy(row).edit? %>
      <%= nav_button(action: :edit, record: row, path: edit_project_path(row), icon_only: true) %>
    <% end %>

    <% if @can_delete %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
