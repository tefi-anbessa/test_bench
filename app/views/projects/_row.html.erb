<tr scope="row">
  <td><%= highlight row.code, params.dig(:q, :code_cont) %></td>
  <td><%= highlight row.title, params.dig(:q, :title_cont) %></td>
  <td><%= highlight row.description, params.dig(:q, :description_cont) %></td>
  <td>
    <% if policy(row).show? %>
      <%= link_to project_path(row), class: "btn btn-outline-info btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>

    <% if policy(row).edit? %>
      <%= link_to edit_project_path(row), class: "btn btn-outline-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline" do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>

    <% if policy(row).destroy? %>
      <%= link_to row,
          data: { method: :delete, confirm: t('actions.delete_sure') },
          class: "btn btn-outline-danger btn-sm icon-link",
          aria: { label: t('actions.delete') },
          title: t('actions.delete'),
          display: "inline" do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>
