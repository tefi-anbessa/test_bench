<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Project Header Card -->
  <div class="card mb-4" style="<%= container_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@project).index? %>
              <%= link_to projects_path,
                    class: "btn btn-sm btn-outline-info me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_project = @project.prev("code") %>
            <% if prev_project.present? %>
              <% disabled = prev_project == @project %>
              <%= link_to project_path(prev_project),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary
                      #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_project.code}" do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Project Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @project.code) %>
                <% if @project.title.present? %>
                  <%= @project.title %>
                <% end %>
              </span> <!-- end badge -->
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_project = @project.next("code") %>
            <% if next_project.present? %>
              <% disabled = next_project == @project %>
              <%= link_to project_path(next_project),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary
                      me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_project.code}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@project).edit? %>
                <%= link_to edit_project_path(@project),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@project).destroy? %>
                <%= link_to @project,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body" style="<%= form_styles(@swatch) %>">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Project Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-body p-3">

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.project.description') %></div>
                <div class="col-8"><%= @project.description || '-' %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.models.swatch') %></div>
                <div class="col-6">
                  <%= @project.swatch&.name || '-' %>
                </div>
                <div class="col-2 text-end">
                  <% if @project.swatch && policy(@project.swatch).show? %>
                    <%= link_to @project.swatch, 
                        class: "btn btn-sm btn-outline-info",
                        aria: { 
                          label: t('actions.show', model: t('activerecord.models.swatch', count: 1)) 
                        } do %>
                      <%= t('actions.show') %>
                      <%== bs_icon('eye') %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div> <!-- end project card body -->
          </div> <!-- end project card -->

        </div> <!-- end responsive columns -->

        <!-- Disciplines Section -->
        <%= render 'disciplines/disciplines', object: @project %>
        
        <!-- Users Section -->
        <%= render 'users/users', users: @users, label: @project.long_label, project: @project %>
      </div> <!-- end justify content center -->
    </div> <!-- end form card body -->
  </div> <!-- end form card -->
</div> <!-- end container -->
