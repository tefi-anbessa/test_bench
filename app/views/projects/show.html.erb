<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Project Header Card -->
  <div class="card mb-4" style="<%= container_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@project).index? %>
              <%= nav_button(action: :index, path: projects_path) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Project Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @project.code) %>
                <% if @project.title.present? %>
                  <%= @project.title %>
                <% end %>
              </span> <!-- end badge -->
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@project).edit? %>
                <%= nav_button(action: :edit, record: @project, path: edit_project_path(@project)) %>
              <% end %>

              <% if policy(@project).destroy? %>
                <%= nav_button(action: :delete, record: @project, path: project_path(@project)) %>
              <% end %>

              <% if policy(@project).new? %>
                <%= nav_button(action: :new, record: @project, path: new_project_path) %>
              <% end %>
            </div> <!-- button group -->
          </div> <!-- d-flex align-items-center -->
        </div> <!-- right navigation and actions -->
      </div> <!-- row align-items-center -->
    </div> <!-- card header -->

    <div class="card-body" style="<%= form_styles(@swatch) %>">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Project Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-body p-3">

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.project.description') %></div>
                <div class="col-8"><%= @project.description || '-' %></div>
              </div>

              <!-- Only show the swatch to users that can change it. -->
              <% if policy(@project).edit? %>
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.models.swatch', count: 1) %></div>
                  <div class="col-8">
                    <% if @project.swatch && policy(@project.swatch).show? %>
                      <%= render 'swatches/card', object: @project.swatch %>
                    <% else %>
                      <%= t("show.unassigned", model: t("activerecord.models.swatch", count: 1)) %>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <!-- Tags and document links -->
              <div class="row mb-1">
                <div class="col-md-12">
                  <div class="d-flex gap-2">
                    <%= link_to project_tags_path(@project),
                        class: "btn btn-outline-info btn-sm",
                        aria: { 
                          label: t('activerecord.models.tag', count: @project.tags.count)
                        } do %>
                      <%== bs_icon('tag') %>
                      <%= t('activerecord.models.tag', count: @project.tags.count) %>
                      <span class="badge bg-info ms-1"><%= @project.tags.count %></span>
                    <% end %>
                    
                    <%= link_to project_documents_path(@project),
                        class: "btn btn-outline-info btn-sm",
                        aria: { 
                          label: t('activerecord.models.document', count: @project.documents.count)
                        } do %>
                      <%== bs_icon('file') %>
                      <%= t('activerecord.models.document', count: @project.documents.count) %>
                      <span class="badge bg-info ms-1"><%= @project.documents.count %></span>
                    <% end %>
                    
                    <% if policy(DocType).index? %>
                      <%= link_to project_doc_types_path(@project),
                          class: "btn btn-outline-info btn-sm",
                          aria: { 
                            label: t('activerecord.models.doc_type', count: @project.doc_types.count)
                          } do %>
                        <%== bs_icon('file') %>
                        <%= t('activerecord.models.doc_type', count: @project.doc_types.count) %>
                        <span class="badge bg-info ms-1"><%= @project.doc_types.count %></span>
                      <% end %>
                    <% end %>
                  </div> <!-- end d-flex -->
                </div> <!-- end col -->
              </div> <!-- end row -->
            </div> <!-- end project card body -->
          </div> <!-- end project card -->
        </div> <!-- end responsive columns -->

        <!-- Disciplines Section -->
        <%= render 'disciplines/disciplines', object: @project %>
        
        <!-- Users Section -->
        <% if @users.any? %>
          <%= render 'users/users', users: @users, label: @project.long_label, project: @project %>
        <% else %>
          <%= t("users.users.no_users", scope_text: @project.long_label) %>
        <% end %>
      </div> <!-- end justify content center -->
    </div> <!-- end form card body -->
  </div> <!-- end form card -->
</div> <!-- end container -->
