<!-- Project collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% project = object %>
<%= render 'components/collapsible',
			id: "#{id}_#{project.id}_details",
      title: [context, project.label].join(": "),
			expanded: false,
			show_icon: true,
			header_class: 'py-1' do %>

	<div class="container-fluid">
    <%= nav_link(action: :show_project, record: project) %>

    <%= show_attribute(project, :code) %>
    <%= show_attribute(project, :title) %>
    <%= show_attribute(project, :description, type: :text) %>

		<% if policy(project).edit? %>
      <%= nav_link(action: :show, record: project.swatch) %>
    <% end %>
	</div>
<% end %>
