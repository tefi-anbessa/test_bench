<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <!-- Center Project Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
            <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: @project,
      layout: :horizontal,
      label_col: "col-sm-4",
      control_col: "col-sm-8",
      wrapper: { class: 'mb-1' }) do |f| %>

      <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
        <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <%= f.text_field :code,
                  placeholder: t('activerecord.attributes.project.code'),
                  help: t('activerecord.help.project.code') %>

            <%= f.text_field :title,
                  placeholder: t('activerecord.attributes.project.title'),
                  help: t('activerecord.help.project.title') %>

            <%= f.text_area :description,
                  placeholder: t('activerecord.attributes.project.description'),
                  rows: 3 %>

            <!-- colour swatch -->
            <div class="row">
              <%= f.select :swatch_id,
                options_for_select(
                  @swatches.map { |s| [s.name, s.id] },
                  @project.swatch_id
                ),
                { class: 'form-select' } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Footer with Actions -->
      <div class="card-footer bg-transparent text-end p-2">
        <% if @project.persisted? %>
          <%= link_to @project,
                class: 'btn btn-warning',
                data: { confirm: t('actions.sure'), turbo: false } do %>
            <%= t('actions.discard') %>
            <%== bs_icon('x-square') %>
          <% end %>
        <% else %>
          <%= link_to projects_path,
                class: 'btn btn-warning',
                data: { confirm: t('actions.sure'), turbo: false } do %>
            <%= t('actions.discard') %>
            <%== bs_icon('x-square') %>
          <% end %>
        <% end %>
        <%= f.button :submit, class: 'btn btn-primary' do %>
          <%= yield(:button_text) %>
          <%== bs_icon('save') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
