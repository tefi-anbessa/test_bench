<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <!-- Center Project Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
            <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: @project,
      html: { novalidate: true },
      layout: :horizontal,
      label_col: "col-sm-4",
      control_col: "col-sm-8",
      wrapper: { class: 'mb-1' }) do |f| %>

      <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
        <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <%= form_field(f, :code) %>
            <%= form_field(f, :title) %>
            <%= form_field(f, :description, type: :text) %>
            <% collection = options_for_select(@swatches.map { |s| [s.name, s.id] }, @project.swatch_id) %>
            <%= form_field(f, :swatch_id, type: :select, collection: collection) %>

            <% if @project.new_record? %>
              <div class="mb-3">
                <label class="form-label fw-bold"><%= t('.disciplines_label') %></label>
                <div class="form-text mb-2"><%= t('.disciplines_help') %></div>
                <% Discipline.standard_options.each do |code, attrs| %>
                  <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="discipline_code_<%= code %>"
                      name="project[discipline_codes][]" value="<%= code %>">
                    <label class="form-check-label" for="discipline_code_<%= code %>">
                      <%= [code, t("discipline.name.#{code}", default: attrs[:name])].join(": ") %>
                      <% if attrs[:module].present? %>
                        <span class="badge bg-success"><%= t('.module_ready') %></span>
                      <% else %>
                        <span class="badge bg-secondary"><%= t('.module_pending') %></span>
                      <% end %>
                    </label>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Card Footer with Actions -->
      <div class="card-footer bg-transparent text-end p-2">
        <% if @project.persisted? %>
          <%= link_to @project,
                class: 'btn btn-warning',
                data: { confirm: t('actions.sure'), turbo: false } do %>
            <%= t('actions.discard') %>
            <%== bs_icon('x-square') %>
          <% end %>
        <% else %>
          <%= link_to projects_path,
                class: 'btn btn-warning',
                data: { confirm: t('actions.sure'), turbo: false } do %>
            <%= t('actions.discard') %>
            <%== bs_icon('x-square') %>
          <% end %>
        <% end %>
        <%= f.button :submit, class: 'btn btn-primary' do %>
          <%= yield(:button_text) %>
          <%== bs_icon('save') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
