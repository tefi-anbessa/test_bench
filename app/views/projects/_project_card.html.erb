<!-- Project collapsible card -->
<div class="card-body">
	<%= render 'components/collapsible',
		title: [t("activerecord.models.project"), local_assigns[:project].label].join(": "),
		id: 'project-collapse',
		expanded: false,
		header_class: 'py-1' do %>  
			<div class="row mb-2">
				<div class="col-12">
					<div class="d-flex align-items-center">
						<span class="text-muted me-2">
							<%= link_to [t('activerecord.models.project'), project.label].join(': '), 
								project_path(project), 
								class: 'text-decoration-none' %>
						</span>
					</div>
				</div>
			</div>
			<div class="row mb-2">
				<div class="col-12">
					<div class="d-flex align-items-center">
						<span><%= [t("activerecord.attributes.project.title"), project.title].join(': ') %></span>
					</div>
				</div>
			</div>
			<div class="row mb-2">
				<div class="col-12">
					<div class="d-flex align-items-center">
						<span><%= [t("activerecord.attributes.project.description"), project.description].join(': ') %></span>
					</div>
				</div>
			</div>
		<% end %>
</div> 