<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch) %>">
  <!-- Projects Index Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="d-flex justify-content-between align-items-center">
        <!-- Header Text (Left) -->
        <div class="ms-2">
          <h5 class="mb-0"><%= t('.header') %></h5>
        </div>

        <!-- New Button (Right) -->
        <% if policy(Project.new()).new? %>
          <%= nav_button(action: :new, path: new_project_path, record: Project.new) %>
        <% end %>
      </div> <!-- end of d-flex -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q do |f| %>
          <%= f.search_field :code_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.project.code') %>
          <%= f.search_field :title_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.project.title') %>
          <%= f.search_field :description_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.project.description') %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <table id='projects' class='table table-responsive table-condensed table-striped table-hoverable table-bordered'>
        <%= render 'header' %>
        <tbody>
          <% @projects.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    </div> <!-- end of card-body -->

    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
