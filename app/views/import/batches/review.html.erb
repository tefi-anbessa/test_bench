<% provide(:title, t(".title")) %>
<% valid_count = @rows.count(&:valid?) %>
<% invalid_count = @rows.size - valid_count %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <h5 class="mb-0"><%= t(".header", filename: @batch.original_filename) %></h5>
    </div>

    <div class="card-body p-3" style="<%= form_styles(@swatch) %>">
      <% if invalid_count.zero? %>
        <div class="alert alert-success"><%= t(".all_valid", count: valid_count) %></div>
      <% else %>
        <div class="alert alert-warning"><%= t(".some_invalid", valid: valid_count, invalid: invalid_count) %></div>
      <% end %>

      <div class="row justify-content-center mb-3">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
          <%= bootstrap_form_with url: refresh_file_import_batch_path(@batch), method: :patch, multipart: true, local: true, html: { novalidate: true } do |f| %>
            <%= f.file_field :file, label: t(".refresh_file_label"), help: t(".refresh_file_help"),
                  accept: Import::SpreadsheetReader::SUPPORTED_EXTENSIONS.join(","), required: true %>
            <div class="d-flex justify-content-end">
              <%= f.submit t(".refresh_file_submit"), class: "btn btn-outline-primary" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="table-responsive mb-3" style="max-height: 500px; overflow-y: auto;">
        <table class="table table-sm table-striped">
          <thead>
            <tr>
              <th><%= t(".row_number") %></th>
              <th><%= t(".status") %></th>
              <th><%= t(".details") %></th>
            </tr>
          </thead>
          <tbody>
            <% @rows.each do |row| %>
              <tr class="<%= row.valid? ? "" : "table-danger" %>">
                <td><%= row.row_number %></td>
                <td>
                  <% if row.valid? %>
                    <span class="badge bg-success"><%= t(".valid") %></span>
                  <% else %>
                    <span class="badge bg-danger"><%= t(".invalid") %></span>
                  <% end %>
                </td>
                <td>
                  <% if row.valid? %>
                    <%= row.raw.values.compact.join(" · ") %>
                  <% else %>
                    <%= row.error_messages.join("; ") %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <%= bootstrap_form_with url: commit_import_batch_path(@batch), method: :post, local: true, html: { novalidate: true } do |f| %>
            <% if invalid_count.positive? %>
              <%= f.check_box :partial, label: t(".partial_label", invalid: invalid_count) %>
            <% end %>

            <div class="d-flex justify-content-between">
              <%= link_to t(".back_to_mapping"), back_to_mapping_import_batch_path(@batch),
                    class: "btn btn-outline-secondary", data: { turbo_method: :patch } %>
              <div class="d-flex gap-2">
                <%= link_to t("actions.cancel"), import_batch_path(@batch),
                      class: "btn btn-warning",
                      data: { turbo_method: :delete, turbo_confirm: t("actions.sure") } %>
                <%= f.submit t(".commit"), class: "btn btn-primary", disabled: invalid_count.positive? && valid_count.zero? %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
