<%# Shared across every importer's upload entry point (see the Importable
    concern) - nothing here is specific to any one model. The calling view
    supplies the model-specific header text, submit URL, and cancel_url (no
    Import::Batch exists yet at this step, so "cancel" just means "back to
    the index this was launched from" - the calling view already knows that
    path); everything else (help text, accepted formats, the file field
    itself) is generic to the spreadsheet-import pipeline. %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <h5 class="mb-0"><%= header %></h5>
    </div>

    <div class="card-body p-3" style="<%= form_styles(@swatch) %>">
      <p class="text-muted"><%= t(".help") %></p>
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <%= bootstrap_form_with url: url, method: :post, multipart: true, local: true do |f| %>
            <%= f.file_field :file, label: t(".file_label"), help: t(".file_help"),
                  accept: Import::SpreadsheetReader::SUPPORTED_EXTENSIONS.join(","), required: true %>

            <div class="d-flex justify-content-end gap-2">
              <%= link_to t("actions.cancel"), cancel_url, class: "btn btn-warning" %>
              <%= f.submit t(".submit"), class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
