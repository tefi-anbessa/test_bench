<%# Shared across every importer's upload entry point (see the Importable
    concern) - nothing here is specific to any one model. The calling view
    supplies the model-specific header text and submit URL; everything else
    (help text, accepted formats, the file field itself) is generic to the
    spreadsheet-import pipeline. %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <h5 class="mb-0"><%= header %></h5>
    </div>

    <div class="card-body p-3" style="<%= form_styles(@swatch) %>">
      <p class="text-muted"><%= t(".help") %></p>

      <%= form_with url: url, method: :post, multipart: true, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :file, t(".file_label"), class: "form-label" %>
          <%= f.file_field :file, class: "form-control", accept: Import::SpreadsheetReader::SUPPORTED_EXTENSIONS.join(","), required: true %>
          <small class="form-text text-muted"><%= t(".file_help") %></small>
        </div>

        <div class="d-flex justify-content-end">
          <%= f.submit t(".submit"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
