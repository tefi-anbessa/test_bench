<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
            <%= yield(:header) %>
            <% if discipline.present? && discipline.persisted? %>
              <small class="text-muted ms-2"><%= discipline.name %></small>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <%= bootstrap_form_with(model: discipline,
      url: discipline.persisted? ? discipline_path(discipline) : project_disciplines_path(project),
      layout: :horizontal, 
      label_col: "col-sm-4", 
      control_col: "col-sm-8",
      html: { novalidate: true }) do |f| %>

      <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
        <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Project -->
            <div class="col-md-12">
              <% if project.present? %>
                <%= f.hidden_field :project_id, value: project.id %>
                <%= render 'projects/card',
                      object: project %>
              <% else %>
                <%= f.select :project_id,
                      options_for_select(
                        @projects.map { |p| ["#{p.code}: #{p.title}", p.id] },
                        discipline.project_id
                      ),
                      { class: 'form-select', required: true  } %>
              <% end %>
            </div>

            <!-- Copy from standard -->
            <% unless discipline.persisted? %>
              <div class="mb-1">
                <%= f.select :copy_from_standard,
                      options_for_select(
                        Constants.disciplines.map { |label, attrs| 
                          [t("discipline.name.#{attrs[:name]}", default: attrs[:name]), label.to_s] 
                        }
                      ),
                      { include_blank: t('form.new_select') },
                      { class: "form-select" } %>
              </div>
           <% end %>

            <!-- Name -->
            <div class="row">
              <%= f.text_field :name,
                label_col: "col-sm-3",
                control_col: "col-sm-9",
                      title: t('activerecord.help.discipline.name'),
                      required: true %>
            </div>

            <!-- Label -->
            <div class="row">
              <%= f.text_field :label,
                label_col: "col-sm-3",
                control_col: "col-sm-9",
                      title: t('activerecord.help.discipline.name'),
                      required: true %>
            </div>

            <!-- prefix schema -->
            <%= render 'prefix_schema_fields', form: f %>

            <!-- colour swatch -->
            <div class="row">
              <%= f.select :swatch_id,
                options_for_select(
                  @swatches.map { |s| [s.name, s.id] },
                  discipline.swatch_id
                ),
                { class: 'form-select' } %>
            </div>

            <!-- Required Role -->
            <div class="row">
              <%= f.select :required_role,
                options_for_select(
                  Role.all_resource_roles[:discipline].map { |r| [r.humanize, r] },
                  discipline.required_role
                ),
                { include_blank: true, label: t('activerecord.attributes.discipline.required_role') },
                { label_col: "col-sm-3",
                  control_col: "col-sm-9",
                  title: t('activerecord.help.discipline.required_role') } %>
            </div>

          </div> <!-- end responsive columns --> 
        </div>
      </div> <!-- card body -->

      <!-- Card Footer with Actions -->
      <div class="card-footer bg-transparent text-end p-2">
        <% if discipline.persisted? %>
            <%= link_to discipline_path(discipline),
              class: "btn btn-warning actions",
              data: { confirm: t('actions.sure'), turbo: false } do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>
        <% else %>
            <%= link_to project_disciplines_path(project),
              class: "btn btn-warning actions",
                data: { confirm: t('actions.sure'), turbo: false } do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>
        <% end %>
        <!-- Button to submit form -->
        <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
          <%= yield(:button_text) %>
          <%== bs_icon('save') %>
        <% end %>
      </div>
    <% end %>
  </div> <!-- card  -->
</div> <!-- container  -->
