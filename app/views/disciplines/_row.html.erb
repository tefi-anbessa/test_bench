<tr scope="row">
  <td><%= discipline.sort_order %></td>
  <td><%= discipline.code %></td>
  <td><%= discipline.name %></td>
  <td><%= discipline.prefix_schema&.[]('name') %></td>
  <td><%= discipline.required_role || '-' %></td>
  <td><%= index_link(action: :show, record: discipline.swatch) %></td>
  <td>
    <% if policy(discipline).show? %>
      <%= nav_button(action: :show, record: discipline, icon_only: true) %>
    <% end %>
    <% if policy(discipline).edit? %>
      <%= nav_button(action: :edit, record: discipline, path: edit_discipline_path(discipline), icon_only: true) %>
    <% end %>
    <% if policy(discipline).destroy? %>
      <%= nav_button(action: :delete, record: discipline, icon_only: true) %>
    <% end %>
  </td>
</tr>