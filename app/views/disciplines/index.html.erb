<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch)%>">

  <!-- Disciplines List Header -->
  <div class="card mb-1" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-1" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2 mb-1">

        <!-- Project link -->
        <div class="col-2">
          <% if current_project.present? %>
            <%= link_to project_path(current_project), class: "btn btn-sm btn-outline-info" do %>
              <%= current_project.label %>
              <%= bs_icon('layers', class: "me-1") %>
            <% end %>
          <% end %>
        </div>

        <!-- Header Text (Left - 8 columns) -->
        <div class="col-8">
          <% scope_text = current_project.present? ? 
            [t("activerecord.models.project.one"), current_project.label].join(': ') : 
            t('index.all', models: t('activerecord.models.project.other')) %>
          <h5><%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 align-content-end">
          <% if current_project.present? && policy(@project.disciplines.build()).new? %>
              <%= link_to new_project_discipline_path(current_project),
                class: "btn btn-sm btn-outline-primary actions",
                aria: { label: t('actions.new') },
                title: t('actions.new') do %>
                <%== bs_icon('plus-square-fill') %>
                <span class="ms-1"><%= [t('actions.new'), t('activerecord.models.discipline.one')].join(' ') %></span>
              <% end %>
          <% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->
    
    <div class="card-body">
      <!-- Disciplines -->
      <table id='disciplines' class='table table-responsive table-condensed table-striped table-hoverable table-bordered'>
        <%= render "header" %>
        <tbody>
          <% @disciplines.each do |discipline| %>
            <%= render 'row', discipline: discipline %>
          <% end %>
        </tbody>
      </table>
    </div> <!-- end of card body -->
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div> <!-- end of car footer -->
  </div> <!-- end of card -->
</div> <!-- end of container -->