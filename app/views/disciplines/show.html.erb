<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Discipline Outer Card Header -->
  <div class="card mb-4" style="<%= container_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@discipline.project).show? %>
              <%= nav_button(action: :show_project, record: @discipline.project) %>
            <% end %>
            <% if policy(Discipline).index? %>
              <%= nav_button(action: :index, path: project_disciplines_path(@discipline.project), record: @discipline) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span id="discipline-header" class="badge fs-5" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', 
                      label: t("discipline.name.#{@discipline.name}", default: @discipline.name)) %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>
            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@discipline).edit? %>
                <%= nav_button(action: :edit, record: @discipline, path: edit_discipline_path(@discipline)) %>
              <% end %>

              <% if policy(@discipline).destroy? %>
                <%= nav_button(action: :delete, record: @discipline) %>
              <% end %>

              <% if policy(@project.disciplines.build()).new? %>
                <%= nav_button(action: :new, record: @project.disciplines.build(), path: new_project_discipline_path(@discipline.project)) %>
              <% end %>
            </div> <!-- button group -->
          </div> <!-- d-flex align-items-center -->
        </div> <!-- right navigation and actions -->
      </div> <!-- row align-items-center -->
    </div> <!-- card header -->

    <div class="d-flex flex-column justify-content-center">
      <div class="card-body">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Discipline Details Card -->
            <div class="row">
              <div class="card mb-4" style="<%= card_styles(@swatch) %>">
                <div class="card-body p-3">

                  <%= show_attribute(@discipline, :notes, type: :text) %>
                  <%= show_attribute(@discipline, :code) %>
                  <%= show_attribute(@discipline, :sort_order, type: :integer) %>
                  <%= show_attribute(@discipline, :required_role) %>
                  <%= show_attribute(@discipline, :catalog_required_role) %>

                  <!-- Project Card -->
                  <% if @project.present? %>
                    <%= show_association(@discipline, :project) %>
                  <% else %>
                    <div class="row mb-3">
                      <div class="alert alert-danger">
                        <%= t('show.orphan', model: t("activerecord.models.project.one")) %>
                      </div>
                    </div>
                  <% end %>

                  <% if @discipline.prefix_schema.present? %>
                    <%= render 'disciplines/prefix_schema_card', 
                      object: @discipline.prefix_schema %>
                  <% else %>
                    <div class="row mb-1">
                      <div class="col-4 text-muted bg-warning"><%= t('activerecord.attributes.discipline.prefix_schema') %></div>
                      <div class="col-8 bg-warning"><%= t("show.unassigned", model: t("activerecord.attributes.discipline.prefix_schema")) %></div>
                    </div>
                  <% end %>

                  <% if policy(@discipline).edit? && @discipline.swatch.present? %>
                    <%= show_association(@discipline, :swatch) %>
                  <% end %>
                </div> <!-- end discipline details card-body -->
              </div> <!-- end discipline card -->
            </div> <!-- end row -->
            
            <!-- Links -->
            <div class="row mb-3">
              <!-- Tags and Documents -->
              <div class="d-flex gap-2">
                <%= link_to discipline_tags_path(@discipline),
                      class: "btn btn-outline-info",
                      title: t('activerecord.models.tag', count: @discipline.tags.count) do %>
                  <%== bs_icon('tags') %>
                  <%= t('activerecord.models.tag', count: @discipline.tags.count) %>
                  <span class="badge bg-info ms-1"><%= @discipline.tags.count %></span>
                <% end %>
                
                <%= link_to discipline_documents_path(@discipline),
                      class: "btn btn-outline-info",
                      title: t('activerecord.models.document', count: @discipline.documents.count) do %>
                  <%== bs_icon('file-earmark-text') %>
                  <%= t('activerecord.models.document', count: @discipline.documents.count) %>
                  <span class="badge bg-info ms-1"><%= @discipline.documents.count %></span>
                <% end %>
                
                <!-- Only show the doc_types index link to users that can create doc_types. -->
                <% if policy(@discipline.doc_types.build()).new? %>
                  <%= link_to discipline_doc_types_path(@discipline),
                        class: "btn btn-outline-info",
                        title: t('activerecord.models.doc_type', count: @discipline.doc_types.count) do %>
                    <%== bs_icon('file-earmark-text') %>
                    <%= t('activerecord.models.doc_type', count: @discipline.doc_types.count) %>
                    <span class="badge bg-info ms-1"><%= @discipline.doc_types.count %></span>
                  <% end %>
                <% end %>
              </div>
            </div> <!-- Tags and Documents row -->

            <div class="row mb-3">
              <!-- Models -->
              <div class="d-flex gap-2">
                <% @model_links.each do |link| %>
                  <%= link_to polymorphic_path([@discipline, link[1].to_sym]), 
                      class: "btn btn-outline-info",
                      title: link[0] do %>
                    <%== bs_icon('box-arrow-in-down-right') %>
                    <%= link[0] %>
                  <% end %>
                <% end %>
              </div>
            </div>
            
            <!-- Users Section -->
            <%= render 'users/users', users: @users, label: @discipline.long_label, project: @discipline.project %>
          </div> <!-- end col -->
        </div> <!-- end justify content row -->
      </div> <!-- end card-body -->
    </div> <!-- end card -->
  </div> <!-- end container -->
</div> <!-- end container -->