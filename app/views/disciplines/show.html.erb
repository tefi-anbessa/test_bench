<% provide(:title, t('.title')) %>
<div class="container mt-3">
  <!-- Discipline Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@discipline).index? %>
              <%= link_to project_disciplines_path(@project),
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: t('actions.index') do %>
                <%== icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>
            <!-- Previous Button -->
            <% prev_discipline = @discipline.prev %>
            <% if prev_discipline.present? %>
              <% disabled = prev_discipline == @discipline %>
              <%= link_to discipline_path(prev_discipline),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary
                      #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_discipline.label}" do %>
                <%== icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge bg-primary fs-6">
                <%= t('.header', label: [@project.label, @discipline.label].join(' '))%>
              </span>
              <small class="text-muted ms-2"><%= @discipline.name %></small>
            </div>
          </div>
        </div>

        <!-- Right Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_discipline = @discipline.next %>
            <% if next_discipline.present? %>
              <% disabled = next_discipline == @discipline %>
              <%= link_to discipline_path(next_discipline),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary
                      me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_discipline.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== icon('box-arrow-in-right') %>
              <% end %>
            <% end %>
            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@discipline).edit? %>
                <%= link_to edit_discipline_path(@discipline),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@discipline).destroy? %>
                <%= link_to @discipline,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column justify-content-center">
      <div class="card-body">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Project Card -->
            <% if @project.present? %>
              <div class="row g-3 mb-3">
                  <%= render 'projects/project_card', project: @project %>
              </div>
            <% else %>
              <div class="row g-3 mb-3">
                <div class="alert alert-danger">
                  <%= t('show.orphan', model: Discipline.model_name.human.downcase) %>
                </div>
              </div>
            <% end %>

            <!-- Discipline Details Card -->
            <div class="row">
              <div class="card mb-4">
                <div class="card-body p-3">

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.discipline.code') %></div>
                    <div class="col-8"><%= @discipline.code %></div>
                  </div>
                
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.discipline.name') %></div>
                    <div class="col-8"><%= @discipline.name %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.discipline.label') %></div>
                    <div class="col-8"><%= @discipline.label %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.discipline.prefix_schema') %></div>
                    <div class="col-8"><%= @discipline.prefix_schema&.[]('name') %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.discipline.module_name') %></div>
                    <div class="col-8"><%= @discipline.module_name %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.discipline.notes') %></div>
                    <div class="col-8"><%= @discipline.notes || '-' %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>