<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Discipline Outer Card Header -->
  <div class="card mb-4" style="<%= container_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if @discipline.present? %>
              <% if policy(@discipline.project).show? %>
                <%= link_to project_path(@discipline.project),
                      class: "btn btn-sm btn-outline-info me-2",
                      title: t('actions.show') do %>
                  <%== bs_icon('layers') %>
                  <span class="d-none d-md-inline"><%= @discipline.project.code %></span>
                <% end %>
              <% end %>
              <% if policy(@discipline).index? %>
                <%= link_to project_disciplines_path(@project),
                      class: "btn btn-sm btn-outline-info me-2",
                      title: t('actions.index') do %>
                  <%== bs_icon('list-columns-reverse') %>
                  <span class="d-none d-md-inline"><%= t('actions.index') %></span>
                <% end %>
              <% end %>
            <% end %>
            <!-- Previous Button -->
            <% prev_discipline = @discipline.prev %>
            <% if prev_discipline.present? %>
              <% disabled = prev_discipline == @discipline %>
              <%= link_to discipline_path(prev_discipline),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary
                      #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_discipline.label}" do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-5" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @discipline.long_label)%>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_discipline = @discipline.next %>
            <% if next_discipline.present? %>
              <% disabled = next_discipline == @discipline %>
              <%= link_to discipline_path(next_discipline),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary
                      me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_discipline.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>
            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@discipline).edit? %>
                <%= link_to edit_discipline_path(@discipline),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@discipline).destroy? %>
                <%= link_to @discipline,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@project.disciplines.build()).new? %>
                <%= link_to new_project_discipline_path(@discipline.project),
                      class: "btn btn-outline-primary",
                      title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.new') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column justify-content-center">
      <div class="card-body">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Discipline Details Card -->
            <div class="row">
              <div class="card mb-4" style="<%= card_styles(@swatch) %>">
                <div class="card-body p-3">
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.discipline.notes') %></div>
                    <div class="col-8"><%= @discipline.notes || '-' %></div>
                  </div> <!-- end row -->

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= t('activerecord.attributes.discipline.required_role') %></div>
                    <div class="col-8"><%= @discipline.required_role || '-' %></div>
                  </div>

                  <!-- Project Card -->
                  <% if @project.present? %>
                    <div class="row mb-3">
                        <%= render 'projects/card', object: @project %>
                    </div>
                  <% else %>
                    <div class="row mb-3">
                      <div class="alert alert-danger">
                        <%= t('show.orphan', model: Project.model_name.human.downcase) %>
                      </div>
                    </div>
                  <% end %>

                  <% if @discipline.prefix_schema.present? %>
                    <%= render 'disciplines/prefix_schema_card', 
                      object: @discipline.prefix_schema %>
                  <% else %>
                    <div class="row mb-1">
                      <div class="col-4 text-muted"><%= t('activerecord.attributes.discipline.prefix_schema') %></div>
                      <div class="col-8"><%= '-' %></div>
                    </div>
                  <% end %>

                  <% if @discipline.swatch.present? %>
                    <%= render 'swatches/card', 
                      object: @discipline.swatch %>
                  <% else %>
                    <div class="row mb-1">
                      <div class="col-4 text-muted"><%= t('activerecord.models.swatch', count: 1) %></div>
                      <div class="col-8"><%= '-' %></div>
                    </div>
                  <% end %>
                </div> <!-- end discipline details card-body -->
              </div> <!-- end discipline card -->
            </div> <!-- end row -->
            
            <!-- Links -->
            <div class="row mb-3">
              <!-- Tags and Documents -->
              <div class="d-flex gap-2">
                <%= link_to discipline_tags_path(@discipline),
                      class: "btn btn-outline-info",
                      title: t('activerecord.models.tag', count: @discipline.tags.count) do %>
                  <%== bs_icon('tags') %>
                  <%= t('activerecord.models.tag', count: @discipline.tags.count) %>
                  <span class="badge bg-info ms-1"><%= @discipline.tags.count %></span>
                <% end %>
                
                <%= link_to discipline_documents_path(@discipline),
                      class: "btn btn-outline-info",
                      title: t('activerecord.models.document', count: @discipline.documents.count) do %>
                  <%== bs_icon('file-earmark-text') %>
                  <%= t('activerecord.models.document', count: @discipline.documents.count) %>
                  <span class="badge bg-info ms-1"><%= @discipline.documents.count %></span>
                <% end %>
                
                <%= link_to discipline_doc_types_path(@discipline),
                      class: "btn btn-outline-info",
                      title: t('activerecord.models.doc_type', count: @discipline.doc_types.count) do %>
                  <%== bs_icon('file-earmark-text') %>
                  <%= t('activerecord.models.doc_type', count: @discipline.doc_types.count) %>
                  <span class="badge bg-info ms-1"><%= @discipline.doc_types.count %></span>
                <% end %>
              </div>
            </div> <!-- Tags and Documents row -->

            <div class="row mb-3">
              <!-- Models -->
              <div class="d-flex gap-2">
                <% @model_links.each do |link| %>
                  <%= link_to polymorphic_path([@discipline, link[1].to_sym]), 
                      class: "btn btn-outline-info",
                      title: link[0] do %>
                    <%== bs_icon('box-arrow-in-down-right') %>
                    <%= link[0] %>
                  <% end %>
                <% end %>
              </div>
            </div>
            
            <!-- Users Section -->
            <%= render 'users/users', users: @users, label: @discipline.long_label, project: @discipline.project %>
          </div> <!-- end col -->
        </div> <!-- end justify content row -->
      </div> <!-- end card-body -->
    </div> <!-- end card -->
  </div> <!-- end container -->
</div> <!-- end container -->