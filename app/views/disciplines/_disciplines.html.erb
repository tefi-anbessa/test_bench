<!-- List project disciplines for project dashboard -->
<% project = object %>
<% disciplines = project.disciplines.where.not(id: nil) %>
<!-- Disciplines Dashboard Panel -->
<div class="card mb-4" style="<%= card_styles(@swatch) %>">
  <div class="card-header d-flex justify-content-between align-items-center py-2" style="<%= card_header_styles(@swatch) %>">
    <h5 class="mb-0"><%= t('disciplines.index.header', scope_text: @project.label) %></h5>
    <% if policy(project.disciplines.build()).new? %>
      <%= nav_button(action: :new, path: new_project_discipline_path(@project), record: project.disciplines.build) %>
    <% end %>
  </div>
  
  <div class="card-body p-3">
    <% disciplines.each do |discipline| %>
      <div class="row align-items-center py-2 border-bottom">
        <!-- Discipline Name Column -->
        <div class="col-md-4">
          <% name = t("discipline.name.#{discipline.name}", default: discipline.name) %>
          <% text = [discipline.code, name].join(": ") %>
          <%= link_to discipline,
              id: "discipline-#{discipline.id}",
              class: "fw-bold text-decoration-none",
              title: text,
              aria: { label: text },
              style: "color: #{@swatch&.text || '#000'}" do %>
            <%= text %>
          <% end %>
        </div>
        
        <!-- Counts Column -->
        <div class="col-md-4">
          <div class="d-flex gap-2">
            <%= link_to discipline_tags_path(discipline),
                class: "btn btn-outline-info btn-sm",
                aria: { 
                  label: t('activerecord.models.tag', count: discipline.tags.count)
                } do %>
              <%== bs_icon('tag') %>
              <%= t('activerecord.models.tag', count: discipline.tags.count) %>
              <span class="badge bg-info ms-1"><%= discipline.tags.count %></span>
            <% end %>
            
            <%= link_to discipline_documents_path(discipline),
                class: "btn btn-outline-info btn-sm",
                aria: { 
                  label: t('activerecord.models.document', count: discipline.documents.count)
                } do %>
              <%== bs_icon('file') %>
              <%= t('activerecord.models.document', count: discipline.documents.count) %>
              <span class="badge bg-info ms-1"><%= discipline.documents.count %></span>
            <% end %>
            
            <!-- Only show the doc_types index link to users that can create doc_types. -->
            <% if policy(DocType).index? %>
              <%= link_to discipline_doc_types_path(discipline),
                  class: "btn btn-outline-info btn-sm",
                  aria: { 
                    label: t('activerecord.models.doc_type', count: discipline.doc_types.count)
                  } do %>
                <%== bs_icon('file') %>
                <%= t('activerecord.models.doc_type', count: discipline.doc_types.count) %>
                <span class="badge bg-info ms-1"><%= discipline.doc_types.count %></span>
              <% end %>
            <% end %>
          </div>
        </div>
        
        <!-- Actions Column -->
        <div class="col-md-4 text-end">
          <div class="d-flex gap-1 justify-content-end">
            <% if policy(discipline).show? %>
              <%= nav_button(action: :show, record: discipline, icon_only: true) %>
            <% end %>
            
            <% if policy(discipline).edit? %>
              <%= nav_button(action: :edit, path: edit_discipline_path(discipline), record: discipline, icon_only: true) %>
            <% end %>
            
            <% if policy(discipline).destroy? %>
              <%= nav_button(action: :delete, record: discipline, icon_only: true) %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    
    <% if disciplines.empty? %>
      <div class="text-center text-muted py-3">
        <%= t('index.empty', models: t('activerecord.models.discipline', count: 0)) %>
      </div>
    <% end %>
  </div>
</div>