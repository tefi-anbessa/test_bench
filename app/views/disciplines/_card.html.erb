<!-- Discipline collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% discipline = object %>
<%= render 'components/collapsible',
      id: "#{id}_#{discipline.id}_details",
      title: [context, discipline.name].join(': '),
      expanded: false,
      header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show_discipline, record: discipline) %>
    <%= nav_link(action: :show_project, record: discipline.project) %>

    <%= show_attribute(discipline, :notes, type: :text) %>
    <%= show_attribute(discipline, :required_role) %>
    <%= show_attribute(discipline, :catalog_required_role) %>
    <%= show_attribute(discipline, :sort_order) %>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.discipline.prefix_schema") %></div>
      <div class="col-8"><%= discipline.prefix_schema["name"] || '-' %></div>
    </div>

    <% if policy(discipline).edit? %>
      <%= nav_link(action: :show, record: discipline.swatch) %>
    <% end %>

  </div> <!-- end container-fluid -->
<% end %>