<% schema = object %>
<%= render 'components/collapsible',
  id: "#{schema['name']}",
  title: [t("activerecord.attributes.discipline.prefix_schema"), schema['name']].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
    <div class="bg-light p-3 rounded">
      <pre class="mb-0"><code class="language-json"><%= JSON.pretty_generate(schema.presence || {}) %></code></pre>
    </div>
  <% end %>
</div>
