<% provide(:title, t(".title")) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <h5 class="mb-0"><%= t(".header", filename: @batch.original_filename) %></h5>
    </div>

    <div class="card-body p-3" style="<%= form_styles(@swatch) %>">
      <p class="text-muted"><%= t(".help") %></p>

      <%= form_with url: import_batch_path(@batch), method: :patch, local: true do %>
        <table class="table table-striped">
          <thead>
            <tr>
              <th><%= t(".column_header") %></th>
              <th><%= t(".field_header") %></th>
            </tr>
          </thead>
          <tbody>
            <% @importer.headers.each do |header| %>
              <tr>
                <td><%= header %></td>
                <td>
                  <%= select_tag "column_mapping[#{header}]",
                        options_for_select(
                          [[t(".ignore_column"), ""]] + @importer.column_definitions.map { |d| [d.label, d.key] },
                          @suggested_mapping[header]
                        ),
                        class: "form-select" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <% if @disciplines.present? %>
          <div class="mb-3">
            <label class="form-label"><%= t(".single_discipline_label") %></label>
            <%= select_tag "single_discipline_id",
                  options_for_select([[t(".single_discipline_blank"), ""]] + @disciplines.map { |d| [d.long_label, d.id] }, @batch.discipline_id),
                  class: "form-select" %>
            <small class="form-text text-muted"><%= t(".single_discipline_help") %></small>
          </div>
        <% end %>

        <div class="d-flex justify-content-end">
          <%= submit_tag t(".submit"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
