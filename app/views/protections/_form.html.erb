<%= form_with(model: protection) do |form| %>
  <% if protection.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(protection.errors.count, "error") %> prohibited this protection from being saved:</h2>

      <ul>
        <% protection.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :device, style: "display: block" %>
    <%= form.number_field :device %>
  </div>

  <div>
    <%= form.label :poles, style: "display: block" %>
    <%= form.number_field :poles %>
  </div>

  <div>
    <%= form.label :curve, style: "display: block" %>
    <%= form.number_field :curve %>
  </div>

  <div>
    <%= form.label :rating, style: "display: block" %>
    <%= form.number_field :rating %>
  </div>

  <div>
    <%= form.label :elcb, style: "display: block" %>
    <%= form.number_field :elcb %>
  </div>

  <div>
    <%= form.label :notes, style: "display: block" %>
    <%= form.text_field :notes %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
