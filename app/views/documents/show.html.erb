<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Document Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Buttons -->
            <% if policy(Document).index? %>
              <%= nav_button(action: :index_project, path: project_documents_path(@discipline.project), record: @document) %>
              <%= nav_button(action: :index_discipline, path: discipline_documents_path(@discipline), record: @document) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-5" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @document.long_label)%>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@document).edit? %>
                <%= nav_button(action: :edit, record: @document, path: edit_document_path(@document)) %>
              <% end %>

              <% if policy(@document).destroy? %>
                <%= nav_button(action: :delete, record: @document, path: document_path(@document)) %>
              <% end %>

              <% if @discipline && policy(@discipline.documents.build()).new? %>
                <%= nav_button(action: :new, record: @document, path: new_discipline_document_path(@discipline)) %>
              <% end %>
            </div> <!-- button group -->
          </div> <!-- d-flex align-items-center -->
        </div> <!-- right navigation and actions -->
      </div> <!-- row align-items-center -->
    </div> <!-- card header -->

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Inner Card -->
          <!-- Document Details -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: t("activerecord.models.document.one")) %></h4>
            </div>
            <div class="card-body">
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.document.doc_number") %></div>
                <div class="col-8"><%= @document.doc_number || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.document.title") %></div>
                <div class="col-8"><%= @document.title || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.document.notes") %></div>
                <div class="col-8"><%= simple_format(@document.notes || '-') %></div>
              </div> <!-- end row -->
            </div>  <!-- temporary end inner card body -->

            <!-- Document Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: t("activerecord.models.document.one")) %></h4>
            </div>

            <div class="card-body p-3">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.models.discipline.one") %></div>
                <div class="col-8"><%= render "disciplines/card", object: @document.discipline %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.models.doc_type.one") %></div>
                <div class="col-8"><%= render "doc_types/card", object: @document.doc_type %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <%= render "issues/issues", object: @document %>
              </div> <!-- end row -->
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
