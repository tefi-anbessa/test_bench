<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Document Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@document).index? %>
              <%= link_to discipline_documents_path(@discipline),
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_document = @document.prev %>
            <% if prev_document.present? %>
              <% disabled = prev_document == @document %>
              <% title_text = "#{t('actions.previous')}: #{prev_document.label}" %>
              <%= link_to prev_document,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: title_text do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @document.label)%>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_document = @document.next %>
            <% if next_document.present? %>
              <% title_text = "#{t('actions.next')}: #{next_document.label}" %>
              <% disabled = next_document == @document %>
              <%= link_to next_document,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: title_text do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@document).edit? %>
                <%= link_to edit_document_path(@document),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@document).destroy? %>
                <%= link_to @document,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@discipline.documents.build()).new? %>
                <%= link_to new_discipline_document_path(@discipline), 
                  class: "btn btn-outline-primary actions",
                  aria: { label: t('actions.new') },
                  title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="ms-1">
                    <%= [t('actions.new'), t('activerecord.models.document')].join(' ') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Document Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @document.model_name.human) %></h4>
            </div>

            <div class="card-body p-3">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @document.class.human_attribute_name(:discipline) %></div>
                <div class="col-8"><%= render "disciplines/card", object: @document.discipline %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @document.class.human_attribute_name(:doc_type) %></div>
                <div class="col-8"><%= render "doc_types/card", object: @document.doc_type %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @document.class.human_attribute_name(:doc_number) %></div>
                <div class="col-8"><%= @document.doc_number || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @document.class.human_attribute_name(:title) %></div>
                <div class="col-8"><%= @document.title || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @document.class.human_attribute_name(:notes) %></div>
                <div class="col-8"><%= simple_format(@document.notes || '-') %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <%= render "issues/issues", object: @document %>
              </div> <!-- end row -->

            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
