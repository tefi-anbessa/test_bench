<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto"style="<%= container_styles(@swatch)%>"
  <!-- Tagable Resource Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <!-- Discipline and project links -->
        <div class="col-2">
          <% if @discipline.present? %>
            <%= nav_button(action: :show_project, record: @discipline.project) %>
            <%= nav_button(action: :show_discipline, record: @discipline) %>
          <% elsif @project.present? %>
            <%= nav_button(action: :show_project, record: @project) %>
          <% end %>
        </div>

        <!-- Header Text (Left - 8 columns) -->
        <div class="col-8">
          <% scope_text = @discipline.present? ? 
          [@discipline.project.code, @discipline.class.model_name.human, @discipline.long_label].join(' ') : 
          current_project.present? ? 
          [current_project.class.model_name.human, current_project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project.other')) %>
          <h5><%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 align-content-end">
          <% if @discipline.present? && policy(@discipline.documents.build()).new? %>
            <%= nav_button(action: :new, path: new_discipline_document_path(@discipline), record: Document.new) %>
          <% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: @discipline.present? ?
        discipline_documents_path(@discipline) :
        project_documents_path(@project) do |f| %>
          <%= f.search_field :discipline_name_cont,
                class: "search_field",
                placeholder: t("activerecord.models.discipline") %>
          <%= f.search_field :doc_type_name_cont,
                class: "search_field",
                placeholder: t("activerecord.models.doc_type") %>
          <%= f.search_field :title_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.document.title") %>
          <%= f.search_field :notes_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.document.notes") %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!--  -->
      <table id='documents' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% @documents.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
