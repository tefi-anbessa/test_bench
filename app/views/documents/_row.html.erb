<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.project.code %></td>
  <% end %>
  <td><%= row.doc_number || '-' %></td>
  <td><%= row.title || '-' %></td>
  <td>
    <% perms = @permissions&.[](row.discipline_id) || permissions_for(row) %>
    <% if perms[:show] %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if perms[:edit] %>
      <%= nav_button(action: :edit, record: row, path: edit_document_path(row), icon_only: true) %>
    <% end %>
    <% if perms[:destroy] %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
