<!-- Document collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% resource = object %>
<% return false unless resource.present? && resource.is_a?(Document) %>
<%= render 'components/collapsible',
      id: "#{id}_#{resource.id}_details",
      title: [context, resource.long_label].join(": "),
      expanded: false,
      header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show_document, record: resource) %>
    <%= show_attribute(resource, :title) %>
    <%= show_attribute(resource, :notes, type: :text) %>
  </div> <!-- end container-fluid -->
<% end %>