<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Doc type Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Buttons -->
            <% if policy(DocType).index? %>
              <%= nav_button(action: :index_project, path: project_doc_types_path(@doc_type.project), record: @doc_type) %>
              <%= nav_button(action: :index_discipline, path: discipline_doc_types_path(@doc_type.discipline), record: @doc_type) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @doc_type.long_label)%>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@doc_type).edit? %>
                <%= nav_button(action: :edit, record: @doc_type, path: edit_doc_type_path(@doc_type)) %>
              <% end %>

              <% if policy(@doc_type).destroy? %>
                <%= nav_button(action: :delete, record: @doc_type, path: doc_type_path(@doc_type)) %>
              <% end %>

              <% if @discipline && policy(@discipline.doc_types.build()).new? %>
                <%= nav_button(action: :new, path: new_discipline_doc_type_path(@discipline), record: @doc_type) %>
              <% end %>
            </div> <!-- Button group -->
          </div> <!-- End of action buttons -->
        </div> <!-- End of right column -->
      </div> <!-- End of row -->
    </div> <!-- End of card header -->

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- DocType Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @doc_type.model_name.human) %></h4>
            </div>

            <div class="card-body p-3">
              <%= show_attribute(@doc_type, :code) %>
              <%= show_attribute(@doc_type, :name) %>
              <%= show_attribute(@doc_type, :description, type: :text) %>
            </div>  <!-- temporary end inner card body -->

            <!-- Document Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: t("activerecord.models.doc_type.one")) %></h4>
            </div>

            <div class="card-body p-3">
              <!-- Discipline card -->
              <%= show_association(@doc_type, :discipline) %>

              <!-- Children card -->
              <div class="row mb-1">
                <%= render 'shared/children', parent: @doc_type, association: :documents, text_method: :title %>
              </div>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
