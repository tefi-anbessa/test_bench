<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.project.code %></td>
  <% end %>
  <td><%= row.discipline.present? ?
    link_to(row.discipline.code, row.discipline) : 
    '-' %></td>
  <td><%= row.code || '-' %></td>
  <td><%= row.name || '-' %></td>
  <td><%= row.description || '-' %></td>
  <td>
    <% if policy(row).show? %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if policy(row).edit? %>
      <%= nav_button(action: :edit, record: row, path: edit_doc_type_path(row), icon_only: true) %>
    <% end %>
    <% if policy(row).destroy? %>
      <%= nav_button(action: :delete, record: row, path: doc_type_path(row), icon_only: true) %>
    <% end %>
  </td>
</tr>