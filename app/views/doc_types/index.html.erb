<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto"style="<%= container_styles(@swatch)%>"
  <!-- Tagable Resource Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <!-- Discipline or project link -->
        <div class="col-2">
          <% if @discipline.present? %>
            <%= link_to discipline_path(@discipline), class: "btn btn-sm btn-outline-info" do %>
              <%= @discipline.name %>
              <%= bs_icon('collection', class: "me-1") %>
            <% end %>
          <% elsif current_project.present? %>
            <%= link_to project_path(current_project), class: "btn btn-sm btn-outline-info" do %>
              <%= current_project.label %>
              <%= bs_icon('layers', class: "me-1") %>
            <% end %>
          <% end %>
        </div>

        <!-- Header Text (Left - 8 columns) -->
        <div class="col-8">
          <% scope_text = @discipline.present? ? 
          [@discipline.project.code, @discipline.class.model_name.human, @discipline.long_label].join(' ') : 
          current_project.present? ? 
          [current_project.class.model_name.human, current_project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project.other')) %>
          <h5><%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 align-content-end">
          <% if @discipline.present? && policy(@discipline.doc_types.build()).new? %>
              <%= link_to new_discipline_doc_type_path(@discipline),
                class: "btn btn-sm btn-outline-primary actions",
                aria: { label: t('actions.new') },
                title: t('actions.new') do %>
                <%== bs_icon('plus-square-fill') %>
                <span class="ms-1"><%= [t('actions.new'), t('activerecord.models.doc_type.one')].join(' ') %></span>
              <% end %>
          <% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: @discipline.present? ?
          discipline_doc_types_path(@discipline) :
          project_doc_types_path(@project) do |f| %>
          <%= f.search_field :code_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.doc_type.code") %>
          <%= f.search_field :name_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.doc_type.name") %>
          <%= f.search_field :description_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.doc_type.description") %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!--  -->
      <table id='doc_types' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% @doc_types.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
