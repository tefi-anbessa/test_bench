<% resource = object %>
<%= render 'components/collapsible',
  id: "doc_type_#{resource.id}_details",
  title: t("doc_types.show.header", label: resource.code),
  expanded: false,
  header_class: 'py-1' do %>
  
    <div class="container-fluid">
      <div class="row mb-1">
        <% text = t("actions.jump_to", model: t("activerecord.models.doc_type", count: 1)) %>
        <%= link_to resource, 
            class: "btn btn-sm btn-outline-secondary me-2",
            title: text do %>
          <%== bs_icon('box-arrow-in-up-left') %>
          <span class="d-none d-md-inline"><%= text %></span>
        <% end %>
      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.models.discipline.one") %></div>
        <div class="col-8"><%= resource.discipline&.label || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.doc_type.code") %></div>
        <div class="col-8"><%= resource.code || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.doc_type.name") %></div>
        <div class="col-8"><%= resource.name || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.doc_type.description") %></div>
        <div class="col-8"><%= simple_format(resource.description || '-') %></div>

      </div>
    </div> <!-- end container-fluid -->
<% end %>