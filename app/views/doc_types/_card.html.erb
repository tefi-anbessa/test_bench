<!-- Doc type collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% doc_type = object %>
<%= render 'components/collapsible',
  id: "#{id}_#{doc_type.id}_details",
  title: t("doc_types.show.header", label: doc_type.code),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: doc_type) %>
    <%= nav_link(action: :show_discipline, record: doc_type.discipline) %>
    
    <%= show_attribute(doc_type, :code) %>
    <%= show_attribute(doc_type, :name) %>
    <%= show_attribute(doc_type, :description, type: :text) %>
  </div> <!-- end container-fluid -->
<% end %>