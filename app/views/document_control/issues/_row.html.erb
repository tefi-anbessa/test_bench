<tr scope="row">
  <td><%= row.code || '-' %></td>
  <td><%= row.reason || '-' %></td>
  <td><%= row.source_format.present? ?
    link_to(row.source_format.label, row.source_format) : 
    '-' %></td>
  <td>
    <% if policy(row).show? %>
      <%= link_to row, class: "btn btn-outline-info btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show') do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(row).edit? %>
      <%= link_to edit_document_control_issue_path(row), class: "btn btn-outline-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit') do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(row).destroy? %>
    <%= link_to row,
            data: { method: :delete, confirm: t('actions.delete_sure') },
            class: "btn btn-outline-danger btn-sm icon-link",
            aria: { label: t('actions.delete') },
            title: t('actions.delete') do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>
