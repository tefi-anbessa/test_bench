<% document = object %>
<%= render 'components/collapsible',
  id: "document_control_issues",
  title: t('document_control.issues.index.header', document: document.doc_number),
  expanded: params[:document_control_issues_expanded] == '1',
  header_class: 'py-1' do %>
  
    <div class="container-fluid">
      <% if policy(DocumentControl::Issue).new? %>
        <%= link_to new_document_document_control_issue_path(document),
              class: "btn btn-primary actions",
              data: { turbo: false },
              aria: { label: t('actions.new') },
              title: t('actions.new') do %>
          <%== bs_icon('plus-square-fill') %>
          <%= [t('actions.new'), t('activerecord.models.document_control.issue')].join(' ') %>
        <% end %>
      <% end %>
      <div class="table-responsive">
        <table class="table table-sm table-striped">
          <thead>
            <th scope="col"><%= t("code", scope: "activerecord.attributes.document_control.issue") %></th>
            <th scope="col"><%= t("reason", scope: "activerecord.attributes.document_control.issue") %></th>
            <th scope="col"><%= t("source_format", scope: "activerecord.attributes.document_control.issue") %></th>
            <th scope="col" width="150px"><%= t('table.links')%></th>
          </thead>
          <tbody>
            <% document.issues.each do |row| %>
              <%= render 'document_control/issues/row', row: row %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
