<% resource = object %>
<%= render 'components/collapsible',
  id: "doc_types_#{resource.id}_details",
  title: t("document_control.doc_types.show.header", label: resource.code),
  expanded: false,
  header_class: 'py-1' do %>
  
    <div class="container-fluid">
      <div class="row mb-1">
        <% text = t("actions.jump_to", model: t("activerecord.models.document_control.doc_type")) %>
        <%= link_to resource, 
            class: "btn btn-sm btn-outline-secondary me-2",
            title: text do %>
          <%== bs_icon('box-arrow-in-up-left') %>
          <span class="d-none d-md-inline"><%= text %></span>
        <% end %>
      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= resource.class.human_attribute_name(:discipline) %></div>
        <div class="col-8"><%= resource.discipline&.label || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= resource.class.human_attribute_name(:code) %></div>
        <div class="col-8"><%= resource.code || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= resource.class.human_attribute_name(:label) %></div>
        <div class="col-8"><%= resource.label || '-' %></div>

      </div>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= resource.class.human_attribute_name(:description) %></div>
 
        <!-- TODO: Add json formatting -->
        <div class="col-8"><%= simple_format(resource.description || '-') %></div>

      </div>
    </div> <!-- end container-fluid -->
<% end %>