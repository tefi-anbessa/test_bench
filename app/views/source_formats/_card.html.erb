<!-- Source Format collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% source_format = object %>
<%= render 'components/collapsible',
      id: "#{id}_#{source_format.id}_details",
      title: [context, source_format.label].join(": "),
      expanded: false,
      header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: source_format) %>
      <%= show_attribute(source_format, :vendor) %>
      <%= show_attribute(source_format, :title) %>
      <%= show_attribute(source_format, :file_extension) %>
      <%= show_attribute(source_format, :revision) %>
      <%= show_attribute(source_format, :notes, type: :text) %>
    </div>
  </div> <!-- end container-fluid -->
<% end %>