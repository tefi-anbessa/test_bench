<tr scope="row">
  <td><%= row.vendor || '-' %></td>
  <td><%= row.title || '-' %></td>
  <td><%= row.revision || '-' %></td>
  <td><%= row.file_extension || '-' %></td>
  <td>
    <% if can_show %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if can_edit %>
      <%= nav_button(action: :edit, record: row, path: edit_source_format_path(row), icon_only: true) %>
    <% end %>
    <% if can_delete %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
