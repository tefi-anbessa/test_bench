<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Source format Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@source_format).index? %>
              <%= nav_button(action: :index, path: source_formats_path, record: @source_format) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @source_format.label)%>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm">
              <% if policy(@source_format).edit? %>
                <%= nav_button(action: :edit, path: edit_source_format_path(@source_format), record: @source_format) %>
              <% end %>
              
              <% if policy(@source_format).destroy? %>
                <%= nav_button(action: :delete, path: source_format_path(@source_format), record: @source_format) %>
              <% end %>

              <% if policy(@source_format).new? %>
                <%= nav_button(action: :new, path: new_source_format_path, record: @source_format) %>
              <% end %>
            </div> <!-- button group -->
          </div> <!-- d-flex align-items-center -->
        </div> <!-- right navigation and actions -->
      </div> <!-- row align-items-center -->
    </div> <!-- card header -->

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- SourceFormat Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @source_format.model_name.human) %></h4>
            </div>

            <div class="card-body">
              <%= show_attribute(@source_format, :vendor) %>
              <%= show_attribute(@source_format, :title) %>
              <%= show_attribute(@source_format, :file_extension) %>
              <%= show_attribute(@source_format, :revision) %>
              <%= show_attribute(@source_format, :notes, type: :text) %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
