<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Source format Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@source_format).index? %>
              <%= link_to source_formats_path,
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_source_format = @source_format.prev %>
            <% if prev_source_format.present? %>
              <% disabled = prev_source_format == @source_format %>
              <% title_text = t('actions.previous') + ": " + prev_source_format.label %>
              <%= link_to prev_source_format,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: title_text do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @source_format.label)%>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_source_format = @source_format.next %>
            <% if next_source_format.present? %>
              <% title_text = t('actions.next') + ": " + next_source_format.label %>
              <% disabled = next_source_format == @source_format %>
              <%= link_to next_source_format,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: title_text do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@source_format).edit? %>
                <%= link_to edit_source_format_path(@source_format),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@source_format).destroy? %>
                <%= link_to @source_format,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(SourceFormat.new()).new? %>
                <%= link_to new_source_format_path, 
                  class: "btn btn-outline-primary actions",
                  aria: { label: t('actions.new') },
                  title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="ms-1">
                    <%= [t('actions.new'), t("activerecord.models.source_format")].join(' ') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- SourceFormat Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @source_format.model_name.human) %></h4>
            </div>

            <div class="card-body p-3">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.source_format.vendor") %></div>
                <div class="col-8"><%= @source_format.vendor || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.source_format.title") %></div>
                <div class="col-8"><%= @source_format.title || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.source_format.file_extension") %></div>
                <div class="col-8"><%= @source_format.file_extension || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.source_format.revision") %></div>
                <div class="col-8"><%= @source_format.revision || '-' %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.source_format.notes") %></div>
 
                <div class="col-8"><%= simple_format(@source_format.notes || '-') %></div>
              </div> <!-- end row -->
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
