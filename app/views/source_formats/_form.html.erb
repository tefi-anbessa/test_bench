<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= container_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
            <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
            <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: source_format,
          layout: :horizontal,
          label_col: "col-sm-4",
          control_col: "col-sm-8",
          wrapper_class: 'mb-1',
          ) do |f| %>

      <div class="card-body p-2" style="<%= card_styles(@swatch) %>">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">        <!-- Adjust to fit field width requirements -->

            <!-- Source format Details -->
            <div class="card mb-1" style="<%= card_styles(@swatch) %>">
              <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
                <h5><%= t('activerecord.models.source_format.one') %></h5>
              </div>

              <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
                <%= render 'shared/error_messages', object: f.object %>

                <%= form_field(f, :vendor, type: :string) %>
                <%= form_field(f, :title, type: :string) %>
                <%= form_field(f, :file_extension, type: :string) %>
                <%= form_field(f, :revision, type: :string) %>
                <%= form_field(f, :notes, type: :text) %>
              </div> <!-- end source_format card body -->
            </div> <!-- end source_format card -->

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%= link_to(source_format.persisted? ? 
              source_format : 
              source_formats_path,
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>

              <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
                <%= yield(:button_text) %>
                <%== bs_icon('save') %>
              <% end %>
            </div> <!-- end card footer -->
          </div> <!-- end responsive columns -->
        </div> <!-- end row -->
      </div> <!-- end card body -->
    <% end %> <!-- end bootstrap_form_with -->
  </div> <!-- end card -->
</div> <!-- end container -->
