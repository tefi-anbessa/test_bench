<div id="<%= dom_id load %>">
  <div class="container text-start">
    <% if load.tag.nil? %>
      <div class="d-flex flex-row mb-1">
        <span class="col-2 data-label">
          <% t('show.orphan', model: t("activerecord.models.tag").tableize) %>
        </span>
      </div>
    <% else %>
      <div class="d-flex flex-row mb-1">
        <span class="col-1 data-label">
          <%= t('activerecord.attributes.tag.full_tag') + ':' %>
        </span>
        <span class="col-1 data-field">
          <%= link_to load.tag.full_tag, tag_path(load.tag.id) %>
        </span>
        <span class="col-3 data-field">
          <%= load.tag.description %>
        </span>
      </div>
    <% end %>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.load.basis') + ':' %>
      </span>
      <span class="col-4 data-field">
        <%= Load.human_enum_name(:basis, load.basis) %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.load.basis_notes') + ':' %>
      </span>
      <span class="col-4 data-field">
        <%= load.basis_notes %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.load.supply') + ':' %>
      </span>
      <span class="col-1 data-field">
        <%= number_to_human(load.supply, precision: 4,
              units: { unit: "V", thousand: "kV"}) %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.load.phase') + ':' %>
      </span>
      <span class="col-4 data-field">
        <%= Load.human_enum_name(:config, load.config) %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.load.power') + ':' %>
      </span>
      <span class="col-1 data-field">
        <%= number_to_human(load.power, precision: 4,
              units: { unit: "W", thousand: "kW", million: "MW"}) %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.load.vector') + ':' %>
      </span>
      <span class="col-1 data-field">
        <%= number_to_human(load.vector, precision: 4,
              units: { unit: "VA", thousand: "kVA", million: "MVA"}) %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.load.power_factor') + ':' %>
      </span>
      <span class="col-1 data-field">
        <%= load.power_factor %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.load.current') + ':' %>
      </span>
      <span class="col-1 data-field">
        <%= number_to_human(load.current, precision: 4,
              units: { unit: "A", thousand: "kA", million: "MA"}) %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.load.duty') + ':' %>
      </span>
      <span class="col-1 data-field">
        <%= load.duty %>
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.load.loadable_type') + ':' %>
      </span>
      <span class="col-1 data-field">
        <%= load.loadable_type %>
      </span>
    </div>
  </div>
</div>
