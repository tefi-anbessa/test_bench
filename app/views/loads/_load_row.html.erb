  <tr scope="row">
    <% if l.tag.nil? %>
      <td class="table-danger">No tag; ID: <%= l.id %></td>
    <% else %>
      <td><%= link_to l.tag.full_tag, tag_path(l.tag) %></td>
    <% end %>
    <td>
      <% if l.basis.blank? %>
        Undefined
      <% else %>
        <%= Load.human_enum_name(:basis, l.basis) %>
      <% end %>
    </td>
    <td>
      <% if l.config.blank? %>
        Undefined
      <% else %>
        <%= Load.human_enum_name(:config, l.config) %>
      <% end %>
    </td>
    <td><%= l.supply %></td>
    <td><%= l.power %></td>
    <td><%= l.vector %></td>
    <td><%= l.power_factor %></td>
    <td><%= l.current %></td>
    <td><%= l.duty %></td>
    <% if l.loadable.nil? %>
      <td><%= l.loadable_type %></td>
    <% else %>
      <td><%= link_to l.loadable %></td>
    <% end %>
    <td>
      <%= link_to demand_path(l), class: "btn btn-secondary btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
        <%== icon('eye') %>
      <% end %>
      <%= link_to edit_demand_path(l), class: "btn btn-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline"  do %>
        <%== icon('pencil') %>
      <% end %>
      <% if current_user && current_user.admin? %>
        <%= link_to demand_path(l), method: :delete, class: "btn btn-danger btn-sm icon-link",
              aria: { label: t('actions.delete') },
              title: t('actions.delete'),
              display: "inline"  do %>
          <%== icon('trash') %>
        <% end %>
      <% end %>
    </td>
  </tr>
