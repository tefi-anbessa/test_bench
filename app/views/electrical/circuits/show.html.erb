<% content_for :title, t('.title', label: @circuit.label) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Circuit Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@circuit.switchboard).index? %>
              <%= nav_button(action: :index, path: electrical_switchboard_circuits_path(@switchboard), record: @circuit) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= [@switchboard.service, t('.header', label: @circuit.long_label)].join(' - ') %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@switchboard).edit? %>
                <%= nav_button(action: :edit, path: edit_electrical_circuit_path(@circuit), record: @circuit) %>
              <% end %>

              <% if policy(@switchboard).destroy? %>
                <%= nav_button(action: :delete, path: electrical_circuit_path(@circuit), record: @circuit) %>
              <% end %>

              <% if policy(@switchboard).new? %>
                <%= nav_button(action: :new, path: new_electrical_switchboard_circuit_path(@switchboard), record: @circuit) %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Circuit Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @circuit.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/circuit.serial') %></div>
                <div class="col-8"><%= @circuit.label.presence || '-' %></div>
              </div>
                  
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/circuit.phase') %></div>
                <div class="col-8"><%= @circuit.phase.presence || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/circuit.device') %></div>
                <div class="col-8"><%= @circuit.device.presence || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/circuit.poles') %></div>
                <div class="col-8"><%= @circuit.poles.presence || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/circuit.curve') %></div>
                <div class="col-8"><%= @circuit.curve.presence || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/circuit.rating') %></div>
                <div class="col-8"><%= @circuit.rating.presence || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/circuit.elcb') %></div>
                <div class="col-8"><%= @circuit.elcb.presence || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/circuit.contactor') %></div>
                <div class="col-8"><%= @circuit.contactor ? t("form.true") : '-' %></div>
              </div>

              <span class="border">
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.notes') %></div>
                </div>
                <div class="row mb-1">
                  <div class="col-8"><%= simple_format(@circuit.notes) %></div>
                </div>
              </span>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @circuit.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">

              <!-- Switchboard Card -->
              <div class="row g-3 mb-3">
                <%= render 'electrical/switchboards/card', object: @circuit.switchboard %>
              </div>

              <!-- Feeder Card -->
              <div class="row mb-1">
                <% if @circuit.feeder.present? %>
                  <%= render 'shared/association', object: @circuit, association: :feeder %>
                <% else %>
                  <div class="col-4 text-muted">
                    <%= t('activerecord.attributes.electrical/circuit.feeder') %>
                  </div>
                  <div class="col-8">
                    <span class="text-muted">
                      <%= t('show.unassigned', model: t("activerecord.attributes.electrical/circuit.feeder")) %>
                    </span>
                  </div>
                <% end %>
              </div>

              <!-- Load Card -->
              <div class="row mb-1">
                <% if @circuit.demand.present? %>
                  <%= render 'shared/association', object: @circuit, association: :demand %>
                <% else %>
                  <div class="col-4 text-muted">
                    <%= t('activerecord.attributes.electrical/circuit.demand') %>
                  </div>
                  <div class="col-8">
                    <span class="text-muted">
                      <%= t('show.unassigned', model: t("activerecord.attributes.electrical/circuit.demand")) %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div> <!-- inner card body -->
          </div> <!-- inner card -->
        </div> <!-- responsive columns -->
      </div> <!-- row -->
    </div> <!-- card body -->
  </div> <!-- card -->
</div> <!-- container -->
