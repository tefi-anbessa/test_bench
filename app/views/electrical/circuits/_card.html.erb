<!-- Circuit collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% circuit = object %>
<% context ||= t("activerecord.models.electrical/circuit.one") %>
<%= render 'components/collapsible',
  id: "#{id}_#{circuit.id}_details",
  title: [context, circuit.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: circuit) %>
    
    <%= show_attribute(circuit, :serial, type: :integer) %>
    <%= show_attribute(circuit, :phase, type: :enum) %>
    <%= show_attribute(circuit, :device, type: :enum) %>
    <%= show_attribute(circuit, :poles, type: :integer) %>
    <%= show_attribute(circuit, :curve, type: :enum) %>
    <%= show_attribute(circuit, :rating, type: :float, units: "A") %>
    <%= show_attribute(circuit, :elcb, type: :enum) %>
    <%= show_attribute(circuit, :contactor, type: :boolean) %>
    <%= show_attribute(circuit, :notes, type: :text) %>

    <%= show_attribute(circuit, :feeder, type: :association) %>
    <%= show_attribute(circuit, :demand, type: :association) %>
  </div>
<% end %>