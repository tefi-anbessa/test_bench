<!-- Expects object and context (optional) to be passed in -->
<% circuit = object %>
<% context ||= t("activerecord.models.electrical/circuit.one") %>
<%= render 'components/collapsible',
  id: "circuit_#{circuit.id}_details",
  title: [context, circuit.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">

    <div class="row mb-1">
      <% text = t("actions.jump_to", model: circuit.model_name.human) %>
      <%= link_to circuit, 
        class: "btn btn-sm btn-outline-secondary me-2",
        title: text do %>
        <%== bs_icon('box-arrow-in-up-left') %>
        <span class="d-none d-md-inline"><%= text %></span>
      <% end %>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/circuit.serial') %></div>
      <div class="col-8"><%= circuit.label.presence || '-' %></div>
    </div>
    
    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/circuit.notes") %></div>
      <div class="col-8" title="<%= circuit.notes %>">
        <%= truncate(strip_tags(circuit.notes.to_s), length: 20) %>
      </div>
    </div>
    
    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/circuit.phase") %></div>
      <div class="col-8"><%= circuit.phase %></div>
    </div>
    
    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/circuit.device") %></div>
      <div class="col-8"><%= circuit.device %></div>
    </div>
    
    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/circuit.feeder") %></div>
      <div class="col-8">
        <% if circuit.feeder.present? && policy(circuit.feeder).show? %>
          <%= link_to circuit.feeder.label, circuit.feeder %>
        <% else %>
          <%= t("index.unassigned") %>
        <% end %>
      </div>
    </div>
    
    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/circuit.demand") %></div>
      <div class="col-8">
        <% if circuit.demand.present? && policy(circuit.demand).show? %>
          <%= link_to circuit.demand.label, circuit.demand %>
        <% else %>
          <%= t("index.unassigned") %>
        <% end %>
      </div>
    </div>

  </div>
<% end %>