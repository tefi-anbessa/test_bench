<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch) %>">

  <!-- Circuit Schedule Card Header -->
  <div class="card mb-1" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-1" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2 mb-1">

        <!-- Switchboard or Discipline link -->
        <div class="col-2">
          <% if @switchboard.present?%>
            <%= link_to electrical_switchboard_path(@switchboard), class: "btn btn-sm btn-outline-info" do %>
              <%= @switchboard.label %>
              <%= bs_icon('box-arrow-in-up-left', class: "me-1") %>
            <% end %>
          <% else %>
            <%= link_to discipline_path(@discipline), class: "btn btn-sm btn-outline-info" do %>
              <%= @discipline.name %>
              <%= bs_icon('collection', class: "me-1") %>
            <% end %>
          <% end %>
        </div>

        <!-- Header Text (Left - 8 columns) -->
        <div class="col-8">
          <% scope_text = @switchboard.present? ? 
            [@switchboard.class.model_name.human, @switchboard.label].join(' ') : 
            t('index.all', models: t('activerecord.models.electrical.switchboard.other')) %>
          <h5><%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 align-content-end">
          <% if policy(Electrical::Switchboard).new? %>
              <%= link_to new_electrical_switchboard_circuit_path(@switchboard), 
                class: "btn btn-sm btn-outline-primary actions",
                aria: { label: t('actions.new') },
                title: t('actions.new') do %>
                <%== bs_icon('plus-square-fill') %>
                <span class="ms-1">
                  <%= [t('actions.new'), t('activerecord.models.electrical.circuit.one')].join(' ') %>
                </span>
              <% end %>
          <% end %>
        </div> 
      </div> <!-- row -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, 
        url: @switchboard.present? ? 
              electrical_switchboard_circuits_path(@switchboard) :
              discipline_electrical_circuits_path(@discipline) do |f| %>
          <%= f.search_field :phase_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.circuit.phase') %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div> <!-- end of search-form -->
      
      <table id='circuits' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <!-- [TODO - orphans go here] -->
          <% @circuits.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    </div> <!-- end of card-body -->
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
