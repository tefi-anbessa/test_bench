<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(@swatch) %>">
            <%= yield(:header) %>
            <small class="text-muted ms-2">
              <%= switchboard&.tag&.service || circuit.switchboard&.tag&.service %>
            </small>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: [switchboard, circuit],
          url: circuit.persisted? ?
            circuit : 
            electrical_switchboard_circuits_path(switchboard),
          method: circuit.persisted? ? :patch : :post,
          layout: :horizontal, 
          label_col: "col-sm-4", 
          control_col: "col-sm-8",
          wrapper_class: 'mb-1') do |f| %>
      
      <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
        <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Basic Information -->
            <div class="row">
              <%= f.number_field :serial,
                    required: true,
                    min: 1,
                    max: 36 %>
            </div>

            <div class="row">
              <%= f.select :phase, 
              options_for_select(Electrical::Circuit.phases.map { |k, v| [k, k] },
                    selected: circuit.phase),
                    { include_blank: t("form.none") } %>
            </div>

            <!-- Protection -->
            <div class="row">
              <%= f.select :device, 
              options_for_select(Electrical::Circuit.devices.map { |k, v| [k, k] },
                    selected: circuit.device),
                    { include_blank: t("form.none") } %>
            </div>

            <div class="row">
              <%= f.number_field :poles,
                    min: 0,
                    max: 6 %>
            </div>

            <div class="row">
              <%= f.select :curve, 
                    options_for_select(Electrical::Circuit.curves.map { |k, v| [k, k] },
                    selected: circuit.curve),
                    { include_blank: t("form.none") } %>
            </div>

            <div class="row">
              <%= f.select :rating, 
                    options_for_select(Constants.electrical.mcb_rating,
                    selected: circuit.rating),
                    { include_blank: t("form.none") } %>
            </div>

            <div class="row">
              <%= f.select :elcb, 
                    options_for_select(Electrical::Circuit.elcbs.map { |k, v| [k, k] },
                    selected: circuit.elcb) %>
            </div>

            <div class="row">
              <%= f.check_box :contactor, 
                    label: t('activerecord.attributes.electrical/circuit.contactor') %>
            </div>

            <div class="row">
              <%= f.text_area :notes,
                    label: t('activerecord.attributes.electrical/circuit.notes'),
                    rows: 2 %>
            </div>

            <div class="row">
              <%= bootstrap_fields @cable  do |c| %>
                <%= c.select :from_id,
                      options_for_select(@cables || [], 
                      selected: circuit.feeder&.id),
                      { include_blank: t("form.none"),
                        layout: :horizontal,
                        label_col: "col-sm-4", 
                        control_col: "col-sm-8",
                        label: t('activerecord.attributes.electrical/circuit.feeder') } %>
              <% end %>
            </div>

            <div class="row">
              <%= bootstrap_fields @cable  do |c| %>
                <%= c.select :to_id,
                      options_for_select(@demands || [], 
                      selected: circuit.feeder&.to&.id),
                      { include_blank: t("form.none"),
                        layout: :horizontal,
                        label_col: "col-sm-4", 
                        control_col: "col-sm-8",
                        label: t('activerecord.attributes.electrical/circuit.demand') } %>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Card Footer with Actions -->
        <div class="card-footer bg-transparent text-end p-2">
          <%= link_to(circuit.persisted? ? 
                circuit : 
                electrical_switchboard_circuits_path(switchboard), 
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>

          <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
            <%= yield(:button_text) %>
            <%== bs_icon('save') %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>