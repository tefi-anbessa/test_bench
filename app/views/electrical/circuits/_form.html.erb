<!-- Expects switchboard, circuit, cables, demands, cable -->
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(@swatch) %>">
            <%= yield(:header) %>
            <small class="text-muted ms-2">
              <%= switchboard&.tag&.service || circuit.switchboard&.tag&.service %>
            </small>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: [switchboard, circuit],
          url: circuit.persisted? ?
            circuit : 
            electrical_switchboard_circuits_path(switchboard),
          method: circuit.persisted? ? :patch : :post,
          layout: :horizontal, 
          label_col: "col-sm-4", 
          control_col: "col-sm-8",
          wrapper_class: 'mb-1') do |f| %>
      
      <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
        <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="row">
            <div class="col-12">
              <%= render "circuits_list", object: switchboard %>
            </div>
          </div>
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <%= form_field(f, :serial, type: :number, min: 1, max: 36, control_cols: 4, required: true) %>
            <%= form_field(f, :phase, type: :enum, control_cols: 4, required: true) %>
            <%= form_field(f, :device, type: :enum, control_cols: 4, required: false) %>
            <%= form_field(f, :poles, type: :number, min: 0, max: 12, control_cols: 4, required: false) %>
            <%= form_field(f, :curve, type: :enum, control_cols: 4, required: false) %>
            <% collection = options_for_select(Constants.electrical.mcb_rating, selected: circuit.rating.to_i) %>
            <%= form_field(f, :rating, type: :select, collection: collection, control_cols: 4, required: false) %>
            <%= form_field(f, :elcb, type: :enum, control_cols: 4, required: false) %>
            <%= form_field(f, :contactor, type: :boolean) %>

            <% enabled = cables.any? && cable.present? && policy(cable).edit? %>
            <% collection = options_for_select(cables || [], selected: circuit.feeder&.id) %>
            <%= form_field(f, :feeder_id, type: :select, collection: collection, required: false, disabled: !enabled) %>
            <% enabled &= demands.any? %>
            <% collection = options_for_select(demands || [], selected: circuit.demand&.id) %>
            <%= form_field(f, :demand_id, type: :select, collection: collection, required: false, disabled: !enabled) %>
            <%= form_field(f, :notes, type: :text) %>
          </div>
        </div>

        <!-- Card Footer with Actions -->
        <div class="card-footer bg-transparent text-end p-2">
          <%= link_to(circuit.persisted? ? 
                circuit : 
                electrical_switchboard_circuits_path(switchboard), 
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>

          <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
            <%= yield(:button_text) %>
            <%== bs_icon('save') %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>