<tr>
  <td><%= row.long_label %></td>
  <td>
    <span title="<%= row.notes %>">
      <%= truncate(strip_tags(row.notes.to_s), length: 20) %>
    </span>
  </td>
  <td><%= row.phase %></td>
  <td><%= row.device %></td>
  <td><%= row.poles %></td>
  <td><%= row.rating %></td>
  <td><%= row.curve %></td>
  <td><%= row.elcb %></td>
  <td><%= row.contactor ? bs_icon('check', height: '1em') : ' ' %></td>
  <td>
    <% if row.feeder.present? && policy(row.feeder).show? %>
      <%= link_to row.feeder.label, row.feeder %>
    <% else %>
      <%= t("index.unassigned") %>
    <% end %>
  </td>
  <td>
    <% if row.demand.present? && policy(row.demand).show? %>
      <%= link_to row.demand.label, row.demand %>
    <% else %>
      <%= t("index.unassigned") %>
    <% end %>
  </td>
  <!-- Links -->
  <td>
    <% if can_show %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if can_edit %>
      <%= nav_button(action: :edit, record: row, path: edit_electrical_circuit_path(row), icon_only: true) %>
    <% end %>
    <% if can_delete %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>