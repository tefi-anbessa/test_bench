<tr>
  <td><%= row.label %></td>
  <td><%= row.phase %></td>
  <td><%= row.device %></td>
  <td><%= row.poles %></td>
  <td><%= row.rating %></td>
  <td><%= row.curve %></td>
  <td><%= row.elcb %></td>
  <td><%= row.contactor ? bs_icon('check', height: '1em') : ' ' %></td>
  <td>
    <% if row.feeder.present? && policy(row.feeder).show? %>
      <%= link_to row.feeder.label, row.feeder %>
    <% else %>
      <%= t("show.unassigned", model: t("activerecord.attributes.electrical.circuit.feeder")) %>
    <% end %>
  </td>
  <td>
    <% if row.demand.present? && policy(row.demand).show? %>
      <%= link_to row.demand.label, row.demand %>
    <% else %>
      <%= t("show.unassigned", model: t("activerecord.models.electrical.demand")) %>
    <% end %>
  </td>
  <!-- Links -->
  <td>
    <% if policy(row).show? %>
      <%= link_to row, class: "btn btn-outline-info btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
              <%== bs_icon('eye') %>
            <% end %>
    <% end %>
        
    <% if policy(row).edit? %>
      <%= link_to edit_electrical_circuit_path(row), class: "btn btn-outline-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline"  do %>
              <%== bs_icon('pencil') %>
            <% end %>
    <% end %>
        
    <% if policy(row).destroy? %>
      <%= link_to row, 
            method: :delete,
            data: { 
              turbo_method: :delete,
              turbo_confirm: t('actions.sure')
            },
            class: "btn btn-outline-danger btn-sm icon-link",
            title: t('actions.delete') do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>