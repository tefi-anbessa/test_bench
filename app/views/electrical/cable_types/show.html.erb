<% provide(:title, t('.title', id: @cable_type.id)) %>
<!-- Centred container for cable type show card -->
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch) %>">
  <!-- Cable Type Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@discipline).index? %>
              <%= nav_button(action: :index, path: discipline_electrical_cable_types_path(@discipline), record: @cable_type) %>
            <% end %>
            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div> <!-- # d-flex align-items-center -->
        </div> <!-- # col auto -->

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
              <%= [@cable_type.model_name.human, 
                @cable_type&.id].compact.join(' ') %>
                <small class="text-muted"><%= @cable_type.long_label %></small>
            </span>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@cable_type).edit? %>
                <%= nav_button(action: :edit, path: edit_electrical_cable_type_path(@cable_type), record: @cable_type) %>
              <% end %>

              <% if policy(@cable_type).destroy? %>
                <%= nav_button(action: :delete, path: electrical_cable_type_path(@cable_type), record: @cable_type) %>
              <% end %>

              <% if policy(@cable_type).new? %>
                <%= nav_button(action: :new, path: new_discipline_electrical_cable_type_path(@discipline), record: @cable_type) %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Cable Type Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @cable_type.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
      

              <!-- Cable Type Details Inner Card -->
              <div class="table-responsive">
                <table class="table table-sm mb-0" style="width: auto;">
                  <tbody>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:conductor_material) %></th>
                      <td><%= @cable_type&.conductor_material %></td>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:groups) %></th>
                      <td><%= @cable_type&.groups %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:construction) %></th>
                      <td><%= @cable_type.class.human_enum_name(:construction, @cable_type.construction) %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:csa) %></th>
                      <td><%= @cable_type&.csa %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:neutral_csa) %></th>
                      <td><%= @cable_type&.neutral_csa %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:earth_csa) %></th>
                      <td><%= @cable_type&.earth_csa %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:insulation) %></th>
                      <td><%= @cable_type&.insulation %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:bedding) %></th>
                      <td><%= @cable_type&.bedding %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:armour) %></th>
                      <td><%= @cable_type&.armour %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:sheath) %></th>
                      <td><%= @cable_type&.sheath %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:bedding_od) %></th>
                      <td><%= @cable_type&.bedding_od %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:overall_od) %></th>
                      <td><%= @cable_type&.overall_od %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:temperature_rating) %></th>
                      <td><%= @cable_type&.temperature_rating %></td>
                    </tr>
                    <tr>
                      <th><%= @cable_type.class.human_attribute_name(:voltage_rating) %></th>
                      <td><%= @cable_type&.voltage_rating %></td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <%= @cable_type.class.human_attribute_name(:notes) %>
              <div class="scrollable-box">
                <%= @cable_type&.notes %>
              </div>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @cable_type.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">

              <!-- Project collapsible card -->
              <div class="row mb-1">
                <%= render 'projects/card', object: @cable_type.project %>
              </div>

              <!-- Discipline card -->
              <div class="row mb-1">
                <%= render 'disciplines/card', object: @cable_type.discipline %>
              </div>

              <!-- Children card -->
              <div class="row mb-1">
                <%= render 'shared/children', parent: @cable_type, association: :electrical_cables %>
              </div>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->

