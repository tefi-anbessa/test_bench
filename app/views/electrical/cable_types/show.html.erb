<% provide(:title, t('.title', id: @cable_type.id)) %>
<!-- Centred container for cable type show card -->
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch) %>">
  <!-- Cable Type Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@discipline).index? %>
              <%= nav_button(action: :index, path: discipline_electrical_cable_types_path(@discipline), record: @cable_type) %>
            <% end %>
            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div> <!-- # d-flex align-items-center -->
        </div> <!-- # col auto -->

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
              <%= [@cable_type.model_name.human, 
                @cable_type&.id].compact.join(' ') %>
                <small class="text-muted"><%= @cable_type.long_label %></small>
            </span>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@cable_type).edit? %>
                <%= nav_button(action: :edit, path: edit_electrical_cable_type_path(@cable_type), record: @cable_type) %>
              <% end %>

              <% if policy(@cable_type).destroy? %>
                <%= nav_button(action: :delete, record: @cable_type) %>
              <% end %>

              <% if policy(@cable_type).new? %>
                <%= nav_button(action: :new, path: new_discipline_electrical_cable_type_path(@discipline), record: @cable_type) %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Cable Type Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @cable_type.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <%= show_attribute(@cable_type, :conductor_material, type: :enum) %>
              <%= show_attribute(@cable_type, :groups, type: :integer) %>
              <%= show_attribute(@cable_type, :construction, type: :enum) %>
              <%= show_attribute(@cable_type, :csa, type: :float, units: "mm²") %>
              <%= show_attribute(@cable_type, :neutral_csa, type: :float, units: "mm²") %>
              <%= show_attribute(@cable_type, :earth_csa, type: :float, units: "mm²") %>
              <%= show_attribute(@cable_type, :insulation, type: :enum) %>
              <%= show_attribute(@cable_type, :bedding, type: :enum) %>
              <%= show_attribute(@cable_type, :armour, type: :enum) %>
              <%= show_attribute(@cable_type, :sheath, type: :enum) %>
              <%= show_attribute(@cable_type, :bedding_od, type: :decimal) %>
              <%= show_attribute(@cable_type, :overall_od, type: :decimal) %>
              <%= show_attribute(@cable_type, :temperature_rating, type: :enum) %>
              <%= show_attribute(@cable_type, :voltage_rating, type: :enum) %>
              <%= show_attribute(@cable_type, :notes, type: :text) %>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @cable_type.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
                <%= show_association(@cable_type, :discipline) %>

              <!-- Children card -->
              <div class="row mb-1">
                <%= render 'shared/children', parent: @cable_type, association: :electrical_cables %>
              </div>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->

