<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(Electrical::CableType.swatch) %>">
  <!-- Cable Type Header Card -->
  <div class="card mb-1" style="<%= card_styles(Electrical::CableType.swatch) %>">
    <div class="card-header p-1" style="<%= card_header_styles(Electrical::CableType.swatch) %>">
      <div class="row align-items-center p-2">

        <!-- discipline return -->
        <div class="col-2">
            <%= link_to discipline_path(@discipline), class: "btn btn-sm btn-outline-info" do %>
              <%= @discipline.name %>
              <%= bs_icon('collection', class: "me-1") %>
            <% end %>
        </div>

        <!-- Header Text (Center) -->
        <div class="col-8">
          <% scope_text = @project.present? ? 
          [@project.class.model_name.human, @project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project').pluralize) %>
          <h5 class="mb-1"><%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 text-end">
          <% if policy(Electrical::CableType).new? %>
            <%= link_to new_discipline_electrical_cable_type_path(@discipline), 
              class: "btn btn-sm btn-outline-primary actions",
              aria: { label: t('actions.new') },
              title: t('actions.new') do %>
              <%== bs_icon('plus-square-fill') %>
              <span class="ms-1"><%= t('actions.new') %></span>
              <span class="d-none d-md-inline"><%= " " + t('activerecord.models.electrical.cable_type') %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div> <!-- end of card header -->
    
    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: discipline_electrical_cable_types_path(@discipline) do |f| %>
          <%= f.search_field :conductor_material_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.cable_type.conductor_material') %>
          <%= f.search_field :groups_eq,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.cable_type.groups') %>
          <%= f.search_field :construction_eq,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.cable_type.construction') %>
          <%= f.search_field :csa_eq,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.cable_type.csa') %>
          <%= f.search_field :insulation_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.cable_type.insulation') %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>
      <table id='cable_types' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render "header" %>
        <tbody>
          <% @cable_types.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
