<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(Electrical::CableType.swatch) %>">
  <!-- Cable Type Header Card -->
  <div class="card mb-4" style="<%= card_styles(Electrical::CableType.swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(Electrical::CableType.swatch) %>">
      <div class="d-flex justify-content-between align-items-center">
        <!-- Header Text (Left) -->
        <div class="ms-2">
          <% project_text = @project.present? ? 
          [@project.class.model_name.human, @project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project').pluralize) %>
          <h5 class="mb-0"><%= t('.header', project: project_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <% if policy(Electrical::CableType).new? %>
          <%= link_to new_project_electrical_cable_type_path(current_project), 
            class: "btn btn-outline-primary actions",
            aria: { label: t('actions.new') },
            title: t('actions.new') do %>
            <%== bs_icon('plus-square-fill') %>
            <span class="ms-1"><%= t('actions.new') %></span>
            <span class="d-none d-md-inline"><%= " " + t('activerecord.models.electrical.cable_type') %></span>
          <% end %>
        <% end %>
      </div>
    </div> <!-- end of card header -->
    
    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: project_electrical_cable_types_path(current_project) do |f| %>
          <%= f.search_field :conductor_material_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.cable_type.conductor_material') %>
          <%= f.search_field :cores_eq,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.cable_type.cores') %>
          <%= f.search_field :csa_eq,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.cable_type.csa') %>
          <%= f.search_field :insulation_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.cable_type.insulation') %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>
      <table id='cable_types' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render "header" %>
        <tbody>
          <% @cable_types.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
