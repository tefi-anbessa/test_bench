<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.project.code %></td>
  <% end %>
  <td><%= row.id %></td>
  <td><%= row.code %></td>
  <td>
    <% if policy(row).show? %>
      <%= link_to electrical_cable_type_path(row), class: "btn btn-outline-info btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(row).edit? %>
      <%= link_to edit_electrical_cable_type_path(row), class: "btn btn-outline-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline"  do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(row).destroy? %>
      <%= link_to electrical_cable_type_path(row), method: :delete, class: "btn btn-outline-danger btn-sm icon-link",
            aria: { label: t('actions.delete') },
            title: t('actions.delete'),
            display: "inline"  do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>
