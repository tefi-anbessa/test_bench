<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.project.code %></td>
  <% end %>
  <td><%= row.id %></td>
  <td>
    <span title="<%= row.notes %>">
      <%= truncate(strip_tags(row.notes.to_s), length: 20) %>
    </span>
  </td>
  <td><%= row.code %></td>
  <td><%= row.electrical_cables.count %></td>
  <td>
    <% if policy(row).show? %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if policy(row).edit? %>
      <%= nav_button(action: :edit, record: row, path: edit_electrical_cable_type_path(row), icon_only: true) %>
    <% end %>
    <% if policy(row).destroy? %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
