<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">

      <!-- Center Label Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(@swatch) %>">
              <%= cable_type.persisted? ? t('actions.edit') : t('actions.new') %> 
              <% if cable_type.present? && cable_type.persisted? %>
                <%= [t('activerecord.models.electrical/cable_type'), cable_type.label].join(': ') %>
                <small class="text-muted ms-2"><%= cable_type.long_label %></small>
              <% else %>
                <%= t('activerecord.models.electrical/cable_type') %>
              <% end %>
          </div>
        </div>
      </div>
    </div> <!-- end of card header -->

    <%= bootstrap_form_with(model: cable_type,
            url: discipline_electrical_cable_types_path(@discipline),
            layout: :horizontal,
            label_col: "col-sm-6",
            control_col: "col-sm-6",
            wrapper_class: 'mb-0 p-1',
            bootstrap: {
              form: { class: 'mb-0' },
              label: { class: 'mb-0' }
            }) do |f| %>

      <div class="card-body p-3 mx-auto" style="<%= form_styles(@swatch) %>">
        <%= render 'shared/error_messages', object: f.object %>
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6"> 

            <!-- Conductor Details -->
            <div class="row">
              <%= f.select :conductor_material,
                    Electrical::CableType.conductor_materials.map { |k, v| [k.to_s.titleize, k] },
                    { wrapper: { class: 'mb-1' },
                      class: 'form-select' } %>
            </div>
            <div class="row">
                <%= f.number_field :groups,
                        step: '1',
                        min: 1,
                        wrapper: { class: 'mb-1' } %>
            </div>
            <div class="row">
                <%= f.select :construction,
                      Electrical::CableType.constructions.map { |k, v| [t("activerecord.attributes.electrical/cable_type.constructions.#{k}"), k] },
                      { wrapper: { class: 'mb-1' },
                        class: 'form-select' } %>
            </div>
            <div class="row">
                <%= f.select :insulation,
                      Electrical::CableType.insulations.map { |k, v| [k, k] },
                      { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>

            <div class="row">
                <%= f.select :csa,
                      @csa_select.map { |csa| ["#{csa} mm²", csa] },
                      { wrapper: { class: 'mb-1' } },
                      { class: 'form-select' } %>
            </div>

            <div class="row">
                <%= f.select :neutral_csa,
                      @csa_select.map { |csa| ["#{csa} mm²", csa] } ,
                      { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>

            <div class="row">
              <%= f.select :earth_csa,
                    @csa_select.map { |csa| ["#{csa} mm²", csa] },
                    { include_blank: t("form.none"),
                    wrapper: { class: 'mb-1' } } %>
            </div>

            <!-- Insulation and Protection -->
            <div class="row">
                <%= f.select :insulation,
                      Electrical::CableType.insulations.map { |k, v| [k, k] },
                      { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :bedding,
                  Electrical::CableType.beddings.map { |k, v| [k, k] },
                  { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :armour,
                  Electrical::CableType.armours.map { |k, v| [k, k] },
                  { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :sheath,
                  Electrical::CableType.sheaths.map { |k, v| [k, k] },
                  { include_blank: t("form.none"),
                      wrapper: { class: 'mb-1' } } %>
            </div>

            <div class="row">
                <%= f.number_field :bedding_od,
                  step: '0.1',
                  min: 0,
                  wrapper: { class: 'mb-1' },
                  append: 'mm' %>
            </div>
            <div class="row">
                <%= f.number_field :overall_od,
                  step: '0.1',
                  min: 0,
                  wrapper: { class: 'mb-1' },
                  append: 'mm' %>
            </div>

            <!-- Rating -->
            <div class="row">
                <%= f.select :temperature_rating,
                  Electrical::CableType.temperature_ratings.map { |k, v| [k, k] },
                  { include_blank: t("form.unknown"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
            <div class="row">
                <%= f.select :voltage_rating,
                  Electrical::CableType.voltage_ratings.map { |k, v| [k, k] },
                  { include_blank: t("form.unknown"),
                      wrapper: { class: 'mb-1' } } %>
            </div>
          </div>
        </div>

        <!-- Notes -->
        <div class="row">
            <%= f.text_area :notes,
              label_col: "col-sm-2",
              control_col: "col-sm-10",
              rows: 3,
              wrapper: { class: 'mb-1' } %>
        </div>
      </div>

      <!-- Card Footer with Actions -->
      <div class="card-footer p-3 mx-auto">
        <div class="d-flex justify-content-end gap-2">
          <%= link_to(cable_type.persisted? ? cable_type : discipline_electrical_cable_types_path(@discipline),
                class: 'btn btn-warning',
                data: { confirm: t('actions.sure'), turbo: false }) do %>
            <%= t('actions.discard') %>
            <%== bs_icon('x-square') %>
          <% end %>

          <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
            <%= yield(:button_text) || t('actions.save') %>
            <%== bs_icon('save') %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
