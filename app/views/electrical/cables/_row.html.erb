<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.tag.nil? ? '-' : row.tag.discipline.project.code %></td>
  <% end %>
  <% if row.tag.nil? %>
    <td><%= "-" %></td>
    <td class="table-danger"><%= t("index.no_tag", id: row.id) %></td>
  <% else %>
    <td><%= row.tag.stage %></td>  
    <td><%= link_to row.tag.label, tag_path(row.tag) %></td>  
  <% end %>
  <td>
    <span title="<%= row.notes %>">
      <%= truncate(strip_tags(row.notes.to_s), length: 20) %>
    </span>
  </td>

  <td>
    <!-- From -->
    <% if row.from_type.present? %>
      <% if Constants.electrical.connect_options.include?(row.from_type) %>
        <% begin %>
          <% if row.from.present? && row.from.respond_to?(:long_label) %>
            <span><%= link_to row.from.long_label, row.from %></span>
          <% else %>
            <span class="text-warning"><%= t('index.link_unassigned', model: row.from_type) %></span>
          <% end %>
        <% rescue NameError => e %>
          <span class="text-danger"><%= t('index.invalid_type', type: row.from_type) %></span>
        <% end %>
      <% else %>
        <!-- invalid from type -->
        <span class="text-danger"><%= t('index.invalid_type', type: row.from_type) %></span>
      <% end %>
    <% else %>
      <!-- unassigned from -->
      <%= t('show.unassigned', model: row.class.human_attribute_name(:from)) %>
    <% end %>
  </td>

  <td>
    <!-- To -->
    <% if row.to_type.present? %>
      <% if Constants.electrical.connect_options.include?(row.to_type) %>
        <% begin %>
          <% if row.to.present? && row.to.respond_to?(:label) %>
            <span><%= link_to row.to.label, row.to %></span>
          <% else %>
            <span class="text-warning"><%= t('index.link_unassigned', model: row.to_type) %></span>
          <% end %>
        <% rescue NameError => e %>
          <span class="text-danger"><%= t('index.invalid_type', type: row.to_type) %></span>
        <% end %>
      <% else %>
        <!-- invalid to type -->
        <span class="text-danger"><%= t('index.invalid_type', type: row.to_type) %></span>
      <% end %>
    <% else %>
      <!-- unassigned to -->
      <%= t('show.unassigned', model: row.class.human_attribute_name(:to)) %>
    <% end %>
  </td>
  <td><%= link_to row.electrical_cable_type.id, electrical_cable_type_path(row.electrical_cable_type_id) %></td>
  <td><%= row.route_length %></td>
  <td>
    <% if can_show %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if can_edit %>
      <%= nav_button(action: :edit, record: row, path: edit_electrical_cable_path(row), icon_only: true) %>
    <% end %>
    <% if can_delete %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
