<% provide :title, "#{t('activerecord.models.' + @cable.model_name.i18n_key.to_s, default: @cable.model_name.human)} #{@cable.tag.full_tag}" %>
<div class="container mt-3">
  <!-- Cable Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@cable).index? %>
              <%= link_to electrical_cables_path,
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_cable = @cable.prev %>
            <% if prev_cable.present? %>
              <% disabled = prev_cable == @cable %>
              <%= link_to electrical_cable_path(prev_cable),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_cable.label}" do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge bg-primary fs-6">
                <%= t('.header', label: @cable.label) %>
              </span>
              <% if @cable.tag.service.present? %>
                <small class="text-muted ms-2"><%= @cable.tag.service %></small>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_cable = @cable.next %>
            <% if next_cable.present? %>
              <% disabled = next_cable == @cable %>
              <%= link_to electrical_cable_path(next_cable),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_cable.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@cable).edit? %>
                <%= link_to edit_electrical_cable_path(@cable),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@cable).destroy? %>
                <%= link_to @cable,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>


    <div class="d-flex flex-column justify-content-center">
      <div class="card-body">
      
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Tag Card -->
            <div class="row g-3 mb-3">
                <%= render 'tags/card', tag: @cable.tag %>
            </div>
          
            <!-- Cable Type Card -->
            <div class="row g-3 mb-3">
                <%= render 'electrical/cable_types/cable_type', cable_type: @cable.electrical_cable_type %>
            </div>
        
            <!-- Cable Details Card -->
            <div class="row">
              <div class="card mb-4">
                <div class="card-header py-1">
                  <h4 class="mb-0"><%= t('show.details', model: @cable.model_name.human) %></h4>
                </div>

                <div class="card-body p-3">
                  
                  <!-- From Section -->
                  <div class="row mb-1">
                    <div class="col-4 text-muted">
                      <%= @cable.class.human_attribute_name(:from) %>
                    </div>
                    <div class="col-8">
                      <span>
                        <% if @cable.from_type.present? && 
                          Constants.electrical.connect_options.include?(@cable.from_type) %>
                          <% text = @cable.from_type.constantize.model_name.human %>
                          <div class="d-flex justify-content-between align-items-center">  
                            <% if @cable.from.present? %>
                              <span><%= @cable.from.label %></span>
                              <%= link_to @cable.from,
                                class: "btn btn-sm btn-outline-secondary mb-2",
                                title: t('show.linked', model: text) do %>
                                  <%== bs_icon('link-45deg') %>
                                  <span class="d-none d-md-inline">
                                    <%= t('show.linked', model: text) %>
                                  </span>
                                <% end %>
                            <% else %>
                              <span class="text-muted">
                                <%= t('show.unassigned', model: text) %>
                              </span>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="text-muted">
                            <%= t('show.unassigned', model: @cable.class.human_attribute_name(:from)) %>
                          </span>
                        <% end %>
                      </span>
                    </div>
                  </div>
                  
                  <!-- To Section -->
                  <div class="row mb-1">
                    <div class="col-4 text-muted">
                      <%= @cable.class.human_attribute_name(:to) %>
                    </div>
                    <div class="col-8">
                      <span>
                        <% if @cable.to_type.present? && 
                          Constants.electrical.connect_options.include?(@cable.to_type) %>
                          <% text = @cable.to_type.constantize.model_name.human %>
                          <div class="d-flex justify-content-between align-items-center">  
                            <% if @cable.to.present? %>
                              <span><%= @cable.to.label %></span>
                              <%= link_to @cable.to,
                                class: "btn btn-sm btn-outline-secondary mb-2",
                                title: t('show.linked', model: text) do %>
                                  <%== bs_icon('link-45deg') %>
                                  <span class="d-none d-md-inline">
                                    <%= t('show.linked', model: text) %>
                                  </span>
                                <% end %>
                            <% else %>
                              <span class="text-muted">
                                <%= t('show.unassigned', model: text) %>
                              </span>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="text-muted">
                            <%= t('show.unassigned', model: @cable.class.human_attribute_name(:to)) %>
                          </span>
                        <% end %>
                      </span>
                    </div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:route_length) %></div>
                    <div class="col-8"><%= number_to_human(@cable.route_length, 
                      units: { unit: "m" }, precision: 2) || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:vertical_allowance) %></div>
                    <div class="col-8"><%= number_to_human(@cable.vertical_allowance, 
                      units: { unit: "m" }, precision: 2) || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:termination_allowance) %></div>
                    <div class="col-8"><%= number_to_human(@cable.termination_allowance, 
                      units: { unit: "m" }, precision: 2) || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:start_mark) %></div>
                    <div class="col-8"><%= @cable.start_mark.presence || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:end_mark) %></div>
                    <div class="col-8"><%= @cable.end_mark.presence || '-' %></div>
                  </div>
                  
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:notes) %></div>
                    <div class="col-8"><%= @cable.notes.presence || '-' %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
