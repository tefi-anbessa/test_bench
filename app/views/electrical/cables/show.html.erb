<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Cable Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@cable).index? %>
              <%= nav_button(action: :index, path: discipline_electrical_cables_path(@discipline), record: @cable) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div> <!-- end d-flex align-items-center -->
        </div> <!-- end left column -->

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @cable.long_label) %>
                <%= @cable.tag.service.presence %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@cable).edit? %>
                <%= nav_button(action: :edit, path: edit_electrical_cable_path(@cable), record: @cable) %>
              <% end %>

              <% if policy(@cable).destroy? %>
                <%= nav_button(action: :delete, path: electrical_cable_path(@cable), record: @cable) %>
              <% end %>

              <% if policy(@cable).new? %>
                <%= nav_button(action: :new, path: new_discipline_electrical_cable_path(@discipline), record: @cable) %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Cable Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @cable.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">

              <span class="border">
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/cable.notes') %></div>
                </div>
                <div class="row mb-1">
                  <div class="col-12"><%= simple_format(@cable.notes) %></div>
                </div>
              </span>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:route_length) %></div>
                <div class="col-8"><%= number_to_human(@cable.route_length, 
                  units: { unit: "m" }, precision: 2) || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:vertical_allowance) %></div>
                <div class="col-8"><%= number_to_human(@cable.vertical_allowance, 
                  units: { unit: "m" }, precision: 2) || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:termination_allowance) %></div>
                <div class="col-8"><%= number_to_human(@cable.termination_allowance, 
                  units: { unit: "m" }, precision: 2) || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:start_mark) %></div>
                <div class="col-8"><%= @cable.start_mark.presence || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:end_mark) %></div>
                <div class="col-8"><%= @cable.end_mark.presence || '-' %></div>
              </div>
            </div> <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @cable.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <!-- Cable Type Card -->
              <div class="row mb-1">
                  <%= render 'electrical/cable_types/card', 
                    object: @cable.electrical_cable_type, 
                    context: t("activerecord.models.electrical/cable_type.one") %>
              </div>
              
              <!-- From Section -->
              <div class="row mb-1">
                <!-- Trap invalid from_type -->
                <% if Constants.electrical.connect_options.include?(@cable.from_type) &&
                    @cable.from_type.safe_constantize %>
                  <%= render 'shared/association', 
                    object: @cable, 
                    association: :from %>
                <% else %>
                  <!-- Invalid from_type -->
                  <div class="col-4 text-muted">
                    <%= @cable.class.human_attribute_name(:from) %>
                  </div>
                  <div class="col-8">
                    <%= t('show.invalid', model: @cable.from_type) %>
                  </div>
                <% end %>
              </div>
              
              <!-- To Section -->
              <div class="row mb-1">
                <!-- Trap invalid to_type -->
                <% if Constants.electrical.connect_options.include?(@cable.to_type) &&
                    @cable.to_type.safe_constantize %>
                  <%= render 'shared/association', 
                    object: @cable, 
                    association: :to %>
                <% else %>
                  <!-- Invalid to_type -->
                  <div class="col-4 text-muted">
                    <%= @cable.class.human_attribute_name(:to) %>
                  </div>
                  <div class="col-8">
                    <%= t('show.invalid', model: @cable.to_type) %>
                  </div>
                <% end %>
              </div>

              <!-- Tag Card -->
              <% if @cable.tag.present? %>
                <div class="row g-3 mb-3">
                    <%= render 'tags/card', object: @cable, association: :tag %>
                </div>
              <% else %>
                <div class="row g-3 mb-3">
                  <div class="alert alert-danger">
                    <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                  </div>
                </div>
              <% end %>
          
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
