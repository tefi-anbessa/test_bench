<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Cable Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@cable).index? %>
              <%= link_to discipline_electrical_cables_path(@discipline),
                    class: "btn btn-sm btn-outline-info me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_cable = @cable.prev %>
            <% if prev_cable.present? %>
              <% disabled = prev_cable == @cable %>
              <%= link_to electrical_cable_path(prev_cable),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_cable.label}" do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @cable.label) %>
                <%= @cable.tag.service.presence %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_cable = @cable.next %>
            <% if next_cable.present? %>
              <% disabled = next_cable == @cable %>
              <%= link_to electrical_cable_path(next_cable),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_cable.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@cable).edit? %>
                <%= link_to edit_electrical_cable_path(@cable),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@cable).destroy? %>
                <%= link_to @cable,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@cable).new? %>
                <%= link_to new_discipline_electrical_cable_path(@discipline),
                  class: "btn btn-outline-primary actions",
                  aria: { label: t('actions.new') },
                  title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="ms-1">
                    <%= [t('actions.new'), t('activerecord.models.electrical/cable.one')].join(' ') %>
                  </span>
                <% end %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Cable Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @cable.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">

              <span class="border">
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/cable.notes') %></div>
                </div>
                <div class="row mb-1">
                  <div class="col-12"><%= simple_format(@cable.notes) %></div>
                </div>
              </span>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:route_length) %></div>
                <div class="col-8"><%= number_to_human(@cable.route_length, 
                  units: { unit: "m" }, precision: 2) || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:vertical_allowance) %></div>
                <div class="col-8"><%= number_to_human(@cable.vertical_allowance, 
                  units: { unit: "m" }, precision: 2) || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:termination_allowance) %></div>
                <div class="col-8"><%= number_to_human(@cable.termination_allowance, 
                  units: { unit: "m" }, precision: 2) || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:start_mark) %></div>
                <div class="col-8"><%= @cable.start_mark.presence || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @cable.class.human_attribute_name(:end_mark) %></div>
                <div class="col-8"><%= @cable.end_mark.presence || '-' %></div>
              </div>
            </div> <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @cable.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <!-- Tag Card -->
              <div class="row mb-1">
                  <%= render 'tags/card', 
                    object: @cable.tag, 
                    context: t("activerecord.models.tag.one") %>
              </div>
          
              <!-- Cable Type Card -->
              <div class="row mb-1">
                  <%= render 'electrical/cable_types/card', 
                    object: @cable.electrical_cable_type, 
                    context: t("activerecord.models.electrical/cable_type.one") %>
              </div>
              
              <!-- From Section -->
              <div class="row mb-1">
                  <%= render 'shared/association', 
                    object_type: @cable.from_type, 
                    object_id: @cable.from_id,
                    allowed_types: Constants.electrical.connect_options,
                    context: t("activerecord.attributes.electrical/cable.from") %>
              </div>
              
              <!-- To Section -->
              <div class="row mb-1">
                  <%= render 'shared/association', 
                    object_type: @cable.to_type, 
                    object_id: @cable.to_id, 
                    allowed_types: Constants.electrical.connect_options, 
                    context: t("activerecord.attributes.electrical/cable.to") %>
              </div>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
