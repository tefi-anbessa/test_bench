<!-- Cable collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% cable = object %>
<% context ||= t("activerecord.models.electrical/cable.one") %>
<%= render 'components/collapsible',
      id: "#{id}_#{cable.id}_details",
      title: [context, cable.long_label].join(': '),
      expanded: false,
      header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: cable) %>
    <%= nav_link(action: :show, record: cable.electrical_cable_type) %>

    <%= show_attribute(cable, :route_length, type: :float, units: "m") %>
    <%= show_attribute(cable, :vertical_allowance, type: :float, units: "m") %>
    <%= show_attribute(cable, :termination_allowance, type: :float, units: "m") %>
    <%= show_attribute(cable, :start_mark, type: :integer, units: "m") %>
    <%= show_attribute(cable, :end_mark, type: :integer, units: "m") %>
    <%= show_attribute(cable, :notes, type: :text) %>

    <%= show_attribute(cable, :from, type: :association) %>
    <%= show_attribute(cable, :to, type: :association) %>
  </div>
<% end %>
