<% cable = object %>

<%= render 'components/collapsible',
      id: "cable_#{cable.id}_details",
      title: [context, cable.long_label].join(': '),
      expanded: false,
      header_class: 'py-1' do %>
  
  <div class="container-fluid">

    <div class="row mb-1">
      <% text = t("actions.jump_to", model: cable.model_name.human) %>
      <%= link_to electrical_cable_path(cable), 
        class: "btn btn-sm btn-outline-secondary me-2",
        title: text do %>
          <%== bs_icon('box-arrow-in-up-left') %>
          <span class="d-none d-md-inline"><%= text %></span>
        <% end %>
    </div>

    <!-- Cable Type card -->
    <div class="row mb-1">
      <%= render 'electrical/cable_types/card', object: cable.electrical_cable_type %>
    </div>

    <dl class="row mb-0">
      <dt class="col-6"><%= t('activerecord.attributes.electrical/cable.route_length') %></dt>
      <dd class="col-6"><%= cable.route_length %> m</dd>
      
      <dt class="col-6"><%= t('activerecord.attributes.electrical/cable.vertical_allowance') %></dt>
      <dd class="col-6"><%= cable.vertical_allowance %> m</dd>
      
      <dt class="col-6"><%= t('activerecord.attributes.electrical/cable.termination_allowance') %></dt>
      <dd class="col-6"><%= cable.termination_allowance %> m</dd>
      
      <dt class="col-6"><%= t('activerecord.attributes.electrical/cable.start_mark') %></dt>
      <dd class="col-6"><%= cable.start_mark %></dd>
      
      <dt class="col-6"><%= t('activerecord.attributes.electrical/cable.end_mark') %></dt>
      <dd class="col-6"><%= cable.end_mark %></dd>
    </dl>
  </div>
<% end %>
