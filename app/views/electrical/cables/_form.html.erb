<div class="container mt-3" style="<%= container_styles(swatch) %>">
  <div class="card" style="<%= card_styles(swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(swatch) %>">
            <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: cable,
          url: cable.persisted? ?
            cable : 
            ( tag.persisted? ?
              tag_electrical_cables_path(tag) :
              discipline_electrical_cables_path(discipline) ),
          layout: :horizontal, 
          label_col: "col-sm-4", 
          control_col: "col-sm-8",
          wrapper_class: 'mb-1'
          ) do |f| %>

      <div class="card-body p-2" style="<%= card_styles(swatch) %>">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Tag -->
            <div class="card mb-1">
              <%= f.fields_for tag do |tag_f| %>
                <%= render 'tags/form_nested', tag_f: tag_f, tag: tag %>
              <% end %>
            </div>

            <!-- Cable Details -->
            <div class="card mb-1" style="<%= card_styles(swatch) %>">
              <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">
                <h5><%= t('activerecord.models.electrical/cable.one') %></h5>
              </div>
              
              <div class="card-body p-2" style="<%= form_styles(swatch) %>">
                <%= render 'shared/error_messages', object: f.object %>

                <!-- Cable Type -->
                <% collection = options_for_select(cable_type_options, selected: cable.electrical_cable_type_id) %>
                <%= form_field(f, :electrical_cable_type_id, type: :select, collection: collection, required: true) %>
                    
                <div data-controller="cable-form" 
                  data-cable-form-id-options-value="<%= @id_options.to_json %>">

                  <!-- From Section -->
                  <div class="row">
                    <%= f.select :from_type,
                      options_for_select(@connect_options, selected: cable.from_type),
                      {include_blank: t("form.optional")},
                      { 
                        class: 'form-select form-select-sm',
                        'data-cable-form-target': 'fromType',
                        'data-action': 'change->cable-form#updateFromOptions'
                      } %> 
                  </div>
                  <div class="row">
                    <%= f.select :from_id, 
                        options_for_select(@id_options[cable.from_type] || [], 
                        selected: cable.from_id), 
                        {include_blank: t("form.optional")},
                        { 'data-cable-form-target': 'fromId' } %>
                  </div>

                  <!-- To Section --> 
                  <div class="row">
                    <%= f.select :to_type, 
                        options_for_select(@connect_options, selected: cable.to_type),
                        {include_blank: t("form.optional")},
                          { 
                            class: 'form-select form-select-sm', 
                            'data-cable-form-target': 'toType',
                            'data-action': 'change->cable-form#updateToOptions'
                          } %>
                  </div>
                  <div class="row">
                    <%= f.select :to_id,
                          options_for_select(@id_options[cable.to_type] || [], 
                          selected: cable.to_id), 
                          {include_blank: t("form.optional")},
                          { 'data-cable-form-target': 'toId' } %>
                  </div>

                  <!-- Design lengths -->
                  <%= form_field(f, :route_length, type: :number, min: 0, step: 0.1, units: "m", control_cols: 4) %>
                  <%= form_field(f, :vertical_allowance, type: :number, min: 0, step: 0.1, units: "m", control_cols: 4) %>
                  <%= form_field(f, :termination_allowance, type: :number, min: 0, step: 0.1, units: "m", control_cols: 4) %>
                  <%= form_field(f, :start_mark, type: :number, min: 0, step: 0.1, units: "m", control_cols: 4) %>
                  <%= form_field(f, :end_mark, type: :number, min: 0, step: 0.1, units: "m", control_cols: 4) %>
                  <%= form_field(f, :notes, type: :text) %>
                </div> <!-- end div data controller -->
              </div> <!-- end cable card body -->
            </div> <!-- end cable card -->

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%= link_to(cable.persisted? ? cable : discipline_electrical_cables_path(@discipline),
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>
              <%= f.button :submit, class: 'btn btn-primary' do %>
                <%= yield(:button_text) || t('actions.save') %>
                <%== bs_icon('save') %>
              <% end %>
            </div>
          </div> <!-- end responsive columns -->
        </div> <!-- end row  justify content centre -->
      </div> <!-- end card body -->
    <% end %>
  </div> <!-- end card -->
</div> <!-- end container -->
