<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch) %>">
  <!-- Cable Schedule Card Header-->
  <div class="card mb-1" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-1" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <!-- Discipline and project links -->
        <div class="col-2">
          <%= nav_button(action: :show_project, record: @discipline.project) %>
          <%= nav_button(action: :show_discipline, record: @discipline) %>
        </div>

        <!-- Header Text (Left) -->
        <div class="col-8">
          <% scope_text = [@discipline.project.label, @discipline.model_name.human, @discipline.label].join(' ')  %>
          <h5><%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 text-end">
          <% if @discipline.present? && policy(Electrical::Cable).new? %>
            <%= nav_button(action: :new, path: new_discipline_tagable_path(@discipline, tagable_type: "Electrical::Cable"),
                record: Electrical::Cable.new) %>
          <% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->
    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: discipline_tagables_path(@discipline) do |f| %>
          <%= hidden_field_tag :tagable_type, @type %>
          <%= f.search_field :electrical_cable_type_code_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical/cable.electrical_cable_type') %>
          <%= f.search_field :notes_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical/cable.notes') %>
          <%= f.button class: "btn btn-outline-primary btn-sm mb-1", type: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!-- Broken and incomplete links -->
      <% unless @link_broken.empty? %>
        <table id='link_broken' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-danger">
              <td colspan="<%= 9 + (current_project ? 1 : 0) %>">
                <%= t('index.link_broken', 
                count: @link_broken.count,
                models: t('activerecord.models.electrical/cable', count: @link_broken.count)) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_broken.each do |tag| %>
              <%= render 'tags/row', row: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <% unless @link_incomplete.empty? %>
        <table id='link_incomplete' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-warning">
              <td colspan="<%= 9 + (current_project ? 1 : 0) %>">
                <%= t('index.link_incomplete', 
                count: @link_incomplete.count,
                models: t('activerecord.models.electrical/cable', count: @link_incomplete.count)) %>
              </td>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_incomplete.each do |tag| %>
              <%= render 'tags/row', row: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <!-- Cables -->
      <!-- Policies for tagables are invariable over the scope , so no need to look up policy for each record. -->
      <% can_show = policy(@discipline.tags.build()).show? %>
      <% can_edit = policy(@discipline.tags.build()).edit? %>
      <% can_delete = policy(@discipline.tags.build()).destroy? %>
      <table id='cables' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render "electrical/cables/header" %>
        <tbody>
          <% unless @orphans.empty? %>
            <tr class="table-danger">
              <td colspan="10">
                <%= t('index.orphans',
                      count: @orphans.count,
                      models: t('activerecord.models.electrical/cable', count: @orphans.count)) %>
              </td>
            </tr>
            <% @orphans.each do |row| %>
              <%= render "electrical/cables/row", row: row, can_show: can_show, can_edit: can_edit, can_delete: can_delete %>
            <% end %>
            <tr class="table-success">
              <td colspan="10">
                <%= t('.title') %>
              </td>
            </tr>
          <% end %>
          <% @cables.each do |row| %>
            <%= render "electrical/cables/row", row: row, can_show: can_show, can_edit: can_edit, can_delete: can_delete %>
          <% end %>
        </tbody>
      </table>
    </div> <!-- card body -->
    <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
      <%== pagy_bootstrap_nav(@pagy, classes: 'pagination pagination-sm') %>
      <%== pagy_info(@pagy) %>
      <%== pagy_limit_selector_js(@pagy) %>
    </div> <!-- card footer -->
  </div> <!-- card -->
</div> <!-- container -->
