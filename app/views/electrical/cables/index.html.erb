<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch) %>">
  <!-- Cable Schedule Card Header-->
  <div class="card mb-1" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-1" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <div class="col-2">
            <%= link_to discipline_path(@discipline), class: "btn btn-sm btn-outline-info" do %>
              <%= @discipline.name %>
              <%= bs_icon('collection', class: "me-1") %>
            <% end %>
        </div>

        <!-- Header Text (Left) -->
        <div class="col-8">
          <h5><%= t('.header',
            scope_text: [@discipline.project.code, 
                          t("activerecord.models.discipline.one"), 
                          @discipline.code].join(' ')) %>
          </h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 text-end">
          <% if policy(Electrical::Cable).new? %>
              <%= link_to new_discipline_electrical_cable_path(@discipline), 
                class: "btn btn-sm btn-outline-primary actions",
                aria: { label: t('actions.new') },
                title: t('actions.new') do %>
                <%== bs_icon('plus-square-fill') %>
                <span class="ms-1"><%= [t('actions.new'), t('activerecord.models.electrical/cable.one')].join(' ') %></span>
              <% end %>
          <% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->
    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: discipline_electrical_cables_path(@discipline) do |f| %>
          <%= f.search_field :electrical_cable_type_code_cont,
                class: "search_field",
                placeholder: t('activerecord.models.electrical/cable_type') %>
          <%= f.search_field :notes_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical/cable.notes') %>
          <%= f.button class: "btn btn-outline-primary btn-sm mb-1", type: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!-- Broken and incomplete links -->
      <% unless @link_broken.empty? %>
        <table id='link_broken' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-danger">
              <td colspan="<%= 9 + (current_project ? 1 : 0) %>">
                <%= t('index.link_broken', 
                count: @link_broken.count,
                models: t('activerecord.models.electrical/cable', count: @link_broken.count)) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_broken.each do |tag| %>
              <%= render 'tags/row', t: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <% unless @link_incomplete.empty? %>
        <table id='link_incomplete' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-warning">
              <td colspan="<%= 9 + (current_project ? 1 : 0) %>">
                <%= t('index.link_incomplete', 
                count: @link_incomplete.count,
                models: t('activerecord.models.electrical/cable', count: @link_incomplete.count)) %>
              </td>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_incomplete.each do |tag| %>
              <%= render 'tags/row', t: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <!-- Cables -->
      <table id='cables' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% unless @orphans.empty? %>
            <tr class="table-danger">
              <td colspan="10">
                <%= t('index.orphans', 
                      count: @orphans.count,
                      models: t('activerecord.models.electrical/cable', count: @orphans.count)) %>
              </td>
            </tr>
            <% @orphans.each do |row| %>
              <%= render 'row', row: row %>
            <% end %>
            <tr class="table-success">
              <td colspan="10">
                <%= t('.title') %>
              </td>
            </tr>
          <% end %>
          <% @cables.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    </div> <!-- card body -->
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div> <!-- card footer -->
  </div> <!-- card -->
</div> <!-- container -->
