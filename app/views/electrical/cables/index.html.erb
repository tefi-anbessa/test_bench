<% provide(:title, t('.title')) %>
<nav class="navbar bg-body-tertiary">
  <div class="container">
    <ul class="navbar-nav me-auto mb-2 mb-lg-0 flex-row">
      <% if policy(Electrical::Cable).new? %>
        <li class="nav-item">
          <%= link_to new_electrical_cable_path, class: "btn btn-primary actions",
                aria: { label: t('actions.new') },
                title: t('actions.new')  do %>
            <%== bs_icon('plus-square-fill') %>
            <%= t('actions.new') + " " + t('activerecord.models.cable') %>
          <% end %>
        </li>
      <% end %>
      <span class="nav-text ms-3 me-3 h2">
        <%= t('.header')%>
      </span>
    </ul>
  </div>
</nav>

<div class = "container">
  <% unless @link_errors.empty? %>
    <table id='tags' class='table table-responsive table-condensed table-hoverable table-bordered' >
      <%= render 'tags/tag_header' %>
      <tbody>
        <% unless @link_broken.empty? %>
          <tr class="table-danger">
            <td colspan="4">
              <%= t('index.link_broken', models: t("activerecord.models.cable").tableize) %>
            </td>
          </tr>
          <% @link_broken.each do |tag| %>
            <%= render 'tags/tag_row', t: tag %>
          <% end %>
        <% end %>
        <% unless @link_incomplete.empty? %>
          <tr class="table-warning">
            <td colspan="4">
              <%= t('index.link_incomplete', models: t("activerecord.models.cable").tableize) %>
            </td>
          </tr>
          <% @link_incomplete.each do |tag| %>
            <%= render 'tags/tag_row', t: tag %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <div class = 'listing'>
    <%== pagy_bootstrap_nav(@pagy) %>
    <table id='cables' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
      <%= render 'cable_header', cable: @cables.first %>
      <tbody>
        <% unless @orphans.empty? %>
          <tr class="table-danger">
            <td colspan="10">
              <%= t('index.orphans', models: t("activerecord.models.cable").tableize) %>
            </td>
          </tr>
          <% @orphans.each do |cable| %>
            <%= render 'cable_row', row: cable %>
          <% end %>
        <% end %>
        <tr class="table-success">
          <td colspan="10">
            <%= t('.title') %>
          </td>
        </tr>
        <% @cables.each do |cable| %>
          <%= render 'cable_row', row: cable %>
        <% end %>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
    <%== pagy_info(@pagy) %>
  </div>
</div>
