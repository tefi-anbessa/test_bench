  <tr scope="row">
    <% if d.tag.nil? %>
      <td class="table-danger"><%= t('table.missing', model: t("activerecord.models.tag")) %>: ID <%= d.id %></td>
    <% else %>
      <td><%= link_to d.tag.label, tag_path(d.tag) %></td>
    <% end %>
    <!-- circuit -->
    <td>
      <% if d.incomer&.from&.present? %>
        <%= link_to d.incomer.from.long_label, d.incomer.from %>
      <% else %>
        <%= t('show.unassigned', model: t("activerecord.models.electrical.circuit.one")) %>
      <% end %>
    </td>
    <!-- incomer -->
    <td>
      <% if d.incomer&.present? %>
        <%= link_to d.incomer.label, d.incomer %>
      <% else %>
        <%= t('show.unassigned', model: t("activerecord.models.electrical.cable.one")) %>
      <% end %>
    </td>
    <td><%= d.class.human_enum_name(:basis, d.basis) %></td>
    <td><%= d.class.human_enum_name(:config, d.config) %></td>
    <!-- Safe number formatting with nil handling -->
    <td><%= number_to_human(d.supply, precision: 4, units: { unit: "V", thousand: "kV" }) || '-' %></td>
    <td><%= number_to_human(d.power, precision: 4, units: { unit: "W", thousand: "kW", million: "MW" }) || '-' %></td>
    <td><%= number_to_human(d.vector, precision: 4, units: { unit: "VA", thousand: "kVA", million: "MVA" }) || '-' %></td>
    <td><%= number_to_human(d.current, precision: 4, units: { unit: "A", thousand: "kA" }) || '-' %></td>
    <td><%= d.power_factor.presence || '-' %></td>
    <td><%= d.duty.presence || '-' %></td>
    <% if d.demandable.present? %>
      <td><%= link_to d.demandable.model_name.human, url_for(d.demandable) %></td>
    <% else %>
      <td><%= d.demandable_type || '-' %></td>
    <% end %>
    <td>
      <% if policy(d).show? %>
        <%= link_to d, class: "btn btn-outline-info btn-sm icon-link",
              aria: { label: t('actions.show') },
              title: t('actions.show'),
              display: "inline" do %>
          <%== bs_icon('eye') %>
        <% end %>
      <% end %>
      <% if policy(d).edit? %>
        <%= link_to edit_electrical_demand_path(d), class: "btn btn-outline-warning btn-sm icon-link",
              aria: { label: t('actions.edit') },
              title: t('actions.edit'),
              display: "inline"  do %>
          <%== bs_icon('pencil') %>
        <% end %>
      <% end %>
      <% if policy(d).destroy? %>
        <%= link_to d, method: :delete, class: "btn btn-outline-danger btn-sm icon-link",
              aria: { label: t('actions.delete') },
              title: t('actions.delete'),
              display: "inline"  do %>
          <%== bs_icon('trash') %>
        <% end %>
      <% end %>
    </td>
  </tr>
