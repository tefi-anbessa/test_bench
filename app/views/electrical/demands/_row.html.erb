<tr scope="row">
  <% if row.tag.nil? %>
    <td class="table-danger"><%= t('table.missing', model: t("activerecord.models.tag")) %>: ID <%= row.id %></td>
  <% else %>
    <td><%= link_to row.tag.label, tag_path(row.tag) %></td>
  <% end %>
  <td>
    <span title="<%= row.notes %>">
      <%= truncate(strip_tags(row.notes.to_s), length: 20) %>
    </span>
  </td>
  <!-- circuit -->
  <td>
    <% if row.incomer&.from&.present? %>
      <%= link_to row.incomer.from.long_label, row.incomer.from %>
    <% else %>
      <%= t('show.unassigned', model: t("activerecord.models.electrical/circuit.one")) %>
    <% end %>
  </td>
  <!-- incomer -->
  <td>
    <% if row.incomer&.present? %>
      <%= link_to row.incomer.label, row.incomer %>
    <% else %>
      <%= t('show.unassigned', model: t("activerecord.models.electrical/cable.one")) %>
    <% end %>
  </td>
  <td><%= row.class.human_enum_name(:basis, row.basis) %></td>
  <td><%= row.class.human_enum_name(:config, row.config) %></td>
  <!-- Safe number formatting with nil handling -->
  <td><%= number_to_human(row.supply, precision: 4, units: { unit: "V", thousand: "kV" }) || '-' %></td>
  <td><%= number_to_human(row.power, precision: 4, units: { unit: "W", thousand: "kW", million: "MW" }) || '-' %></td>
  <td><%= number_to_human(row.vector, precision: 4, units: { unit: "VA", thousand: "kVA", million: "MVA" }) || '-' %></td>
  <td><%= number_to_human(row.current, precision: 4, units: { unit: "A", thousand: "kA" }) || '-' %></td>
  <td><%= row.power_factor.presence || '-' %></td>
  <td><%= row.duty.presence || '-' %></td>
  <% if row.demandable.present? %>
    <td><%= link_to row.demandable.model_name.human, url_for(row.demandable) %></td>
  <% else %>
    <td><%= row.demandable_type || '-' %></td>
  <% end %>
  <td>
    <% if can_show %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if can_edit %>
      <%= nav_button(action: :edit, record: row, path: edit_electrical_demand_path(row), icon_only: true) %>
    <% end %>
    <% if can_delete %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
