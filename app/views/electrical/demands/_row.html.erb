<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.tag&.nil? ? '-' : row.tag.discipline.project.code %></td>
  <% end %>
  <% if row.tag&.nil? %>
    <td>'-'</td>
    <td class="table-danger"><%= t("index.no_tag", id: row.id) %></td>
  <% else %>
    <td><%= row.tag.stage %></td>
    <td><%= index_link(action: :show_tag, record: row.tag) %></td>
  <% end %>
  <td><%= index_link(action: :up, record: row.demandable) %></td>
  <td>
    <span title="<%= row.notes %>">
      <%= truncate(strip_tags(row.notes.to_s), length: 20) %>
    </span>
  </td>
  <!-- circuit -->
  <td><%= index_link(action: :show, record: row.circuit) %></td>
  <!-- incomer -->
  <td><%= index_link(action: :show, record: row.incomer) %></td>
  <!-- Safe number formatting with nil handling -->
  <td><%= number_to_human(row.supply, precision: 4, units: { unit: "V", thousand: "kV" }) || '-' %></td>
  <td><%= number_to_human(row.power, precision: 4, units: { unit: "W", thousand: "kW", million: "MW" }) || '-' %></td>
  <td><%= number_to_human(row.vector, precision: 4, units: { unit: "VA", thousand: "kVA", million: "MVA" }) || '-' %></td>
  <td><%= number_to_human(row.current, precision: 4, units: { unit: "A", thousand: "kA" }) || '-' %></td>
  <td><%= row.power_factor.presence || '-' %></td>
  <td><%= row.duty.presence || '-' %></td>
  <td>
    <% if can_show %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if can_edit %>
      <%= nav_button(action: :edit, record: row, path: edit_electrical_demand_path(row), icon_only: true) %>
    <% end %>
    <% if can_delete %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
