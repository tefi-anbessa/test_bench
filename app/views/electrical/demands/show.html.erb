<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Load Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@demand).index? %>
              <%= nav_button(action: :index, path: discipline_electrical_demands_path(@discipline), record: @demand) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div> <!-- end d-flex align-items-center -->
        </div> <!-- end left column -->

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @demand.long_label)%>
                <%= @demand.tag.service %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@demand).edit? %>
                <%= nav_button(action: :edit, path: edit_electrical_demand_path(@demand), record: @demand) %>
              <% end %>

              <% if policy(@demand).destroy? %>
                <%= nav_button(action: :delete, record: @demand) %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Load Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @demand.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <%= show_attribute(@demand, :notes, type: :text) %>
              <%= show_attribute(@demand, :basis, type: :enum_translated) %>
              <%= show_attribute(@demand, :basis_notes, type: :text) %>
              <%= show_attribute(@demand, :supply, type: :float, units: "V", precision: 4, si: true) %>
              <%= show_attribute(@demand, :config, type: :enum_translated) %>
              <%= show_attribute(@demand, :power, type: :float, units: "W", precision: 4, si: true) %>
              <%= show_attribute(@demand, :power_factor, type: :float) %>
              <%= show_attribute(@demand, :vector, type: :float, units: "VA", precision: 4, si: true) %>
              <%= show_attribute(@demand, :current, type: :float, units: "A", precision: 4, si: true) %>
              <%= show_attribute(@demand, :duty, type: :float) %>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @demand.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <!-- Demandable Card -->
              <%= show_association(@demand, :demandable) %>

              <!-- Circuit Section -->
              <%= show_association(@demand, :circuit) %>

              <!-- Incomer Section -->
              <%= show_association(@demand, :incomer) %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
