<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Load Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@demand).index? %>
              <%= link_to discipline_electrical_demands_path(@discipline),
                    class: "icon-link btn btn-sm btn-outline-info me-2 actions",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <%= t('actions.index') %>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_demand = @demand.prev %>
            <% if prev_demand.present? %>
              <% disabled = prev_demand == @demand %>
              <%= link_to prev_demand,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_demand.tag&.full_tag}" do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @demand.label)%>
                <%= @demand.tag.service %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_demand = @demand.next %>
            <% if next_demand.present? %>
              <% disabled = next_demand == @demand %>
              <%= link_to next_demand,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_demand.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@demand).edit? %>
                <%= link_to edit_electrical_demand_path(@demand),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@demand).destroy? %>
                <%= link_to @demand,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div> <!--- end of col auto -->
      </div> <!--- end of header row -->
    </div> <!--- end of outer card header -->


    <div class="card-body"> <!--- outer card body -->
      <div class="d-flex flex-column justify-content-center">

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Demandable Card -->
            <% model = @demand.demandable_type.tableize.singularize %>
            <% partial = "#{model.pluralize}/card" %>
            <% if lookup_context.exists?(partial, [], true) %>
              <div class="row g-3 mb-3">
                <%= render partial, object: @demand.demandable %>
              </div>
            <% else %>
              <div class="row mb-1">
                <% model_text = t("activerecord.models.#{@demand.demandable.model_name.i18n_key}.one") %>
                <% text = t("actions.jump_to", model: model_text) %>
                <% path = begin
                  polymorphic_path([@demand.demandable])
                rescue NoMethodError, ActionController::UrlGenerationError
                  '#'
                end %>
                <% text = t("actions.jump_to", model: model_text) %>
                <%= link_to path,
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: text do %>
                  <%== bs_icon('box-arrow-in-up-left') %>
                  <span class="d-none d-md-inline"><%= text %></span>
                <% end %>
              </div>
            <% end %>

            <!-- Load Details Card -->
            <div class="card mb-4" style="<%= card_styles(@swatch) %>"> <!-- load details inner card -->
              <div class="card-body p-3">

                  <!-- Circuit Section -->
                  <div class="row mb-1">
                    <div class="col-4 text-muted">
                      <%= @demand.class.human_attribute_name(:circuit) %>
                    </div>
                    <div class="col-8">
                      <% if @demand.circuit.present? %>
                        <% text = t("activerecord.models.electrical/circuit.one") %>
                        <div class="d-flex justify-content-between align-items-center">
                          <span><%= @demand.circuit.label %></span>
                          <%= link_to @demand.circuit,
                                class: "btn btn-sm btn-outline-secondary mb-2",
                                title: t('show.linked', model: text) do %>
                                  <%== bs_icon('box-arrow-in-right') %>
                                  <span class="d-none d-md-inline"><%= t('show.linked', model: text) %></span>
                                <% end %>
                        </div>
                      <% else %>
                        <span class="text-muted">
                          <%= t('show.unassigned', model: t("activerecord.models.electrical/circuit.one")) %>
                        </span>
                      <% end %>
                    </div>
                  </div>

                  <!-- Incomer Section -->
                  <div class="row mb-1">
                    <div class="col-4 text-muted">
                      <%= @demand.class.human_attribute_name(:incomer) %>
                    </div>
                    <div class="col-8">
                      <% if @demand.incomer.present? %>
                        <% text = t("activerecord.models.electrical/cable.one") %>
                        <div class="d-flex justify-content-between align-items-center">
                          <span><%= @demand.incomer.label %></span>
                          <%= link_to @demand.incomer,
                                class: "btn btn-sm btn-outline-secondary mb-2",
                                title: t('show.linked', model: text) do %>
                                  <%== bs_icon('box-arrow-in-right') %>
                                  <span class="d-none d-md-inline"><%= t('show.linked', model: text) %></span>
                                <% end %>
                        </div>
                      <% else %>
                        <span class="text-muted">
                          <%= t('show.unassigned', model: @demand.class.human_attribute_name(:incomer)) %>
                        </span>
                      <% end %>
                    </div>
                  </div>

                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.basis") %></div>
                  <div class="col-8"><%= @demand.class.human_enum_name(:basis, @demand.basis) %></div>
                </div>

                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.basis_notes") %></div>
                  <div class="col-8"><%= @demand.basis_notes.present? ?
                    simple_format(@demand.basis_notes) : '-' %></div>
                </div>

                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.supply") %></div>
                  <div class="col-8"><%= number_to_human(@demand.supply, precision: 4,
                                          units: { unit: "V", thousand: "kV"}) %></div>
                </div>

                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.config") %></div>
                  <div class="col-8"><%= @demand.class.human_enum_name(:config, @demand.config) %></div>
                </div>

                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.power") %></div>
                  <div class="col-8"><%= number_to_human(@demand.power, precision: 4,
                                          units: { unit: "W", thousand: "kW", million: "MW"}) %></div>
                </div>

                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.vector") %></div>
                  <div class="col-8"><%= number_to_human(@demand.vector, precision: 4,
                                          units: { unit: "VA", thousand: "kVA", million: "MVA"}) %></div>
                </div>

                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.power_factor") %></div>
                  <div class="col-8"><%= @demand.power_factor || '-'%></div>
                </div>

                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.current") %></div>
                  <div class="col-8"><%= number_to_human(@demand.current, precision: 4,
                                          units: { unit: "A", thousand: "kA", million: "MA"}) %></div>
                </div>

                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.duty") %></div>
                  <div class="col-8"><%= @demand.duty %></div>
                </div>

                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.notes") %></div>
                  <div class="col-8"><%= @demand.notes.present? ?
                    simple_format(@demand.notes) : '-' %></div>
                </div>
              </div> <!-- end of load details inner card body -->
            </div> <!-- end of load details inner card -->
          </div> <!-- end of responsive columns -->
        </div> <!-- end of row -->
      </div> <!-- end of d-flex column -->
    </div> <!-- end of outer card body -->
  </div> <!-- end of outer card -->
</div> <!-- end of container -->
