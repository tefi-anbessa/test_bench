<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch) %>">
  <!-- Motor Schedule Card Header -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2 mb-1">

        <!-- Discipline link -->
        <div class="col-2">
            <%= link_to discipline_path(@discipline), class: "btn btn-sm btn-outline-info" do %>
              <%= @discipline.name %>
              <%= bs_icon('collection', class: "me-1") %>
            <% end %>
        </div>

        <!-- Header Text (Left - 8 columns) -->
        <div class="col-8">
          <% scope_text = current_project.present? ? 
          [current_project.class.model_name.human, current_project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project').pluralize) %>
          <h5><%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <!-- No new button from index, demand requires a tag -->
      </div> <!-- end of row -->
    </div> <!-- end of card header -->
    
    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: discipline_electrical_demands_path(@discipline) do |f| %>
          <%= f.search_field :basis_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.demand.basis') %>
          <%= f.search_field :basis_notes_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.demand.basis_notes') %>
          <%= f.search_field :config_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.demand.config') %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!-- Demands -->
      <table id='demands' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% unless @orphans.empty? %>
            <tr class="table-danger">
              <td colspan="13">
                <%= t('index.orphans', models: t("activerecord.models.demand").tableize) %>
              </td>
            </tr>
            <% @orphans.each do |demand| %>
              <%= render 'row', d: demand %>
            <% end %>
            <tr class="table-success">
              <td colspan="13">
                <%= t('.title') %>
              </td>
            </tr>
          <% end %>
          <% @demands.each do |demand| %>
            <%= render 'row', d: demand %>
          <% end %>
        </tbody>
      </table>
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div> <!-- end of card-body -->
  </div> <!-- end of card -->
</div>
