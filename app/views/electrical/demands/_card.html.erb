<!-- Load collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% demand = object %>
<% context ||= t('activerecord.models.electrical/demand.one') %>
<%= render 'components/collapsible',
  id: "#{id}_#{demand.id}_details",
  title: [context, demand.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: demand) %>

    <%= show_attribute(demand, :notes, type: :text) %>
    <%= show_attribute(demand, :basis, type: :enum_translated) %>
    <%= show_attribute(demand, :basis_notes, type: :text) %>
    <%= show_attribute(demand, :supply, type: :float, units: "V") %>
    <%= show_attribute(demand, :config, type: :enum_translated) %>
    <%= show_attribute(demand, :power, type: :float, units: "VA") %>
    <%= show_attribute(demand, :power_factor, type: :float) %>
    <%= show_attribute(demand, :current, type: :float, units: "A") %>
    <%= show_attribute(demand, :duty, type: :float) %>
  </div>
<% end %>