<% text = t('activerecord.models.electrical.demand.one') %>
<% if row.electrical_demand.present? %>
  <%= link_to row.electrical_demand,
    class: "btn btn-sm btn-outline-info",
    title: t('show.linked', model: text) do %>
      <%== bs_icon('box-arrow-in-down-right') %>
      <%= text %>
    <% end %>
<% else %>
  <% if row.tag&.present? %>
    <% if policy(Electrical::Demand).new? %>
      <%= link_to new_tag_electrical_demand_path(row.tag.id),
        class: "btn btn-sm btn-outline-primary",
        title: t('actions.link', resource: text) do %>
          <%== bs_icon('link') %>
          <%= text %>
        <% end %>
    <% else %>
      <span class="d-none d-md-inline">
        <%= t('index.unassigned') %>
      </span>
    <% end %>
  <% end %>
<% end %>