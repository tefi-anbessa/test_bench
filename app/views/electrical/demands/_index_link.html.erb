<% text = t('activerecord.models.electrical/demand.one') %>
<% if row.electrical_demand.present? %>
  <%= index_link(action: :down, record: row.electrical_demand) %>
<% else %>
  <% if row.tag&.present? %>
    <% if policy(Electrical::Demand).new? %>
      <%= index_link(action: :link, path: new_tag_electrical_demand_path(row.tag.id), record: Electrical::Demand.new) %>
    <% else %>
      <span class="d-none d-md-inline">
        <%= t('index.unassigned') %>
      </span>
    <% end %>
  <% end %>
<% end %>