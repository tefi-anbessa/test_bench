<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(@swatch) %>">
            <%= yield(:header) %>
            <% if tag.present? && tag.persisted? %>
              <small class="text-muted ms-2"><%= tag.service %></small>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: demand,
        url: demand.persisted? ? edit_electrical_demand_path(demand) : tag_electrical_demands_path(tag),
        layout: :horizontal, 
        label_col: "col-sm-4", 
        control_col: "col-sm-8") do |f| %>

      <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
        <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <div class="row">
              <%= f.select :basis, 
                    demand.class.bases.keys.collect { |basis| [demand.class.human_enum_name(:basis, basis), basis] },
                    help: t('activerecord.help.electrical.demand.basis') %>
            </div>
            
            <div class="row">
              <%= f.text_area :basis_notes,
                  help: t('activerecord.help.electrical.demand.basis_notes') %>
            </div>

            <div class="row">
              <%= f.select :config, 
                    demand.class.configs.keys.collect { |config| [demand.class.human_enum_name(:config, config), config] },
                    help: t('activerecord.help.electrical.demand.config') %>
            </div>

            <div class="row">
              <%= f.select :supply, Constants.electrical.supply.to_h.invert,
                  include_blank: t("form.other"),
                  help: t('activerecord.help.electrical.demand.supply') %>
              <%= f.number_field :other_supply,
                append: "V",
                  help: t('activerecord.help.electrical.demand.other_supply') %>
            </div>

            <% disabled = [:current, :power, :vector, :power_factor] %>
            <% case demand.basis %>
            <% when "summation" %>
            <% when "power_pf" %>
              <% disabled.delete(:power) %>
              <% disabled.delete(:power_factor) %>
            <% when "vector_pf" %>
              <% disabled.delete(:vector) %>
              <% disabled.delete(:power_factor) %>
            <% when "current_pf" %>
              <% disabled.delete(:current) %>
              <% disabled.delete(:power_factor) %>
            <% when "current_power" %>
              <% disabled.delete(:current) %>
              <% disabled.delete(:power) %>
            <% end %>
        
            <div class="row">
              <%= f.number_field :current,
                    value: number_to_human(f.object.current, precision: 4),
                    disabled: disabled.include?(:current), append: "A" %>
            </div>

            <div class="row">
              <%= f.number_field :power,
                    value: number_to_human(f.object.power, precision: 4),
                    disabled: disabled.include?(:power), append: "W" %>
            </div>

            <div class="row">
              <%= f.number_field :power_factor, in: -1.0 .. 1.0, step: 0.01,
                    disabled: disabled.include?(:power_factor) %>
            </div>

            <div class="row">
              <%= f.number_field :vector,
                    value: number_to_human(f.object.vector, precision: 4),
                    disabled: disabled.include?(:vector), append: "VA" %>
            </div>

            <div class="row">
              <%= f.number_field :duty, in: 0.0 .. 1.0, step: 0.01,
                    help: t('activerecord.help.electrical.demand.duty') %>
            </div>
          </div> <!-- end responsive columns --> 
        </div>
      </div> <!-- card body -->

      <!-- Card Footer with Actions -->
      <div class="card-footer bg-transparent text-end p-2">
        <%= link_to demand.persisted? ? demand : tag,
          class: "btn btn-warning actions",
          data: { confirm: t('actions.sure'), turbo: false } do %>
            <%= t('actions.discard') %>
            <%== bs_icon('x-square') %>
          <% end %>
        <!-- Button to submit form -->
        <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
          <%= yield(:button_text) %>
          <%== bs_icon('save') %>
        <% end %>
      </div>
    <% end %>
  </div> <!-- card  -->
</div> <!-- container  -->
