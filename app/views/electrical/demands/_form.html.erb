<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(@swatch) %>">
            <%= yield(:header) %>
            <% if tag.present? && tag.persisted? %>
              <small class="text-muted ms-2"><%= tag.service %></small>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: demand,
        url: demand.persisted? ? demand : tag_electrical_demands_path(tag),
        layout: :horizontal, 
        label_col: "col-sm-4", 
        control_col: "col-sm-8") do |f| %>

      <div class="card-body p-2" data-controller="electrical-demand" style="<%= form_styles(@swatch) %>">
        <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <%= form_field(f, :basis, type: :enum_translated, required: true,
                data: { electrical_demand_target: "basis", action: "change->electrical-demand#recalculate" }) %>
            <%= form_field(f, :basis_notes, type: :text) %>
            <%= form_field(f, :config, type: :enum_translated, required: true,
                data: { electrical_demand_target: "config", action: "change->electrical-demand#recalculate" }) %>
            <%= form_field(f, :supply, type: :number, required: true, step: 1.0, units: "V",
                data: { electrical_demand_target: "supply", action: "input->electrical-demand#recalculate" }) %>

            <% disabled = [:current, :power, :vector, :power_factor] %>
            <% case demand.basis %>
            <% when "summation" %>
            <% when "power_pf" %>
              <% disabled.delete(:power) %>
              <% disabled.delete(:power_factor) %>
            <% when "vector_pf" %>
              <% disabled.delete(:vector) %>
              <% disabled.delete(:power_factor) %>
            <% when "current_pf" %>
              <% disabled.delete(:current) %>
              <% disabled.delete(:power_factor) %>
            <% when "current_power" %>
              <% disabled.delete(:current) %>
              <% disabled.delete(:power) %>
            <% end %>

            <%= form_field(f, :current, type: :number, units: "A",
                disabled: disabled.include?(:current),
                data: { electrical_demand_target: "current", action: "input->electrical-demand#recalculate" }) %>
            <%= form_field(f, :power, type: :number, units: "W",
                disabled: disabled.include?(:power),
                data: { electrical_demand_target: "power", action: "input->electrical-demand#recalculate" }) %>
            <%= form_field(f, :power_factor, type: :number, in: -1.0 .. 1.0, step: 0.01,
                disabled: disabled.include?(:power_factor),
                data: { electrical_demand_target: "pf", action: "input->electrical-demand#recalculate" }) %>
            <%= form_field(f, :vector, type: :number, units: "VA",
                disabled: disabled.include?(:vector),
                data: { electrical_demand_target: "vector", action: "input->electrical-demand#recalculate" }) %>

            <%= form_field(f, :duty, type: :number, in: 0 .. 1.0, step: 0.01) %>
            <%= form_field(f, :notes, type: :text) %>
          </div> <!-- end responsive columns -->
        </div>
      </div> <!-- card body -->

      <!-- Card Footer with Actions -->
      <div class="card-footer bg-transparent text-end p-2">
        <%= link_to demand.persisted? ? demand : tag,
          class: "btn btn-warning actions",
          data: { confirm: t('actions.sure'), turbo: false } do %>
            <%= t('actions.discard') %>
            <%== bs_icon('x-square') %>
          <% end %>
        <!-- Button to submit form -->
        <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
          <%= yield(:button_text) %>
          <%== bs_icon('save') %>
        <% end %>
      </div>
    <% end %>
  </div> <!-- card  -->
</div> <!-- container  -->
