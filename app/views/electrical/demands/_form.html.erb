<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(@swatch) %>">
            <%= yield(:header) %>
            <% if tag.present? && tag.persisted? %>
              <small class="text-muted ms-2"><%= tag.service %></small>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: demand,
        url: demand.persisted? ? demand : tag_electrical_demands_path(tag),
        data: {
          recalculate_url: recalculate_electrical_demand_path(demand)
        },
        layout: :horizontal, 
        label_col: "col-sm-4", 
        control_col: "col-sm-8") do |f| %>

      <div class="card-body p-2" style="<%= form_styles(@swatch) %>">
        <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <div data-controller="typed-select demand-form"
                data-demand-form-supply-options-value="<%= Constants.electrical.supply.to_h.to_json %>">

              <input type="text"
                    data-typed-select-target="input"
                    data-action="input->typed-select#search blur->typed-select#commit">

              <input type="hidden"
                    name="electrical_demand[supply]"
                    data-typed-select-target="hidden"
                    data-demand-form-target="supply">

              <div data-typed-select-target="menu"></div>

              <%= f.select :basis,
                    demand.class.bases.keys.collect { |basis| [demand.class.human_enum_name(:basis, basis), basis] },
                    {},
                    data: {
                      demand_form_target: "basis",
                      action: "change->demand-form#basisChanged"
                    } %>
              
              <div class="row">
                <%= f.text_area :basis_notes,
                    help: t('activerecord.help.electrical/demand.basis_notes') %>
              </div>

              <div class="row">
                <%= f.select :config, 
                      demand.class.configs.keys.collect { |config| [demand.class.human_enum_name(:config, config), config] },
                      help: t('activerecord.help.electrical/demand.config') %>
              </div>

              <%= f.select :supply_reference,
                      demand.class.supply_references.keys.collect { |key| [demand.class.human_enum_name(:supply_reference, key), key] },
                {},
                data: {
                  action: "change->demand-form#supplyReferenceChanged",
                  demand_form_target: "supplyReference"
                } %>

              <%= f.number_field :power,
                    data: { demand_form_target: "power",
                            action: "input->demand-form#inputChanged" } %>

              <%= f.number_field :vector,
                    data: { demand_form_target: "vector",
                            action: "input->demand-form#inputChanged" } %>

              <%= f.number_field :current,
                    data: { demand_form_target: "current",
                            action: "input->demand-form#inputChanged" } %>

              <%= f.number_field :power_factor,
                    step: 0.01,
                    data: { demand_form_target: "pf",
                            action: "input->demand-form#inputChanged" } %>

              <%= f.hidden_field :config, data: { demand_form_target: "config" } %>
              <%= f.hidden_field :supply, data: { demand_form_target: "supply" } %>

              <div class="row">
                <%= f.number_field :duty, in: 0.0 .. 1.0, step: 0.01,
                      help: t('activerecord.help.electrical/demand.duty') %>
              </div>
              
              <div class="row">
                <%= f.text_area :notes,
                    help: t('activerecord.help.electrical/demand.notes') %>
              </div>
            </div> <!-- end data-controllers -->
          </div> <!-- end responsive columns --> 
        </div>
      </div> <!-- card body -->

      <!-- Card Footer with Actions -->
      <div class="card-footer bg-transparent text-end p-2">
        <%= link_to demand.persisted? ? demand : tag,
          class: "btn btn-warning actions",
          data: { confirm: t('actions.sure'), turbo: false } do %>
            <%= t('actions.discard') %>
            <%== bs_icon('x-square') %>
          <% end %>
        <!-- Button to submit form -->
        <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
          <%= yield(:button_text) %>
          <%== bs_icon('save') %>
        <% end %>
      </div>
    <% end %>
  </div> <!-- card  -->
</div> <!-- container  -->
