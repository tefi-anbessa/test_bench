<%= render 'components/collapsible',
  id: "demand_#{demand.id}_details",
  title: t('demands.show.header', label: demand.label),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <% if demand.tag.nil? %>
      <div class="row mb-1">
        <div class="col-12 text-muted">
          <%= t('show.orphan', model: t("activerecord.models.tag").tableize) %>
        </div>
      </div>
    <% else %>
      <div class="row mb-2">
        <div class="col-4 text-muted">
          <%= t('activerecord.attributes.tag.full_tag') %>:
        </div>
        <div class="col-8">
          <%= link_to demand.tag.full_tag, tag_path(demand.tag.id) %>
          <% if demand.tag.service.present? %>
            <span class="text-muted ms-2"><%= demand.tag.service %></span>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.basis") %>:</div>
      <div class="col-8"><%= demand.class.human_enum_name(:basis, demand.basis) %></div>
    </div>

    <% if demand.basis_notes.present? %>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.basis_notes") %>:</div>
        <div class="col-8"><%= demand.basis_notes %></div>
      </div>
    <% end %>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.supply") %>:</div>
      <div class="col-8">
        <%= number_to_human(demand.supply, precision: 4, units: { unit: "V", thousand: "kV"}) %>
      </div>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.config") %></div>
      <div class="col-8"><%= demand.class.human_enum_name(:config, demand.config) %></div>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.power") %></div>
      <div class="col-8">
        <%= number_to_human(demand.power, precision: 4, units: { unit: "W", thousand: "kW", million: "MW"}) %>
      </div>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.vector") %></div>
      <div class="col-8">
        <%= number_to_human(demand.vector, precision: 4, units: { unit: "VA", thousand: "kVA", million: "MVA"}) %>
      </div>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.power_factor") %></div>
      <div class="col-8"><%= demand.power_factor %></div>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.current") %></div>
      <div class="col-8">
        <%= number_to_human(demand.current, precision: 4, units: { unit: "A", thousand: "kA", million: "MA"}) %>
      </div>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.duty") %></div>
      <div class="col-8"><%= demand.duty %></div>
    </div>

    <% if demand.demandable.present? %>
      <div class="row mb-1">
        <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/demand.demandable_type") %></div>
        <div class="col-8">
          <% if demand.demandable.respond_to?(:to_s) %>
            <%= link_to demand.demandable.to_s, demand.demandable %>
          <% else %>
            <%= demand.demandable_type %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>