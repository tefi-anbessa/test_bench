<% provide(:title, t('.title')) %>
<% provide(:header, t('.header', label: @heater.long_label)) %>
<% provide(:button_text, t('actions.update')) %>
<% partial = File.join(@heater.model_name.collection, "form") %>
<%= render partial,
  heater: @heater,
  discipline: @discipline,
  tag: @tag,
  parent: @tag,
  swatch: @swatch
%>
