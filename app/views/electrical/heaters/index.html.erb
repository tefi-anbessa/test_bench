<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch) %>">
  <!-- Tagable Resource Header Card -->
  <div class="card mb-1" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-1" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <!-- Discipline link -->
        <div class="col-2">
            <%= nav_button(action: :show_discipline, record: @discipline) %>
        </div>

        <!-- Header Text (Left) -->
        <div class="col-8">
          <h5><%= t('.header',
            scope_text: [@discipline.project.code, 
                          t("activerecord.models.discipline.one"), 
                          @discipline.code].join(' ')) %>
          </h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 text-end">
          <% if policy(Electrical::Heater).new? %>
            <%= nav_button(action: :new, path: new_discipline_electrical_heater_path(@discipline),
                record: Electrical::Heater.new) %>
          <% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->

    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: discipline_electrical_heaters_path(@discipline) do |f| %>
          <%= f.search_field :heater_type_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.electrical/heater.heater_type") %>
          <%= f.search_field :application_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.electrical/heater.application") %>
          <%= f.search_field :ingress_protection_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.electrical/heater.ingress_protection") %>
          <%= f.search_field :sheath_material_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.electrical/heater.sheath_material") %>
          <%= f.search_field :insulation_material_cont,
                class: "search_field",
                placeholder: t("activerecord.attributes.electrical/heater.insulation_material") %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!-- Broken and incomplete links -->
      <% unless @link_broken.empty? %>
        <table id='link_broken' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-danger">
              <th colspan="9">
                <%= t('index.link_broken', 
                      count: @link_broken.count,
                      models: t("activerecord.models.electrical/heater", count: @link_broken.count)) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_broken.each do |tag| %>
              <%= render 'tags/row', row: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <% unless @link_incomplete.empty? %>
        <table id='link_incomplete' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-warning">
              <th colspan="9">
                <%= t('index.link_incomplete', 
                      count: @link_incomplete.count,
                      models: t("activerecord.models.electrical/heater", count: @link_incomplete.count)) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_incomplete.each do |tag| %>
              <%= render 'tags/row', row: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <!-- Heaters -->
      <!-- Policies for tagables are invariable over the scope , so no need to look up policy for each record. -->
      <% can_show = policy(@discipline.tags.build()).show? %>
      <% can_edit = policy(@discipline.tags.build()).edit? %>
      <% can_delete = policy(@discipline.tags.build()).destroy? %>
      <table id='electrical_heaters' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% unless @orphans.empty? %>
            <tr class="table-danger">

              <td colspan="<%= columns + (current_project ? 0 : 1) %>">
                <%= t('index.orphans', models: t("activerecord.models.electrical/heater").tableize) %>
              </td>
            </tr>
            <% @orphans.each do |row| %>
              <%= render 'row', row: row, can_show: can_show, can_edit: can_edit, can_delete: can_delete %>
            <% end %>
            <tr class="table-success">
              <td colspan="<%= columns + (current_project ? 0 : 1) %>">
                <%= t('.title') %>
              </td>
            </tr>
          <% end %>
          <% @heaters.each do |row| %>
            <%= render 'row', row: row, can_show: can_show, can_edit: can_edit, can_delete: can_delete %>
          <% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
