<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.tag&.nil? ? '-' : row.tag.discipline.project.code %></td>
  <% end %>
  <% if row.tag&.nil? %>
    <td>'-'</td>
    <td class="table-danger"><%= t("index.no_tag", id: row.id) %></td>
  <% else %>
    <td><%= row.tag.stage %></td>
    <td><%= link_to row.tag.label, tag_path(row.tag) %></td>
  <% end %>
  <td><%= row.class.human_enum_name(:heater_type, row.heater_type) %></td>
  <td><%= row.class.human_enum_name(:application, row.application) %></td>
  <td><%= row.ingress_protection || '-' %></td>
  <td><%= number_to_human(row.sheath_temperature_max, 
    precision: 4, units: { unit: "°C" }) || '-' %></td>
  <td><%= number_to_human(row.power_density_min, 
    precision: 4, units: { unit: "W/m²" , thousand: "kW/m²", million: "MW/m²" }) || '-' %></td>
  <td><%= number_to_human(row.power_density_max, 
    precision: 4, units: { unit: "W/m²" , thousand: "kW/m²", million: "MW/m²" }) || '-' %></td>
  <td><%= row.class.human_enum_name(:sheath_material, row.sheath_material) %></td>
  <td><%= row.class.human_enum_name(:insulation_material, row.insulation_material) %></td>
  <td>
    <% text = t('activerecord.models.electrical.demand') %>
    <% if row.electrical_demand.present? %>
      <%= link_to row.electrical_demand,
        class: "btn btn-sm btn-outline-info",
        title: text do %>
          <%= text %>
        <% end %>
    <% else %>
      <% if row.tag&.present? %>
        <% if policy(Electrical::Demand).new? %>
          <% text = t("actions.link", resource: text) %>
          <%= link_to new_tag_electrical_demand_path(row.tag.id),
            class: "btn btn-sm btn-outline-primary",
            title: text do %>
              <%== bs_icon('link') %>
              <%= text %>
            <% end %>
        <% else %>
          <span class="d-none d-md-inline">
            <%= t('show.unassigned', model: text) %>
          </span>
        <% end %>
      <% end %>
    <% end %>
  </td>
  <td>
    <% if policy(row).show? %>
      <%= link_to row, class: "btn btn-outline-info btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show') do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(row).edit? %>
      <%= link_to edit_electrical_heater_path(row), class: "btn btn-outline-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit') do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(row).destroy? %>
      <%= link_to row,
              data: { method: :delete, confirm: t('actions.delete_sure') },
              class: "btn btn-outline-danger btn-sm icon-link",
              aria: { label: t('actions.delete') },
              title: t('actions.delete') do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>
