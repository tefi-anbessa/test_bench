<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Heater Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@heater).index? %>
              <%= link_to discipline_electrical_heaters_path(@discipline),
                    class: "btn btn-sm btn-outline-info me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_heater = @heater.prev %>
            <% if prev_heater.present? %>
              <% disabled = prev_heater == @heater %>
              <% title_text = t('actions.previous') + ": " + prev_heater.label %>
              <%= link_to prev_heater,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: title_text do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @heater.label)%>
                <%= @heater.tag.service.presence %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_heater = @heater.next %>
            <% if next_heater.present? %>
              <% title_text = t('actions.next') + ": " + next_heater.label %>
              <% disabled = next_heater == @heater %>
              <%= link_to next_heater,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: title_text do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@heater).edit? %>
                <%= link_to edit_electrical_heater_path(@heater),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@heater).destroy? %>
                <%= link_to @heater,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@heater).new? %>
                <%= link_to new_discipline_electrical_heater_path(@discipline),
                  class: "btn btn-outline-primary actions",
                  aria: { label: t('actions.new') },
                  title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="ms-1">
                    <%= [t('actions.new'), t('activerecord.models.electrical.heater.one')].join(' ') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body">

      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
          <!-- Tag Card -->
          <% if @heater.tag.present? %>
            <div class="row g-3 mb-3">
                <%= render 'tags/card', tag: @heater.tag %>
            </div>
          <% else %>
            <div class="row g-3 mb-3">
              <div class="alert alert-danger">
                <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
              </div>
            </div>
          <% end %>

          <!-- Resource Details Card -->
          <div class="card mb-4">
            <div class="card-header py-1">
              <h4 class="mb-0"><%= t('show.details', model: @heater.model_name.human) %></h4>
            </div>

            <div class="card-body p-3">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @heater.class.human_attribute_name(:heater_type) %></div>
                <div class="col-8"><%= @heater.class.human_enum_name(:heater_type, @heater.heater_type) %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @heater.class.human_attribute_name(:application) %></div>
                <div class="col-8"><%= @heater.class.human_enum_name(:application, @heater.application) %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @heater.class.human_attribute_name(:ingress_protection) %></div>
                <div class="col-8"><%= @heater.ingress_protection || '-' %></div>

              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @heater.class.human_attribute_name(:sheath_temperature_max) %></div>
                <div class="col-8"><%= number_to_human(@heater.sheath_temperature_max, 
                  precision: 4, 
                  units: { unit: "°C" }) || '-' %></div>

              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @heater.class.human_attribute_name(:power_density_min) %></div>
                <div class="col-8"><%= number_to_human(@heater.power_density_min, 
                  precision: 4, 
                  units: { unit: "W/m²" , thousand: "kW/m²", million: "MW/m²" }) || '-' %></div>

              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @heater.class.human_attribute_name(:power_density_max) %></div>
                <div class="col-8"><%= number_to_human(@heater.power_density_max, 
                  precision: 4, 
                  units: { unit: "W/m²" , thousand: "kW/m²", million: "MW/m²" }) || '-' %></div>

              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @heater.class.human_attribute_name(:sheath_material) %></div>
                <div class="col-8"><%= @heater.class.human_enum_name(:sheath_material, @heater.sheath_material) %></div>
              </div> <!-- end row -->
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @heater.class.human_attribute_name(:insulation_material) %></div>
                <div class="col-8"><%= @heater.class.human_enum_name(:insulation_material, @heater.insulation_material) %></div>
              </div> <!-- end row -->

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= @heater.class.human_attribute_name(:notes) %></div>
                <div class="col-8"><%= @heater.notes.present? ? simple_format(@heater.notes) : '-' %></div>
              </div>

              <!-- Demand section -->
              <div class="row mb-1">
                <div class="col-4 text-muted">
                  <% text = t('activerecord.models.electrical.demand.one') %>
                  <% if @heater.electrical_demand.present? %>
                    <%= link_to @heater.electrical_demand,
                      class: "btn btn-sm btn-outline-secondary",
                      title: text do %>
                        <%= text %>
                        <%== bs_icon('box-arrow-in-down-right') %>
                    <% end %>
                  <% elsif @heater.tag&.present? %> <!-- Cannot create a new demand without a tag. -->
                    <% text = t("actions.link", resource: text) %>
                    <% if policy(Electrical::Demand).new? %>
                      <%= link_to new_tag_electrical_demand_path(@heater.tag.id),
                          class: "btn btn-sm btn-outline-primary mb-2",
                          title: text do %>
                            <span class="d-none d-md-inline">
                              <%= text %>
                            </span>
                            <%== bs_icon('link') %>
                          <% end %>
                    <% else %>
                      <span class="d-none d-md-inline">
                        <%= t('show.unassigned', model: text) %>
                      </span>
                    <% end %>
                  <% end %>
                </div> <!-- end column -->
              </div> <!-- end demand row -->
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
