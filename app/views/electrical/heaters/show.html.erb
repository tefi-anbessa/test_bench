<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Heater Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@heater).index? %>
              <%= nav_button(action: :index, path: discipline_electrical_heaters_path(@discipline), record: @heater) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @heater.long_label)%>
                <%= @heater.tag.service.presence %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@heater).edit? %>
                <%= nav_button(action: :edit, path: edit_electrical_heater_path(@heater), record: @heater) %>
              <% end %>

              <% if policy(@heater).destroy? %>
                <%= nav_button(action: :delete, path: electrical_heater_path(@heater), record: @heater) %>
              <% end %>

              <% if policy(@heater).new? %>
                <%= nav_button(action: :new, path: new_discipline_electrical_heater_path(@discipline), record: @heater) %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-sm-12 col-10 col-md-8 col-lg-6 col-xl-6">

          <!-- Inner Card -->
          <!-- Resource Details Card -->
          <div class="card mb-4">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: t('activerecord.models.electrical/heater.one')) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.heater_type') %></div>
                <div class="col-8"><%= @heater.class.human_enum_name(:heater_type, @heater.heater_type) %></div>
              </div> <!-- end row -->

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.application') %></div>
                <div class="col-8"><%= @heater.class.human_enum_name(:application, @heater.application) %></div>
              </div> <!-- end row -->
                  
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.ingress_protection') %></div>
                <div class="col-8"><%= @heater.ingress_protection.present? ? 
                  ["IP", @heater.ingress_protection].join('') : '-' %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.sheath_temperature_max') %></div>
                <div class="col-8"><%= number_to_human(@heater.sheath_temperature_max, 
                  precision: 4, 
                  units: { unit: "°C" }) || '-' %></div>
              </div> <!-- end row -->

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.power_density_min') %></div>
                <div class="col-8"><%= number_to_human(@heater.power_density_min, 
                  precision: 4, 
                  units: { unit: "W/m²" , thousand: "kW/m²", million: "MW/m²" }) || '-' %></div>
              </div> <!-- end row -->

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.power_density_max') %></div>
                <div class="col-8"><%= number_to_human(@heater.power_density_max, 
                  precision: 4, 
                  units: { unit: "W/m²" , thousand: "kW/m²", million: "MW/m²" }) || '-' %></div>
              </div> <!-- end row -->
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.sheath_material') %></div>
                <div class="col-8"><%= @heater.class.human_enum_name(:sheath_material, @heater.sheath_material) %></div>
              </div> <!-- end row -->
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.insulation_material') %></div>
                <div class="col-8"><%= @heater.class.human_enum_name(:insulation_material, @heater.insulation_material) %></div>
              </div> <!-- end row -->

              <span class="border">
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.notes') %></div>
                </div>
                <div class="row mb-1">
                  <div class="col-8"><%= simple_format(@heater.notes) %></div>
                </div>
              </span>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @heater.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <!-- Demand -->
              <%= render 'electrical/demands/show_insert', tag: @heater.tag, demand: @heater.electrical_demand %>
              <!-- Tag Card -->
              <% if @heater.tag.present? %>
                <div class="row g-3 mb-3">
                    <%= render 'tags/card', object: @heater, association: :tag %>
                </div>
              <% else %>
                <div class="row g-3 mb-3">
                  <div class="alert alert-danger">
                    <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                  </div>
                </div>
              <% end %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- end justify-content-center -->
    </div> <!-- end card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
