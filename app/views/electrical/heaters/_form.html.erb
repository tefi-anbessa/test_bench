<div class="container mt-3" style="<%= container_styles(swatch) %>">
  <div class="card" style="<%= card_styles(swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(swatch) %>">
            <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: heater,
          url: heater.persisted? ?
            heater : 
            ( tag.persisted? ?
              tag_electrical_heaters_path(tag) :
              discipline_electrical_heaters_path(discipline) ),
          layout: :horizontal,
          label_col: "col-sm-4",
          control_col: "col-sm-8",
          wrapper_class: 'mb-1',
          ) do |f| %>

      <div class="card-body p-2" style="<%= form_styles(swatch) %>">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">        <!-- Adjust to fit requirements -->

            <!-- Tag -->
            <div class="card mb-1">
              <%= f.fields_for tag do |tag_f| %>
                <%= render 'tags/form_nested', tag_f: tag_f, tag: tag %>
              <% end %>
            </div>

            <!-- Heater Details -->
            <div class="card mb-1" style="<%= card_styles(swatch) %>">
              <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">
                <h5><%= t('activerecord.models.electrical.heater.one') %></h5>
              </div>

              <div class="card-body p-2" style="<%= form_styles(swatch) %>">
                <%= render 'shared/error_messages', object: f.object %>

                <%= f.select :heater_type,
                    options_for_select(
                      Electrical::Heater.heater_types.keys.collect { |k| [Electrical::Heater.human_enum_name(:heater_type, k), k] },
                      selected: heater.heater_type
                    ),
                    { include_blank: t('form.required') },
                    class: 'form-control form-control-sm' %>

                <%= f.select :application,
                    options_for_select(
                      Electrical::Heater.applications.keys.collect { |k| [Electrical::Heater.human_enum_name(:application, k), k] },
                      selected: heater.application
                    ),
                    { include_blank: t('form.required') },
                    class: 'form-control form-control-sm' %>

                <div class="card p-2 mb-2" data-controller="ip-rating">
                  <div class="row">
                    <div class="col-4">
                      <%= f.text_field :ingress_protection,
                              class: 'form-control form-control-sm',
                              layout: :vertical,
                              prepend: 'IP',
                              data: { 'ip-rating-target': 'output' } %>
                    </div>
                    <div class="col-6">
                      <div class="row">
                      <%= select_tag :ip_1,
                        options_for_select(ip_1.map { |k, v| ["#{v} - #{k.to_s.titleize}", v] }, 
                          heater.ingress_protection&.first),
                        {
                          class: 'form-select mb-0',
                          label_col: "col-sm-4",
                          control_col: "col-sm-3",
                          data: { 
                            action: 'change->ip-rating#update',
                            'ip-rating-target': 'firstDigit' 
                          } 
                        } %>
                      </div>
                      <div class="row">
                        <%= select_tag :ip_2,
                          options_for_select(ip_2.map { |k, v| ["#{v} - #{k.to_s.titleize}", v] }, 
                            heater.ingress_protection&.last),
                            {
                              class: 'form-select mb-0',
                              label_col: "col-sm-2",
                              control_col: "col-sm-10",
                              data: { 
                                action: 'change->ip-rating#update',
                                'ip-rating-target': 'secondDigit' 
                              } 
                            } %>
                      </div>
                    </div>
                  </div>
                </div> <!-- end ip Card -->

                <%= f.number_field :sheath_temperature_max,
                        class: 'form-control form-control-sm',
                        step: 10.0,                             # Customize as required
                        label_col: "col-sm-4",
                        control_col: "col-sm-8"%>

                <%= f.number_field :power_density_min,
                        class: 'form-control form-control-sm',
                        step: 0.01,                             # Customize as required
                        label_col: "col-sm-4",
                        control_col: "col-sm-8"%>

                <%= f.number_field :power_density_max,
                        class: 'form-control form-control-sm',
                        step: 0.01,                             # Customize as required
                        label_col: "col-sm-4",
                        control_col: "col-sm-8"%>

                <%= f.select :sheath_material,
                    options_for_select(
                      Electrical::Heater.sheath_materials.keys.collect { |k| [Electrical::Heater.human_enum_name(:sheath_material, k), k] },
                        selected: heater.sheath_material
                    ),
                    { include_blank: t('form.optional') },
                    class: 'form-control form-control-sm' %>

                <%= f.select :insulation_material,
                    options_for_select(
                      Electrical::Heater.insulation_materials.keys.collect { |k| [Electrical::Heater.human_enum_name(:insulation_material, k), k] },
                      selected: heater.insulation_material
                    ),
                    { include_blank: t('form.optional') },
                    class: 'form-control form-control-sm' %>

                <%= f.text_area :notes,
                        class: 'form-control form-control-sm',
                        label_col: "col-sm-4",
                        control_col: "col-sm-8"%>
                
              </div> <!-- end heater card body -->
            </div> <!-- end heater card -->

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%= link_to(heater.persisted? ? heater : discipline_electrical_heaters_path(@discipline),
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>

              <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
                <%= yield(:button_text) %>
                <%== bs_icon('save') %>
              <% end %>
            </div> <!-- end card footer -->
          </div> <!-- end responsive columns -->
        </div> <!-- end row -->
      </div> <!-- end card body -->
    <% end %> <!-- end bootstrap_form_with -->
  </div> <!-- end card -->
</div> <!-- end container -->
