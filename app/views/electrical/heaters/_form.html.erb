<div class="container mt-3" style="<%= container_styles(swatch) %>">
  <div class="card" style="<%= card_styles(swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(swatch) %>">
            <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: heater,
          url: polymorphic_path([parent, :tagable]),
          local: true,
          layout: :horizontal,
          label_col: "col-sm-4",
          control_col: "col-sm-8",
          wrapper_class: 'mb-1',
          ) do |f| %>

      <div class="card-body p-2" style="<%= form_styles(swatch) %>">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">        <!-- Adjust to fit requirements -->

            <!-- Tag -->
            <% if tag.persisted? %>
              <%= render'tags/tag', tag: tag, swatch: swatch %>
            <% else %>
              <%= f.fields_for tag do |tag_f| %>
                <%= render 'tags/form_nested', tag_f: tag_f, tag: tag %>
              <% end %>
            <% end %>
            <%= hidden_field_tag :tagable_type, tag.tagable_type %>

            <!-- Heater Details -->
            <div class="card mb-1" style="<%= card_styles(swatch) %>">
              <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">
                <h6><%= yield(:header) %></h6>
              </div>

              <div class="card-body p-2" style="<%= form_styles(swatch) %>">
                <%= render 'shared/error_messages', object: f.object %>

                <%= form_field(f, :heater_type, type: :enum_translated, required: true) %>
                <%= form_field(f, :application, type: :enum_translated, required: true) %>
                <%= render "shared/ip_rating", form: f, object: heater %>
                <%= form_field(f, :sheath_temperature_max, type: :number, required: false, control_cols: 4, units: "°C", step: 10) %>
                <%= form_field(f, :power_density_min, type: :number, required: false, control_cols: 4, units: "°C", step: 0.01, units: "W/m²") %>
                <%= form_field(f, :power_density_max, type: :number, required: false, control_cols: 4, units: "°C", step: 0.01, units: "W/m²") %>
                <%= form_field(f, :sheath_material, type: :enum_translated, required: false) %>
                <%= form_field(f, :insulation_material, type: :enum_translated, required: false) %>
                <%= form_field(f, :notes, type: :text) %>                
              </div> <!-- end heater card body -->
            </div> <!-- end heater card -->

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%= link_to(heater.persisted? ? tag_tagable_path(tag) : discipline_tagables_path(discipline, tagable_type: 'Electrical::Heater'),
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>

              <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
                <%= yield(:button_text) %>
                <%== bs_icon('save') %>
              <% end %>
            </div> <!-- end card footer -->
          </div> <!-- end responsive columns -->
        </div> <!-- end row -->
      </div> <!-- end card body -->
    <% end %> <!-- end bootstrap_form_with -->
  </div> <!-- end card -->
</div> <!-- end container -->
