<div class="container mt-3" style="<%= container_styles(swatch) %>">
  <div class="card" style="<%= card_styles(swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(swatch) %>">
            <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: motor,
          url: motor.persisted? ?
            motor :
            ( tag.persisted? ?
              tag_electrical_motors_path(tag) :
              discipline_electrical_motors_path(@discipline)),
          layout: :horizontal,
          label_col: "col-sm-4",
          control_col: "col-sm-8",
          wrapper_class: 'mb-1',
          ) do |f| %>

      <div class="card-body p-2" style="<%= form_styles(swatch) %>">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Tag -->
            <div class="card mb-1">
              <%= f.fields_for tag do |tag_f| %>
                <%= render 'tags/form_nested', tag_f: tag_f, tag: tag %>
              <% end %>
            </div>

            <!-- Motor Details -->
            <div class="card mb-1" style="<%= form_styles(swatch) %>">
              <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">
                <h5><%= t('activerecord.models.electrical/motor.one') %></h5>
              </div>

              <div class="card-body p-2" style="<%= form_styles(swatch) %>">
                <%= render 'shared/error_messages', object: f.object %>
                <%= form_field(f, :motor_type, type: :enum_translated, required: true) %>
                <%= form_field(f, :frame_size, type: :enum) %>
                <%= form_field(f, :poles, type: :number, control_cols: 2, min: 1, max: 12) %>
                <%= render "shared/ip_rating", form: f, object: motor %>
                <%= form_field(f, :speed_rated, type: :number, control_cols: 4, min: 1, step: '1', append: 'rpm') %>
                <%= form_field(f, :notes, type: :text) %>
              </div> <!-- end motor card body -->
            </div> <!-- end motor card -->

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%= link_to(motor.persisted? ? motor : discipline_electrical_motors_path(@discipline),
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>

              <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
                <%= yield(:button_text) %>
                <%== bs_icon('save') %>
              <% end %>
            </div> <!-- end card footer -->
          </div> <!-- end responsive columns -->
        </div> <!-- end row -->
      </div> <!-- end card body -->
    <% end %>
  </div> <!-- end card -->
</div> <!-- end container -->
