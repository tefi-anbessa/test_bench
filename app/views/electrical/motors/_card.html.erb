<!-- Socket Circuit collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% motor = object %>
<% context ||= t("activerecord.models.electrical/motor.one") %>
<%= render 'components/collapsible',
  id: "#{id}_#{motor.id}_details",
  title: [context, motor.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: motor) %>

    <%= show_attribute(motor, :motor_type, type: :enum_translated) %>
    <%= show_attribute(motor, :frame_size, type: :enum) %>
    <%= show_attribute(motor, :poles, type: :integer) %>
    <%= show_attribute(motor, :ingress_protection) %>
    <%= show_attribute(motor, :speed_rated, type: :float, units: "rpm") %>
    <%= show_attribute(motor, :notes, type: :text) %>
  </div>
<% end %>