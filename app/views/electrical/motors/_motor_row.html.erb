<tr scope="row">
<% if row.tag.nil? %>
  <td class="table-danger"><%= t("index.no_tag", id: row.id) %></td>
<% else %>
  <td><%= link_to row.tag.full_tag, tag_path(row.tag) %></td>
<% end %>
  <td><%= row.class.human_enum_name(:motor_type, row.motor_type) %></td>
  <td><%= row.frame_size.present? ? "frame_#{row.frame_size}" : '-'  %></td>
  <td><%= row.poles || '-' %></td>
  <td><%= row.ingress_protection.present? ?
                      ["IP", row.ingress_protection].join('') : '-' %></td>
  <td><%= row.speed_rated || '-' %></td>
  <td>
    <% if policy(row).show? %>
      <%= link_to row, class: "btn btn-secondary btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(row).edit? %>
      <%= link_to edit_electrical_motor_path(row), class: "btn btn-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline"  do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(row).destroy? %>
      <%= link_to row,
              data: { method: :delete, confirm: t('actions.delete_sure') },
              class: "btn btn-danger btn-sm icon-link",
              aria: { label: t('actions.delete') },
              title: t('actions.delete'),
              display: "inline"  do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>
