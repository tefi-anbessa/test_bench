<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.tag&.nil? ? '-' : row.tag.discipline.project.code %></td>
  <% end %>
  <% if row.tag.nil? %>
    <td>'-'</td>
    <td class="table-danger"><%= t("index.no_tag", id: row.id) %></td>
  <% else %>
    <td><%= row.tag.stage %></td>
    <td><%= link_to row.tag.label, row.tag %></td>
  <% end %>
  <td><%= row.class.human_enum_name(:motor_type, row.motor_type) %></td>
  <td><%= row.frame_size.present? ? "frame_#{row.frame_size}" : '-'  %></td>
  <td><%= row.poles || '-' %></td>
  <td><%= row.ingress_protection.present? ?
                      ["IP", row.ingress_protection].join('') : '-' %></td>
  <td><%= row.speed_rated || '-' %></td>
  <td>
    <% if policy(row).show? %>
      <%= link_to row, class: "btn btn-outline-info btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show') do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(row).edit? %>
      <%= link_to edit_electrical_motor_path(row), class: "btn btn-outline-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit') do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(row).destroy? %>
      <%= link_to row,
              data: { method: :delete, confirm: t('actions.delete_sure') },
              class: "btn btn-outline-danger btn-sm icon-link",
              aria: { label: t('actions.delete') },
              title: t('actions.delete') do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>
