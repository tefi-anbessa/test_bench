<tr scope="row">
  <% unless current_project %>
    <td><%= row.tag&.nil? ? '-' : row.tag&.discipline&.project&.code %></td>
  <% end %>
  <% if row.tag.nil? %>
    <td>'-'</td>
    <td class="table-danger"><%= t("index.no_tag", id: row.id) %></td>
  <% else %>
    <td><%= row.tag.stage %></td>
    <td><%= link_to row.tag.label, row.tag %></td>
  <% end %>
  <td>
    <span title="<%= row.notes %>">
      <%= truncate(strip_tags(row.notes.to_s), length: 20) %>
    </span>
  </td>
  <td><%= row.class.human_enum_name(:motor_type, row.motor_type) %></td>
  <td><%= row.frame_size.present? ? "frame_#{row.frame_size}" : '-'  %></td>
  <td><%= row.poles || '-' %></td>
  <td><%= row.ingress_protection.present? ?
                      ["IP", row.ingress_protection].join('') : '-' %></td>
  <td><%= row.speed_rated || '-' %></td>
  <td>
    <%= render 'electrical/demands/index_link', row: row %>
  </td>
  <td>
    <% if can_show %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if can_edit %>
      <%= nav_button(action: :edit, record: row, path: edit_electrical_motor_path(row), icon_only: true) %>
    <% end %>
    <% if can_delete %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
