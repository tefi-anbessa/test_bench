<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Motor Header Card -->
  <div class="card mb-4" style="<%= container_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@motor).index? %>
              <%= nav_button(action: :index, path: discipline_electrical_motors_path(@discipline), record: @motor) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div> <!-- end d-flex align-items-center -->
        </div> <!-- end left column -->

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @motor.long_label)%>
                <%= @motor.tag.service.presence %>
              </span>
            </div>
          </div> <!-- end d-flex align-items-center -->
        </div> <!-- end centre column -->

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@motor).edit? %>
                <%= nav_button(action: :edit, path: edit_electrical_motor_path(@motor), record: @motor) %>
              <% end %>

              <% if policy(@motor).destroy? %>
                <%= nav_button(action: :delete, path: electrical_motor_path(@motor), record: @motor) %>
              <% end %>

              <% if policy(@motor).new? %>
                <%= nav_button(action: :new, path: new_discipline_electrical_motor_path(@discipline), record: @motor) %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Motor Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @motor.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/motor.motor_type') %></div>
                <div class="col-8"><%= @motor.class.human_enum_name(:motor_type, @motor.motor_type) %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/motor.frame_size') %></div>
                <div class="col-8"><%= "frame_#{@motor.frame_size}" %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/motor.poles') %></div>
                <div class="col-8"><%= @motor.poles || '-' %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/motor.ingress_protection') %></div>
                <div class="col-8"><%= @motor.ingress_protection.present? ?
                ["IP", @motor.ingress_protection].join(' ') : '-' %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/motor.speed_rated') %></div>
                <div class="col-8"><%= @motor.speed_rated.present? ? 
                                        number_to_human(@motor.speed_rated, precision: 4, units: { unit: "rpm"}) : 
                                        '-' %></div>
              </div>

              <span class="border">
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.notes') %></div>
                </div>
                <div class="row mb-1">
                  <div class="col-8"><%= simple_format(@motor.notes) %></div>
                </div>
              </span>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @motor.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <!-- Demand -->
              <%= render 'electrical/demands/show_insert', tag: @motor.tag, demand: @motor.electrical_demand %>
              
              <!-- Tag Card -->
              <% if @motor.tag.present? %>
                <div class="row g-3 mb-3">
                    <%= render 'tags/card', object: @motor, association: :tag %>
                </div>
              <% else %>
                <div class="row g-3 mb-3">
                  <div class="alert alert-danger">
                    <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                  </div>
                </div>
              <% end %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
