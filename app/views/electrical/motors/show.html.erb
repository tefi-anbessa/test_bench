<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Motor Header Card -->
  <div class="card mb-4" style="<%= container_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@motor).index? %>
              <%= link_to discipline_electrical_motors_path(@discipline),
                    class: "btn btn-sm btn-outline-info me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_motor = @motor.prev %>
            <% if prev_motor.present? %>
              <% disabled = prev_motor == @motor %>
              <%= link_to prev_motor,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_motor.label}" do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div> <!-- end d-flex align-items-center -->
        </div> <!-- end left column -->

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @motor.long_label)%>
                <%= @motor.tag.service.presence %>
              </span>
            </div>
          </div> <!-- end d-flex align-items-center -->
        </div> <!-- end centre column -->

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_motor = @motor.next %>
            <% if next_motor.present? %>
              <% disabled = next_motor == @motor %>
              <%= link_to next_motor,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_motor.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@motor).edit? %>
                <%= link_to edit_electrical_motor_path(@motor),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@motor).destroy? %>
                <%= link_to @motor,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %><!-- New Button (Right) -->

              <% if policy(Electrical::Motor).new? %>
                  <%= link_to new_discipline_electrical_motor_path(@discipline), 
                    class: "btn btn-sm btn-outline-primary actions",
                    aria: { label: t('actions.new') },
                    title: t('actions.new') do %>
                    <%== bs_icon('plus-square-fill') %>
                    <span class="ms-1"><%= [t('actions.new'), t('activerecord.models.electrical/motor.one')].join(' ') %></span>
                  <% end %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Motor Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @motor.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/motor.motor_type') %></div>
                <div class="col-8"><%= @motor.class.human_enum_name(:motor_type, @motor.motor_type) %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/motor.frame_size') %></div>
                <div class="col-8"><%= "frame_#{@motor.frame_size}" %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/motor.poles') %></div>
                <div class="col-8"><%= @motor.poles || '-' %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/motor.ingress_protection') %></div>
                <div class="col-8"><%= @motor.ingress_protection.present? ?
                ["IP", @motor.ingress_protection].join(' ') : '-' %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/motor.speed_rated') %></div>
                <div class="col-8"><%= @motor.speed_rated.present? ? 
                                        number_to_human(@motor.speed_rated, precision: 4, units: { unit: "rpm"}) : 
                                        '-' %></div>
              </div>

              <span class="border">
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/heater.notes') %></div>
                </div>
                <div class="row mb-1">
                  <div class="col-8"><%= simple_format(@motor.notes) %></div>
                </div>
              </span>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @motor.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <!-- Demand -->
              <%= render 'electrical/demands/show_insert', tag: @motor.tag, demand: @motor.electrical_demand %>
              
              <!-- Tag Card -->
              <% if @motor.tag.present? %>
                <div class="row g-3 mb-3">
                    <%= render 'tags/card', object: @motor, association: :tag %>
                </div>
              <% else %>
                <div class="row g-3 mb-3">
                  <div class="alert alert-danger">
                    <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                  </div>
                </div>
              <% end %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->
