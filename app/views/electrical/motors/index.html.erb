<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto">
  <!-- Motor Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="d-flex justify-content-between align-items-center">
        <!-- Header Text (Left) -->
        <div class="ms-2">
          <% project_text = current_project.present? ? 
          [current_project.class.model_name.human, current_project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project').pluralize) %>
          <h5 class="mb-0"><%= t('.header', project: project_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <% if policy(Electrical::Motor).new? %>
            <%= link_to new_electrical_motor_path, 
              class: "btn btn-outline-primary actions",
              aria: { label: t('actions.new') },
              title: t('actions.new') do %>
              <%== bs_icon('plus-square-fill') %>
              <span class="ms-1"><%= [t('actions.new'), t('activerecord.models.motor')].join(' ') %></span>
            <% end %>
        <% end %>
      </div> <!-- end of d-flex -->
    </div> <!-- end of card header -->
    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q do |f| %>
          <%= f.search_field :motor_type_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.motor.motor_type') %>
          <%= f.search_field :frame_size_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.motor.frame_size') %>
          <%= f.search_field :poles_eq,
                class: "search_field",
                placeholder: t('activerecord.attributes.motor.poles') %>
          <%= f.search_field :ingress_protection_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.motor.ingress_protection') %>
          <%= f.search_field :speed_rated_eq,
                class: "search_field",
                placeholder: t('activerecord.attributes.motor.speed_rated') %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>
      <table id='motors' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% @motors.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
