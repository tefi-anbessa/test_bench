<% socket_cct = object %>
<%= render 'components/collapsible',
  id: "socket_cct_#{socket_cct.id}_details",
  title: t('socket_ccts.show.header', label: socket_cct.label),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <div class="row mb-1">
      <% text = t("actions.back_to", model: socket_cct.class.model_name.human) %>
      <%= link_to electrical_socket_cct_path(socket_cct), 
          class: "btn btn-sm btn-outline-secondary me-2",
          title: text do %>
        <%== icon('box-arrow-in-up-left') %>
        <span class="d-none d-md-inline"><%= text %></span>
      <% end %>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= socket_cct.class.human_attribute_name(:socket_type) %></div>
      <div class="col-8"><%= socket_cct.class.human_enum_name(:socket_type, socket_cct.socket_type) %></div>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= socket_cct.class.human_attribute_name(:quantity) %></div>
      <div class="col-8"><%= socket_cct.quantity %></div>
    </div>
    
    <div class="row mb-1">
      <div class="col-4 text-muted"><%= socket_cct.class.human_attribute_name(:notes) %></div>
      <div class="col-8"><%= socket_cct.notes.present? ? simple_format(socket_cct.notes) : '-' %></div>
    </div>
  </div>
<% end %>