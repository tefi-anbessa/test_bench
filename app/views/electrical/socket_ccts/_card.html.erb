<!-- Expects object and context (optional) to be passed in -->
<% socket_cct = object %>
<% context ||= t("activerecord.models.electrical/socket_cct.one") %>
<%= render 'components/collapsible',
  id: "socket_cct_#{socket_cct.id}_details",
  title: [context, socket_cct.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <div class="row mb-1">
      <% text = t("actions.jump_to", model: t("activerecord.models.electrical/socket_cct.one")) %>
      <%= link_to socket_cct, 
          class: "btn btn-sm btn-outline-secondary me-2",
          title: text do %>
        <%== bs_icon('box-arrow-in-up-left') %>
        <span class="d-none d-md-inline"><%= text %></span>
      <% end %>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/socket_cct.socket_type') %></div>
      <div class="col-8"><%= socket_cct.class.human_enum_name(:socket_type, socket_cct.socket_type) %></div>
    </div>

    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/socket_cct.quantity') %></div>
      <div class="col-8"><%= socket_cct.quantity.present? ? socket_cct.quantity : '-' %></div>
    </div>
    
    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/socket_cct.notes') %></div>
      <div class="col-8"><%= simple_format(socket_cct.notes) %></div>
    </div>
    </div>
<% end %>