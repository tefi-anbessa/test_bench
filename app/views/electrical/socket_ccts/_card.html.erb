<!-- Socket Circuit collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% socket_cct = object %>
<% context ||= t("activerecord.models.electrical/socket_cct.one") %>
<%= render 'components/collapsible',
  id: "#{id}_#{socket_cct.id}_details",
  title: [context, socket_cct.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: socket_cct) %>

    <%= show_attribute(socket_cct, :socket_type, type: :enum_translated) %>
    <%= show_attribute(socket_cct, :quantity, type: :integer) %>
    <%= show_attribute(socket_cct, :notes, type: :text) %>
    </div>
<% end %>