<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Socket Circuit Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@socket_cct).index? %>
              <%= link_to discipline_electrical_socket_ccts_path(@discipline),
                    class: "btn btn-sm btn-outline-info me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @socket_cct.long_label)%>
                <%= @socket_cct.tag.service.presence %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@socket_cct).edit? %>
                <%= link_to edit_electrical_socket_cct_path(@socket_cct),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@socket_cct).destroy? %>
                <%= link_to @socket_cct,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@socket_cct).new? %>
                <%= link_to new_discipline_electrical_socket_cct_path(@discipline),
                  class: "btn btn-outline-primary actions",
                  aria: { label: t('actions.new') },
                  title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="ms-1">
                    <%= [t('actions.new'), t('activerecord.models.electrical/socket_cct.one')].join(' ') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column justify-content-center">
      <div class="card-body">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Tag Card -->
            <% if @socket_cct.tag.present? %>
              <div class="row g-3 mb-3">
                  <%= render 'tags/card', tag: @socket_cct.tag %>
              </div>
            <% else %>
              <div class="row g-3 mb-3">
                <div class="alert alert-danger">
                  <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                </div>
              </div>
            <% end %>

            <!-- Socket Circuit Details Card -->
            <div class="row">
              <div class="card mb-4" style="<%= card_styles(@socket_cct.tag.discipline.swatch) %>">
                <div class="card-header py-1" style="<%= card_header_styles(@socket_cct.tag.discipline.swatch) %>">
                  <h4 class="mb-0"><%= t('show.details', model: @socket_cct.model_name.human) %></h4>
                </div>
                <div class="card-body p-3">
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @socket_cct.class.human_attribute_name(:socket_type) %></div>
                    <div class="col-8"><%= Electrical::SocketCct.human_enum_name(:socket_type, @socket_cct.socket_type) %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @socket_cct.class.human_attribute_name(:quantity) %></div>
                    <div class="col-8"><%= @socket_cct.quantity || '-' %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @socket_cct.class.human_attribute_name(:notes) %></div>
                    <div class="col-8"><%= @socket_cct.notes || '-' %></div>
                  </div>

              <!-- Demand section -->
              <div class="row mb-1">
                <div class="col-4 text-muted">
                  <% text = t('activerecord.models.electrical/demand.one') %>
                  <% if @socket_cct.electrical_demand.present? %>
                    <%= link_to @socket_cct.electrical_demand,
                      class: "btn btn-sm btn-outline-secondary",
                      title: text do %>
                        <%= text %>
                        <%== bs_icon('box-arrow-in-down-right') %>
                    <% end %>
                  <% elsif @socket_cct.tag&.present? %> <!-- Cannot create a new demand without a tag. -->
                    <% text = t("actions.link", resource: text) %>
                    <% if policy(Electrical::Demand).new? %>
                      <%= link_to new_tag_electrical_demand_path(@socket_cct.tag.id),
                          class: "btn btn-sm btn-outline-primary mb-2",
                          title: text do %>
                            <span class="d-none d-md-inline">
                              <%= text %>
                            </span>
                            <%== bs_icon('link') %>
                          <% end %>
                    <% else %>
                      <span class="d-none d-md-inline">
                        <%= t('show.unassigned', model: text) %>
                      </span>
                    <% end %>
                  <% end %>
                </div> <!-- end column -->
              </div> <!-- end demand row -->
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>