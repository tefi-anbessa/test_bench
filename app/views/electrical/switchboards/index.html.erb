<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch)%>">

  <!-- Switchboard List Card Header -->
  <div class="card mb-1" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-1" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2 mb-1">

        <!-- Discipline link -->
        <div class="col-2">
            <%= link_to discipline_path(@discipline), class: "btn btn-sm btn-outline-info" do %>
              <%= @discipline.name %>
              <%= bs_icon('collection', class: "me-1") %>
            <% end %>
        </div>

        <!-- Header Text (Left - 8 columns) -->
        <div class="col-8">
          <h5><%= t('.header', 
            scope_text: [@discipline.project.code, t("activerecord.models.discipline.one"), @discipline.label].join(' ')) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 align-content-end">
          <% if policy(Electrical::Switchboard).new? %>
              <%= link_to new_discipline_electrical_switchboard_path(@discipline),
                class: "btn btn-sm btn-outline-primary actions",
                aria: { label: t('actions.new') },
                title: t('actions.new') do %>
                <%== bs_icon('plus-square-fill') %>
                <span class="ms-1"><%= [t('actions.new'), t('activerecord.models.electrical/switchboard.one')].join(' ') %></span>
              <% end %>
          <% end %>
        </div>
      </div> <!-- end of row -->
    </div> <!-- end of card header -->
    
    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: discipline_electrical_switchboards_path(@discipline) do |f| %>
          <%= f.search_field :voltage_rating_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical/switchboard.voltage_rating') %>
          <%= f.search_field :busbar_rating_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical/switchboard.busbar_rating') %>
          <%= f.search_field :incomer_protection_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical/switchboard.incomer_protection') %>
          <%= f.search_field :metering_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical/switchboard.metering') %>
          <%= f.search_field :notes_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical/switchboard.notes') %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!-- Broken and incomplete links -->
      <% unless @link_broken.empty? %>
        <table id='link_broken' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-danger">
              <th colspan="9">
                <%= t('index.link_broken', 
                      count: @link_broken.count,
                      models: t("activerecord.models.electrical/switchboard", count: @link_broken.count)) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_broken.each do |tag| %>
              <%= render 'tags/row', t: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <% unless @link_incomplete.empty? %>
        <table id='link_incomplete' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-warning">
              <th colspan="9">
                <%= t('index.link_incomplete', 
                      count: @link_incomplete.count,
                      models: t("activerecord.models.electrical/switchboard", count: @link_incomplete.count)) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_incomplete.each do |tag| %>
              <%= render 'tags/row', t: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <!-- Switchboards -->
      <table id='switchboards' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% unless @orphans.empty? %>
            <tr class="table-danger">
              <td colspan="<%= 9 + (current_project ? 1 : 0) %>">
                <%= t('index.orphans', models: t("activerecord.models.switchboard").tableize) %>
              </td>
            </tr>
            <% @orphans.each do |row| %>
              <%= render 'row', row: row %>
            <% end %>
            <tr class="table-success">
              <td colspan="<%= 9 + (current_project ? 1 : 0) %>">
                <%= t('.title') %>
              </td>
            </tr>
          <% end %>
          <% @switchboards.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    </div> <!-- end of card body -->
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div> <!-- end of car footer -->
  </div> <!-- end of card -->
</div> <!-- end of container -->
