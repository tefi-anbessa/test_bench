<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto">
  <!-- Motor Schedule Card Header -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="d-flex justify-content-between align-items-center">
        <!-- Header Text (Left) -->
        <div class="ms-2">
          <% project_text = current_project.present? ? 
          [current_project.class.model_name.human, current_project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project').pluralize) %>
          <h5 class="mb-0"><%= t('.header', project: project_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <% if policy(Electrical::Switchboard).new? %>
            <%= link_to new_electrical_switchboard_path, 
              class: "btn btn-outline-primary actions",
              aria: { label: t('actions.new') },
              title: t('actions.new') do %>
              <%== bs_icon('plus-square-fill') %>
              <span class="ms-1"><%= [t('actions.new'), t('activerecord.models.switchboard')].join(' ') %></span>
            <% end %>
        <% end %>
      </div> <!-- end of d-flex -->
    </div> <!-- end of card header -->
    
    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q do |f| %>
      <%= f.search_field :voltage_rating_cont,
            class: "search_field",
            placeholder: t('activerecord.attributes.switchboard.voltage_rating') %>
      <%= f.search_field :busbar_rating_cont,
            class: "search_field",
            placeholder: t('activerecord.attributes.switchboard.busbar_rating') %>
      <%= f.search_field :incomer_protection_cont,
            class: "search_field",
            placeholder: t('activerecord.attributes.switchboard.incomer_protection') %>
      <%= f.search_field :metering_cont,
            class: "search_field",
            placeholder: t('activerecord.attributes.switchboard.metering') %>
      <%= f.search_field :notes_cont,
            class: "search_field",
            placeholder: t('activerecord.attributes.switchboard.notes') %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!-- Broken and incomplete links -->
      <% unless @link_broken.empty? %>
        <table id='link_broken' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-danger">
              <th colspan="9">
                <%= t('index.link_broken', models: t("activerecord.models.motor").tableize) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_broken.each do |tag| %>
              <%= render 'tags/row', t: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <% unless @link_incomplete.empty? %>
        <table id='link_incomplete' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-warning">
              <th colspan="9">
                <%= t('index.link_incomplete', models: t("activerecord.models.motor").tableize) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_incomplete.each do |tag| %>
              <%= render 'tags/row', t: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <!-- Switchboards -->
      <table id='switchboards' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% unless @orphans.empty? %>
            <tr class="table-danger">
              <td colspan="<%= 9 + (current_project ? 1 : 0) %>">
                <%= t('index.orphans', models: t("activerecord.models.switchboard").tableize) %>
              </td>
            </tr>
            <% @orphans.each do |row| %>
              <%= render 'row', row: row %>
            <% end %>
            <tr class="table-success">
              <td colspan="<%= 9 + (current_project ? 1 : 0) %>">
                <%= t('.title') %>
              </td>
            </tr>
          <% end %>
          <% @switchboards.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
