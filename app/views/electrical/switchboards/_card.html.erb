<!-- Switchboard collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% switchboard = object %>
<% context ||= t("activerecord.models.electrical/switchboard.one") %>
<%= render 'components/collapsible',
  id: "#{id}_#{switchboard.id}_details",
  title: [context, switchboard.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: switchboard) %>

    <%= show_attribute(switchboard, :notes, type: :text) %>
    <%= show_attribute(switchboard, :ingress_protection) %>
    <%= show_attribute(switchboard, :voltage_rating, type: :enum) %>
    <%= show_attribute(switchboard, :busbar_rating, type: :float, units: "A") %>
    <%= show_attribute(switchboard, :busbar_fault_rating, type: :float, units: "A") %>
    <%= show_attribute(switchboard, :busbar_fault_duration, type: :float, units: "s") %>
    <%= show_attribute(switchboard, :cable_entry) %>
    <%= show_attribute(switchboard, :incomer_protection, type: :text) %>
    <%= show_attribute(switchboard, :metering, type: :text) %>
    <%= show_attribute(switchboard, :neutral_bar_connections, type: :text) %>
    <%= show_attribute(switchboard, :earth_bar_connections, type: :text) %>
    
    <div class="row mb-1">
      <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/switchboard.circuits') %></div>
      <div class="col-8"><%= switchboard.circuits.count %></div>
    </div>
  </div>
<% end %>