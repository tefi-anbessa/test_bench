<div class="container mt-3" style="<%= container_styles(swatch) %>">
  <div class="card" style="<%= card_styles(swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="badge fs-6" style="<%= badge_styles(swatch) %>">
            <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div>
    <%= bootstrap_form_with(model: switchboard,
          url: switchboard.persisted? ?
            switchboard : 
            ( tag.persisted? ?
              tag_electrical_switchboards_path(tag) :
              discipline_electrical_switchboards_path(discipline) ),
          layout: :horizontal, 
          label_col: "col-sm-4", 
          control_col: "col-sm-8",
          wrapper_class: 'mb-1',
          ) do |f| %>

      <div class="card-body p-2" style="<%= form_styles(swatch) %>">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Tag -->
            <%= f.fields_for tag do |tag_f| %>
              <%= render 'tags/form_nested', tag_f: tag_f, tag: tag %>
            <% end %>

            <!-- Switchboard Details -->
            <div class="card mb-1" style="<%= card_styles(swatch) %>">
              <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">
                <h6><%= yield(:header) %></h6>
              </div>

              <div class="card-body p-2" style="<%= form_styles(swatch) %>">
                <%= render 'shared/error_messages', object: f.object %>

                <%= render 'shared/ip_rating', form: f, object: f.object %>
                
                <%= form_field(f, :voltage_rating, type: :enum, required: true) %>
                <%= form_field(f, :busbar_rating, type: :number, control_cols: 4, required: true, min: 0, step: 10, units: "A") %>
                <%= form_field(f, :busbar_fault_rating, type: :number, control_cols: 4, required: false, min: 0, step: 100, units: "A") %>
                <%= form_field(f, :busbar_fault_duration, type: :number, control_cols: 4, required: false, min: 0, step: 0.1, units: "s") %>
                <%= form_field(f, :cable_entry) %>
                <%= form_field(f, :incomer_protection, type: :text) %>
                <%= form_field(f, :metering, type: :text) %>
                <%= form_field(f, :neutral_bar_connections, type: :text) %>
                <%= form_field(f, :earth_bar_connections, type: :text) %>
                <%= form_field(f, :notes, type: :text) %>

                <div class="row mb-1">
                  <label class="col-form-label col-sm-4" for="circuits">
                    <%= t('activerecord.models.electrical/circuit.one').pluralize %>
                  </label>
                  <div class="col-sm-4">
                    <%= number_field_tag :circuits, circuits,
                            class: 'form-control form-control-sm',
                            min: 0, max: 36, step: 1 %>
                  </div>
                </div>
              </div> <!-- end switchboard card body -->
            </div> <!-- end switchboard card -->

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%= link_to(switchboard.persisted? ? switchboard : discipline_electrical_switchboards_path(discipline), 
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>

              <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
                <%= yield(:button_text) %>
                <%== bs_icon('save') %>
              <% end %>
            </div> <!-- end card footer -->
          </div> <!-- end responsive columns -->
        </div> <!-- end row -->
      </div> <!-- end card body -->
    <% end %>
  </div> <!-- end card -->
</div> <!-- end container -->
