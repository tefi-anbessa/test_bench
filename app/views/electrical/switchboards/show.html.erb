<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Switchboard Header Card -->
  <div class="card mb-4" style="<%= container_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@switchboard).index? %>
              <%= nav_button(action: :index, path: discipline_electrical_switchboards_path(@discipline), record: @switchboard) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div> <!-- end d-flex align-items-center -->
        </div> <!-- end left column -->

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @switchboard.long_label)%>
                <%= @switchboard.tag.service.presence %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@switchboard).edit? %>
                <%= nav_button(action: :edit, path: edit_electrical_switchboard_path(@switchboard), record: @switchboard) %>
              <% end %>

              <% if policy(@switchboard).destroy? %>
                <%= nav_button(action: :delete, path: electrical_switchboard_path(@switchboard), record: @switchboard) %>
              <% end %>

              <% if policy(@switchboard).new? %>
                <%= nav_button(action: :new, path: new_discipline_electrical_switchboard_path(@discipline), record: @switchboard) %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Switchboard Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @switchboard.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <%= show_attribute(@switchboard, :notes, type: :text) %>
              <%= show_attribute(@switchboard, :ingress_protection) %>
              <%= show_attribute(@switchboard, :voltage_rating, type: :enum) %>
              <%= show_attribute(@switchboard, :busbar_rating, type: :float, units: "A") %>
              <%= show_attribute(@switchboard, :busbar_fault_rating, type: :float, units: "A") %>
              <%= show_attribute(@switchboard, :busbar_fault_duration, type: :float, units: "s") %>
              <%= show_attribute(@switchboard, :cable_entry) %>
              <%= show_attribute(@switchboard, :incomer_protection, type: :text) %>
              <%= show_attribute(@switchboard, :metering, type: :text) %>
              <%= show_attribute(@switchboard, :neutral_bar_connections, type: :text) %>
              <%= show_attribute(@switchboard, :earth_bar_connections, type: :text) %>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @switchboard.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <!-- Demand -->
              <%= render 'electrical/demands/show_insert', object: @switchboard %>
              
              <!-- Tag Card -->
              <% if @switchboard.tag.present? %>
                <%= show_association(@switchboard, :tag) %>
              <% else %>
                <div class="row g-3 mb-3">
                  <div class="alert alert-danger">
                    <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                  </div>
                </div>
              <% end %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
        <%= render 'electrical/circuits/circuits', object: @switchboard %>
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->