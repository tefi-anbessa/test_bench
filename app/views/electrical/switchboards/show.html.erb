<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Switchboard Header Card -->
  <div class="card mb-4" style="<%= container_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@switchboard).index? %>
              <%= link_to discipline_electrical_switchboards_path(@discipline),
                    class: "btn btn-sm btn-outline-info me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_switchboard = @switchboard.prev %>
            <% if prev_switchboard.present? %>
              <% disabled = prev_switchboard == @switchboard %>
              <%= link_to prev_switchboard,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_switchboard.label}" do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @switchboard.long_label)%>
                <%= @switchboard.tag.service.presence %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_switchboard = @switchboard.next %>
            <% if next_switchboard.present? %>
              <% disabled = next_switchboard == @switchboard %>
              <%= link_to next_switchboard,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_switchboard.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('arrow-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@switchboard).edit? %>
                <%= link_to edit_electrical_switchboard_path(@switchboard),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@switchboard).destroy? %>
                <%= link_to @switchboard,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@switchboard).new? %>
                <%= link_to new_discipline_electrical_switchboard_path(@discipline),
                  class: "btn btn-outline-primary actions",
                  aria: { label: t('actions.new') },
                  title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="ms-1">
                    <%= [t('actions.new'), t('activerecord.models.electrical/switchboard.one')].join(' ') %>
                  </span>
                <% end %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Switchboard Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @switchboard.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">

              <span class="border">
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/switchboard.notes') %></div>
                </div>
                <div class="row mb-1">
                  <div class="col-8"><%= simple_format(@switchboard.notes) %></div>
                </div>
              </span>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/switchboard.ingress_protection") %></div>
                <div class="col-8"><%= @switchboard.ingress_protection.present? ? 
                  [t("ingress_protection.ip"), @switchboard.ingress_protection].join('') : '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/switchboard.voltage_rating") %></div>
                <div class="col-8"><%= @switchboard.voltage_rating %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/switchboard.busbar_rating") %></div>
                <div class="col-8"><%= @switchboard.busbar_rating %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/switchboard.busbar_fault_rating") %></div>
                <div class="col-8"><%= @switchboard.busbar_fault_rating || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/switchboard.busbar_fault_duration") %></div>
                <div class="col-8"><%= @switchboard.busbar_fault_duration || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/switchboard.cable_entry") %></div>
                <div class="col-8"><%= @switchboard.cable_entry || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/switchboard.incomer_protection") %></div>
                <div class="col-8"><%= @switchboard.incomer_protection || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/switchboard.metering") %></div>
                <div class="col-8"><%= @switchboard.metering || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/switchboard.neutral_bar_connections") %></div>
                <div class="col-8"><%= @switchboard.neutral_bar_connections || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t("activerecord.attributes.electrical/switchboard.earth_bar_connections") %></div>
                <div class="col-8"><%= @switchboard.earth_bar_connections || '-' %></div>
              </div>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @switchboard.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <!-- Demand -->
              <%= render 'electrical/demands/show_insert', tag: @switchboard.tag, demand: @switchboard.electrical_demand %>
              
              <!-- Tag Card -->
              <% if @switchboard.tag.present? %>
                <div class="row g-3 mb-3">
                    <%= render 'tags/card', object: @switchboard.tag, context: t('activerecord.models.tag.one') %>
                </div>
              <% else %>
                <div class="row g-3 mb-3">
                  <div class="alert alert-danger">
                    <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                  </div>
                </div>
              <% end %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
        <%= render 'electrical/circuits/circuits', object: @switchboard %>
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->