<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.tag&.nil? ? '-' : row.tag.discipline.project.code %></td>
  <% end %>
  <% if row.tag&.nil? %>
    <td>'-'</td>
    <td class="table-danger"><%= t("index.no_tag", id: row.id) %></td>
  <% else %>
    <td><%= row.tag.stage %></td>
    <td><%= index_link(action: :show_tag, record: row.tag) %></td>
  <% end %>
  <td><%= index_attribute(row, :notes, type: :text) %></td>
  <td><%= index_attribute(row, :ingress_protection) %></td>
  <td><%= index_attribute(row, :voltage_rating, type: :enum) %></td>
  <td><%= index_attribute(row, :busbar_rating, type: :float, units: "A") %></td>
  <td><%= index_attribute(row, :busbar_fault_rating, type: :float, units: "A") %></td>
  <td><%= index_attribute(row, :busbar_fault_duration, type: :float, units: "s") %></td>
  <td>
    <%= render 'electrical/demands/index_link', row: row %>
  </td>
  <td><%= index_link(action: :children, path: electrical_switchboard_circuits_path(row), count: row.circuits.count) %></td>
  <td>
    <% if can_show %>
      <%= nav_button(action: :show, record: row, icon_only: true) %>
    <% end %>
    <% if can_edit %>
      <%= nav_button(action: :edit, record: row, path: edit_electrical_switchboard_path(row), icon_only: true) %>
    <% end %>
    <% if can_delete %>
      <%= nav_button(action: :delete, record: row, icon_only: true) %>
    <% end %>
  </td>
</tr>
