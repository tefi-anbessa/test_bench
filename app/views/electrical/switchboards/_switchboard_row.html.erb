<tr scope="row">
<% if row.tag.nil? %>
  <td class="table-danger"><%= t("index.no_tag", id: row.id) %></td>
<% else %>
  <td><%= link_to row.tag.full_tag, tag_path(row.tag) %></td>
<% end %>
  <td><%= row.ingress_protection %></td>
  <td><%= row.voltage_rating %></td>
  <td><%= row.busbar_rating %></td>
  <td><%= row.busbar_fault_rating %></td>
  <td><%= row.busbar_fault_duration %></td>
  <td><%= link_to row.electrical_circuits.count, electrical_switchboard_circuits_path(row) %></td>
  <td>
    <% if policy(row).show? %>
      <%= link_to row, class: "btn btn-secondary btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(row).edit? %>
      <%= link_to edit_electrical_switchboard_path(row), class: "btn btn-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline"  do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(row).destroy? %>
      <%= link_to row,
              data: { method: :delete, confirm: t('actions.delete_sure') },
              class: "btn btn-danger btn-sm icon-link",
              aria: { label: t('actions.delete') },
              title: t('actions.delete'),
              display: "inline"  do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>
