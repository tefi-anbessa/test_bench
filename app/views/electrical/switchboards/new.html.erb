<% provide(:title, t('.title')) %>
<% provide(:header, t('.header', scope_text: @discipline.long_label)) %>
<% provide(:button_text, t('actions.create')) %>
<% partial = File.join(@switchboard.model_name.collection, "form") %>
<%= render partial,
  switchboard: @switchboard,
  parent: @parent,
  tag: @tag,
  discipline: @discipline,
  swatch: @swatch,
  circuits: @circuits
%>