<% provide(:title, t('.title')) %>
<div class="container mt-3 mx-auto" style="<%= container_styles(@swatch) %>">
  <!-- Light Cct Schedule Card Header -->
  <div class="card mb-1" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-1" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center p-2">

        <div class="col-2">
            <%= link_to discipline_path(@discipline), class: "btn btn-sm btn-outline-info" do %>
              <%= @discipline.name %>
              <%= bs_icon('collection', class: "me-1") %>
            <% end %>
        </div>

        <!-- Header Text (Left) -->
        <div class="col-8">
          <% scope_text = current_project.present? ? 
          [current_project.class.model_name.human, current_project.label].join(': ') : 
          t('index.all', models: t('activerecord.models.project').pluralize) %>
          <h5 class="mb-1"><%= t('.header', scope_text: scope_text) %></h5>
        </div>

        <!-- New Button (Right) -->
        <div class="col-2 text-end">
          <% if policy(Electrical::LightCct).new? %>
              <%= link_to new_discipline_electrical_light_cct_path(@discipline), 
                class: "btn btn-sm btn-outline-primary actions",
                aria: { label: t('actions.new') },
                title: t('actions.new') do %>
                <%== bs_icon('plus-square-fill') %>
                <span class="ms-1">
                  <%= [t('actions.new'), t('activerecord.models.electrical.light_cct.one')].join(' ') %>
                </span>
              <% end %>
          <% end %>
        </div>
      </div> <!-- end of d-flex -->
    </div> <!-- end of card header -->
    <div class="card-body">
      <div class="row search-form">
        <%= search_form_for @q, url: discipline_electrical_light_ccts_path(@discipline) do |f| %>
          <%= f.search_field :light_fitting_type_cont,
                class: "search_field",
                placeholder: t('activerecord.attributes.electrical.light_cct.light_fitting_type') %>
          <%= f.button nil, class: "btn btn-outline-primary btn-sm mb-1", action: :submit do %>
            <%== bs_icon('search') %>
          <% end %>
        <% end %>
      </div>

      <!-- Broken and incomplete links -->
      <% unless @link_broken.empty? %>
        <table id='link_broken' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-danger">
              <th colspan="9">
                <%= t('index.link_broken', 
                      count: @link_broken.count,
                      models: t("activerecord.models.electrical.light_cct", count: @link_broken.count)) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_broken.each do |tag| %>
              <%= render 'tags/row', t: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <% unless @link_incomplete.empty? %>
        <table id='link_incomplete' class='table table-responsive table-condensed table-hoverable table-bordered' >
          <thead>
            <tr class="table-warning">
              <th colspan="9">
                <%= t('index.link_incomplete', 
                      count: @link_incomplete.count,
                      models: t("activerecord.models.electrical.light_cct", count: @link_incomplete.count)) %>
              </th>
            </tr>
            <%= render 'tags/header' %>
          </thead>
          <tbody>
            <% @link_incomplete.each do |tag| %>
              <%= render 'tags/row', t: tag %>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <!-- Light Ccts -->
      <table id='light_ccts' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
        <%= render 'header' %>
        <tbody>
          <% unless @orphans.empty? %>
            <tr class="table-danger">
              <td colspan="<%= 4 + (current_project ? 1 : 0) %>">
                <%= t('index.orphans', models: t("activerecord.models.electrical.light_cct").tableize) %>
              </td>
            </tr>
            <% @orphans.each do |row| %>
              <%= render 'row', row: row %>
            <% end %>
            <tr class="table-success">
              <td colspan="<%= 4 + (current_project ? 1 : 0) %>">
                <%= t('.title') %>
              </td>
            </tr>
          <% end %>
          <% @light_ccts.each do |row| %>
            <%= render 'row', row: row %>
          <% end %>
        </tbody>
      </table>
    <div class="card-footer">
      <%== pagy_bootstrap_nav(@pagy) %>
      <%== pagy_info(@pagy) %>
    </div>
  </div> <!-- end of card -->
</div> <!-- end of container -->
