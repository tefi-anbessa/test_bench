<div class="container mt-3" style="<%= container_styles(swatch) %>">
  <div class="card" style="<%= card_styles(swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(swatch) %>">
      <!-- Center Header Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
            <%= yield(:header) %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: light_cct,
          url: light_cct.persisted? ?
            light_cct : 
            ( tag.persisted? ?
              tag_electrical_light_ccts_path(tag) :
              discipline_electrical_light_ccts_path(discipline) ),
          layout: :horizontal,
          label_col: "col-sm-4",
          control_col: "col-sm-8",
          wrapper_class: 'mb-1',
          ) do |f| %>

      <div class="card-body p-2" style="<%= form_styles(swatch) %>">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <!-- Tag -->
            <div class="card mb-1">
              <%= f.fields_for tag do |tag_f| %>
                <%= render 'tags/form_nested', tag_f: tag_f, tag: tag %>
              <% end %>
            </div>

            <!-- Light Circuit Details -->
            <div class="card mb-1">
              <div class="card-header p-2">
                <h5><%= light_cct.model_name.human %></h5>
              </div>

              <div class="card-body p-2">
                <%= render 'shared/error_messages', object: f.object %>

                <%= form_field(f, :light_fitting_type, type: :enum_translated, required: true) %>
                <%= form_field(f, :quantity, type: :number, control_cols: 4, min: 1, max: 100, required: true) %>
                <%= form_field(f, :notes, type: :text) %>
              </div> <!-- end light circuit card body -->
            </div> <!-- end light circuit card -->

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%= link_to(light_cct.persisted? ? light_cct : discipline_electrical_light_ccts_path(discipline),
                    class: 'btn btn-warning',
                    data: { confirm: t('actions.sure'), turbo: false }) do %>
                <%= t('actions.discard') %>
                <%== bs_icon('x-square') %>
              <% end %>

              <%= f.button :submit, class: 'btn btn-primary', name: 'form[submit]' do %>
                <%= yield(:button_text) %>
                <%== bs_icon('save') %>
              <% end %>
            </div> <!-- end card footer -->
          </div> <!-- end responsive columns -->
        </div> <!-- end row -->
      </div> <!-- end card body -->
    <% end %>
  </div> <!-- end card -->
</div> <!-- end container -->