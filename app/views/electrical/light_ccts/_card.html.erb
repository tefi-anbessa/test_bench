<!-- Light Circuit collapsible card -->
<!-- Expecting 'object', 'context' and 'id' variables, passed from the shared/_association partial. -->
<!-- The card uses the context name in the header and the id for the block (for testing). -->
<% light_cct = object %>
<% context ||= t("activerecord.models.electrical/light_cct.one") %>
<%= render 'components/collapsible',
  id: "#{id}_#{light_cct.id}_details",
  title: [context, light_cct.long_label].join(': '),
  expanded: false,
  header_class: 'py-1' do %>
  
  <div class="container-fluid">
    <%= nav_link(action: :show, record: light_cct) %>

    <%= show_attribute(light_cct, :light_fitting_type, type: :enum_translated) %>
    <%= show_attribute(light_cct, :quantity, type: :integer) %>
    <%= show_attribute(light_cct, :notes, type: :text) %>
  </div>
<% end %>