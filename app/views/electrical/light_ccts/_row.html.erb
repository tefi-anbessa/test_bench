<tr scope="row">
  <% unless current_project %>
    <td scope = "col"><%= row.tag&.nil? ? '-' : row.tag.discipline.project.code %></td>
  <% end %>
  <% if row.tag&.nil? %>
    <td>'-'</td>
    <td class="table-danger"><%= t("index.no_tag", id: row.id) %></td>
  <% else %>
    <td><%= row.tag.stage %></td>
    <td><%= link_to row.tag.label, row.tag %></td>
  <% end %>
  <td><%= row.class.human_enum_name(:light_fitting_type, row.light_fitting_type) %></td>
  <td><%= row.quantity %></td>
  <td>
    <% if policy(row).show? %>
      <%= link_to row, class: "btn btn-outline-info btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(row).edit? %>
      <%= link_to edit_electrical_light_cct_path(row), class: "btn btn-outline-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline"  do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(row).destroy? %>
      <%= link_to row,
              data: { method: :delete, confirm: t('actions.delete_sure') },
              class: "btn btn-outline-danger btn-sm icon-link",
              aria: { label: t('actions.delete') },
              title: t('actions.delete'),
              display: "inline"  do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>