<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Light Circuit Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@light_cct).index? %>
              <%= nav_button(action: :index_discipline, path: discipline_tagables_path(@discipline, tagable_type: "Electrical::LightCct"), record: @light_cct) %>
            <% end %>

            <!-- Previous Button -->
            <%= nav_button(action: :previous_tagable, record: @neighbours[0]) %>
          </div> <!-- end d-flex align-items-center -->
        </div> <!-- end left column -->

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @light_cct.long_label)%>
                <%= @light_cct.tag.service.presence %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <%= nav_button(action: :next_tagable, record: @neighbours[1]) %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@light_cct).edit? %>
                <%= nav_button(action: :edit_tagable, path: edit_tag_tagable_path(@tag), record: @light_cct) %>
              <% end %>

              <% if policy(@light_cct).destroy? %>
                <%= nav_button(action: :delete, path: tag_tagable_path(@tag), record: @light_cct) %>
              <% end %>

              <% if policy(@light_cct).new? %>
                <%= nav_button(action: :new, path: new_discipline_tagable_path(@discipline.id, tagable_type: "Electrical::LightCct"),
                  record: Electrical::LightCct.new) %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Light Circuit Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @light_cct.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <%= show_attribute(@light_cct, :light_fitting_type, type: :enum_translated) %>
              <%= show_attribute(@light_cct, :quantity, type: :integer) %>
              <%= show_attribute(@light_cct, :notes, type: :text) %>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @light_cct.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <!-- Demand -->
              <%= render 'electrical/demands/show_insert', object: @light_cct %>
              <!-- Tag Card -->
              <% if @light_cct.tag.present? %>
                <%= show_association(@light_cct, :tag) %>
              <% else %>
                <div class="row g-3 mb-3">
                  <div class="alert alert-danger">
                    <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                  </div>
                </div>
              <% end %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->