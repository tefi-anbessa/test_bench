<% provide(:title, t('.title')) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <!-- Light Circuit Header Card -->
  <div class="card mb-4" style="<%= card_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@light_cct).index? %>
              <%= link_to discipline_electrical_light_ccts_path(@discipline),
                    class: "btn btn-sm btn-outline-info me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>

            <!-- Previous Button -->
            <% prev_light_cct = @light_cct.prev %>
            <% if prev_light_cct.present? %>
              <% disabled = prev_light_cct == @light_cct %>
              <%= link_to prev_light_cct,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_light_cct.label}" do %>
                <%== bs_icon('box-arrow-in-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div> <!-- end d-flex align-items-center -->
        </div> <!-- end left column -->

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge fs-6" style="<%= badge_styles(@swatch) %>">
                <%= t('.header', label: @light_cct.long_label)%>
                <%= @light_cct.tag.service.presence %>
              </span>
            </div>
          </div>
        </div>

        <!-- Right Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_light_cct = @light_cct.next %>
            <% if next_light_cct.present? %>
              <% disabled = next_light_cct == @light_cct %>
              <%= link_to next_light_cct,
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_light_cct.label}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== bs_icon('box-arrow-in-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@light_cct).edit? %>
                <%= link_to edit_electrical_light_cct_path(@light_cct),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@light_cct).destroy? %>
                <%= link_to @light_cct,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@light_cct).new? %>
                <%= link_to new_discipline_electrical_light_cct_path(@discipline),
                  class: "btn btn-outline-primary actions",
                  aria: { label: t('actions.new') },
                  title: t('actions.new') do %>
                  <%== bs_icon('plus-square-fill') %>
                  <span class="ms-1">
                    <%= [t('actions.new'), t('activerecord.models.electrical/light_cct.one')].join(' ') %>
                  </span>
                <% end %>
              <% end %>
            </div> <!-- end button group -->
          </div> <!-- end d-flex -->
        </div> <!-- end col-auto -->
      </div> <!-- end row -->
    </div> <!-- end card header -->

    <div class="card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

          <!-- Light Circuit Details Card -->
          <div class="card mb-4" style="<%= card_styles(@swatch) %>">
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.details', model: @light_cct.model_name.human) %></h4>
            </div> <!-- end inner card header -->

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/light_cct.light_fitting_type') %></div>
                <div class="col-8"><%= Electrical::LightCct.human_enum_name(:light_fitting_type, @light_cct.light_fitting_type) %></div>
              </div>

              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/light_cct.quantity') %></div>
                <div class="col-8"><%= @light_cct.quantity || '-' %></div>
              </div>

              <span class="border">
                <div class="row mb-1">
                  <div class="col-4 text-muted"><%= t('activerecord.attributes.electrical/light_cct.notes') %></div>
                </div>
                <div class="row mb-1">
                  <div class="col-8"><%= simple_format(@light_cct.notes) %></div>
                </div>
              </span>
            </div>  <!-- temporary end inner card body -->

            <!-- Associations -->
            <div class="card-header py-1" style="<%= card_header_styles(@swatch) %>">
              <h4 class="mb-0"><%= t('show.associations', model: @light_cct.class.model_name.human) %></h4>
            </div>

            <div class="card-body p-3" style="<%= card_styles(@swatch) %>">
              <!-- Demand -->
              <%= render 'electrical/demands/show_insert', tag: @light_cct.tag, demand: @light_cct.electrical_demand %>
              <!-- Tag Card -->
              <% if @light_cct.tag.present? %>
                <div class="row g-3 mb-3">
                    <%= render 'tags/card', object: @light_cct, association: :tag %>
                </div>
              <% else %>
                <div class="row g-3 mb-3">
                  <div class="alert alert-danger">
                    <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                  </div>
                </div>
              <% end %>
            </div>  <!-- end inner card body -->
          </div> <!-- end inner card -->
        </div> <!-- end responsive columns -->
      </div> <!-- justify-content-center -->
    </div> <!-- end outer card body -->
  </div> <!-- end card -->
</div> <!-- end container -->