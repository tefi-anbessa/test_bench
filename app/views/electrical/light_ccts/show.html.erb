<% provide(:title, t('.title')) %>
<div class="container mt-3">
  <!-- Light Circuit Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <% if policy(@light_cct).index? %>
              <%= link_to electrical_light_ccts_path,
                    class: "btn btn-sm btn-outline-secondary me-2",
                    title: t('actions.index') do %>
                <%== bs_icon('list-columns-reverse') %>
                <span class="d-none d-md-inline"><%= t('actions.index') %></span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge bg-primary fs-6">
                <%= t('.header', label: @light_cct.label)%>
              </span>
              <% if @light_cct.tag&.service.present? %>
                <small class="text-muted ms-2"><%= @light_cct.tag.service %></small>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Right Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@light_cct).edit? %>
                <%= link_to edit_electrical_light_cct_path(@light_cct),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== bs_icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@light_cct).destroy? %>
                <%= link_to @light_cct,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== bs_icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column justify-content-center">
      <div class="card-body">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Tag Card -->
            <% if @light_cct.tag.present? %>
              <div class="row g-3 mb-3">
                  <%= render 'tags/card', tag: @light_cct.tag %>
              </div>
            <% else %>
              <div class="row g-3 mb-3">
                <div class="alert alert-danger">
                  <%= t('show.orphan', model: Tag.model_name.human.downcase) %>
                </div>
              </div>
            <% end %>

            <!-- Light Circuit Details Card -->
            <div class="row">
              <div class="card mb-4">
                <div class="card-header py-1">
                  <h4 class="mb-0"><%= t('show.details', model: @light_cct.model_name.human) %></h4>
                </div>
                <div class="card-body p-3">
                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @light_cct.class.human_attribute_name(:light_fitting_type) %></div>
                    <div class="col-8"><%= Electrical::LightCct.human_enum_name(:light_fitting_type, @light_cct.light_fitting_type) %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @light_cct.class.human_attribute_name(:quantity) %></div>
                    <div class="col-8"><%= @light_cct.quantity || '-' %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted"><%= @light_cct.class.human_attribute_name(:notes) %></div>
                    <div class="col-8"><%= @light_cct.notes || '-' %></div>
                  </div>

                  <div class="row mb-1">
                    <div class="col-4 text-muted">
                      <% text = t('activerecord.models.demand') %>
                      <% if @light_cct.electrical_demand.present? %>
                        <%= link_to electrical_demand_path(@light_cct.demand),
                          class: "btn btn-sm btn-outline-secondary",
                          title: text do %>
                            <%= text %>
                            <%== bs_icon('box-arrow-in-down-right') %>
                        <% end %>
                      <% else %>
                      <% text = t("actions.link", resource: t("activerecord.models.demand")) %>
                        <% if policy(Electrical::Demand).new? %>
                          <%= link_to new_tag_electrical_demand_path(@light_cct.tag.id),
                              class: "btn btn-sm btn-outline-primary mb-2",
                              title: text do %>
                                <span class="d-none d-md-inline">
                                  <%= text %>
                                </span>
                                <%== bs_icon('link') %>
                              <% end %>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>