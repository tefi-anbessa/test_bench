<% content_for :title, "#{t('activerecord.models.' + @cable.model_name.i18n_key.to_s, default: @cable.model_name.human)} #{@cable.tag.full_tag}" %>
<div class="container mt-3">
  <!-- Cable Header Card -->
  <div class="card mb-4">
    <div class="card-header p-2">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Index Button -->
            <%= link_to cables_path,
                  class: "btn btn-sm btn-outline-secondary me-2",
                  title: t('actions.index') do %>
              <%== icon('list-columns-reverse') %>
              <span class="d-none d-md-inline"><%= t('actions.index') %></span>
            <% end %>

            <!-- Previous Button -->
            <% prev_cable = @cable.prev %>
            <% if prev_cable.present? %>
              <% disabled = prev_cable == @cable %>
              <%= link_to cable_path(prev_cable),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary #{'disabled' if disabled}",
                    title: "#{t('actions.previous')}: #{prev_cable.tag.full_tag}" do %>
                <%== icon('arrow-left') %>
                <span class="d-none d-md-inline">
                  <%= t('actions.previous') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Center Tag Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <div class="mt-1">
              <span class="badge bg-primary fs-6">
                <%= t('activerecord.models.cable') + ' ' + @cable.tag.full_tag %>
              </span>
              <% if @cable.tag.service.present? %>
                <small class="text-muted ms-2"><%= @cable.tag.service %></small>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Right Navigation and Actions -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <!-- Next Button -->
            <% next_cable = @cable.next %>
            <% if next_cable.present? %>
              <% disabled = next_cable == @cable %>
              <%= link_to cable_path(next_cable),
                    disabled: disabled,
                    class: "btn btn-sm btn-outline-secondary me-2 #{'disabled' if disabled}",
                    title: "#{t('actions.next')}: #{next_cable.tag.full_tag}" do %>
                <span class="d-none d-md-inline">
                  <%= t('actions.next') %>
                </span>
                <%== icon('arrow-right') %>
              <% end %>
            <% end %>

            <!-- Action Buttons -->
            <div class="btn-group btn-group-sm gap-1">
              <% if policy(@cable).edit? %>
                <%= link_to edit_cable_path(@cable),
                      class: "btn btn-outline-warning",
                      title: t('actions.edit') do %>
                  <%== icon('pencil-square') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.edit') %>
                  </span>
                <% end %>
              <% end %>

              <% if policy(@cable).destroy? %>
                <%= link_to @cable,
                      method: :delete,
                      data: { confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger",
                      title: t('actions.delete') do %>
                  <%== icon('trash') %>
                  <span class="d-none d-md-inline">
                    <%= t('actions.delete') %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Tag and Cable Type Cards -->
      <div class="row g-3 mb-3">
        <!-- Tag Card -->
        <div class="col-md-6">
          <%= render 'tags/tag_card', tag: @cable.tag %>
        </div>
        
        <!-- Cable Type Card -->
        <div class="col-md-6">
          <%= render 'cable_types/cable_type', cable_type: @cable.cable_type %>
        </div>
      </div>
      
      <!-- Cable Details Card -->
      <div class="row">
        <div class="col-md-6">
          <div class="card mb-4">
            <div class="card-header py-1">
              <h5 class="mb-0"><%= t('cables.show.cable_details') %></h5>
            </div>
            <div class="card-body p-3">
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.cable.cable_type') %></div>
                <div class="col-8"><%= @cable.cable_type&.description || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.cable.route_length') %></div>
                <div class="col-8"><%= @cable.route_length.present? ? "#{@cable.route_length} m" : '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.cable.vertical_allowance') %></div>
                <div class="col-8"><%= @cable.vertical_allowance.present? ? "#{@cable.vertical_allowance} m" : '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.cable.termination_allowance') %></div>
                <div class="col-8"><%= @cable.termination_allowance.present? ? "#{@cable.termination_allowance} m" : '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.cable.start_mark') %></div>
                <div class="col-8"><%= @cable.start_mark.presence || '-' %></div>
              </div>
              
              <div class="row mb-1">
                <div class="col-4 text-muted"><%= t('activerecord.attributes.cable.end_mark') %></div>
                <div class="col-8"><%= @cable.end_mark.presence || '-' %></div>
              </div>
            </div>
          </div>
        </div>
        
        <% if @cable.circuit.present? %>
          <div class="col-md-6">
            <%= render 'components/collapsible',
                  title: t('cables.show.circuit_details'),
                  id: 'circuit-details-collapse',
                  expanded: true,
                  header_class: 'py-1' do %>
                  
              <dl class="row mb-0">
                <dt class="col-sm-4"><%= t('activerecord.models.switchboard') %></dt>
                <dd class="col-sm-8">
                  <%= link_to @cable.circuit.switchboard.tag.full_tag, 
                        @cable.circuit.switchboard %>
                  <small class="text-muted d-block"><%= @cable.circuit.switchboard.tag.service %></small>
                </dd>

                <dt class="col-sm-4"><%= t('activerecord.models.circuit') %></dt>
                <dd class="col-sm-8">
                  <%= link_to @cable.circuit.serial, @cable.circuit %>
                </dd>

                <% if @cable.circuit.demand&.present? %>
                  <dt class="col-sm-4"><%= t('activerecord.models.demand') %></dt>
                  <dd class="col-sm-8">
                    <%= link_to @cable.circuit.load.loadable.tag.full_tag, 
                          @cable.circuit.load %>
                    <small class="text-muted d-block"><%= @cable.circuit.load.loadable.tag.service %></small>
                  </dd>
                <% end %>
              </dl>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
