<div class="container mt-3">
  <div class="card">
    <div class="card-header p-2">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
            <span class="badge bg-primary fs-6">
              <%= cable.persisted? ? t('actions.edit') : t('actions.new') %> 
              <% if tag.present? && tag.persisted? %>
                <%= t('activerecord.models.cable') + ' ' + tag.full_tag %>
                <small class="text-muted ms-2"><%= tag.service %></small>
              <% else %>
                <%= t('activerecord.models.cable') %>
              <% end %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: cable, 
        layout: :horizontal, 
        label_col: "col-sm-5", 
        control_col: "col-sm-7",
        wrapper_class: 'mb-1',
        bootstrap: { 
          form: { class: 'mb-0' },
          label: { class: 'mb-0' }
        }) do |f| %>
      
      <div class="card-body p-2">
        <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-none mb-2">
            <div class="card-header bg-transparent border-0 p-1">
              <h6 class="mb-0"><%= t('cables.show.cable_details') %></h6>
            </div>
            <div class="card-body p-1">
              <!-- Cable Type -->
              <%= f.collection_select :cable_type_id,
                    CableType.all,
                    :id,
                    :description,
                    { include_blank: true },
                    { 
                      class: 'form-select form-select-sm',
                      wrapper: { class: 'mb-1' },
                      required: true 
                    } %>

              <!-- Circuit ID (Temporary) -->
              <%= f.number_field :circuit_id,
                    class: 'form-control form-control-sm',
                    min: 0,
                    placeholder: 'Temporary: Will be replaced',
                    wrapper: { class: 'mb-1' } %>

              <!-- Design lengths -->
              <%= f.number_field :route_length,
                    class: 'form-control form-control-sm',
                    step: '0.1',
                    min: 0,
                    wrapper: { class: 'mb-1' } %>

              <%= f.number_field :vertical_allowance,
                    class: 'form-control form-control-sm',
                    step: '0.1',
                    min: 0,
                    wrapper: { class: 'mb-1' } %>

              <%= f.number_field :termination_allowance,
                    class: 'form-control form-control-sm',
                    step: '0.1',
                    min: 0,
                    wrapper: { class: 'mb-1' } %>

              <!-- Installed length -->
              <%= f.number_field :start_mark,
                    class: 'form-control form-control-sm',
                    step: '1',
                    min: 0,
                    wrapper: { class: 'mb-1' } %>

              <%= f.number_field :end_mark,
                    class: 'form-control form-control-sm',
                    step: '1',
                    min: 0,
                    wrapper: { class: 'mb-1' } %>
            </div>
            </div>

            <!-- Card Footer with Actions -->
            <div class="card-footer bg-transparent text-end p-2">
              <%= link_to t('actions.cancel'), cables_path, class: 'btn btn-sm btn-outline-secondary me-2' %>
              <%= f.submit t('actions.save'), class: 'btn btn-sm btn-primary' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
