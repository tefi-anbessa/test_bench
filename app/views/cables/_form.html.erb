<div class="container mt-3">
  <div class="card">
    <div class="card-header p-2">

      <!-- Center Tag Info -->
      <div class="col text-center">
        <div class="d-flex flex-column align-items-center">
          <div class="mt-1">
              <%= cable.persisted? ? t('actions.edit') : t('actions.new') %> 
              <% if cable.tag.present? && cable.tag.persisted? %>
                <%= [t('activerecord.models.cable'), cable.tag.full_tag].join(': ') %>
                <small class="text-muted ms-2"><%= cable.tag.service %></small>
              <% else %>
                <%= t('activerecord.models.cable') %>
              <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= bootstrap_form_with(model: cable, 
          layout: :horizontal, 
          label_col: "col-sm-4", 
          control_col: "col-sm-8",
          wrapper_class: 'mb-1',
          bootstrap: { 
            form: { class: 'mb-0' },
            label: { class: 'mb-0' }
          }) do |f| %>
      
      <div class="card-body p-2">
        <%= render 'shared/error_messages', object: f.object %>

        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <!-- Tag -->
            <% if tag.persisted? %>
              <%= render 'tags/tag_card', tag: tag %>
            <% else %>
            # TODO: Add tag form
            <% end %>

            <!-- Cable Type -->
            <%= f.collection_select :cable_type_id,
                    @cable_types,
                    :id,
                    :label,
                    { 
                      class: 'form-select form-select-sm',
                      wrapper: { class: 'mb-1' },
                      required: true 
                    } %>
                    
            <div data-controller="cable-form" 
              data-cable-form-id-options-value="<%= @id_options.to_json %>">


            <!-- From Section --> 
            <div class="row">
              <%= f.select :from_type,
                options_for_select(@connect_options, selected: @cable.from_type),
                { include_blank: true },
                { 
                  class: 'form-select form-select-sm',
                  'data-cable-form-target': 'fromType',
                  'data-action': 'change->cable-form#updateFromOptions'
                } %> 
            </div>
            <div class="row">
              <%= f.select :from_id, 
                   options_for_select(@id_options[@cable.from_type] || [], 
                   selected: @cable.from_id), 
                   { include_blank: true },
                   { 'data-cable-form-target': 'fromId' } %>
            </div>

            <!-- To Section --> 
            <div class="row">
              <%= f.select :to_type, 
                  options_for_select(@connect_options, selected: @cable.to_type),
                    { include_blank: true },
                    { 
                      class: 'form-select form-select-sm', 
                      'data-cable-form-target': 'toType',
                      'data-action': 'change->cable-form#updateToOptions'
                    } %>
            </div>
            <div class="row">
              <%= f.select :to_id,
                    options_for_select(@id_options[@cable.to_type] || [], 
                    selected: @cable.to_id), 
                    { include_blank: true },
                    { 'data-cable-form-target': 'toId' } %>
              </div>

            <!-- Design lengths -->
            <%= f.number_field :route_length,
                    class: 'form-control form-control-sm',
                    step: '0.1',
                    min: 0,
                    label_col: "col-sm-4",
                    control_col: "col-sm-3",
                    wrapper: { class: 'mb-1' } %>

            <%= f.number_field :vertical_allowance,
                    class: 'form-control form-control-sm',
                    step: '0.1',
                    min: 0,
                    label_col: "col-sm-4",
                    control_col: "col-sm-3",
                    wrapper: { class: 'mb-1' } %>

            <%= f.number_field :termination_allowance,
                    class: 'form-control form-control-sm',
                    step: '0.1',
                    min: 0,
                    label_col: "col-sm-4",
                    control_col: "col-sm-3",
                    wrapper: { class: 'mb-1' } %>

            <!-- Installed length -->
            <%= f.number_field :start_mark,
                    class: 'form-control form-control-sm',
                    step: '1',
                    min: 0,
                    label_col: "col-sm-4",
                    control_col: "col-sm-3",
                    wrapper: { class: 'mb-1' } %>

            <%= f.number_field :end_mark,
                    class: 'form-control form-control-sm',
                    step: '1',
                    min: 0,
                    label_col: "col-sm-4",
                    control_col: "col-sm-3",
                    wrapper: { class: 'mb-1' } %>
          </div>

          <!-- Card Footer with Actions -->
          <div class="card-footer bg-transparent text-end p-2">
            <%= link_to(cable.persisted? ? cable_path(@cable) : cables_path,
                  class: 'btn btn-warning',
                  data: { confirm: t('actions.sure'), turbo: false }) do %>
              <%= t('actions.discard') %>
              <%== icon('x-square') %>
            <% end %>
            <%= f.button :submit, class: 'btn btn-primary' do %>
              <%= yield(:button_text) || t('actions.save') %>
              <%== icon('save') %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
