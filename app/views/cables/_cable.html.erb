<div id="<%= dom_id cable %>">
  <div class="container text-start">
    <% if cable.tag.nil? %>
      <div class="d-flex flex-row mb-1">
        <span class="col-1 data-label">
          <% t('show.orphan', model: t("activerecord.models.tag").tableize) %>
        </span>
      </div>
    <% else %>
      <div class="d-flex flex-row mb-1">
        <span class="col-1 data-label">
          <%= t('activerecord.attributes.tag.full_tag') + ':' %>
        </span>
        <span class="col-1 data-field">
          <%= link_to cable.tag.full_tag, tag_path(cable.tag.id) %>
        </span>
        <span class="col-4 data-field">
          <%= cable.tag.description %>
        </span>
      </div>
    <% end %>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable.cable_type_id') %>:
      </span>
      <span class="col-1 data-field">
        <%= link_to cable.cable_type_id, cable_type_path(cable.cable_type_id) %>
      </span>
    </div>
    <% if cable.circuit.present? %>
      <div class="d-flex flex-row mb-1">
        <span class="col-1 data-label">
          <%= t('activerecord.models.switchboard') %>:
        </span>
        <span class="col-1 data-field">
          <%= link_to cable.circuit.switchboard.tag.full_tag,
                switchboard_path(cable.circuit.switchboard) %>
        </span>
        <span class="col-1 data-field">
          <%= cable.circuit.switchboard.tag.description %>:
        </span>
        <span class="col-1 data-label">
          <%= t('activerecord.models.circuit') %>:
        </span>
        <span class="col-1 data-field">
          <%= link_to cable.circuit.serial,
                circuit_path(cable.circuit) %>
        </span>
      <% else %>
        <%= t('show.unassigned', model: t('activerecord.models.circuit')) %>
      <% end %>
    </div>
    <% if cable.circuit.load.present? %>
      <div class="d-flex flex-row mb-1">
        <span class="col-1 data-label">
          <%= t('activerecord.models.demand') %>:
        </span>
        <span class="col-1 data-field">
          <%= link_to cable.circuit.load.loadable.tag.full_tag,
                demand_path(cable.circuit.load) %>
        </span>
        <span class="col-4 data-field">
          <%= cable.circuit.load.loadable.tag.description %>
        </span>
      </div>
    <% else %>
      <%= t('show.unassigned', model: t('activerecord.models.demand')) %>
    <% end %>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable.route_length') %>:
      </span>
      <span class="col-1 data-field">
        <%= cable.route_length %>m
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable.vertical_allowance') %>:
      </span>
      <span class="col-1 data-field">
        <%= cable.vertical_allowance %>m
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable.termination_allowance') %>:
      </span>
      <span class="col-1 data-field">
        <%= cable.termination_allowance %>m
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable.start_mark') %>:
      </span>
      <span class="col-1 data-field">
        <%= cable.start_mark %>m
      </span>
    </div>
    <div class="d-flex flex-row mb-1">
      <span class="col-1 data-label">
        <%= t('activerecord.attributes.cable.end_mark') %>:
      </span>
      <span class="col-1 data-field">
        <%= cable.end_mark %>m
      </span>
    </div>
  </div>
</div>
