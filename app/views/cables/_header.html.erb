  <% end %>
  <th scope="col"><%= sort_link(@q, :tag_stage, t("activerecord.attributes.tag.stage")) %></th>
  <th scope="col"><%= sort_link(@q, :tag, t("activerecord.attributes.tag.full_tag")) %></th>
  <th scope="col"><%= t('activerecord.attributes.cable.notes') %></th>
