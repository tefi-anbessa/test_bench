<!-- Project Users Dashboard Panel -->
<div class="card mb-4" style="<%= card_styles(@swatch) %>">
  <div class="card-header d-flex justify-content-between align-items-center py-2" style="<%= card_header_styles(@swatch) %>">
    <h5 class="mb-0"><%= t('.header', scope_text: label) %></h5>
    <% if policy(User).new? %>
      <%= link_to new_user_path,
            class: "btn btn-outline-primary btn-sm",
            data: { turbo: false },
            aria: { label: t('actions.new') } do %>
        <%== bs_icon('plus-square-fill') %>
        <%= t('actions.new') %>
      <% end %>
    <% end %>
  </div>
  
  <div class="card-body p-3">
    <% if users.any? %>
      <% users.each do |user| %>
        <div class="row align-items-center py-2 border-bottom">
          <!-- User Info -->
          <div class="col-md-3">
            <div class="d-flex align-items-center gap-3">
              <div>
                <%= gravatar_for user, size: 40, class: "rounded-circle" %>
              </div>
              <div>
                <div class="fw-bold">
                  <%= user.name %>
              </div>
                <div class="text-muted small"><%= user.email %></div>
              </div>
            </div>
          </div>
          
          <!-- Project & Discipline Roles -->
          <div class="col-md-6">
            <div class="d-flex flex-wrap gap-1">
              <% project_roles = user.roles.where(resource_type: 'Project', resource_id: project.id) %>
              <% discipline_roles = user.roles.where(resource_type: 'Discipline', resource_id: project.discipline_ids) %>
              
              <% project_roles.each do |role| %>
                <span class="badge bg-primary">
                  <%= t("rolify.names.#{role.name}") %>
                </span>
              <% end %>
              
              <% discipline_roles.each do |role| %>
                <span class="badge bg-secondary">
                  <%= role.resource.name %>: <%= role.name %>
                </span>
              <% end %>
              
              <% if user.has_role?(:admin) %>
                <span class="badge bg-danger">
                  <%= t('activerecord.attributes.user.admin') %>
                </span>
              <% end %>
            </div>
          </div>
          
          <!-- Action Buttons -->
          <div class="col-md-3 text-end">
            <%= link_to user_path(user),
                  class: "btn btn-outline-info btn-sm",
                  aria: { label: t('actions.show') } do %>
              <%== bs_icon('eye') %>
              <%= t('actions.show') %>
            <% end %>
            
            <% if policy(user).edit? %>
              <%= link_to edit_user_path(user),
                    class: "btn btn-outline-warning btn-sm",
                    aria: { label: t('actions.edit') } do %>
                <%== bs_icon('pencil') %>
                <%= t('actions.edit') %>
              <% end %>
            <% end %>
            
            <% if policy(user).destroy? %>
              <%= link_to user,
                      data: { method: :delete, confirm: t('actions.delete_sure') },
                      class: "btn btn-outline-danger btn-sm",
                      aria: { label: t('actions.delete') } do %>
                <%== bs_icon('trash') %>
                <%= t('actions.delete') %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center text-muted py-3">
        <%= t('.no_users', scope_text: label) %>
      </div>
    <% end %>
  </div>
</div>
