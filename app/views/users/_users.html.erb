<!-- Project Users Dashboard Panel -->
<div class="card mb-4" style="<%= card_styles(@swatch) %>">
  <div class="card-header d-flex justify-content-between align-items-center py-2" style="<%= card_header_styles(@swatch) %>">
    <h5 class="mb-0"><%= t('.header', scope_text: label) %></h5>
    <% if policy(User).new? %>
      <%= link_to new_user_path,
            class: "btn btn-outline-primary btn-sm",
            data: { turbo: false },
            aria: { label: t('actions.new') } do %>
        <%== bs_icon('plus-square-fill') %>
        <%= t('actions.new') %>
      <% end %>
    <% end %>
  </div>
  
  <div class="card-body p-3">
    <% if users.any? %>
      <% users.each do |user| %>
        <div class="row align-items-center py-2 border-bottom">
          <!-- User Info -->
          <div class="col-md-3">
            <div class="d-flex align-items-center gap-3">
              <div>
                <%= gravatar_for user, size: 40, class: "rounded-circle" %>
              </div>
              <div>
                <div class="fw-bold">
                  <%= user.name %>
              </div>
                <div class="text-muted small"><%= user.email %></div>
              </div>
            </div>
          </div>
          
          <!-- Project & Discipline Roles -->
          <div class="col-md-6">
            <div class="d-flex flex-wrap gap-1">
              <% project_roles = user.roles.where(resource_type: 'Project', resource_id: project.id) %>
              <% discipline_roles = user.roles.where(resource_type: 'Discipline', resource_id: project.discipline_ids) %>
              <% global_roles = user.roles.where(resource_type: nil)%>
              
              <% project_roles.each do |role| %>
                <span class="badge bg-primary">
                  <%= t("rolify.names.#{role.name}", default: "*#{role.name}") %>
                </span>
              <% end %>
              
              <% discipline_roles.each do |role| %>
                <span class="badge bg-secondary">
                  <%= t("activerecord.models.#{role.resource.model_name.i18n_key}", count: 1) %>: 
                  <%= t("rolify.names.#{role.name}", default: "*#{role.name}") %>
                </span>
              <% end %>
              
              <% global_roles.each do |role| %>
                <span class="badge bg-danger">
                  <%= t("rolify.names.#{role.name}", default: "*#{role.name}") %>
                </span>
              <% end %>
            </div>
          </div>
          
          <!-- Action Buttons -->
          <div class="col-md-3 text-end">
            <%= nav_button(action: :show, record: user, icon_only: true) %>
            
            <% if policy(user).edit? %>
              <%= nav_button(action: :edit, record: user, path: edit_user_path(user), icon_only: true) %>
            <% end %>
            
            <% if policy(user).destroy? %>
              <%= nav_button(action: :delete, record: user, icon_only: true) %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center text-muted py-3">
        <%= t('.no_users', scope_text: label) %>
      </div>
    <% end %>
  </div>
</div>
