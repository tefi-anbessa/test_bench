<% provide(:title, t('.title')) %>
<nav class="navbar bg-body-tertiary">
  <div class="container-fluid">
    <ul class="navbar-nav me-auto mb-2 mb-lg-0 flex-row">
      <li class="nav-item">
        <%= link_to new_user_registration_path, class: "btn btn-primary actions",
              aria: { label: t('actions.new') },
              title: t('actions.new')  do %>
          <%== bs_icon('plus-square-fill') %>
          <%= t('actions.new') + " " + t('activerecord.models.user.one') %>
        <% end %>
      </li>
      <span class="nav-text ms-5 me-5 h2">
        <%= t('.header')%>
      </span>
    </ul>
  </div>
</nav>
<div class = "container">
  <div class = 'listing'>
    <%= search_form_for @q do |f| %>
      <%= f.search_field :name_or_email_cont, class: "search_field" %>
      <%= f.button nil, class: "btn btn-primary btn-sm", action: :submit do %>
        <%== bs_icon('search') %>
      <% end %>
    <% end %>
    <%== pagy_bootstrap_nav(@pagy, classes: 'pagination pagination-sm') %>
    <div class="card mb-3" style="<%= card_styles(@swatch) %>">
      <table id='projects' class='table table-responsive table-condensed table-striped table-hoverable table-bordered mb-0' >
        <thead>
          <th scope="col" width="150px"><%= t('.avatar')%></th>
          <th scope="col"><%= sort_link(@q, :name) %></th>
          <th scope="col"><%= sort_link(@q, :email) %></th>
          <th scope="col" width="150px"><%= t('table.links')%></th>
        </thead>
        <tbody>
          <% @users.each do |u| %>
            <tr scope="row">
              <td><%= avatar_for u, size: 20 %></td>
              <td><%= link_to u.name, user_path(u) %></td>
              <td><%= highlight u.email, params.dig(:q, :email_cont)  %></td>
              <td>
                <%= nav_button(action: :show, record: u, icon_only: true) %>
                <% if policy(u).edit? %>
                  <%= nav_button(action: :edit, record: u, icon_only: true) %>
                <% end %>
                <% if policy(u).destroy? %>
                  <%= nav_button(action: :delete, record: u, icon_only: true) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <%== pagy_bootstrap_nav(@pagy, classes: 'pagination pagination-sm') %>
      <%== pagy_info(@pagy) %>
      <%== pagy_limit_selector_js(@pagy) %>
    </div>

  </div>
</div>
