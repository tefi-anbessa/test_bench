<% provide(:title, @user.name) %>
<div class="container mt-3" style="<%= container_styles(@swatch) %>">
  <div class="card mb-4" style="<%= container_styles(@swatch) %>">
    <div class="card-header p-2" style="<%= card_header_styles(@swatch) %>">
      <div class="row align-items-center">
        <!-- Left Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <% if policy(User).index? %>
              <%= nav_button(action: :index, path: users_path, record: @user) %>
            <% end %>
            <%= nav_button(action: :previous, record: @neighbours[0]) %>
          </div>
        </div>

        <!-- Center Info -->
        <div class="col text-center">
          <div class="d-flex flex-column align-items-center">
            <span class="badge fs-5" style="<%= badge_styles(@swatch) %>">
              <%= @user.name %>
            </span>
          </div>
        </div>

        <!-- Right Navigation -->
        <div class="col-auto">
          <div class="d-flex align-items-center">
            <%= nav_button(action: :next, record: @neighbours[1]) %>
            <% if policy(@user).edit? %>
              <%= nav_button(action: :edit, path: edit_user_path(@user), record: @user) %>
            <% end %>
            <% if policy(@user).destroy? %>
              <%= nav_button(action: :delete, record: @user) %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="card-body p-3">
      <%= render @user %>
    </div>
  </div>
</div>
