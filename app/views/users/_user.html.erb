<div class="card mb-4" style="<%= card_styles(@swatch) %>">
  <div class="card-header d-flex align-items-center gap-3 py-2" style="<%= card_header_styles(@swatch) %>">
    <%= avatar_for user, size: 50 %>
    <div>
      <h5 class="mb-0"><%= user.name %></h5>
      <% if user.job_title.present? %>
        <div class="small"><%= user.job_title %></div>
      <% end %>
    </div>
  </div>

  <div class="card-body p-3">
    <%= show_attribute(user, :email) %>
    <%= show_attribute(user, :job_title) %>
    <%= show_attribute(user, :time_zone) %>
    <div class="row mb-1">
      <span class="col-4 text-muted"><%= t('activerecord.attributes.user.preferred_locale') %>: </span>
      <span class="col-8">
        <%= user.preferred_locale.present? ? t('language', locale: user.preferred_locale) : t('index.unassigned') %>
      </span>
    </div>

    <% roles = user.roles.includes(:resource) %>
    <% if roles.any? %>
      <hr>
      <div class="d-flex flex-wrap gap-1">
        <% roles.each do |role| %>
          <% if role.resource_type.nil? %>
            <span class="badge bg-danger"><%= t("rolify.names.#{role.name}", default: "*#{role.name}") %></span>
          <% else %>
            <span class="badge bg-secondary">
              <%= t("activerecord.models.#{role.resource_type.underscore}", count: 1) %>
              <%= role.resource&.label %>: <%= t("rolify.names.#{role.name}", default: "*#{role.name}") %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
