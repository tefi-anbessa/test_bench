
<table class="table table-hover">
  <thead>
    <tr>
      <th><%= t('activerecord.attributes.user.gravatar') %></th>
      <th><%= t('activerecord.attributes.user.name') %></th>
      <th><%= t('activerecord.attributes.user.email') %></th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= gravatar_for user, size: 50 %></td>
      <td><%= user.name %></td>
      <td><%= user.email %></td>
    </tr>
  </tbody>
</table>
