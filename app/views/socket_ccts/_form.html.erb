<%= form_with(model: socket_cct) do |form| %>
  <% if socket_cct.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(socket_cct.errors.count, "error") %> prohibited this socket_cct from being saved:</h2>
      <ul>
        <% socket_cct.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :socket_type, class: "form-label" %>
    <%= form.select :socket_type, 
          options_for_select(SocketCct.socket_types.map { |k, v| [SocketCct.human_enum_name(:socket_type, k), k] }, 
          selected: socket_cct.socket_type), 
          {}, 
          class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :quantity, class: "form-label" %>
    <%= form.number_field :quantity, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :notes, class: "form-label" %>
    <%= form.text_area :notes, class: "form-control", rows: 3 %>
  </div>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t('actions.cancel'), socket_ccts_path, class: "btn btn-secondary" %>
  </div>
<% end %>