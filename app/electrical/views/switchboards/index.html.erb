<% provide(:title, t('.title')) %>
<nav class="navbar bg-body-tertiary">
  <div class="container">
    <ul class="navbar-nav me-auto mb-2 mb-lg-0 flex-row">
    <% if policy(Switchboard).new? %>
      <li class="nav-item">
        <%= link_to new_switchboard_path, 
              class: "btn btn-primary actions",
              data: { turbo: false },
              aria: { label: t('actions.new') },
              title: t('actions.new') do %>
          <%== bs_icon('plus-square-fill') %>
          <%= [t('actions.new'), t('activerecord.models.switchboard')].join(' ') %>
        <% end %>
      </li>
    <% end %>
      <span class="nav-text ms-3 me-3 h2">
        <%= t('.header')%>
      </span>
    </ul>
  </div>
</nav>
<div class = "container">
  <div class = 'listing'>
    <%= search_form_for @q do |f| %>
      <%= f.search_field :busbar_rating_cont,
            class: "search_field",
            placeholder: t('activerecord.attributes.switchboard.busbar_rating') %>
      <%= f.search_field :incomer_protection_cont,
            class: "search_field",
            placeholder: t('activerecord.attributes.switchboard.incomer_protection') %>
      <%= f.search_field :metering_cont,
            class: "search_field",
            placeholder: t('activerecord.attributes.switchboard.metering') %>
      <%= f.button nil, class: "btn btn-primary btn-sm", action: :submit do %>
        <%== bs_icon('search') %>
      <% end %>
    <% end %>
    <%== pagy_bootstrap_nav(@pagy) %>
    <table id='switchboards' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
      <%= render "switchboard_header" %>
      <tbody>
        <% @switchboards.each do |row| %>
          <%= render 'switchboard_row', row: row %>
        <% end %>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
    <%== pagy_info(@pagy) %>


  </div>
</div>

