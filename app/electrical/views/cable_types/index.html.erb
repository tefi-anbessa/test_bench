<% provide(:title, t('.title')) %>
<nav class="navbar bg-body-tertiary">
  <div class="container">
    <ul class="navbar-nav me-auto mb-2 mb-lg-0 flex-row">
    <% if policy(CableType).new? %>
      <li class="nav-item">
        <%= link_to new_cable_type_path, class: "btn btn-primary actions",
              aria: { label: t('actions.new') },
              title: t('actions.new')  do %>
          <%== bs_icon('plus-square-fill') %>
          <%= t('actions.new') + " " + t('activerecord.models.cable_type') %>
        <% end %>
      </li>
    <% end %>
      <span class="nav-text ms-3 me-3 h2">
        <%= t('.header')%>
      </span>
    </ul>
  </div>
</nav>
<div class = "container">
  <div class = 'listing'>
    <%= search_form_for @q do |f| %>
      <%= f.search_field :conductor_material_cont,
            class: "search_field",
            placeholder: t('activerecord.attributes.cable_type.conductor_material') %>
      <%= f.search_field :cores_eq,
            class: "search_field",
            placeholder: t('activerecord.attributes.cable_type.cores') %>
      <%= f.search_field :csa_eq,
            class: "search_field",
            placeholder: t('activerecord.attributes.cable_type.csa') %>
      <%= f.search_field :insulation_cont,
            class: "search_field",
            placeholder: t('activerecord.attributes.cable_type.insulation') %>
      <%= f.button nil, class: "btn btn-primary btn-sm", action: :submit do %>
        <%== bs_icon('search') %>
      <% end %>
    <% end %>
    <%== pagy_bootstrap_nav(@pagy) %>
    <table id='cable_types' class='table table-responsive table-condensed table-striped table-hoverable table-bordered' >
      <%= render "cable_type_header" %>
      <tbody>
        <% @cable_types.each do |row| %>
          <%= render 'cable_type_row', row: row %>
        <% end %>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
    <%== pagy_info(@pagy) %>


  </div>
</div>
