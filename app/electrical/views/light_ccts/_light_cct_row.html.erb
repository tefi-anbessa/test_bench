<tr scope="row">
<% if light_cct.tag.nil? %>
  <td class="table-danger"><%= t("index.no_tag", id: light_cct.id) %></td>
<% else %>
  <td><%= link_to light_cct.tag.full_tag, tag_path(light_cct.tag) %></td>
<% end %>
  <td><%= LightCct.human_enum_name(:light_fitting_type, light_cct.light_fitting_type) %></td>
  <td><%= light_cct.quantity %></td>
  <td>
    <% if policy(light_cct).show? %>
      <%= link_to light_cct_path(light_cct), class: "btn btn-secondary btn-sm icon-link",
            aria: { label: t('actions.show') },
            title: t('actions.show'),
            display: "inline" do %>
        <%== bs_icon('eye') %>
      <% end %>
    <% end %>
    <% if policy(light_cct).edit? %>
      <%= link_to edit_light_cct_path(light_cct), class: "btn btn-warning btn-sm icon-link",
            aria: { label: t('actions.edit') },
            title: t('actions.edit'),
            display: "inline"  do %>
        <%== bs_icon('pencil') %>
      <% end %>
    <% end %>
    <% if policy(light_cct).destroy? %>
      <%= link_to light_cct_path(light_cct),
              data: { method: :delete, confirm: t('actions.delete_sure') },
              class: "btn btn-danger btn-sm icon-link",
              aria: { label: t('actions.delete') },
              title: t('actions.delete'),
              display: "inline"  do %>
        <%== bs_icon('trash') %>
      <% end %>
    <% end %>
  </td>
</tr>